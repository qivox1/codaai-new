{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "lang": {
      "default": "de",
      "type": "string",
      "enum": [
        "de",
        "en"
      ]
    },
    "de": {
      "type": "string"
    },
    "seoTitle": {
      "type": "string",
      "maxLength": 32
    },
    "shortDefinition": {
      "type": "string",
      "maxLength": 240
    },
    "synonyms": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "grundlagen",
        "grounding",
        "pipeline",
        "content",
        "technik",
        "offpage",
        "messung"
      ]
    },
    "stufe": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "faq": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ],
        "additionalProperties": false
      }
    },
    "noindex": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "lang",
    "shortDefinition",
    "synonyms",
    "category",
    "related",
    "pubDate",
    "faq",
    "noindex"
  ],
  "additionalProperties": false
}