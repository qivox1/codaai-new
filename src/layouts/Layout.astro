---
import '../styles/global.css';

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
  /** Optional additional JSON-LD scripts (pass as serialised JSON string) */
  jsonLd?: string[];
  /** Pass for blog article pages to get article-specific Open Graph + meta */
  article?: ArticleMeta;
}

const {
  title = 'CodaAI',
  description = 'AI Content Platform',
  lang = 'de',
  jsonLd = [],
  article,
} = Astro.props;

// ── Base structured data (present on every page) ──────────────────────────────
const SITE_URL = 'https://qivox1.github.io/codaai-new';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CodaAI',
  alternateName: 'CodaAI – KI Content-Plattform',
  url: `${SITE_URL}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hi@codaai.ai',
    telephone: '+49-151-53406969',
    contactType: 'customer service',
    availableLanguage: ['German', 'English'],
  },
  founder: {
    '@type': 'Person',
    name: 'Anja Miebach',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Langer Weg 7b',
    addressLocality: 'Gütersloh',
    postalCode: '33332',
    addressCountry: 'DE',
  },
  sameAs: [],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CodaAI',
  url: `${SITE_URL}/`,
  inLanguage: [lang === 'en' ? 'en' : 'de', lang === 'en' ? 'de' : 'en'],
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_URL}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const baseSchemas = [
  JSON.stringify(organizationSchema),
  JSON.stringify(webSiteSchema),
  ...jsonLd,
];

const SITE_ORIGIN = 'https://qivox1.github.io';
const BASE = `${SITE_ORIGIN}/codaai-new`;
// Canonical: Astro.url.pathname already has the full path e.g. /codaai-new/
const canonicalUrl = `${SITE_ORIGIN}${Astro.url.pathname}`;

// hreflang: strip /codaai-new prefix, normalize /en/ to get bare slug
const pathNoBase = Astro.url.pathname.replace('/codaai-new', '').replace(/^\/en\//, '/').replace(/\/$/, '') || '/';
const deUrl = pathNoBase === '/' ? `${BASE}/` : `${BASE}${pathNoBase}/`;
const enUrl = pathNoBase === '/' ? `${BASE}/en/` : `${BASE}/en${pathNoBase}/`;

/*
 * Content Security Policy
 *
 * Delivered via <meta http-equiv> — the only option on GitHub Pages (no server config).
 * Note: `frame-ancestors` and HSTS are HTTP-header-only directives and cannot be set via meta.
 * Clickjacking is handled via JS frame-busting below as a defence-in-depth measure.
 *
 * Supabase endpoint: https://fcauvtwqkluvsbicaojo.supabase.co
 * Fonts: fully self-hosted via @fontsource-variable/inter — no external font requests.
 */
const csp = [
  "default-src 'self'",
  // Astro generates inline <script> blocks (theme init, mobile menu) → unsafe-inline required
  // strict-dynamic is not viable with static generation (no per-request nonces)
  "script-src 'self' 'unsafe-inline'",
  // Tailwind/Radix inline styles + React inline style props
  "style-src 'self' 'unsafe-inline'",
  // Fonts are self-hosted — no external font CDN needed
  "font-src 'self'",
  // Local images + data: URIs (inline SVG placeholders)
  "img-src 'self' data: blob:",
  // Supabase Edge Functions + Auth
  "connect-src 'self' https://fcauvtwqkluvsbicaojo.supabase.co",
  // No iframes, objects or plugins
  "frame-src 'none'",
  "object-src 'none'",
  "media-src 'none'",
  // Prevent base-tag hijacking
  "base-uri 'self'",
  // Only allow form submissions to own origin and Supabase
  "form-action 'self' https://fcauvtwqkluvsbicaojo.supabase.co",
  // Upgrade any accidental http:// sub-resource requests
  "upgrade-insecure-requests",
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      ── Security Headers (via meta) ─────────────────────────────────────────────
      HSTS cannot be set via meta tag — GitHub Pages enforces HTTPS by default,
      but to get the Strict-Transport-Security header you'd need a CDN/proxy like
      Cloudflare in front of the origin (set: Strict-Transport-Security:
      max-age=31536000; includeSubDomains; preload).

      X-Frame-Options is also header-only, but CSP frame-ancestors (below) is
      the modern equivalent. Since frame-ancestors is ignored in <meta> CSP,
      we use JS frame-busting as defence-in-depth (see <body>).
    */}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Preconnect to Supabase edge functions — reduces DNS+TLS cold-start when form is submitted */}
    <link rel="preconnect" href="https://fcauvtwqkluvsbicaojo.supabase.co" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Canonical — use article-specific canonical if provided, else current URL */}
    <link rel="canonical" href={article?.canonicalUrl ?? canonicalUrl} />

    {/* Robots */}
    {article?.noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />
    }

    {/* Open Graph — article pages get richer og:type + article meta */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={article?.ogImage ?? 'https://qivox1.github.io/codaai-new/images/og-image.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime  && <meta property="article:modified_time"  content={article.modifiedTime} />}
    {article?.author        && <meta property="article:author"         content={article.author} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter / X Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={article?.ogImage ?? 'https://qivox1.github.io/codaai-new/images/og-image.png'} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />
    {/* Fonts are now self-hosted — no Google Fonts DNS lookup or external request */}

    {/* ── JSON-LD Structured Data ───────────────────────────────────────────── */}
    {baseSchemas.map((schema) => (
      <script type="application/ld+json" set:html={schema} />
    ))}
  </head>
  <body>
    {/*
      ── Clickjacking Defence (JS frame-busting) ─────────────────────────────────
      X-Frame-Options and CSP frame-ancestors require HTTP headers which GitHub
      Pages does not allow. This script runs synchronously before the DOM renders,
      immediately redirecting the top-level window if the page is framed.
    */}
    <script is:inline>
      (function () {
        if (window.self !== window.top) {
          // Break out of any frame/iframe
          window.top.location.replace(window.self.location.href);
        }
      })();
    </script>

    <a href="#main-content" class="skip-to-content">
      {lang === 'en' ? 'Skip to main content' : 'Zum Hauptinhalt springen'}
    </a>
    <slot />
    <script>
      // Theme initialization
      const theme = localStorage.getItem('theme') || 'light';
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    </script>
  </body>
</html>
