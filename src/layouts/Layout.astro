---
import '../styles/global.css';

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  lang?: 'de' | 'en';
  /** Optional additional JSON-LD scripts (pass as serialised JSON string) */
  jsonLd?: string[];
  /** Pass for blog article pages to get article-specific Open Graph + meta */
  article?: ArticleMeta;
}

const {
  title = 'CodaAI',
  description = 'AI Content Platform',
  lang = 'de',
  jsonLd = [],
  article,
} = Astro.props;

// ââ Base structured data (present on every page) ââââââââââââââââââââââââââââââ
const SITE_URL = 'https://www.codaai.ai';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: 'CodaAI',
  alternateName: 'CodaAI â KI Content-Plattform',
  url: `${SITE_URL}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/favicon.svg`,
  },
  image: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/images/og-image.png`,
    width: 1200,
    height: 630,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hi@codaai.ai',
    telephone: '+49-151-53406969',
    contactType: 'customer service',
    availableLanguage: ['German', 'English'],
  },
  founder: {
    '@type': 'Person',
    '@id': `${SITE_URL}/co-create/#anja-miebach`,
    name: 'Anja Miebach',
    jobTitle: 'GrÃ¼nderin & Inhaberin',
    url: `${SITE_URL}/co-create/`,
    image: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/team/anja-miebach.webp`,
    },
    knowsAbout: ['KI Content Marketing', 'B2B Strategie', 'GEO', 'SEO', 'Marketing Automation'],
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Langer Weg 7b',
    addressLocality: 'GÃ¼tersloh',
    postalCode: '33332',
    addressCountry: 'DE',
  },
  sameAs: [],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'CodaAI',
  url: `${SITE_URL}/`,
  inLanguage: [lang === 'en' ? 'en' : 'de', lang === 'en' ? 'de' : 'en'],
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE_URL}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const baseSchemas = [
  JSON.stringify(organizationSchema),
  JSON.stringify(webSiteSchema),
  ...jsonLd,
];

const SITE_ORIGIN = 'https://www.codaai.ai';
const BASE = SITE_ORIGIN;
// Canonical: Astro.url.pathname already has the full path e.g. /codaai-new/
const canonicalUrl = `${SITE_ORIGIN}${Astro.url.pathname}`;

// hreflang: strip /codaai-new prefix, normalize /en/ to get bare slug
const pathNoBase = Astro.url.pathname.replace(/^\/en\//, '/').replace(/\/$/, '') || '/';
const deUrl = pathNoBase === '/' ? `${BASE}/` : `${BASE}${pathNoBase}/`;
const enUrl = pathNoBase === '/' ? `${BASE}/en/` : `${BASE}/en${pathNoBase}/`;

/*
 * Content Security Policy
 *
 * Delivered via <meta http-equiv> â the only option on GitHub Pages (no server config).
 * Note: `frame-ancestors` and HSTS are HTTP-header-only directives and cannot be set via meta.
 * Clickjacking is handled via JS frame-busting below as a defence-in-depth measure.
 *
 * Supabase endpoint: https://fcauvtwqkluvsbicaojo.supabase.co
 * Fonts: fully self-hosted via @fontsource-variable/inter â no external font requests.
 */
const csp = [
  "default-src 'self'",
  // Astro generates inline <script> blocks (theme init, mobile menu) â unsafe-inline required
  // strict-dynamic is not viable with static generation (no per-request nonces)
  // GTM loader needs googletagmanager.com for gtm.js
  "script-src 'self' 'unsafe-inline' https://www.googletagmanager.com",
  // Tailwind/Radix inline styles + React inline style props
  "style-src 'self' 'unsafe-inline'",
  // Fonts are self-hosted â no external font CDN needed
  "font-src 'self'",
  // Local images + data: URIs + GA4 measurement pixel
  "img-src 'self' data: blob: https://www.google-analytics.com",
  // Supabase + GA4 data collection endpoints + GTM
  "connect-src 'self' https://fcauvtwqkluvsbicaojo.supabase.co https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com",
  // GTM noscript fallback iframe; no other frames allowed
  "frame-src https://www.googletagmanager.com",
  "object-src 'none'",
  "media-src 'none'",
  // Prevent base-tag hijacking
  "base-uri 'self'",
  // Only allow form submissions to own origin and Supabase
  "form-action 'self' https://fcauvtwqkluvsbicaojo.supabase.co",
  // Upgrade any accidental http:// sub-resource requests
  "upgrade-insecure-requests",
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Preconnect: warm up Google CDN before deferred GTM load -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <!-- Google Tag Manager – deferred after window.load (preserves Core Web Vitals) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
      window.addEventListener('load', function() {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-N3CZH2WT';
        document.head.appendChild(s);
      }, {once: true});
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      ââ Security Headers (via meta) âââââââââââââââââââââââââââââââââââââââââââââ
      HSTS cannot be set via meta tag â GitHub Pages enforces HTTPS by default,
      but to get the Strict-Transport-Security header you'd need a CDN/proxy like
      Cloudflare in front of the origin (set: Strict-Transport-Security:
      max-age=31536000; includeSubDomains; preload).

      X-Frame-Options is also header-only, but CSP frame-ancestors (below) is
      the modern equivalent. Since frame-ancestors is ignored in <meta> CSP,
      we use JS frame-busting as defence-in-depth (see <body>).
    */}
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Preconnect to Supabase edge functions â reduces DNS+TLS cold-start when form is submitted */}
    <link rel="preconnect" href="https://fcauvtwqkluvsbicaojo.supabase.co" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Canonical â use article-specific canonical if provided, else current URL */}
    <link rel="canonical" href={article?.canonicalUrl ?? canonicalUrl} />

    {/* Robots */}
    {article?.noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />
    }

    {/* Open Graph â article pages get richer og:type + article meta */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={article?.ogImage ?? 'https://www.codaai.ai/images/og-image.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.modifiedTime  && <meta property="article:modified_time"  content={article.modifiedTime} />}
    {article?.author        && <meta property="article:author"         content={article.author} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter / X Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={article?.ogImage ?? 'https://www.codaai.ai/images/og-image.png'} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />
    {/* Fonts are now self-hosted â no Google Fonts DNS lookup or external request */}

    {/* ââ JSON-LD Structured Data âââââââââââââââââââââââââââââââââââââââââââââ */}
    {baseSchemas.map((schema) => (
      <script type="application/ld+json" set:html={schema} />
    ))}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N3CZH2WT"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {/*
      ââ Clickjacking Defence (JS frame-busting) âââââââââââââââââââââââââââââââââ
      X-Frame-Options and CSP frame-ancestors require HTTP headers which GitHub
      Pages does not allow. This script runs synchronously before the DOM renders,
      immediately redirecting the top-level window if the page is framed.
    */}
    <script is:inline>
      (function () {
        if (window.self !== window.top) {
          // Break out of any frame/iframe
          window.top.location.replace(window.self.location.href);
        }
      })();
    </script>

    <a href="#main-content" class="skip-to-content">
      {lang === 'en' ? 'Skip to main content' : 'Zum Hauptinhalt springen'}
    </a>
    <slot />
    <script>
      // Theme initialization
      const theme = localStorage.getItem('theme') || 'light';
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    </script>
  </body>
</html>
