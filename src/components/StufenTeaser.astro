---
import { t, getTranslations } from '../i18n/utils';
import Reveal from './fx/Reveal.astro';
import CurveDraw from './fx/CurveDraw.astro';

interface Props {
  lang: 'de' | 'en';
  /** Optionaler Titel-Override (z. B. für den Preisseiten-Kontext, statt der Startseiten-Copy). */
  title?: string;
  /** Optionaler CTA-Href-Override (z. B. Rechner-Anker #rechner/#calculator statt /preise/). */
  ctaHref?: string;
}

const { lang, title, ctaHref } = Astro.props;
const translations = getTranslations(lang);
const items = translations.tiers.items;
// Bullet-Punkte je Stufe stammen aus den bestehenden Programm-Gruppen (program.groups) —
// keine neue Copy erfunden, nur wiederverwendet: Basis = Kern-Leistungen, Aktiv = Skalierung,
// Dominanz = Premium (gekürzt auf 3 Punkte je Stufe für die Kartenoptik).
const groups = translations.program.groups;
const steepness: ('flat' | 'medium' | 'steep')[] = ['flat', 'medium', 'steep'];
---

<section id="stufen" class="py-20 lg:py-28 bg-muted/30 border-t border-border">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <Reveal class="text-center max-w-3xl mx-auto" as="div">
      <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-2">
        {t(lang, "tiers.eyebrow")}
      </p>
      <h2 class="cai-h2 text-foreground">
        {title ?? t(lang, "tiers.title")}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        {t(lang, "tiers.intro")}
      </p>
    </Reveal>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {items.map((tier: { name: string; badge: string; price: string; priceNote: string; text: string }, i: number) => (
        <Reveal delay={i * 120} as="div">
          <article class:list={[
            'relative flex h-full flex-col rounded-2xl border bg-card p-8 transition-transform hover:-translate-y-1',
            tier.badge ? 'border-cta border-2 shadow-lg shadow-cta/10' : 'border-border',
          ]}>
            {tier.badge && (
              <span class="absolute -top-3 left-8 rounded-full bg-cta px-3 py-1 text-xs font-bold text-white">
                {tier.badge}
              </span>
            )}
            <h3 class="text-lg font-semibold text-foreground">{tier.name}</h3>
            <div class="mt-3">
              <span class="text-2xl font-bold text-foreground">{tier.price}</span>
              <p class="mt-1 text-xs text-muted-foreground">{tier.priceNote}</p>
            </div>

            <div class="mt-4 -mx-1">
              <CurveDraw steepness={steepness[i] ?? 'medium'} delay={i * 150} height={80} />
            </div>

            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{tier.text}</p>

            <ul class="mt-4 space-y-2.5">
              {groups[i]?.items.slice(0, 3).map((item: { title: string; text: string }) => (
                <li class="flex items-start gap-2.5 text-sm text-foreground/85">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" class="mt-0.5 shrink-0">
                    <path d="M5 13l4 4L19 7" stroke="hsl(var(--confirm-text))" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <span>{item.title}</span>
                </li>
              ))}
            </ul>
          </article>
        </Reveal>
      ))}
    </div>

    <div class="mt-10 text-center">
      <p class="text-sm text-muted-foreground">{t(lang, "tiers.note")}</p>
      <a
        href={ctaHref ?? t(lang, "tiers.ctaHref")}
        class="mt-4 inline-flex items-center gap-2 rounded-[14px] bg-cta px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        {t(lang, "tiers.ctaLabel")}
      </a>
    </div>
  </div>
</section>
