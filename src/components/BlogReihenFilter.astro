---
/* Filter der Blog-Übersicht nach den vier Themenreihen (22.09.2026).
   Ohne JavaScript bleiben alle Artikel sichtbar; mit #reihe-<id> blendet das
   kleine Skript die übrigen Karten aus. Links statt Knöpfe, damit jede Reihe
   eine teilbare Adresse hat.
   29.10.2026: Sprungmarke statt ?reihe=<id> — die Query-Varianten wurden als
   vier zusätzliche Seiten mit gleichem Titel gecrawlt. ?reihe= greift weiter. */
import { REIHEN } from '../data/reihen';
interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const de = lang === 'de';
const blog = de ? '/blog/' : '/en/blog/';
---
<nav aria-label={de ? 'Themenreihen' : 'Series'} class="mb-10" data-reihen-filter>
  <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">{de ? 'Vier Themenreihen' : 'Four series'}</p>
  <ul class="flex flex-wrap gap-2">
    <li><a href={blog} data-reihe-chip="" class="reihe-chip">{de ? 'Alle Artikel' : 'All articles'}</a></li>
    {REIHEN.map((r) => (
      <li>
        <a href={`${blog}#reihe-${r.id}`} data-reihe-chip={r.id} class="reihe-chip" title={r.worum[lang]}>
          {r.name[lang]}<span class="reihe-chip-fach">{r.fach[lang]}</span>
        </a>
      </li>
    ))}
  </ul>
  {REIHEN.map((r) => (
    <p data-reihe-worum={r.id} hidden class="mt-4 text-sm text-muted-foreground max-w-2xl">
      {r.worum[lang]} <a href={r.pillar[lang]} class="text-cta-accessible underline underline-offset-4">{de ? 'Grundlagen im Leitfaden' : 'The basics in the guide'}</a>
    </p>
  ))}
</nav>
<script is:inline>
/* Läuft erst nach dem Parsen: der Filter steht ÜBER der Kartenliste, ein sofort
   ausgeführtes Inline-Skript fand bis 29.10.2026 keine einzige Karte und
   filterte deshalb nie (auch nicht mit ?reihe=). */
document.addEventListener('DOMContentLoaded', function () {
  var valid = ['technik', 'content', 'offpage', 'messung'];
  var cards = document.querySelectorAll('article[data-reihe], article[data-reihe-none]');
  /* Ursprüngliche Breiten-Klassen merken, damit „Alle“ nach einem Filter wieder stimmt. */
  cards.forEach(function (el) {
    el.setAttribute('data-wide', (el.classList.contains('md:col-span-2') ? '1' : '') + (el.classList.contains('md:flex-row') ? '2' : ''));
  });
  function current() {
    var m = location.hash.match(/^#reihe-([a-z]+)$/);
    var id = (m && m[1]) || new URLSearchParams(location.search).get('reihe') || '';
    return valid.indexOf(id) < 0 ? '' : id;
  }
  function apply() {
    var id = current();
    document.querySelectorAll('[data-reihe-chip]').forEach(function (a) {
      if (a.getAttribute('data-reihe-chip') === id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
    document.querySelectorAll('[data-reihe-worum]').forEach(function (p) {
      p.hidden = p.getAttribute('data-reihe-worum') !== id;
    });
    cards.forEach(function (el) {
      var w = el.getAttribute('data-wide') || '';
      if (!id) {
        el.style.display = '';
        if (w.indexOf('1') > -1) el.classList.add('md:col-span-2');
        if (w.indexOf('2') > -1) el.classList.add('md:flex-row');
        return;
      }
      el.style.display = el.getAttribute('data-reihe') === id ? '' : 'none';
      el.classList.remove('md:col-span-2', 'md:flex-row');
    });
  }
  apply();
  window.addEventListener('hashchange', apply);
  /* „Alle Artikel“ auf derselben Seite: Filter aufheben statt neu zu laden. */
  var all = document.querySelector('[data-reihe-chip=""]');
  if (all) all.addEventListener('click', function (e) {
    if (!current()) return;
    e.preventDefault();
    history.pushState(null, '', location.pathname);
    apply();
  });
});
</script>
