---
import { t, getTranslations } from '../i18n/utils';
import ContentRequestForm from './react/ContentRequestForm';
import FlipWords from './react/FlipWords';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const rawFlipWords: string[] = translations.hero.flipWords;

// Last word gets the CTA purple, all others get the original gray #999999
const flipWordsData = rawFlipWords.map((text: string, i: number) => ({
  text,
  color: i === rawFlipWords.length - 1 ? '#DF41FB' : '#999999',
}));

const avatars = [
  { initials: "M" },
  { initials: "K" },
  { initials: "S" },
  { initials: "A" },
  { initials: "J" },
  { initials: "D" },
];
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-24 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-20 right-1/3 w-96 h-96 bg-gradient-to-br from-cta/20 to-transparent rounded-full blur-3xl opacity-50"></div>
    <div class="absolute bottom-20 left-1/4 w-96 h-96 bg-gradient-to-br from-primary/10 to-transparent rounded-full blur-3xl opacity-50"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <div class="max-w-xl animate-fade-in">
        <h1 class="text-4xl sm:text-5xl font-semibold text-foreground leading-[1.15] tracking-tight lg:text-6xl">
          {t(lang, "hero.headline")}<br />
          <FlipWords words={flipWordsData} client:load />
        </h1>

        <p class="mt-6 leading-relaxed text-base text-primary">
          {t(lang, "hero.description")}
        </p>

        <div class="mt-6 flex items-center gap-3">
          <div class="flex items-center gap-1.5">
            <div class="size-5 rounded bg-cta flex items-center justify-center">
              <span class="text-[10px] font-bold text-white">AI</span>
            </div>
            <div class="size-5 rounded bg-cta flex items-center justify-center">
              <span class="text-[10px] font-bold text-white">G</span>
            </div>
            <div class="size-5 rounded bg-cta flex items-center justify-center">
              <span class="text-[10px] font-bold text-white">X</span>
            </div>
          </div>
          <span class="text-sm text-muted-foreground">{t(lang, "hero.poweredBy")}</span>
        </div>
      </div>

      <div class="lg:max-w-md lg:ml-auto lg:mt-[140px] animate-fade-in">
        <div class="relative w-full">
          <ContentRequestForm lang={lang} triggerType="email-input" client:load />
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-6">
          <div class="flex items-center">
            <div class="flex -space-x-2">
              {avatars.map((avatar, i) => (
                <div
                  key={i}
                  class="size-8 rounded-full flex items-center justify-center text-xs font-medium text-white ring-2 ring-background bg-[hsl(0,0%,60%)]"
                >
                  {avatar.initials}
                </div>
              ))}
            </div>
            <span class="ml-3 text-sm font-medium text-foreground">{t(lang, "hero.users")}</span>
          </div>

          <div class="h-4 w-px bg-border" />

          <div class="flex items-center gap-1.5">
            <div class="flex gap-0.5">
              {[...Array(5)].map((_, i) => (
                <svg key={i} class="size-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <span class="text-sm font-medium text-foreground">5.0</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
