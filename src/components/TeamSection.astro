---
import { t, getTranslations } from '../i18n/utils';
import CardFlip from './react/CardFlip';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const members = translations.teamSection.members;

// Exact colors from original Lovable source
const accentColors = [
  'hsl(200, 85%, 50%)',  // Pascal Planner  â cyan-blue
  'hsl(150, 70%, 40%)',  // Timo Text        â green
  'hsl(280, 70%, 55%)',  // Viola Visio      â dark purple
  'hsl(25,  95%, 55%)',  // Florian Finder   â orange
  'hsl(300, 80%, 55%)',  // Sina Spark       â bright magenta-purple
  'hsl(175, 70%, 50%)',  // Sophie Sync      â teal-green
];

// Same icon mapping as Feature cards (same order)
const iconNames = [
  'calendar-days',  // Pascal Planner  â Redaktionsplanung
  'file-text',      // Timo Text        â SEO-Blogartikel
  'image',          // Viola Visio      â Bilder & Infografiken
  'search',         // Florian Finder   â GEO-Optimierung
  'video',          // Sina Spark       â Social-Media-Videos
  'share',          // Sophie Sync      â Content Distribution
];

const images = [
  '/images/team/pascal-planner.webp',
  '/images/team/timo-text.webp',
  '/images/team/viola-visio.webp',
  '/images/team/florian-finder.webp',
  '/images/team/sina-spark.webp',
  '/images/team/sophie-sync.webp',
];
---

<section id="team" class="py-24 lg:py-32 bg-muted/20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center max-w-5xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-4xl font-semibold text-foreground tracking-tight lg:whitespace-nowrap">
        {t(lang, "teamSection.title")}
      </h2>
      <p class="mt-6 text-lg text-muted-foreground">
        {t(lang, "teamSection.subtitle")}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {members.map((member: any, index: number) => (
        <CardFlip
          client:visible
          name={member.name}
          role={member.role}
          description={member.description}
          features={member.features}
          accentColor={accentColors[index]}
          iconName={iconNames[index]}
          image={images[index]}
          lang={lang}
        />
      ))}
    </div>
  </div>
</section>
