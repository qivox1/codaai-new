---
import { t, getTranslations } from '../i18n/utils';
import CardFlip from './react/CardFlip';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const members = translations.teamSection.members;

const icons = ['👨‍💼', '📚', '🎨', '🔬', '🎬', '📊'];

const accentColors = [
  '#DF41FB', // purple
  '#3B82F6', // blue
  '#F59E0B', // amber
  '#10B981', // emerald
  '#EF4444', // red
  '#8B5CF6', // violet
];
---

<section id="team" class="py-24 lg:py-32 bg-muted/20">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center max-w-5xl mx-auto mb-16">
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-semibold text-foreground tracking-tight">
        {t(lang, "teamSection.title")}
      </h2>
      <p class="mt-6 text-lg text-muted-foreground">
        {t(lang, "teamSection.subtitle")}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {members.map((member: any, index: number) => (
        <CardFlip
          client:visible
          name={member.name}
          role={member.role}
          description={member.description}
          features={member.features}
          icon={icons[index]}
          accentColor={accentColors[index]}
        />
      ))}
    </div>
  </div>
</section>
