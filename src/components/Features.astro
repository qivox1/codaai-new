---
import { t, getTranslations } from '../i18n/utils';
import FeatureCard from './react/FeatureCard';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const experts = translations.features.experts;

// Icon names — rendered as Lucide SVG inside FeatureCard
const iconNames = [
  'calendar-days',   // Redaktionsplanung
  'file-text',       // SEO-Blogartikel
  'image',           // Bilder & Infografiken
  'search',          // GEO-Optimierung
  'video',           // Social-Media-Videos
  'share',           // Content Distribution – Social-Media-Netzwerk-Icon
];

// Exact colors from original Lovable source
const accentColors = [
  'hsl(200, 85%, 50%)',  // cyan-blue  – Redaktionsplanung
  'hsl(150, 70%, 40%)',  // green      – SEO-Blogartikel
  'hsl(280, 70%, 55%)',  // purple     – Bilder & Infografiken
  'hsl(25, 95%, 55%)',   // orange     – GEO-Optimierung
  'hsl(300, 80%, 55%)',  // magenta    – Social-Media-Videos
  'hsl(175, 70%, 50%)',  // teal       – Content Distribution
];
---

<section id="features" class="py-24 lg:py-32 bg-muted/30">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center max-w-5xl mx-auto mb-16">
      <p class="text-sm font-medium text-primary uppercase tracking-wider mb-4">
        {t(lang, "features.badge")}
      </p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-foreground tracking-tight whitespace-nowrap overflow-hidden text-ellipsis">
        {t(lang, "features.title")}
      </h2>
      <p class="mt-6 text-lg text-muted-foreground">
        {t(lang, "features.subtitle")}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {experts.map((expert: any, index: number) => (
        <FeatureCard
          client:visible
          iconName={iconNames[index]}
          title={expert.title}
          role={expert.role}
          description={expert.description}
          features={expert.features}
          lang={lang}
          accentColor={accentColors[index]}
        />
      ))}
    </div>
  </div>
</section>
