---
import { t, getTranslations } from '../i18n/utils';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const costBreakdown = translations.pricing.costBreakdown;

const icons = ['📄', '🖼️', '🎥', '📅'];
---

<section id="pricing" class="py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mt-16">
      <div class="text-center mb-12">
        <p class="text-sm font-medium text-primary uppercase tracking-wider mb-4">
          {t(lang, "pricing.badge")}
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-4xl font-semibold text-foreground tracking-tight lg:whitespace-nowrap">
          {t(lang, "pricing.title")}
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {costBreakdown.map((item: any, index: number) => (
          <div key={item.area} class="group relative rounded-2xl border border-border bg-card p-6 hover:border-primary/50 transition-all duration-300">
            <div class="flex items-center gap-3 mb-4">
              <div class="size-10 rounded-xl bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors text-xl">
                {icons[index]}
              </div>
              <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                {item.hours}
              </span>
            </div>
            <h4 class="font-semibold text-foreground mb-2">{item.area}</h4>
            <p class="text-2xl font-bold text-accent mb-3">{item.cost}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>

      <div class="relative overflow-hidden rounded-2xl border border-cta/20 p-8 bg-[hsl(291_96%_97%)]">
        <div class="relative flex flex-col items-center gap-8">
          <div class="flex flex-col lg:flex-row items-center justify-center gap-6 w-full">
            <div class="text-center lg:text-left">
              <p class="text-sm font-medium text-cta mb-1">
                {t(lang, "pricing.totalLabel")}
              </p>
              <div class="flex items-baseline gap-2 justify-center lg:justify-start">
                <span class="text-4xl lg:text-5xl font-bold text-foreground">{t(lang, "pricing.totalCost")}</span>
                <span class="text-lg text-muted-foreground">{t(lang, "pricing.totalHours")}</span>
              </div>
              <p class="mt-2 text-sm text-muted-foreground max-w-md">
                {t(lang, "pricing.totalDescription")}
              </p>
            </div>

            <svg class="size-8 text-primary rotate-90 lg:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>

            <div class="text-center p-6 rounded-xl bg-cta/10 border border-cta/30">
              <p class="text-sm font-medium text-cta mb-1">{t(lang, "pricing.withCodaAI")}</p>
              <div class="flex items-baseline gap-1 justify-center">
                <span class="text-3xl lg:text-4xl font-bold text-cta">{t(lang, "pricing.codaAIPrice")}</span>
                <span class="text-sm text-muted-foreground">{t(lang, "pricing.codaAIPer")}</span>
              </div>
            </div>
          </div>

          <button class="btn-cta h-14 px-12 text-lg" type="button" aria-label={lang === 'de' ? 'Kostenlos testen – jetzt starten' : 'Start Free Trial'}>
            {lang === 'de' ? 'Kostenlos testen' : 'Free Trial'}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
