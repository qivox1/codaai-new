---
import { t, getTranslations } from '../i18n/utils';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const costBreakdown = translations.pricing.costBreakdown;

// SVG paths — same Tabler/Lucide line-icon style as FeatureCard
const iconData = [
  {
    // SEO-Blogartikel / Blog article
    paths: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><path d="M9 9l1 0"/><path d="M9 13l6 0"/><path d="M9 17l6 0"/>`,
  },
  {
    // Bilder & Infografiken / Images
    paths: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 8h.01"/><path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z"/><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5"/><path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3"/>`,
  },
  {
    // Content Promotion / Distribution
    paths: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/><path d="M18 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/><path d="M18 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/><path d="M8.7 10.7l6.6 -3.4"/><path d="M8.7 13.3l6.6 3.4"/>`,
  },
  {
    // Planung & Koordination / Planning
    paths: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12z"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M4 11h16"/><path d="M7 14h.013"/><path d="M10.01 14h.005"/><path d="M13.01 14h.005"/><path d="M16.015 14h.005"/><path d="M13.015 17h.005"/><path d="M7.01 17h.005"/><path d="M10.01 17h.005"/>`,
  },
];
---

<section id="pricing" class="py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mt-16">
      <div class="text-center mb-12">
        <p class="text-sm font-medium text-primary uppercase tracking-wider mb-4">
          {t(lang, "pricing.badge")}
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-4xl font-semibold text-foreground tracking-tight lg:whitespace-nowrap">
          {t(lang, "pricing.title")}
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {costBreakdown.map((item: any, index: number) => (
          <div key={item.area} class="group relative rounded-2xl border border-border bg-card p-6 hover:border-primary/50 transition-all duration-300">
            <div class="flex items-center gap-3 mb-5">
              <div class="size-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-muted/60">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-muted-foreground"
                  set:html={iconData[index].paths}
                />
              </div>
              <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                {item.hours}
              </span>
            </div>
            <h4 class="font-semibold text-foreground mb-2">{item.area}</h4>
            <p class="text-2xl font-bold text-foreground mb-3">{item.cost}</p>
            <p class="text-xs text-muted-foreground leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>

      {/* Comparison banner */}
      <div class="relative overflow-hidden rounded-2xl border border-cta/20 p-8 bg-[hsl(291_96%_97%)]">
        <div class="relative flex flex-col items-center gap-6">

          {/* Savings badge — prominent, top-center */}
          <div class="flex items-center gap-2 bg-cta text-white text-sm font-bold px-5 py-2 rounded-full shadow-md shadow-cta/30">
            <svg class="size-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            {t(lang, "pricing.codaAISavings")}
          </div>

          {/* Prices — always one row */}
          <div class="flex flex-row items-center justify-center gap-4 sm:gap-8 w-full flex-wrap">

            {/* Left: Agency total */}
            <div class="text-center">
              <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">
                {t(lang, "pricing.totalLabel")}
              </p>
              <div class="flex items-baseline gap-1.5 justify-center whitespace-nowrap">
                <span class="text-3xl lg:text-4xl font-bold text-foreground">{t(lang, "pricing.totalCost")}</span>
                <span class="text-sm text-muted-foreground">{t(lang, "pricing.totalHours")}</span>
              </div>
              <p class="mt-1 text-xs text-muted-foreground max-w-[220px] mx-auto">
                {t(lang, "pricing.totalDescription")}
              </p>
            </div>

            {/* Arrow */}
            <svg class="size-7 text-cta flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>

            {/* Right: CodaAI price */}
            <div class="text-center p-5 rounded-xl bg-cta/10 border border-cta/30">
              <p class="text-xs font-medium text-cta uppercase tracking-wider mb-1">{t(lang, "pricing.withCodaAI")}</p>
              <div class="flex items-baseline gap-1.5 justify-center whitespace-nowrap">
                <span class="text-3xl lg:text-4xl font-bold text-cta leading-none">{t(lang, "pricing.codaAIPrice")}</span>
              </div>
              <p class="text-sm text-muted-foreground mt-1">
                {t(lang, "pricing.codaAIStatt")}
              </p>
            </div>
          </div>

          <button class="btn-cta h-14 px-12 text-lg" type="button" aria-label={lang === 'de' ? 'Kostenlos testen – jetzt starten' : 'Start Free Trial'}>
            {lang === 'de' ? 'Kostenlos testen' : 'Free Trial'}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
