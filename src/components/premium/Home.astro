  .mi-vscan .sd i{width:7px;height:7px;border-radius:50%;background:#fff;opacity:.5;animation:mi-sd 1s ease infinite}
  .mi-vscan .sd i:nth-child(2){animation-delay:.15s}
  .mi-vscan .sd i:nth-child(3){animation-delay:.3s}
  @keyframes mi-sd{0%,100%{transform:translateY(0);opacity:.45}50%{transform:translateY(-3px);opacity:1}}
  .mi-verdict.is-scanning .dot,.mi-verdict.is-scanning .mi-vout{display:none}
