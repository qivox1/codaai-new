  .mi-verdict .dot{width:9px;height:9px;flex:none;border-radius:50%;background:#fff;margin-top:8px;opacity:.85}
  .mi-vscan{display:none;align-items:center;gap:9px;color:#fff;font-weight:600;font-size:.9rem}
