      spot.style.setProperty('--mx',(x*100)+'%'); spot.style.setProperty('--my',(y*100)+'%');
      if(card){ card.style.transform='rotateY('+((x-0.5)*8)+'deg) rotateX('+((0.5-y)*8)+'deg) translateZ(0)'; }
    });
