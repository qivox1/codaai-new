---
/* CodaAI Premium-Startseite — aus prototyp-startseite.html transformiert.
   Global-CSS auf #cai-premium gescopt; GSAP/ScrollTrigger/Lenis via CDN. */
import AuditCTA from './AuditCTA.astro';
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Playfair+Display:ital,wght@0,700..900;1,700..900&display=swap" rel="stylesheet">

<div id="cai-premium">
<div class="progress"><i id="prog"></i></div>
<div class="grain"></div>

<div class="dotnav" id="dotnav">
  <a href="#hero" data-nav="hero" class="on"><span>Start</span></a>
  <a href="#problem" data-nav="problem"><span>Das Problem</span></a>
  <a href="#schauplaetze" data-nav="schauplaetze"><span>SEO · AEO · GEO</span></a>
  <a href="#programm" data-nav="programm"><span>Das System</span></a>
  <a href="#outcome" data-nav="outcome"><span>Auftragseingang</span></a>
</div>

<!-- ================= HERO ================= -->
<section class="hero" id="hero">
  <div class="hero-aurora"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>
  <div class="hero-spot" id="herospot"></div>
  <div class="wrap hero-grid">
    <div>
      <h1>
        <span class="l1">Sichtbar, wo Ihre Kunden</span>
        <span class="flip" id="flip" aria-live="polite"><span class="sizer">Anbieter vergleichen.</span></span>
      </h1>
      <p class="desc">94 % der B2B-Einkäufer nutzen KI im Kaufprozess (Forrester 2026). Wir sorgen dafür, dass Sie dort empfohlen werden — und aus Empfehlungen qualifizierte Anfragen werden. Das CodaAI Digital Visibility System aus SEO, AEO und GEO macht genau das messbar.</p>
      <div class="ctas">
        <AuditCTA label="Digital Visibility Audit kostenlos anfordern" />
        <a href="#programm" class="btn ghost mag" data-mag>Das System im Detail →</a>
      </div>
      <div class="pb"><i>AI</i><span>Powered by AI · SEO · AEO · GEO</span></div>
    </div>

    <div class="kicard-wrap" id="ktilt">
      <div class="kicard" id="kicard">
        <span class="kbadge"><span class="pulse"></span> KI-Antwort · dokumentiert</span>
        <div class="kq"><span id="kqtext"></span><span class="kcaret" id="kqcaret"></span></div>
        <div class="kthink" id="kthink"><span></span><span></span><span></span></div>
        <div class="kres" id="kres">
          <div class="kr" data-kr><span class="n">1</span><span class="m"><b>Berger Antriebstechnik GmbH</b><s>namentlich empfohlen · als Quelle zitiert</s></span><span class="bdg">Sichtbarkeit 63 %</span></div>
          <div class="kr" data-kr><span class="n">2</span><span class="m"><b>Systemtechnik Nord GmbH &amp; Co. KG</b><s>namentlich empfohlen</s></span><span class="bdg">Position 2</span></div>
          <div class="kr" data-kr><span class="n">3</span><span class="m"><b>ProTec Industrieanlagen AG</b><s>namentlich empfohlen</s></span><span class="bdg">häufig zitiert</span></div>
        </div>
        <div class="kpunch" id="kpunch"><b>… und Sie?</b><s>In 55 % der Einkäuferfragen nicht genannt.</s></div>
        <div class="kfoot" id="kfoot"><em>Dokumentiert in</em><span class="pill">ChatGPT</span><span class="pill">Google KI-Übersicht</span></div>
      </div>
      <p class="kcap">Anonymisiertes Beispiel aus 7.184 dokumentierten KI-Antworten (CodaAI-Studie 2026).</p>
    </div>
  </div>
</section>

<!-- ================= PROBLEM ================= -->
<section class="problem" id="problem">
  <div class="p-scene" id="p-scene">
    <div class="p-stage">
      <div class="p-rail"><i id="prail"></i></div>
      <div class="p-steps" id="psteps">
        <span data-step="0">Suchanfrage</span><span data-step="1">Google-Treffer</span><span data-step="2">KI-Übersicht</span><span data-step="3">Wettbewerber</span><span data-step="4">Ihr Blindspot</span>
      </div>
      <div class="p-phasebar">
        <span class="eyebrow">Wie Einkäufer heute entscheiden</span>
        <p class="p-phasehl" id="pphase">Ihr Kunde sucht — in Google oder gleich in der KI.</p>
        <span class="p-phasenum" id="pphasenum">Schritt 1 / 5</span>
      </div>
      <div class="p-inner">
        <div class="browser">
          <div class="bbar"><span class="d"></span><span class="d"></span><span class="d"></span>
            <div class="omni"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><span class="q"><span id="qtext"></span><span class="qcaret" id="qcaret"></span></span></div>
          </div>
          <div class="vp">
            <div class="serp" id="serp">
              <div class="res" data-res><div class="u"><b></b>wettbewerber-alpha.de</div><div class="t">Alpha Systems — Marktführer für Industrie-Automation</div><div class="s">Seit 1998 Komplettlösungen für den Mittelstand. Referenzen, Whitepaper, Beratung …</div></div>
              <div class="res" data-res><div class="u"><b></b>beta-technik.de</div><div class="t">Beta Technik AG — Anlagen &amp; Steuerungen</div><div class="s">Individuelle Lösungen, zertifizierte Qualität, 24/7-Service für Ihre Produktion …</div></div>
              <div class="res" data-res><div class="u"><b></b>gamma-group.com</div><div class="t">Gamma Group — Ihr Partner für digitale Fertigung</div><div class="s">Vom Sensor bis zur Cloud. Über 400 Projekte europaweit umgesetzt …</div></div>
              <div class="res" data-res><div class="u"><b></b>ihr-unternehmen.de</div><div class="t" style="color:#5b5b66">Ihr Unternehmen — Seite 2, Position 14</div><div class="s">… kaum noch jemand scrollt so weit.</div></div>
              <div class="serplabel" id="serplabel">↓ organische Treffer — unter die Falz geschoben</div>
            </div>
            <div class="ai" id="ai">
              <div class="ai-head"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.2L20 10l-5.8 1.8L12 18l-2.2-6.2L4 10l5.8-1.8z"/></svg> KI-Übersicht</div>
              <div class="ai-body" id="aibody"></div>
              <div class="chips" id="chips">
                <span class="chip" data-chip>Alpha Systems</span><span class="chip" data-chip>Beta Technik AG</span><span class="chip" data-chip>Gamma Group</span><span class="chip ghost" data-ghost>Ihr Unternehmen</span>
              </div>
            </div>
          </div>
        </div>
        <aside class="p-stat" id="pstat">
          <div class="big"><em id="statnum">0</em></div>
          <div class="lab">weniger Klicks auf Platz 1, sobald Google die KI-Übersicht zeigt — <strong style="color:#fff">11 statt 27</strong> von 100 Suchenden.</div>
          <div class="src">SISTRIX 2026</div>
        </aside>
        <div class="punch" id="punch">
          <div class="num">55&#8202;%</div>
          <div class="cap">der Einkäuferfragen bleiben <em>ohne Nennung Ihres Unternehmens</em>.</div>
          <p class="close">Wer in diesen Antworten nicht vorkommt, ist aus dem Relevant Set raus — ohne es zu merken. Diese Nicht-Nennung erscheint in keiner Statistik und keinem Traffic-Report.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= SEO / AEO / GEO (horizontal) ================= -->
<section class="hz" id="schauplaetze">
  <div class="hz-pin" id="hz-pin">
    <div class="hz-head">
      <p class="eyebrow">Drei Disziplinen, ein Ziel</p>
      <h2 class="sec">SEO, AEO, GEO —<span class="l2">was ist das eigentlich?</span></h2>
    </div>
    <div class="hz-count" id="hzcount"><i class="on"></i><i></i><i></i></div>
    <div class="hz-track" id="hz-track">

      <!-- SEO -->
      <div class="hz-panel">
        <div class="disc">
          <svg class="disc-illu" viewBox="0 0 420 420" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="60" y1="150" x2="250" y2="150" stroke-linecap="round"/>
            <line x1="60" y1="188" x2="215" y2="188" stroke-linecap="round"/>
            <line x1="60" y1="226" x2="240" y2="226" stroke-linecap="round"/>
            <circle cx="240" cy="205" r="120"/>
            <line x1="326" y1="291" x2="394" y2="362" stroke-width="6" stroke-linecap="round"/>
            <path d="M300 152 l6 17 17 6 -17 6 -6 17 -6 -17 -17 -6 17 -6 z" fill="currentColor" stroke="none"/>
          </svg>
          <div>
            <div class="disc-kicker">SEO</div>
            <div class="disc-step">Ebene 1 · Suchmaschinenoptimierung</div>
            <h3 class="disc-title">Gefunden werden, wenn jemand aktiv sucht.</h3>
            <p class="disc-def">Ihre Website rankt in <b>Google und Bing</b>. Sucht ein Einkäufer „Antriebstechnik Sondermaschinenbau", steht Ihre Leistungsseite auf Seite 1. Das Fundament — denn auch KI-Systeme bedienen sich aus den Suchindizes.</p>
          </div>
          <div class="disc-demo">
            <div class="d-card">
              <div class="d-sq"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5" stroke-linecap="round"/></svg> Antriebstechnik Sondermaschinenbau</div>
              <div class="d-row"><span class="d-rank">1</span><span>Berger Antriebstechnik</span></div>
              <div class="d-row"><span class="d-rank">2</span><span>Systemtechnik Nord</span></div>
              <div class="d-row you"><span class="d-rank">4</span><span>Ihre Firma — sichtbar auf Seite 1 ✓</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- AEO -->
      <div class="hz-panel">
        <div class="disc">
          <svg class="disc-illu" viewBox="0 0 420 420" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="70" y="95" width="292" height="132" rx="18"/>
            <line x1="100" y1="140" x2="320" y2="140" stroke-linecap="round"/>
            <line x1="100" y1="172" x2="288" y2="172" stroke-linecap="round"/>
            <path d="M352 58 l9 25 25 9 -25 9 -9 25 -9 -25 -25 -9 25 -9 z" fill="currentColor" stroke="none"/>
            <line x1="80" y1="272" x2="250" y2="272" stroke-linecap="round"/>
            <line x1="80" y1="304" x2="215" y2="304" stroke-linecap="round"/>
            <line x1="80" y1="336" x2="240" y2="336" stroke-linecap="round"/>
          </svg>
          <div>
            <div class="disc-kicker">AEO</div>
            <div class="disc-step">Ebene 2 · Answer Engine Optimization</div>
            <h3 class="disc-title">Zitiert werden in Googles KI-Übersicht.</h3>
            <p class="disc-def">Google beantwortet immer mehr Fragen <b>direkt über den Treffern</b> — in der KI-Übersicht. AEO sorgt dafür, dass Ihre Inhalte in dieser Antwortbox als Quelle erscheinen. Wer dort fehlt, verliert Klicks trotz gutem Ranking.</p>
          </div>
          <div class="disc-demo">
            <div class="d-card">
              <div class="d-aio">
                <div class="h"><span style="color:var(--magenta)">✦</span> KI-Übersicht</div>
                <p>Worauf es bei der Auswahl eines Anbieters ankommt, fassen mehrere Quellen zusammen — darunter <strong>Ihre Leistungsseite</strong> und <strong>Ihr Fachbeitrag</strong>.</p>
              </div>
              <span class="d-check">✓ Als Quelle zitiert</span>
            </div>
          </div>
        </div>
      </div>

      <!-- GEO -->
      <div class="hz-panel">
        <div class="disc">
          <svg class="disc-illu" viewBox="0 0 420 420" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="210" y1="210" x2="90" y2="110"/>
            <line x1="210" y1="210" x2="330" y2="90"/>
            <line x1="210" y1="210" x2="352" y2="228"/>
            <line x1="210" y1="210" x2="300" y2="342"/>
            <line x1="210" y1="210" x2="112" y2="322"/>
            <line x1="210" y1="210" x2="70" y2="222"/>
            <circle cx="90" cy="110" r="7"/>
            <circle cx="330" cy="90" r="7"/>
            <circle cx="352" cy="228" r="7"/>
            <circle cx="300" cy="342" r="7"/>
            <circle cx="112" cy="322" r="7"/>
            <circle cx="70" cy="222" r="7"/>
            <circle cx="210" cy="210" r="22"/>
            <circle cx="210" cy="210" r="13" fill="currentColor" stroke="none"/>
          </svg>
          <div>
            <div class="disc-kicker">GEO</div>
            <div class="disc-step">Ebene 3 · Generative Engine Optimization</div>
            <h3 class="disc-title">Namentlich empfohlen in ChatGPT &amp; Co.</h3>
            <p class="disc-def">Die Königsdisziplin: Ihr Unternehmen wird in <b>ChatGPT, Gemini, Perplexity und Claude</b> beim Namen genannt, wenn Einkäufer nach Anbietern fragen. GEO entscheidet, ob dort Ihr Name steht — oder der Ihres Wettbewerbers.</p>
          </div>
          <div class="disc-demo">
            <div class="d-card">
              <div class="d-gpt">
                <p class="u">Welche Hersteller sollten wir anfragen?</p>
                <p>Empfehlenswert sind vor allem <strong>Ihre Firma</strong> (dokumentierte Prozesse, starke Referenzen) sowie zwei weitere Anbieter.</p>
              </div>
              <span class="d-check">✓ Namentlich empfohlen</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CTA-Band nach SEO/AEO/GEO (invertiert: schwarz/weiß) -->
<section class="acta-band" style="padding:78px 0;background:#0f0f12;border-top:1px solid #1e1e26;border-bottom:1px solid #1e1e26">
  <div class="wrap" style="text-align:center;max-width:760px">
    <p style="font-size:clamp(1.4rem,3vw,2rem);font-weight:700;letter-spacing:-.015em;color:#ffffff;line-height:1.25;margin:0 0 22px">
      Wie sichtbar ist Ihr Unternehmen heute in ChatGPT &amp; der Google&nbsp;KI-Übersicht?
    </p>
    <div style="display:flex;justify-content:center">
      <AuditCTA variant="band" align="center" theme="dark" />
    </div>
  </div>
</section>

<!-- ================= CONCLUSIO (Farbüberblendung + Zitat) ================= -->
<section class="conclusio" id="conclusio">
  <div class="cc-scene" id="cc-scene">
    <div class="cc-stage">
      <div class="cc-veil" id="cc-veil"></div>
      <div class="cc-quote">
        <span class="cc-mark" aria-hidden="true">&ldquo;</span>
        <div class="cc-row cc-r1">
          <span class="cc-w t-label">Jede</span>
          <span class="cc-w cc-big t-outline">Ebene</span>
          <span class="cc-w t-label">für sich</span>
        </div>
        <div class="cc-row cc-r2">
          <span class="cc-w t-mid">bleibt</span>
          <span class="cc-w cc-big t-huge">Stückwerk.</span>
        </div>
        <div class="cc-row cc-r3">
          <span class="cc-w t-label">Erst alle</span>
          <span class="cc-w cc-big t-outline">3</span>
          <span class="cc-w t-mid">zusammen</span>
          <span class="cc-w t-label">ergeben</span>
        </div>
        <div class="cc-row cc-r4">
          <span class="cc-w cc-big t-mega">Digital Visibility.</span>
        </div>
        <div class="cc-row cc-r5">
          <span class="cc-w cc-sub">Sichtbar an jeder Stelle, an der Ihre Kunden entscheiden.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= PROGRAMM / BENTO ================= -->
<section class="prog" id="programm">
  <div class="wrap">
    <div class="prog-head">
      <p class="eyebrow">Das CodaAI Digital Visibility System</p>
      <h2 class="sec">Ein System. Drei Ebenen. Ein Ziel: empfohlen werden.</h2>
      <p class="lead" style="margin-top:14px">Sichtbarkeit in KI-Antworten entsteht zum großen Teil außerhalb der eigenen Website. Unser System arbeitet deshalb auf drei Ebenen — vom Fundament bis zur Marktführerschaft.</p>
    </div>
    <div class="sys" id="sys">
      <!-- Showcase (wechselt je Ebene) -->
      <div class="sys-stage">
        <div class="sys-panel on" data-level="0">
          <div class="shot">
            <div class="shot-head"><b>Digital Visibility Audit</b><span class="chip2">ihre-domain.de</span></div>
            <div class="barrow2"><span class="bl">SEO-Sichtbarkeit</span><span class="bt"><i style="--w:62%"></i></span><span class="bv">6,2</span></div>
            <div class="barrow2"><span class="bl">AIO-Präsenz</span><span class="bt"><i style="--w:41%"></i></span><span class="bv">41 %</span></div>
            <div class="barrow2"><span class="bl">KI-Nennungsrate</span><span class="bt"><i style="--w:12%"></i></span><span class="bv">12 %</span></div>
            <p class="shot-cap">Ihr Ausgangswert — schwarz auf weiß.</p>
          </div>
        </div>
        <div class="sys-panel" data-level="1">
          <div class="shot">
            <div class="shot-head"><b>Sichtbar in jeder Engine</b><span class="chip2">Digital-PR</span></div>
            <svg class="eng" viewBox="0 0 260 150" width="100%" height="150" style="margin-top:6px">
              <g><line x1="92" y1="75" x2="176" y2="25" stroke="var(--magenta)" stroke-opacity=".35" stroke-width="1.5"/><rect x="176" y="12" width="80" height="26" rx="6" fill="none" stroke="var(--line2)"/><text x="216" y="29" text-anchor="middle" font-size="11" font-weight="700" fill="#444">ChatGPT</text></g>
              <g><line x1="92" y1="75" x2="176" y2="75" stroke="var(--magenta)" stroke-opacity=".35" stroke-width="1.5"/><rect x="176" y="62" width="80" height="26" rx="6" fill="none" stroke="var(--line2)"/><text x="216" y="79" text-anchor="middle" font-size="11" font-weight="700" fill="#444">Google</text></g>
              <g><line x1="92" y1="75" x2="176" y2="125" stroke="var(--magenta)" stroke-opacity=".35" stroke-width="1.5"/><rect x="176" y="112" width="80" height="26" rx="6" fill="none" stroke="var(--line2)"/><text x="216" y="129" text-anchor="middle" font-size="11" font-weight="700" fill="#444">Perplexity</text></g>
              <rect x="4" y="60" width="88" height="30" rx="8" fill="var(--magenta)"/><text x="48" y="79" text-anchor="middle" font-size="11" font-weight="700" fill="#fff">Ihre Website</text>
            </svg>
            <p class="shot-cap">Ihr Name in fremden Quellen — die KI empfiehlt, wen sie oft liest.</p>
          </div>
        </div>
        <div class="sys-panel" data-level="2">
          <div class="shot">
            <div class="shot-head"><b>Eigene Studie &amp; Daten-Assets</b><span class="chip2">Zitatmagnet</span></div>
            <svg viewBox="0 0 260 150" width="100%" height="150" style="margin-top:6px">
              <line x1="10" y1="130" x2="250" y2="130" stroke="var(--line)" stroke-width="1.5"/>
              <rect class="gbar" x="30" y="94" width="34" height="36" rx="4" fill="rgba(223,65,251,.32)"/>
              <rect class="gbar" x="86" y="72" width="34" height="58" rx="4" fill="rgba(223,65,251,.5)"/>
              <rect class="gbar" x="142" y="48" width="34" height="82" rx="4" fill="rgba(223,65,251,.72)"/>
              <rect class="gbar" x="198" y="24" width="34" height="106" rx="4" fill="var(--magenta)"/>
            </svg>
            <p class="shot-cap"><strong>7.184</strong> dokumentierte KI-Antworten — Zahlen, die sonst niemand hat.</p>
          </div>
        </div>
        <button class="sys-pp" aria-label="Pause">&#10073;&#10073;</button>
      </div>

      <!-- Segmented-Pill-Tabs -->
      <div class="sys-tabs">
        <div class="sys-tablist" role="tablist" aria-label="Die drei Ebenen des Systems">
          <button class="sys-tab on" role="tab" data-tab="0" aria-selected="true">Fundament<i class="pgr"></i></button>
          <button class="sys-tab" role="tab" data-tab="1" aria-selected="false">Skalierung<i class="pgr"></i></button>
          <button class="sys-tab" role="tab" data-tab="2" aria-selected="false">Marktführerschaft<i class="pgr"></i></button>
        </div>
      </div>

      <!-- Erläuterungen je Ebene -->
      <div class="sys-body">
        <div class="sys-content on" data-content="0">
          <div class="sys-lead"><span class="lv">Ebene 1 · in jeder Stufe enthalten</span><h3>Das Fundament — messbar und zitierfähig.</h3></div>
          <div class="sys-items" style="grid-template-rows:repeat(3,auto)">
            <div class="sys-item"><span class="dot">1</span><div><b>Digital Visibility Audit</b><p>Was ChatGPT &amp; die Google KI-Übersicht heute über Sie sagen — als persönliches Dashboard.</p></div></div>
            <div class="sys-item"><span class="dot">2</span><div><b>KI-Sichtbarkeits-Monitoring</b><p>Monatlicher Report Ihrer KI-Nennungen. Ohne Messung kein beweisbarer Fortschritt.</p></div></div>
            <div class="sys-item"><span class="dot">3</span><div><b>SEO — inklusive Bing</b><p>Google und Bing. ChatGPT bedient sich beim Bing-Index — kaum jemand optimiert dafür.</p></div></div>
            <div class="sys-item"><span class="dot">4</span><div><b>Technische KI-Zugänglichkeit</b><p>KI-Crawler lesen kein JavaScript. Wir machen Ihre Inhalte lesbar und zitierbar.</p></div></div>
            <div class="sys-item"><span class="dot">5</span><div><b>Zitierfähiger Content</b><p>Statistiken, Quellen, klare Aussagen — das Format, das KI bevorzugt zitiert.</p></div></div>
            <div class="sys-item"><span class="dot">6</span><div><b>Content-Refresh &amp; Bestandsseiten</b><p>Wir halten Ihre wichtigsten Seiten systematisch aktuell — KI bevorzugt frische Inhalte.</p></div></div>
          </div>
        </div>
        <div class="sys-content" data-content="1">
          <div class="sys-lead"><span class="lv">Ebene 2 · die nächste Ausbaustufe</span><h3>Skalierung — außerhalb Ihrer Website.</h3></div>
          <div class="sys-items" style="grid-template-rows:repeat(2,auto)">
