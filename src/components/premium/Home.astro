  .dotnav a span{position:absolute;right:20px;top:50%;transform:translateY(-50%);white-space:nowrap;font-size:.72rem;
    color:var(--fg);background:#fff;border:1px solid var(--line);border-radius:6px;padding:2px 8px;opacity:0;pointer-events:none;transition:opacity .2s;box-shadow:0 6px 18px -10px rgba(0,0,0,.3)}
  .dotnav a:hover span{opacity:1}
  @media(max-width:820px){.dotnav{display:none}}

  nav.top{position:fixed;left:0;top:0;right:0;z-index:85;display:flex;align-items:center;justify-content:space-between;
    padding:14px clamp(20px,4vw,40px);transition:background .3s,box-shadow .3s,backdrop-filter .3s}
  nav.top.solid{background:rgba(255,255,255,.82);backdrop-filter:blur(10px);box-shadow:0 1px 0 var(--line)}
  .logo{font-weight:800;letter-spacing:-.02em;font-size:1.15rem}
  .logo b{color:var(--magenta)}
  .btn{display:inline-flex;align-items:center;gap:.5rem;border-radius:12px;font-weight:600;font-size:.95rem;padding:.7rem 1.25rem;
    transition:transform .18s ease,opacity .18s,box-shadow .18s;will-change:transform}
  .btn.cta{background:var(--magenta);color:#fff;box-shadow:0 10px 30px -12px rgba(223,65,251,.7)}
  .btn.cta:hover{box-shadow:0 14px 36px -10px rgba(223,65,251,.85)}
  .btn.ghost{border:1px solid var(--line2);color:var(--fg)}
  .mag{display:inline-block}

  /* ============ HERO ============ */
  .hero{padding:150px 0 90px;overflow:hidden}
  .hero-aurora{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}
  .blob{position:absolute;border-radius:50%;filter:blur(60px);opacity:.55}
  .b1{width:520px;height:520px;top:-120px;right:8%;background:radial-gradient(circle at 30% 30%,rgba(223,65,251,.5),transparent 70%);animation:float1 14s ease-in-out infinite}
  .b2{width:460px;height:460px;bottom:-160px;left:2%;background:radial-gradient(circle at 60% 40%,rgba(124,58,237,.32),transparent 70%);animation:float2 18s ease-in-out infinite}
  .b3{width:300px;height:300px;top:30%;left:44%;background:radial-gradient(circle,rgba(223,65,251,.22),transparent 70%);animation:float1 20s ease-in-out infinite reverse}
  @keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(-40px,30px)}}
  @keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(40px,-30px)}}
  .hero-spot{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:0;transition:opacity .4s;
    background:radial-gradient(340px circle at var(--mx,50%) var(--my,40%),rgba(223,65,251,.10),transparent 70%)}
