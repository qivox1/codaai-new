  .mi-vtyped.typing::after{content:"";display:inline-block;width:2px;height:1.05em;background:#fff;margin-left:2px;vertical-align:-3px;animation:mi-caret .8s step-end infinite}
  @keyframes mi-caret{50%{opacity:0}}
  .mi-logo-wrap,.mi-ans,.mi-verdict{transition:opacity .45s ease}
  .mi-arow{display:flex;align-items:center;gap:16px;margin-bottom:2px}
  .mi-logo-wrap{flex:none;display:flex;align-items:center;justify-content:center}
  .mi-logo-lg{width:56px;height:56px;display:block}
  .mi-ans.mi-typing::after{content:"";display:inline-block;width:2px;height:1.05em;background:#B01FD1;margin-left:1px;vertical-align:-3px;animation:mi-caret .8s step-end infinite}
  .mi-foot{padding:18px 22px;background:#fafafc;border-top:1px solid var(--line);font-size:.84rem;color:var(--mut)}
  .mi-foot a{color:var(--magenta-ink);font-weight:700}
