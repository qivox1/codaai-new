  /* ── Outcome: 4,4 × als Balkenvergleich (Ä10) ── */
  .oc-lead{margin-top:10px;color:var(--d-mut);font-size:1rem;line-height:1.6}
  .oc-vals{max-width:540px;margin:22px auto 0;text-align:left}
  .vrow{display:grid;grid-template-columns:190px minmax(0,1fr) 58px;gap:12px;align-items:center;margin:10px 0}
