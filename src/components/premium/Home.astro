---
/* CodaAI Premium-Startseite — aus prototyp-startseite.html transformiert.
   Global-CSS auf #cai-premium gescopt; GSAP/ScrollTrigger/Lenis via CDN.
   Schriften kommen selbst gehostet aus global.css (kein Google-Fonts-Request). */
import AuditCTA from './AuditCTA.astro';
---

<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

<div id="cai-premium">
<div class="progress"><i id="prog"></i></div>
<div class="grain"></div>

<div class="dotnav" id="dotnav">
  <a href="#hero" data-nav="hero" class="on"><span>Start</span></a>
  <a href="#problem" data-nav="problem"><span>Das Problem</span></a>
  <a href="#spiegel" data-nav="spiegel"><span>Ein echtes Audit</span></a>
  <a href="#angebot" data-nav="angebot"><span>Das Angebot</span></a>
  <a href="#outcome" data-nav="outcome"><span>Auftragseingang</span></a>
</div>

<!-- ================= HERO ================= -->
<section class="hero" id="hero">
  <div class="hero-aurora"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>
  <div class="hero-spot" id="herospot"></div>
  <div class="wrap hero-grid">
    <div>
      <h1 class="cai-h1 cai-kipp">
        <span class="l1 k1">Die KI empfiehlt drei Anbieter.</span>
        <span class="l1b k2">Sind Sie einer davon?</span>
      </h1>
      <p class="hl2">Dort, wo Ihre Kunden <span class="flip" id="flip" aria-live="polite"><span class="sizer">Anbieter vergleichen.</span></span></p>
      <p class="desc">94 % der B2B-Einkäufer nutzen KI im Kaufprozess (Forrester 2026). Wer dort nicht empfohlen wird, bekommt die Anfrage nicht — und erfährt nie, dass es sie gab.</p>
      <div class="ctas">
        <AuditCTA label="Zeigen Sie mir, was die KI über mein Unternehmen sagt" />
      </div>
      <div class="pb"><i>AI</i><span>Powered by AI · SEO · AEO · GEO</span></div>
    </div>

    <div class="kicard-wrap" id="ktilt">
      <div class="kicard" id="kicard">
        <span class="kbadge"><span class="pulse"></span> KI-Antwort · dokumentiert</span>
        <div class="kq"><span id="kqtext"></span><span class="kcaret" id="kqcaret"></span></div>
        <div class="kthink" id="kthink"><span></span><span></span><span></span></div>
        <div class="kres" id="kres">
          <div class="kr" data-kr><span class="n">1</span><span class="m"><b>Berger Antriebstechnik GmbH</b><s>namentlich empfohlen · als Quelle zitiert</s></span><span class="bdg">Sichtbarkeit 63 %</span></div>
          <div class="kr" data-kr><span class="n">2</span><span class="m"><b>Systemtechnik Nord GmbH &amp; Co. KG</b><s>namentlich empfohlen</s></span><span class="bdg">Position 2</span></div>
          <div class="kr" data-kr><span class="n">3</span><span class="m"><b>ProTec Industrieanlagen AG</b><s>namentlich empfohlen</s></span><span class="bdg">häufig zitiert</span></div>
          <div class="kr kr-empty" data-kr><span class="n"></span><span class="m"><b>Ihr Unternehmen</b><s>steht hier nicht</s></span><span class="bdg-empty">— —</span></div>
        </div>
        <div class="kfoot" id="kfoot"><em>Dokumentiert in</em><span class="pill">ChatGPT</span><span class="pill">Google KI-Übersicht</span></div>
      </div>
      <p class="kcap">Anonymisiertes Beispiel aus 7.184 dokumentierten KI-Antworten (CodaAI-Studie 2026).</p>
    </div>
  </div>
</section>

<!-- ================= PROBLEM ================= -->
<section class="problem" id="problem">
  <div class="p-scene" id="p-scene">
    <div class="p-stage">
      <div class="p-rail"><i id="prail"></i></div>
      <div class="p-steps" id="psteps">
        <span data-step="0">Die Frage</span><span data-step="1">Die KI-Antwort</span><span data-step="2">Ihre Leerstelle</span>
      </div>
      <div class="p-phasebar" id="pphasebar">
        <span class="eyebrow">Wie Einkäufer heute entscheiden</span>
        <p class="p-phasehl" id="pphase">Ein potenzieller Kunde fragt bei google.de.</p>
      </div>
      <div class="p-inner">
        <div class="browser">
          <div class="bbar"><span class="d"></span><span class="d"></span><span class="d"></span>
            <div class="omni"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg><span class="q"><span id="qtext"></span><span class="qcaret" id="qcaret"></span></span></div>
            <span class="p-phasenum" id="pphasenum">Schritt 1 / 3</span>
          </div>
          <div class="vp">
            <div class="serp" id="serp">
              <div class="res" data-res><div class="u"><b></b>wettbewerber-alpha.de</div><div class="t">Alpha Systems — Marktführer für Industrie-Automation</div><div class="s">Seit 1998 Komplettlösungen für den Mittelstand. Referenzen, Whitepaper, Beratung …</div></div>
              <div class="res" data-res><div class="u"><b></b>beta-technik.de</div><div class="t">Beta Technik AG — Anlagen &amp; Steuerungen</div><div class="s">Individuelle Lösungen, zertifizierte Qualität, 24/7-Service für Ihre Produktion …</div></div>
              <div class="res" data-res><div class="u"><b></b>gamma-group.com</div><div class="t">Gamma Group — Ihr Partner für digitale Fertigung</div><div class="s">Vom Sensor bis zur Cloud. Über 400 Projekte europaweit umgesetzt …</div></div>
              <div class="res" data-res><div class="u"><b></b>ihr-unternehmen.de</div><div class="t" style="color:#5b5b66">Ihr Unternehmen — Seite 2, Position 14</div><div class="s">… kaum noch jemand scrollt so weit.</div></div>
              <div class="serplabel" id="serplabel">↓ organische Treffer — unter die Falz geschoben</div>
            </div>
            <div class="ai" id="ai">
              <div class="ai-head"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.2L20 10l-5.8 1.8L12 18l-2.2-6.2L4 10l5.8-1.8z"/></svg> KI-Übersicht</div>
              <div class="ai-body" id="aibody"></div>
              <div class="chips" id="chips">
                <span class="chip" data-chip>Alpha Systems</span><span class="chip" data-chip>Beta Technik AG</span><span class="chip" data-chip>Gamma Group</span><span class="chip ghost" data-ghost>Ihr Unternehmen</span>
              </div>
            </div>
          </div>
        </div>
        <aside class="p-stat" id="pstat">
          <div class="big"><em id="statnum">0</em></div>
          <div class="lab">weniger Klicks auf Platz 1, sobald Google die KI-Übersicht zeigt — <strong style="color:#fff">11 statt 27</strong> von 100 Suchenden.</div>
          <div class="src">SISTRIX 2026</div>
        </aside>
        <div class="punch" id="punch">
          <div class="num">55&#8202;%</div>
          <div class="cap">der Einkäuferfragen bleiben ohne Nennung Ihres Unternehmens — <em>genau diese Interessenten erreichen Sie nie</em>.</div>
          <p class="close">Wer in diesen Antworten nicht vorkommt, ist aus dem Relevant Set raus — ohne es zu merken. Diese Nicht-Nennung erscheint in keiner Statistik und keinem Traffic-Report.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= DREI STELLEN + BEGRIFFE (Akkordeon) ================= -->
<!-- Ersetzt die frühere gepinnte SEO/AEO/GEO-Horizontalszene (~200vh Scrollstrecke
     für drei Definitionen). Die Erklärung bleibt vollständig erhalten, kostet aber
     null Scrollstrecke: Grundzustand eine Zeile, Tiefe auf Klick. Es ist das
     EINZIGE Akkordeon der Startseite — das Muster bleibt für optionales
     Begriffswissen reserviert. -->
<section class="rooms" id="stellen">
  <div class="wrap">
    <h2 class="cai-h2 sec rooms-lead">Diese Entscheidung fällt an drei Stellen: in der klassischen Suche
      (<b>SEO</b>), in Googles KI-Übersicht (<b>AEO</b>) und in KI-Assistenten wie ChatGPT (<b>GEO</b>).</h2>

    <div class="acc">
      <button class="accbtn" id="accbtn" aria-expanded="false" aria-controls="accbody">
        <span>Was die drei Begriffe bedeuten</span>
        <span class="ar" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
        </span>
      </button>
      <div class="accbody" id="accbody">
        <div class="tabs" role="tablist" aria-label="SEO, AEO und GEO">
          <button class="tab on" data-tab="0" role="tab" aria-selected="true">SEO</button>
          <button class="tab" data-tab="1" role="tab" aria-selected="false">AEO</button>
          <button class="tab" data-tab="2" role="tab" aria-selected="false">GEO</button>
        </div>
        <div class="panes">
          <div class="pane on" data-pane="0">
            <span class="plv">Ebene 1 · Search Engine Optimization</span>
            <h3>Gefunden werden, wenn jemand aktiv sucht.</h3>
            <p>Ihre Website rankt in Google und Bing. Sucht ein Einkäufer nach Ihrer Leistung, steht
              Ihre Seite auf Seite 1. Das Fundament — denn auch KI-Systeme bedienen sich aus den Suchindizes.</p>
          </div>
          <div class="pane" data-pane="1">
            <span class="plv">Ebene 2 · Answer Engine Optimization</span>
            <h3>Zitiert werden in Googles KI-Übersicht.</h3>
            <p>Google beantwortet immer mehr Fragen direkt über den Treffern. AEO sorgt dafür, dass Ihre
              Inhalte in dieser Antwortbox als Quelle erscheinen. Wer dort fehlt, verliert Klicks trotz gutem Ranking.</p>
          </div>
          <div class="pane" data-pane="2">
            <span class="plv">Ebene 3 · Generative Engine Optimization</span>
            <h3>Namentlich empfohlen in ChatGPT &amp; Co.</h3>
            <p>Die Königsdisziplin: Ihr Unternehmen wird in ChatGPT, Gemini, Perplexity und Claude beim
              Namen genannt, wenn Einkäufer nach Anbietern fragen. GEO entscheidet, ob dort Ihr Name
              steht — oder der Ihres Wettbewerbers.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ================= DER SPIEGEL — echtes Muster-Audit ================= -->
<!-- Herzstück der reduzierten Startseite: ersetzt geschätzt 800 Wörter Erklärung
     durch Beweis. Interaktion statt Animation — der Besucher öffnet selbst.
     Quelle: https://audit.codaai.ai/view/musteraudit  (echtes Audit, Firmenname,
     Logo und Website-Ansicht entfernt, Zahlen und KI-Antworten unverändert). -->
<section class="mirror" id="spiegel">
  <div class="wrap">
    <div class="mi-head">
      <span class="eyebrow">Beispiel-Audit · echte Zahlen, Firmenname entfernt</span>
      <h2 class="cai-h2 sec">Ein echtes Audit zeigt schwarz auf weiß, <em>wer statt Ihnen empfohlen wird.</em></h2>
      <p class="lead">Für dieses Unternehmen — ein deutscher Hersteller von Sanitärarmaturen aus dem
        Mittelstand — haben wir 8 Fragen formuliert, die seine Käufer wirklich stellen: zu seinen
        Produkten, seinem Markt, seinen Wettbewerbern. Dann haben wir sie ChatGPT und Googles
        KI-Übersicht gestellt und protokolliert, wer genannt wurde. Name und Logo sind entfernt.
        Die Befunde nicht.</p>
      <p class="mi-cue"><i aria-hidden="true">↓</i> Klappen Sie eine Frage auf. In Ihrem Audit steht dort
        Ihre Branche — und der Name, der statt Ihrem genannt wird.</p>
    </div>

    <div class="mi-card" id="mi-card">
      <div class="mi-top">
        <span class="mi-lg">Coda<em>AI</em> Digital Visibility Audit</span>
        <span class="mi-anon">Firmenname entfernt · Zahlen unverändert</span>
      </div>

      <div class="mi-kpi">
        <div><b class="bad">0 %</b><span>KI-Sichtbarkeit</span></div>
        <div><b class="bad">0 von 8</b><span>Fragen mit Nennung</span></div>
        <div><b class="bad">100 %</b><span>der Fragen nennen stattdessen Wettbewerber</span></div>
        <div><b>8</b><span>individuell formulierte Käuferfragen</span></div>
      </div>

      <div class="mi-q">
        <button class="mi-qh" aria-expanded="false">
          <span class="mi-main">
            <span class="mi-st">Marktübersicht</span>
            <span class="mi-t">Welche deutschen Hersteller von Sanitärarmaturen bieten das beste
              Preis-Leistungs-Verhältnis für mittlere Projektgrößen?</span>
          </span>
          <span class="mi-flag">nicht genannt</span>
          <span class="mi-cta"><em>Antwort ansehen</em><span class="mi-ar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg></span></span>
        </button>
        <div class="mi-qb"><div class="mi-qi">
          <div class="mi-arow"><span class="mi-logo-wrap"><img class="mi-logo-lg" src="/images/ai-chatgpt.svg" alt="ChatGPT" width="56" height="56" loading="lazy" decoding="async" /></span><p class="mi-ans">„Bei mittleren Projektgrößen gibt es mehrere deutsche Hersteller von
            Sanitärarmaturen, die ein gutes Preis-Leistungs-Verhältnis bieten:<br>1. <mark>Grohe</mark> …
            2. <mark>Hansgrohe</mark> … 3. <mark>Kludi</mark> … 4. <mark>Hansa</mark> …“</p></div>
          <p class="mi-verdict" data-verdict>
            <span class="dot"></span>
            <span class="mi-vscan" aria-hidden="true"><span class="sd"><i></i><i></i><i></i></span><span class="mi-vlabel">CodaAI liest die Frage.</span></span>
            <span class="mi-vout"><b>Befund:</b> <span class="mi-vtyped">Das untersuchte Unternehmen wird nicht genannt — obwohl genau dieses Preissegment sein Kerngeschäft ist. Fünf Wettbewerber übernehmen die Empfehlung.</span></span>
          </p>
        </div></div>
      </div>

      <div class="mi-q">
        <button class="mi-qh" aria-expanded="false">
          <span class="mi-main">
            <span class="mi-st">Anwendungsfall</span>
            <span class="mi-t">Welche Duschsysteme mit Handbrause empfehlen sich für barrierefreie
              Bäder in Pflegeeinrichtungen?</span>
          </span>
          <span class="mi-flag">nicht genannt</span>
          <span class="mi-cta"><em>Antwort ansehen</em><span class="mi-ar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg></span></span>
        </button>
        <div class="mi-qb"><div class="mi-qi">
          <div class="mi-arow"><span class="mi-logo-wrap"><img class="mi-logo-lg" src="/images/ai-google.svg" alt="Google KI-Übersicht" width="56" height="56" loading="lazy" decoding="async" /></span><p class="mi-ans">„Für barrierefreie Bäder in Pflegeeinrichtungen empfehlen sich Duschsysteme, die den DIN-Normen für barrierefreies Bauen (DIN 18040-2) entsprechen und Sicherheit, Ergonomie und Wartungsfreundlichkeit vereinen. Bewährte Hersteller sind u. a.:<br>1. <mark>Grohe</mark> … 2. <mark>Hansgrohe</mark> … 3. <mark>Hansa</mark> …“</p></div>
          <p class="mi-verdict" data-verdict>
            <span class="dot"></span>
            <span class="mi-vscan" aria-hidden="true"><span class="sd"><i></i><i></i><i></i></span><span class="mi-vlabel">CodaAI liest die Frage.</span></span>
            <span class="mi-vout"><b>Befund:</b> <span class="mi-vtyped">Die KI nennt Normen und Anforderungen — und dann Anbieter. Das untersuchte Unternehmen führt passende Produkte im Programm, kommt in der Antwort aber nicht vor.</span></span>
          </p>
        </div></div>
      </div>

      <div class="mi-q">
        <button class="mi-qh" aria-expanded="false">
          <span class="mi-main">
            <span class="mi-st">Wettbewerbsvergleich</span>
            <span class="mi-t">Welche günstigeren Alternativen zu Hansgrohe gibt es bei Duschsystemen
              für Bauträger?</span>
          </span>
          <span class="mi-flag">nicht genannt</span>
          <span class="mi-cta"><em>Antwort ansehen</em><span class="mi-ar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg></span></span>
        </button>
        <div class="mi-qb"><div class="mi-qi">
          <div class="mi-arow"><span class="mi-logo-wrap"><img class="mi-logo-lg" src="/images/ai-chatgpt.svg" alt="ChatGPT" width="56" height="56" loading="lazy" decoding="async" /></span><p class="mi-ans">„Es gibt mehrere günstigere Alternativen zu Hansgrohe, die dennoch qualitativ
            hochwertige Duschsysteme anbieten:<br>1. <mark>GROHE</mark> … 2. <mark>Ideal Standard</mark> …
            3. <mark>Hansa</mark> … 4. <mark>RAVAK</mark> … 5. <mark>Kludi</mark> …“</p></div>
          <p class="mi-verdict" data-verdict>
            <span class="dot"></span>
            <span class="mi-vscan" aria-hidden="true"><span class="sd"><i></i><i></i><i></i></span><span class="mi-vlabel">CodaAI liest die Frage.</span></span>
            <span class="mi-vout"><b>Befund:</b> <span class="mi-vtyped">Das untersuchte Unternehmen ist die günstigere Alternative — das ist sein Geschäftsmodell. Auf genau diese Frage wird es nicht genannt.</span></span>
          </p>
        </div></div>
      </div>

      <p class="mi-foot">Auszug: 3 von 8 individuell formulierten Käuferfragen.
        <a href="https://audit.codaai.ai/view/musteraudit?unlocked=1" target="_blank" rel="noopener">Das
        vollständige Audit ansehen →</a></p>
    </div>

    <div class="mi-after">
      <p>Für Ihr Unternehmen formulieren wir eigene Fragen. Ergebnis in 24 Stunden.</p>
      <AuditCTA label="Mein Audit anfordern" />
    </div>
  </div>
</section>

<!-- ================= ANGEBOT (Magenta) ================= -->
<!-- Ersetzt die frühere gepinnte Programm-/Bento-Szene (260vh). Kommerziell der
     wichtigste Block der Seite und deshalb der EINZIGE gesättigte: der Farbsprung
     von Schwarz auf Pink ist die härteste Kante der Seite — genau dort, wo aus
     Diagnose Angebot wird. Schrift durchgehend weiß (Beschluss Oli, 03.08.2026);
     dafür liegt der Grund auf dem tieferen #C405E6 statt auf #DF41FB,
     wo Weiß nur 3,34:1 erreicht hätte. Audit-Button dunkel, weil ein pinker
     Button auf pinkem Grund unsichtbar wäre. -->
<section class="offer" id="angebot">
  <div class="wrap">
    <h2 class="cai-h2 sec off-h">CodaAI bringt Ihr Unternehmen in die Antwort.</h2>
    <h3 class="off-l2">Ihre Marke in Googles KI-Übersicht, ChatGPT und anderen KI-Systemen — monatlich messbar.</h3>

    <div class="tiers">
      <article class="tier">
        <div class="tbars"><i class="hi"></i><i></i><i></i></div>
        <span class="tno">Stufe 1 · Gefunden</span>
        <h3>Die KI kann Ihr Unternehmen lesen und zitieren.</h3>
        <p>Ihre Website wird für KI-Systeme lesbar, Ihre Leistungen stehen als Text statt im PDF,
          Ihre KI-Nennungen werden monatlich gemessen. In jeder Stufe enthalten.</p>
      </article>
      <article class="tier">
        <div class="tbars"><i class="hi"></i><i class="hi"></i><i></i></div>
        <span class="tno">Stufe 2 · Empfohlen</span>
        <h3>Sie stehen dort, wo die KI ihre Belege holt.</h3>
        <p>Zusätzlich Präsenz auf den Quellen, aus denen KI-Systeme zitieren: Fachportale,
          Verzeichnisse, Branchenmedien. Damit die Empfehlung nicht nur von Ihnen selbst kommt.</p>
      </article>
      <article class="tier">
        <div class="tbars"><i class="hi"></i><i class="hi"></i><i class="hi"></i></div>
        <span class="tno">Stufe 3 · Zitiert</span>
        <h3>Ihr Markt beruft sich auf Ihre Zahlen.</h3>
        <p>Sie werden zur Quelle, die zitiert wird: eigene Studien, Fachbeiträge und Daten, auf die
          sich Ihr Markt beruft. Die stärkste Position, die es in KI-Antworten gibt.</p>
      </article>
    </div>

    <p class="off-price"><b>Der Grundpreis startet bei 1.470 € pro Monat.</b> Netto, 6 Monate Mindestlaufzeit —
      im Preisrechner nachrechenbar statt „auf Anfrage".</p>

    <a class="off-link" href="/preise/">Alle Leistungen je Stufe und die Preise →</a>

    <div class="off-cta">
      <AuditCTA label="Audit kostenlos anfordern" />
      <p class="off-micro">Kostenlos und unverbindlich.<s>·</s>Kein Verkaufsanruf — Sie erhalten das
        Audit per E-Mail.<s>·</s>Auch sinnvoll, wenn Sie eine Agentur haben: sie bekommt die Bausteine.</p>
    </div>
  </div>
</section>

<!-- ================= OUTCOME — „Die Kette" ================= -->
<section class="outcome" id="outcome">
  <div class="oc-scene" id="oc-scene">
    <div class="oc-stage">
      <div class="oc-top">
        <span class="eyebrow">Was Nicht-genannt-Werden kostet</span>
        <h2 class="cai-h2 sec">Nicht genannt. Nicht angefragt. Kein Auftrag.</h2>
        <p class="oc-lead">So entsteht heute ein Auftrag — und so bricht er ab.</p>
      </div>

      <div class="oc-chain" id="oc-chain">
        <div class="oc-node" data-node="0"><span class="tag">in der KI nicht genannt</span><div class="nn">1</div><b>Genannt</b><p>in KI-Antworten empfohlen</p></div>
        <div class="oc-conn"><i></i><span class="brk">&#10005;</span></div>
        <div class="oc-node" data-node="1"><div class="nn">2</div><b>Vertraut</b><p>durch Quellen &amp; Konsistenz</p></div>
        <div class="oc-conn"><i></i></div>
        <div class="oc-node" data-node="2"><div class="nn">3</div><b>Angefragt</b><p>qualifizierte Anfrage</p></div>
        <div class="oc-conn"><i></i></div>
        <div class="oc-node" data-node="3"><div class="nn">4</div><b>Beauftragt</b><p>Auftragseingang</p></div>
      </div>

      <div class="oc-vals" id="oc-vals">
        <div class="vrow">
          <span class="vlab">Besucher aus klassischer Suche</span>
          <span class="vtrack"><i class="vfill" id="v-seo"></i></span>
          <span class="vnum">1,0&#8202;×</span>
        </div>
        <div class="vrow">
