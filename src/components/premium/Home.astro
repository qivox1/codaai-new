  .res .t{color:var(--google-blue);font-size:1.02rem;font-weight:600;margin-top:.15rem}
  .res .s{color:var(--d-mut);font-size:.82rem;margin-top:.15rem;line-height:1.45;max-width:60ch}
  .serplabel{position:absolute;left:1.6rem;bottom:.8rem;font-size:.7rem;color:var(--d-mut);opacity:0}
  .ai{position:absolute;left:0;right:0;top:0;transform:translateY(-102%);background:linear-gradient(180deg,#1a1024,#161020);border-bottom:1px solid rgba(223,65,251,.35);padding:1.3rem 1.6rem 1.5rem;box-shadow:0 30px 60px -20px rgba(223,65,251,.25)}
  .ai-head{display:flex;align-items:center;gap:.55rem;font-size:.8rem;font-weight:700;color:var(--magenta);letter-spacing:.02em}
