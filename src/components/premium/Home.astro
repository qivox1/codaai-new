  .kbadge .pulse::before{content:"";position:absolute;inset:0;border-radius:50%;background:var(--magenta);animation:ping 1.6s ease infinite}
  .kbadge .pulse::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--magenta)}
  @keyframes ping{0%{transform:scale(1);opacity:.6}80%,100%{transform:scale(2.4);opacity:0}}
  .kq{position:relative;margin-top:16px;background:var(--fg);color:#fff;border-radius:16px 16px 16px 6px;padding:12px 15px;font-size:.9rem;font-weight:500;line-height:1.5;min-height:2.6em}
  .kcaret{display:inline-block;width:2px;height:1em;background:#fff;vertical-align:-2px;margin-left:1px;animation:blink 1s step-end infinite}
