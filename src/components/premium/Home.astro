  .chips{margin-top:.9rem;display:flex;flex-wrap:wrap;gap:.5rem}
  .chip{border:1px solid rgba(223,65,251,.4);background:rgba(223,65,251,.12);color:#f3d9ff;border-radius:999px;padding:.4rem .8rem;font-size:.82rem;font-weight:600;opacity:0;transform:translateY(8px) scale(.96)}
  .chip.ghost{border-style:dashed;border-color:var(--d-line2);background:transparent;color:var(--d-mut);position:relative}
  .chip.ghost::after{content:"nicht genannt";position:absolute;left:50%;top:-1.4rem;transform:translateX(-50%);font-size:.62rem;color:var(--d-mut);white-space:nowrap;opacity:0;transition:opacity .4s}
  .chip.ghost.flag::after{opacity:1}
  .p-stat{position:absolute;right:-14px;top:50%;transform:translate(100%,-50%);z-index:30;width:min(230px,42vw);border:1px solid var(--d-line2);border-radius:16px;background:var(--d-card);padding:1.1rem 1.2rem;opacity:0}
  .p-stat .big{font-size:clamp(2.4rem,5vw,3.4rem);font-weight:800;letter-spacing:-.02em;line-height:1;color:#fff;font-variant-numeric:tabular-nums}
  .p-stat .big em{font-style:normal;color:var(--magenta)}
  .p-stat .lab{margin-top:.5rem;font-size:.82rem;color:var(--d-mut);line-height:1.45}
  .p-stat .src{margin-top:.5rem;font-size:.66rem;color:rgba(154,154,167,.7)}
  @media(max-width:900px){.p-stat{position:static;transform:none;width:auto;margin-top:1rem}}
  .punch{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:1rem;padding:6vh 8vw;background:radial-gradient(80% 60% at 50% 50%,rgba(10,10,15,.86),rgba(10,10,15,.96));opacity:0;pointer-events:none;z-index:50}
  .punch .num{font-size:clamp(3.5rem,12vw,8rem);font-weight:800;letter-spacing:-.03em;line-height:1;background:linear-gradient(120deg,#fff,var(--magenta));-webkit-background-clip:text;background-clip:text;color:transparent}
  .punch .cap{font-size:clamp(1.1rem,2.6vw,1.7rem);font-weight:600;max-width:24ch;line-height:1.3}
  .punch .cap em{font-style:normal;color:var(--magenta)}
  .punch .close{color:var(--d-mut);max-width:52ch;font-size:.95rem;line-height:1.6}

  /* ============ SEO/AEO/GEO horizontal ============ */
  .hz{background:var(--muted)}
  .hz-head{text-align:center;max-width:820px;margin:0 auto;padding:88px 20px 0;flex:none}
  .hz-head .sec .l2{display:block}
  .hz-pin{position:relative;height:100vh;overflow:hidden;display:flex;flex-direction:column}
  .hz-track{display:flex;flex:1;min-height:0;gap:0;will-change:transform}
  .hz-panel{width:100vw;flex:none;display:flex;align-items:center;justify-content:center;padding:0 clamp(20px,6vw,90px)}
  .hz-card-wrap{width:min(720px,90vw)}
  .hz-tag{display:inline-flex;align-items:center;gap:8px;font-size:.8rem;font-weight:700;margin-bottom:14px}
  .hz-tag b{background:rgba(223,65,251,.1);color:var(--magenta-ink);border:1px solid rgba(223,65,251,.3);border-radius:8px;padding:2px 8px;font-weight:800}
  .surf{border:1px solid var(--line);border-radius:20px;background:#fff;padding:24px;box-shadow:0 30px 70px -40px rgba(20,10,40,.3)}
  .sq{display:flex;align-items:center;gap:10px;border:1.5px solid var(--line);border-radius:999px;padding:9px 16px;font-size:.9rem;color:#555;max-width:440px}
  .sr{border-bottom:1px solid var(--line);padding:12px 0}.sr:last-child{border:0}
  .sr .t{font-size:.98rem;font-weight:600;color:#1A4FD6}.sr .u{font-size:.72rem;color:#0E7A4A;margin:2px 0}.sr .s{font-size:.85rem;color:var(--mut)}
  .sr.you{border:1.5px solid var(--magenta);background:rgba(223,65,251,.05);border-radius:12px;padding:12px 14px;margin:8px 0}
  .sr.you .tag{display:inline-block;background:var(--magenta);color:#fff;font-size:.68rem;font-weight:800;border-radius:999px;padding:2px 9px;margin-bottom:6px}
  .sr.you .t{color:var(--magenta-ink)}
  .aio{border:1.5px solid rgba(223,65,251,.25);background:linear-gradient(180deg,rgba(223,65,251,.04),rgba(223,65,251,.09));border-radius:16px;padding:18px 20px}
  .aio .h{display:flex;align-items:center;gap:8px;font-weight:800;color:#333;font-size:.9rem;margin-bottom:8px}
  .aio p{font-size:.95rem;line-height:1.6;color:#333}.aio strong{color:#111}
  .miss{margin-top:14px;display:inline-flex;align-items:center;gap:6px;background:var(--magenta);color:#fff;font-size:.75rem;font-weight:800;border-radius:999px;padding:6px 13px}
  .missnote{margin-top:10px;font-size:.82rem;color:var(--mut)}
  .gpt{background:var(--fg);color:#fff;border-radius:16px;padding:20px}
  .gpt .u{margin-left:auto;max-width:420px;background:rgba(255,255,255,.15);border-radius:16px 16px 6px 16px;padding:10px 14px;font-size:.9rem;margin-bottom:14px}
  .gpt p{font-size:.9rem;line-height:1.6;color:rgba(255,255,255,.85)}.gpt strong{color:#fff}
  .hz-key{margin-top:16px;display:flex;align-items:flex-start;gap:10px;font-size:.9rem;color:#333}
  .hz-key b{flex:none;background:rgba(223,65,251,.1);color:var(--magenta-ink);border:1px solid rgba(223,65,251,.3);border-radius:6px;padding:2px 8px;font-weight:800;font-size:.8rem}
  .hz-count{display:flex;justify-content:center;gap:8px;margin:14px auto 4px;flex:none;z-index:5}
  .hz-count i{width:26px;height:4px;border-radius:2px;background:var(--line2);transition:background .3s}
  .hz-count i.on{background:var(--magenta)}
  /* Disziplin-Panels (SEO / AEO / GEO — was ist das eigentlich?) */
  .disc{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;width:min(1000px,90vw);position:relative}
  .disc>div{position:relative;z-index:1}
  /* Feine Hintergrund-Illustration je Disziplin (Lupe / Antwort-Box+Funken / Konstellation) */
  .disc-illu{position:absolute;left:52%;top:50%;transform:translate(-50%,-63%);width:min(820px,80%);height:auto;color:var(--magenta);opacity:.2;pointer-events:none;z-index:0;overflow:visible}
  @media(max-width:820px){.disc-illu{display:none}}
  @media(max-width:820px){.disc{grid-template-columns:1fr;gap:22px}}
  .disc-kicker{font-size:clamp(3rem,7vw,5.5rem);font-weight:800;line-height:1;letter-spacing:-.03em;
    background:linear-gradient(120deg,var(--fg),var(--magenta));-webkit-background-clip:text;background-clip:text;color:transparent}
  .disc-step{margin-top:10px;font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--magenta-ink)}
  .disc-title{margin-top:14px;font-size:clamp(1.35rem,2.6vw,1.9rem);font-weight:700;letter-spacing:-.02em;line-height:1.2}
  .disc-def{margin-top:14px;color:#444;line-height:1.6;font-size:1.02rem;max-width:46ch}
  .disc-def b{color:var(--fg)}
  .disc-demo{display:flex;justify-content:center}
  .d-card{width:100%;max-width:390px;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 30px 70px -40px rgba(20,10,40,.3);padding:20px}
  .d-sq{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:999px;padding:8px 14px;font-size:.85rem;color:#555;margin-bottom:12px}
  .d-row{display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:.92rem;font-weight:600;color:#333}
  .d-row:last-child{border:0}
  .d-rank{width:22px;height:22px;border-radius:50%;background:var(--muted);color:var(--mut);font-size:.75rem;font-weight:800;display:grid;place-items:center;flex:none}
  .d-row.you{color:var(--magenta-ink)}.d-row.you .d-rank{background:var(--magenta);color:#fff}
  .d-aio{border:1.5px solid rgba(223,65,251,.25);background:linear-gradient(180deg,rgba(223,65,251,.04),rgba(223,65,251,.09));border-radius:14px;padding:16px}
  .d-aio .h{display:flex;align-items:center;gap:6px;font-weight:800;font-size:.85rem;color:#333;margin-bottom:8px}
  .d-aio p{font-size:.9rem;line-height:1.55;color:#333;margin:0}.d-aio strong{color:#111}
  .d-gpt{background:var(--fg);color:#fff;border-radius:14px;padding:16px}
  .d-gpt .u{margin-left:auto;max-width:82%;background:rgba(255,255,255,.15);border-radius:14px 14px 4px 14px;padding:8px 12px;font-size:.82rem;margin-bottom:12px}
  .d-gpt p{font-size:.86rem;line-height:1.55;color:rgba(255,255,255,.85);margin:0}.d-gpt strong{color:#fff}
  .d-check{margin-top:12px;display:inline-flex;align-items:center;gap:6px;font-size:.72rem;font-weight:800;color:#fff;background:var(--magenta);border-radius:999px;padding:5px 11px}
  .hz-sum{text-align:center;font-weight:700;color:#333;max-width:660px;margin:0 auto;padding:14px 20px 72px;font-size:1.08rem}
  .hz-sum b{color:var(--magenta-ink)}
  /* ============ CONCLUSIO — Farbüberblendung + Zitat-Reveal ============ */
  .conclusio{position:relative}
  .cc-scene{height:300vh;position:relative}
  .cc-stage{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;align-items:center;justify-content:center;
    background:radial-gradient(125% 120% at 50% 22%, #EA6BFF 0%, #DF41FB 46%, #A81BC9 100%)}
  .cc-veil{position:absolute;inset:0;background:var(--muted2);will-change:opacity;z-index:1}
  /* Editorial-Komposition: volle Breite, gemischte Fonts/Größen, art-directed */
  .cc-quote{position:relative;z-index:2;width:min(1500px,93vw);text-align:left}
  .cc-mark{position:absolute;top:-9vh;left:-1.5vw;font-family:'Instrument Serif',Georgia,serif;font-weight:400;
    font-size:clamp(7rem,20vw,18rem);line-height:.6;color:rgba(255,255,255,.16);pointer-events:none;z-index:-1}
  .cc-row{display:flex;flex-wrap:wrap;align-items:baseline;gap:.1em .45em;line-height:.95;perspective:1200px}
  .cc-r2{margin-left:clamp(20px,11vw,200px)}
  .cc-r3{margin-top:.3em}
  .cc-r4{margin-top:.04em}
  .cc-r5{margin-top:1.15em;justify-content:flex-end}
  /* Typo-Rollen */
  /* Konsistentes System: Instrument Serif (kursiv) für die großen Wörter auf EINER Größe,
     „Digital Visibility" als fetter Playfair-Display-Kontrast —
     unterschieden nur über Weiß / Hellgrau / Schwarz + Outline. Inter-Versal-Labels für Verbindungswörter. */
  .t-label{font-family:'Inter',sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:.2em;
    font-size:clamp(.95rem,1.7vw,1.4rem);color:rgba(255,255,255,.72);align-self:center}
  .t-mid{font-family:'Instrument Serif',Georgia,serif;font-weight:400;color:#fff;font-size:clamp(1.7rem,3.4vw,2.9rem);align-self:center}
  .cc-big{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;line-height:.95;font-size:clamp(3.8rem,11vw,10rem)}
  .t-outline{color:transparent;-webkit-text-stroke:1.6px rgba(255,255,255,.9)}
  .t-huge{color:rgba(255,255,255,.55)}                              /* „Stückwerk" — hellgrau */
  /* „Digital Visibility" — anderer Schnitt, FETT (Playfair Display Bold) als Höhepunkt */
  .t-mega{font-family:'Playfair Display',Georgia,serif;font-style:normal;font-weight:800;color:#141419;font-size:clamp(3.4rem,9.5vw,8.6rem);letter-spacing:-.02em}
  .cc-sub{font-family:'Inter',sans-serif;font-weight:700;color:#141419;font-size:clamp(1rem,2.1vw,1.45rem);line-height:1.45;letter-spacing:0;max-width:46ch;text-align:right}
  .cc-w{display:inline-block;opacity:0;transform-origin:50% 100%;backface-visibility:hidden;will-change:transform,opacity}
  body:not(.anim) .cc-scene{height:auto}
  body:not(.anim) .cc-stage{position:static;height:auto;padding:96px 0}
  body:not(.anim) .cc-veil{display:none}
  body:not(.anim) .cc-w{opacity:1;transform:none;filter:none}

  /* ============ BENTO / Programm ============ */
  .prog{background:var(--muted2);padding:96px 0}
  .prog-head{text-align:center;max-width:760px;margin:0 auto 48px}
  /* ===== System-Tabs (Apple-„Experience"-Muster) ===== */
  .sys{max-width:1000px;margin:0 auto}
  .sys-stage{position:relative;border-radius:28px;overflow:hidden;border:1px solid var(--line);
    background:linear-gradient(180deg,#ffffff,#f2ecf8);box-shadow:0 40px 90px -50px rgba(20,10,40,.4);
    min-height:clamp(340px,42vw,470px)}
  .sys-panel{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    padding:clamp(24px,4vw,56px);opacity:0;transform:scale(.985);transition:opacity .6s ease,transform .6s ease;pointer-events:none}
  .sys-panel.on{opacity:1;transform:none;pointer-events:auto}
  .shot{width:min(560px,94%);border:1px solid var(--line);border-radius:18px;background:#fff;padding:22px;box-shadow:0 24px 60px -40px rgba(20,10,40,.35)}
  .shot-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
  .shot-head b{font-size:1.02rem}
  .shot-cap{margin-top:14px;font-size:.85rem;color:var(--mut);line-height:1.5}
  .shot-cap strong{color:var(--magenta-ink)}
  .chip2{font-size:.72rem;font-weight:700;color:var(--magenta-ink);border:1px solid rgba(223,65,251,.3);background:rgba(223,65,251,.08);border-radius:999px;padding:4px 10px;white-space:nowrap}
  .barrow2{display:flex;align-items:center;gap:12px;margin-top:10px}
  .barrow2 .bl{width:120px;flex:none;font-size:.84rem;font-weight:600;color:#444}
  .barrow2 .bt{flex:1;height:8px;border-radius:999px;background:var(--muted);overflow:hidden}
  .barrow2 .bt i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,rgba(223,65,251,.4),var(--magenta));width:var(--w)}
  .barrow2 .bv{width:52px;flex:none;text-align:right;font-weight:800;font-size:.9rem}
  .sys-pp{position:absolute;right:16px;bottom:16px;width:38px;height:38px;border-radius:50%;border:1px solid var(--line2);
    background:rgba(255,255,255,.82);backdrop-filter:blur(6px);color:#333;font-size:.62rem;letter-spacing:1px;display:grid;place-items:center;cursor:pointer;z-index:3;transition:background .2s}
  .sys-pp:hover{background:#fff}
  .sys-tabs{display:flex;justify-content:center;margin:26px auto 0}
  .sys-tablist{display:inline-flex;gap:4px;background:#ECEAF1;border-radius:999px;padding:5px;max-width:100%;flex-wrap:wrap;justify-content:center}
  .sys-tab{position:relative;overflow:hidden;border:0;background:transparent;cursor:pointer;font-family:inherit;font-weight:700;
    font-size:.95rem;color:#3a3a44;padding:10px 22px;border-radius:999px;transition:color .3s,background .3s}
  .sys-tab.on{background:var(--magenta);color:#fff;box-shadow:0 8px 22px -8px rgba(223,65,251,.75)}
  .sys-tab .pgr{position:absolute;left:0;bottom:0;height:3px;width:0;background:rgba(20,10,40,.25)}
  .sys-tab.on .pgr{background:rgba(255,255,255,.75)}
  .sys-body{position:relative;margin-top:30px}
  .sys-content{opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease;position:absolute;inset:0;pointer-events:none}
  .sys-content.on{opacity:1;transform:none;position:relative;pointer-events:auto}
  .sys-lead{text-align:center;max-width:640px;margin:0 auto 22px}
  .sys-lead .lv{font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--magenta-ink)}
  .sys-lead h3{margin-top:6px;font-size:clamp(1.3rem,2.6vw,1.8rem);font-weight:700;letter-spacing:-.01em}
  /* Spaltenweise Nummerierung: erst linke Spalte (1..n) runter, dann rechte — grid-auto-flow:column */
  .sys-items{display:grid;grid-template-columns:1fr 1fr;grid-auto-flow:column;gap:16px 34px;max-width:900px;margin:0 auto}
  @media(max-width:720px){.sys-items{grid-template-columns:1fr;grid-auto-flow:row;grid-template-rows:auto !important}}
  .sys-item{display:flex;gap:12px}
  .sys-item .dot{flex:none;width:22px;height:22px;border-radius:50%;background:rgba(223,65,251,.12);color:var(--magenta-ink);display:grid;place-items:center;font-size:.7rem;font-weight:800;margin-top:2px}
  .sys-item b{font-size:.98rem;font-weight:700;color:var(--fg)}
  .sys-item p{margin-top:2px;font-size:.9rem;color:var(--mut);line-height:1.5}
  .sys-more{text-align:center;margin-top:34px}
  .sys-more a{color:var(--magenta-ink);font-weight:700}
  body:not(.anim) .sys-panel{position:relative;opacity:1;transform:none}
  body:not(.anim) .sys-panel:not(.on){display:none}
  body:not(.anim) .sys-content{position:relative;opacity:1;transform:none}
  body:not(.anim) .sys-content:not(.on){display:none}
  .bento{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;grid-auto-rows:200px}
  @media(max-width:900px){.bento{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.bento{grid-template-columns:1fr}}
  .cell{border:1px solid var(--line);border-radius:20px;background:#fff;padding:22px;overflow:hidden;position:relative;
    opacity:0;transform:translateY(26px);transition:box-shadow .3s;transform-style:preserve-3d;will-change:transform}
  .cell.in{opacity:1;transform:none}
  .cell:hover{box-shadow:0 24px 60px -34px rgba(20,10,40,.45)}
  .cell.big{grid-column:span 2;grid-row:span 2}
  @media(max-width:560px){.cell.big{grid-column:span 1;grid-row:span 2}}
  .cell .cl{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--mut)}
  .cell strong.title{font-size:1.05rem}
  .barrow{display:flex;align-items:center;gap:12px;margin-top:12px}
  .barrow .bl{width:110px;flex:none;font-size:.82rem;font-weight:600;color:#444}
  .barrow .bt{flex:1;height:8px;border-radius:999px;background:var(--muted);overflow:hidden}
  .barrow .bt i{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,rgba(223,65,251,.4),var(--magenta));transition:width 1.1s cubic-bezier(.2,.7,.2,1)}
  .cell.in .barrow .bt i{width:var(--w)}
  .barrow .bv{width:52px;flex:none;text-align:right;font-weight:800;font-size:.9rem}
  .spark path.draw{fill:none;stroke:var(--magenta);stroke-width:2.5;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1}
  .cell.in .spark path.draw{stroke-dashoffset:0;transition:stroke-dashoffset 1.4s ease .3s}
  .pulse-dot{transform-box:fill-box;transform-origin:center}
  .cell.in .pulse-dot{animation:sonar 2s ease-out infinite}
  @keyframes sonar{from{transform:scale(.4);opacity:.7}to{transform:scale(2.6);opacity:0}}
  .sat{opacity:.16;transition:opacity .5s}
  .cell.in .sat{opacity:1}
  .cell.in .s1{transition-delay:.15s}.cell.in .s2{transition-delay:.35s}.cell.in .s3{transition-delay:.55s}.cell.in .s4{transition-delay:.75s}.cell.in .s5{transition-delay:.95s}
  .cbadge{display:inline-flex;align-items:center;gap:6px;font-size:.72rem;font-weight:800;color:var(--magenta-ink);border:1px solid rgba(223,65,251,.3);background:rgba(223,65,251,.08);border-radius:999px;padding:5px 12px;margin-top:auto}
  .skel{height:10px;border-radius:999px;background:var(--muted);margin-top:10px}
  .live{display:inline-flex;align-items:center;gap:6px;font-size:.7rem;font-weight:800;color:var(--magenta-ink)}
  .live i{width:6px;height:6px;border-radius:50%;background:var(--magenta);animation:blink 1.6s infinite}

  /* ============ OUTCOME FUNNEL ============ */
  /* ============ OUTCOME — „Die Kette" (gepinnte Scroll-Szene) ============ */
  .outcome{background:#fff;border-top:1px solid var(--line)}
  .oc-scene{height:560vh;position:relative}
  .oc-stage{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:0 clamp(20px,5vw,60px);background:radial-gradient(92% 72% at 50% 32%,rgba(223,65,251,.05),transparent 60%),#fff}
  .oc-top{text-align:center;margin-bottom:clamp(28px,6vh,60px)}
  .oc-top .sec{margin-top:8px}
  .oc-chain{display:flex;align-items:stretch;width:min(1000px,96vw)}
  .oc-node{flex:1;position:relative;border:1.5px solid var(--line);border-radius:16px;background:#fff;padding:20px 12px;text-align:center;opacity:.5}
  .oc-node .nn{width:38px;height:38px;border-radius:50%;background:var(--muted);color:var(--mut);font-weight:800;display:grid;place-items:center;margin:0 auto 10px}
  .oc-node b{font-size:1.02rem;font-weight:700;display:block}
  .oc-node p{margin-top:3px;font-size:.78rem;color:var(--mut);line-height:1.35}
  .oc-node .tag{position:absolute;left:50%;top:-14px;transform:translate(-50%,-100%);white-space:nowrap;font-size:.68rem;font-weight:700;color:#fff;background:#6b6b76;border-radius:999px;padding:4px 10px;opacity:0}
  .oc-conn{flex:none;width:clamp(20px,4vw,58px);align-self:center;position:relative;height:3px;background:var(--line);border-radius:2px}
  .oc-conn i{position:absolute;left:0;top:0;height:100%;width:0;background:linear-gradient(90deg,var(--magenta),#a21caf);border-radius:2px}
  .oc-conn .brk{position:absolute;left:50%;top:50%;width:22px;height:22px;border-radius:50%;background:#e5484d;color:#fff;font-size:.72rem;font-weight:800;display:grid;place-items:center;opacity:0;z-index:3}
  .oc-payoff{margin-top:clamp(26px,6vh,52px);text-align:center}
  .oc-payoff .pv{font-size:clamp(3rem,8vw,6rem);font-weight:800;letter-spacing:-.03em;color:var(--magenta);font-variant-numeric:tabular-nums;line-height:1}
  .oc-payoff .pl{display:block;margin:8px auto 0;max-width:34ch;font-size:.9rem;color:var(--mut);line-height:1.4}
  .oc-punch,.oc-final{position:absolute;inset:0;z-index:6;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;padding:6vh 8vw;opacity:0;pointer-events:none;background:radial-gradient(90% 70% at 50% 40%,#fff, #faf7fc)}
  .oc-punch .pt{font-size:clamp(1.2rem,2.8vw,1.9rem);font-weight:700;color:var(--fg)}
  .oc-punch .pb{font-size:clamp(1.5rem,4.4vw,3rem);font-weight:800;letter-spacing:-.02em;max-width:22ch;line-height:1.15}
  .oc-punch .pb em{font-style:normal;color:var(--magenta)}
  .oc-final .ft{font-size:clamp(1.3rem,3vw,2.1rem);font-weight:700}
  .oc-final .fq{font-size:clamp(1.5rem,4.2vw,2.7rem);font-weight:800;letter-spacing:-.02em;max-width:24ch;line-height:1.2}
  .oc-final .fq em{font-style:normal;color:var(--magenta)}
  .oc-final .btn{margin-top:22px;pointer-events:auto;position:relative;overflow:hidden;animation:oc-cta-pulse 2.1s ease-in-out infinite}
  .oc-final .btn::after{content:"";position:absolute;top:0;left:-70%;width:45%;height:100%;transform:skewX(-18deg);
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);animation:oc-cta-shine 3s ease-in-out infinite}
  @keyframes oc-cta-pulse{0%,100%{box-shadow:0 10px 30px -12px rgba(223,65,251,.7),0 0 0 0 rgba(223,65,251,.55)}50%{box-shadow:0 16px 44px -10px rgba(223,65,251,.95),0 0 0 14px rgba(223,65,251,0)}}
  @keyframes oc-cta-shine{0%{left:-70%}45%,100%{left:140%}}
  @media(prefers-reduced-motion:reduce){.oc-final .btn{animation:none}.oc-final .btn::after{display:none}}
  body:not(.anim) .oc-scene{height:auto}
  body:not(.anim) .oc-stage{position:static;height:auto;padding:80px 0}
  body:not(.anim) .oc-node{opacity:1}
  body:not(.anim) .oc-conn i{width:100%}
  body:not(.anim) .oc-punch,body:not(.anim) .oc-final{position:static;opacity:1;background:none;margin-top:44px}

  /* ============ VERSPRECHEN ============ */
  .promise{background:linear-gradient(180deg,#fff, #FBF3FE);padding:96px 0;border-top:1px solid var(--line)}
