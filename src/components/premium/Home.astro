  .mi-qh:hover .mi-cta em,.mi-qh:focus-visible .mi-cta em{text-decoration:underline;
    text-decoration-thickness:1.5px;text-underline-offset:3px}
  .mi-qh[aria-expanded="true"]{background:var(--muted2);box-shadow:inset 3px 0 0 var(--magenta)}
  .mi-st{display:block;margin-bottom:7px;font-size:.66rem;font-weight:800;letter-spacing:.14em;
    text-transform:uppercase;color:var(--magenta-ink)}
  .mi-t{display:block;font-size:1rem;font-weight:600;line-height:1.45}
  .mi-res{display:block;margin-top:6px;font-size:.84rem;color:var(--mut);line-height:1.5}
  .mi-res b{color:var(--magenta-ink);font-weight:700}
  .mi-flag{font-size:.72rem;font-weight:700;white-space:nowrap;padding:5px 11px;border-radius:999px;
    background:rgba(223,65,251,.1);color:var(--magenta-ink);border:1px solid rgba(223,65,251,.35)}
  .mi-cta{display:flex;align-items:center;gap:9px}
  .mi-cta em{font-style:normal;font-size:.8rem;font-weight:700;color:var(--magenta-ink);white-space:nowrap}
  .mi-ar{width:30px;height:30px;flex:none;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center;transition:.3s}
  .mi-ar svg{width:15px;height:15px}
  .mi-qh[aria-expanded="true"] .mi-ar{background:var(--magenta);border-color:var(--magenta);color:#fff;transform:rotate(180deg)}
  .mi-qh[aria-expanded="true"] .mi-cta em{display:none}
  .mi-q.hint .mi-ar{animation:miPulse 1.9s ease-in-out infinite}
  @keyframes miPulse{0%,100%{box-shadow:0 0 0 0 rgba(223,65,251,.42)}50%{box-shadow:0 0 0 9px rgba(223,65,251,0)}}
  @media(max-width:820px){.mi-qh{grid-template-columns:minmax(0,1fr) auto;gap:12px}.mi-cta em{display:none}}
  .mi-qb{max-height:0;overflow:hidden;transition:max-height .45s cubic-bezier(.4,0,.2,1)}
