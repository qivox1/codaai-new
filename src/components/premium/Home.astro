  .mi-anon{margin-left:auto;font-size:.72rem;color:var(--mut);border:1px solid var(--line2);padding:5px 11px;border-radius:999px}
  .mi-kpi{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}
  .mi-kpi>div{padding:18px 22px;border-right:1px solid var(--line)}
  .mi-kpi>div:last-child{border-right:0}
  .mi-kpi b{display:block;font-size:clamp(1.2rem,2.2vw,1.55rem);font-weight:800;letter-spacing:-.03em}
  .mi-kpi b.bad{color:var(--magenta)}
  .mi-kpi span{display:block;margin-top:5px;font-size:.74rem;color:var(--mut);line-height:1.45}
  @media(max-width:760px){.mi-kpi{grid-template-columns:repeat(2,1fr)}.mi-kpi>div{border-bottom:1px solid var(--line)}}
  .mi-q{border-bottom:1px solid var(--line)}
  .mi-q:last-of-type{border-bottom:0}
  /* 25.07.2026: Das Stufen-Label saß in einer 132-px-Spalte und ragte bei
     „Wettbewerbsvergleich" in den Fragetext. Es steht jetzt über der Frage —
     löst das Problem strukturell und liest sich mobil ebenfalls besser. */
  .mi-qh{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:18px;align-items:center;
    width:100%;background:none;border:0;font:inherit;text-align:left;padding:18px 22px;cursor:pointer;transition:background .2s}
  /* 25.07.2026: Der Hover war mit 4 % Magenta praktisch unsichtbar. Wer die
     Selbstöffnung verpasst, muss trotzdem erkennen, dass die Zeilen anklickbar
     sind — deshalb hellgrauer Grund, magenta Kante links und ein reagierender
     Pfeil. Tastaturbedienung bekommt denselben Zustand über :focus-visible. */
  .mi-qh:hover,.mi-qh:focus-visible{background:var(--muted2);outline:none;
    box-shadow:inset 3px 0 0 var(--magenta)}
  .mi-qh:hover .mi-ar,.mi-qh:focus-visible .mi-ar{border-color:var(--magenta);color:var(--magenta);
