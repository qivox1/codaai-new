  @media(max-width:620px){.vrow{grid-template-columns:minmax(0,1fr) 50px}.vlab{grid-column:1/-1}}

  /* ── Angebot: der einzige gesättigte Block der Seite (Ä19/Ä20/Ä21) ──
     Schrift durchgehend weiss (Beschluss Oli, 03.08.2026). Auf dem hellen
     #DF41FB erreicht Weiss nur 3,34:1 und faellt fuer Fliesstext durch. Der
     Grund liegt deshalb auf #C405E6 — derselbe Farbton (H 291, S 96 %), nur
     dunkler: der pinkste Wert, bei dem Weiss noch 4,65:1 erreicht und damit
     die Schwelle 4,5 haelt. Jeder hellere Ton faellt durch. Folge: KEIN
     abgetoentes Weiss in dieser Sektion — schon 95 % Deckkraft landen bei
     4,27:1. Die Hierarchie kommt hier aus Groesse und Schnitt. */
  .offer{--offer-bg:#C405E6;background:var(--offer-bg);color:#fff;padding:clamp(70px,10vh,110px) 0}
  .offer .off-h{max-width:40ch;color:#fff}
  /* Dieselbe Hierarchie wie im Hero: grosse Aussage, darunter die kleinere,
     zurueckgenommene Zeile. Die Zuruecknahme kommt allein aus Groesse und
     Schnitt — ein abgetoentes Weiss ginge hier nicht durch. */
  .offer .off-l2{margin-top:12px;max-width:46ch;color:#fff;
    font-size:clamp(1.05rem,1.9vw,1.4rem);font-weight:500;line-height:1.42;letter-spacing:-.02em}
  .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:32px}
  @media(max-width:900px){.tiers{grid-template-columns:1fr}}
  .tier{background:#fff;border-radius:18px;padding:22px 22px 24px;box-shadow:0 16px 44px rgba(70,8,84,.22)}
  .tbars{display:flex;gap:5px;align-items:flex-end;height:26px;margin-bottom:15px}
  .tbars i{width:11px;border-radius:3px;background:#ece0ef;display:block;height:40%}
  .tbars i:nth-child(2){height:68%}
