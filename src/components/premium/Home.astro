  /* ═══════════ NEU 25.07.2026 (AP5) ═══════════════════════════════════ */

  /* ── Drei Stellen + Begriffe-Akkordeon (ersetzt die 200vh-Horizontalszene) ── */
  /* 25.07.2026: von Schwarz auf Grau — zwei dunkle Blöcke hintereinander liefen
     ineinander. Rhythmus jetzt: dunkle Szene → grau → weiß (Spiegel) → dunkle Szene. */
  .rooms{background:var(--muted);color:var(--fg);padding:clamp(64px,9vh,104px) 0;
    border-top:1px solid var(--line)}
  .rooms-lead{max-width:52ch}
  /* Marken-Pink statt des abgedunkelten Tons: die Ueberschrift ist Grosstext
     (>=28,8px, weight 800), damit gilt die AA-Schwelle 3,0 — #DF41FB erreicht
     auf #F7F4FA 3,07:1. Knapp, aber zulaessig. Achtung: fuer KLEINE Texte auf
     diesem Grund weiterhin --magenta-ink verwenden (dort gilt 4,5). */
  .rooms-lead b{color:var(--magenta);font-weight:800}
  .acc{margin-top:26px;border-top:1px solid var(--line2)}
  /* 25.07.2026: Der Button lief über die volle Containerbreite, dadurch stand der
     Pfeil auf dem Desktop weit rechts vom Label — man erkannte nicht, dass beides
     zusammengehört. Jetzt inline, Pfeil direkt neben dem Text, und beim Hovern
     wechselt er auf Pink. */
  .accbtn{display:inline-flex;align-items:center;gap:12px;width:auto;background:none;border:0;font:inherit;
    color:var(--fg);padding:18px 0;cursor:pointer;text-align:left;transition:color .2s}
  .accbtn>span:first-child{font-size:1rem;font-weight:600}
  .accbtn .ar{width:30px;height:30px;flex:none;border-radius:50%;
    border:1px solid var(--line2);display:grid;place-items:center;transition:.3s}
  .accbtn .ar svg{width:15px;height:15px}
  .accbtn:hover,.accbtn:focus-visible{color:var(--magenta-ink);outline:none}
  .accbtn:hover>span:first-child,.accbtn:focus-visible>span:first-child{text-decoration:underline;
    text-decoration-thickness:1.5px;text-underline-offset:4px}
  .accbtn:hover .ar,.accbtn:focus-visible .ar{border-color:var(--magenta);color:var(--magenta);
    background:rgba(223,65,251,.1)}
  .accbtn[aria-expanded="true"] .ar{background:var(--magenta);border-color:var(--magenta);color:#fff;transform:rotate(180deg)}
  .accbody{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.4,0,.2,1);border-bottom:1px solid var(--line2)}
  .tabs{display:flex;gap:8px;padding:4px 0 20px;flex-wrap:wrap}
  .tab{background:var(--card);border:1px solid var(--line2);color:var(--mut);border-radius: var(--btn-radius);
    padding:9px 18px;font:inherit;font-size:.86rem;font-weight:700;letter-spacing:.04em;cursor:pointer;transition:.25s}
  .tab.on{background:var(--magenta);border-color:var(--magenta);color:#fff}
  .panes{padding-bottom:24px}
  .pane{display:none;max-width:66ch}
  .pane.on{display:block}
  .pane .plv{font-size:.68rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--magenta-ink)}
  .pane h3{margin-top:8px;font-size:1.1rem;font-weight:700;letter-spacing:-.01em}
  .pane p{margin-top:8px;color:var(--mut);font-size:.95rem;line-height:1.7}

  /* ── Der Spiegel: echtes Muster-Audit, Interaktion statt Animation ── */
  .mirror{background:var(--bg);padding:clamp(72px,10vh,112px) 0;border-top:1px solid var(--line)}
  .mi-head{max-width:80ch}
  .mi-head .sec{margin-top:12px}
  /* Pointe in die zweite Zeile: der Satz kippt mit dem Umbruch von der Feststellung
     auf den Einwand — das ist die Wirkung, die den Block traegt. */
  .mi-head .sec em{display:block;margin-top:4px;font-style:normal;color:var(--magenta)}
  .mi-head .lead{margin-top:16px}
  .mi-cue{margin-top:16px;display:flex;gap:10px;align-items:flex-start;font-size:.98rem;font-weight:600;line-height:1.5}
  .mi-cue i{width:24px;height:24px;flex:none;border-radius:50%;background:var(--magenta);color:#fff;
    display:grid;place-items:center;font-style:normal;font-size:.78rem}
  .mi-card{margin-top:32px;background:var(--card);border:1px solid var(--line);border-radius:20px;
    overflow:hidden;box-shadow:0 26px 70px -34px rgba(20,10,40,.28)}
  .mi-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:16px 22px;
    border-bottom:1px solid var(--line);background:linear-gradient(90deg,rgba(223,65,251,.08),transparent)}
