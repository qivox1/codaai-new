  .qcaret{display:inline-block;width:2px;height:1.05em;background:var(--magenta);vertical-align:-2px;margin-left:1px}
  .vp{position:relative;height:clamp(360px,52vh,520px);overflow:hidden}
  .serp{position:absolute;inset:0;padding:1.4rem 1.6rem;display:flex;flex-direction:column;gap:1.15rem}
