---
/**
 * SnapshotModule — „Visibility Snapshot" (seit 24.09.2026, Konzept: Claude-Doc
 * „KI-Empfehlungs-Check — Konzept", Name-Entscheidung Oli 24.09.).
 *
 * Besucher gibt Website + eine Kundenfrage ein → fünf KI-Systeme werden live
 * gefragt → Befund auf Magenta: genannt in x von 5, Logos mit ✓/✗, welche
 * Firmen stattdessen empfohlen werden. Antworttexte + Quellen erst nach
 * bestätigter Firmen-E-Mail (Double-Opt-in, Mail kommt vom Server).
 *
 * Backend: audit.codaai.ai/ai/frage + /ai/frage/freischalten
 * (Pipeline-CLAUDE.md 4.38, Modul scripts/ai_frage.py). Datenquellen und
 * Modellnamen werden bewusst nirgends genannt (Nachahmerschutz).
 *
 * Captcha: Cloudflare Turnstile, sobald TURNSTILE_SITEKEY gesetzt ist. Bis
 * dahin schützen Lockfeld + Mindest-Ausfüllzeit (serverseitig geprüft).
 *
 * URL-Übergabe: ?d=firma.de&q=Frage füllt vor und startet automatisch
 * (Teaser auf Startseite/Webinar, Nurture-Mails).
 *
 * Eingabehilfe (27.09.2026, seit 27.09. für alle live):
 * animierter Platzhalter mit Beispielfragen je Rolle (?src=li-gf | li-vl | li-ml),
 * eine Formelzeile und ein Fragen-Vorschlag aus der Startseite der eingegebenen
 * Website (POST /ai/frage/vorschlag, max. ~4,5 s, überschreibt nie Eingetipptes).
 *
 * Kurz-Freischaltung (27.09.2026, für alle live): Freischaltung nur mit
 * geschäftlicher E-Mail (Name wird serverseitig aus der Adresse abgeleitet, Domain muss zur
 * geprüften Website passen) und Knöpfe „<Bereich> prüfen“ für weitere Geschäftsbereiche
 * (res.bereiche, vom Server parallel zur Messung ermittelt).
 *
 * dataLayer: snapshot_start {lang}, snapshot_result {genannt, von, cached},
 *            snapshot_vorschlag {ok, ms}, snapshot_vorschlag_behalten,
 *            snapshot_error {status}, snapshot_unlock {marketing}
 */
interface Props { source?: string }
const { source = 'snapshot' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const TURNSTILE_SITEKEY = '';   // ← Site Key von Cloudflare Turnstile hier eintragen
const logos = [
  { key: 'chatgpt', label: 'ChatGPT' },
  { key: 'claude', label: 'Claude' },
  { key: 'gemini', label: 'Gemini' },
  { key: 'perplexity', label: 'Perplexity' },
  { key: 'google_ai_mode', label: 'Google AI Mode', file: 'google' },
];
const beispiele = [
  'Welche Anbieter für [Ihr Produkt] sind in Deutschland führend?',
  'Welcher Hersteller eignet sich am besten für [Ihre Anwendung]?',
  'Welche Alternativen gibt es zu [Ihr größter Wettbewerber]?',
];
---

<div class="snap" data-snap data-state="idle" data-source={source} data-sitekey={TURNSTILE_SITEKEY || undefined}>
  <form class="snap-form" data-form novalidate autocomplete="off">
    <div class="snap-hp" inert aria-hidden="true"><label>Website<input type="text" name="website_url" data-hp tabindex="-1" autocomplete="off" /></label></div>

    <label class="snap-lbl" for="snap-domain">Ihre Website</label>
    <input id="snap-domain" class="snap-in" data-domain type="text" inputmode="url" spellcheck="false" placeholder="z. B. ihrefirma.de" />

    <label class="snap-lbl" for="snap-frage">Eine Frage, die Ihre Kunden der KI stellen würden</label>
    <p class="snap-formel" data-formel hidden>Produkt + Anwendung – so fragt ein Kunde, der Sie nicht kennt.</p>
    <textarea id="snap-frage" class="snap-in snap-ta" data-frage rows="3" maxlength="250" placeholder="z. B. Welche Anbieter für Präzisionsklimaanlagen sind in Deutschland führend?"></textarea>
    <p class="snap-vhint" data-vhint role="status" hidden>Vorschlag für Ihre Website – gern anpassen.</p>
    <div class="snap-fhint" data-fhint role="status" hidden>
      <p class="snap-fhint-t" data-fhint-t></p>
      <button type="button" class="snap-fhint-use" data-fhint-use hidden><span class="snap-fhint-k">Vorschlag übernehmen</span><span data-fhint-v></span></button>
      <button type="button" class="snap-fhint-skip" data-fhint-skip hidden>Trotzdem mit meiner Frage prüfen</button>
    </div>

    {TURNSTILE_SITEKEY && <div class="snap-captcha" data-captcha></div>}

    <button type="submit" class="snap-go" data-go>
      <span>Snapshot starten</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <p class="snap-err" data-err role="alert" hidden></p>
    <div class="snap-lim" data-lim hidden>
      <p class="snap-lim-t" data-limt></p>
      <button type="button" class="snap-send" data-limbtn>Wettbewerbsvergleich anfordern <span aria-hidden="true">→</span></button>
      <div class="snap-lim-f" data-limf hidden>
        <label class="snap-amail snap-amail--hell" data-limmailw><input data-limmail type="text" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="vorname.nachname" aria-label="Geschäftliche E-Mail-Adresse" /><span data-limat></span></label>
        <button type="button" class="snap-send" data-limsend>Wettbewerbsvergleich anfordern <span aria-hidden="true">→</span></button>
        <p class="snap-aerr" data-limerr role="alert" hidden></p>
        <p class="snap-lim-mini"><a href={`${base}/datenschutz/#visibility-snapshot`} target="_blank" rel="noopener">Datenschutzhinweise</a></p>
      </div>
      <p class="snap-lim-done" data-limdone hidden></p>
    </div>
    <p class="snap-micro">Kostenlos · rund 20 Sekunden · Ergebnis ohne Anmeldung</p>
  </form>

  <div class="snap-load" data-load aria-live="polite">
    <p class="snap-load-h" data-loadh aria-live="polite">Wir fragen die KI-Systeme …</p>
    <p class="snap-lq" data-lq></p>
    <div class="snap-bar"><span data-lbar></span></div>
    <ul class="snap-logos snap-logos--load" data-loadlogos>
      {logos.map((l, i) => (
        <li style={`--i:${i}`} data-sys={l.key}><span class="snap-lg"><img src={`${base}/images/ki-logos/${l.file ?? l.key}.svg`} alt="" width="30" height="30" /><i class="snap-mark" aria-hidden="true"></i></span><span>{l.label}</span></li>
      ))}
    </ul>
    <div class="snap-tech" data-techbox>
      <p class="snap-tech-h">Parallel lesen wir Ihre Website so, wie ein KI-System sie sieht:</p>
      <div class="snap-tech-g">
      <figure class="snap-shot snap-lshot" data-lshot aria-hidden="true">
        <div class="snap-shot-b"><i></i><i></i><i></i><span data-lshotd></span></div>
        <div class="snap-lshot-f"><img data-lshotimg alt="" hidden /><span class="snap-lshot-ph">Startseite wird geladen …</span><i class="snap-scan"></i></div>
      </figure>
      <ul class="snap-tech-l" data-techl>
        <li data-tk="crawler"><i></i><span>Dürfen KI-Systeme Ihre Website lesen?</span></li>
        <li data-tk="schutz"><i></i><span>Lässt Ihr Website-Schutz sie durch?</span></li>
        <li data-tk="text"><i></i><span>Sehen sie Ihre Inhalte ohne JavaScript?</span></li>
        <li data-tk="klar"><i></i><span>Ist klar erkennbar, was Sie anbieten?</span></li>
        <li data-tk="aktuell"><i></i><span>Wie aktuell sind Ihre Inhalte?</span></li>
        <li data-tk="schema"><i></i><span>Sind Ihre Firmendaten maschinenlesbar?</span></li>
      </ul>
      </div>
    </div>
  </div>

  <div class="snap-res" data-res aria-live="polite">
    <p class="snap-kicker">Visibility Snapshot · <span data-dom></span> · <span data-stand></span></p>
    <div class="snap-qrow">
    <p class="snap-q">„<span data-q></span>“</p>
    <figure class="snap-thumb" data-thumb hidden><div class="snap-shot-b"><i></i><i></i><i></i><span data-thumbd></span></div><img data-thumbimg alt="Startseite Ihrer Website" width="640" height="400" /></figure>
    </div>
    <p class="snap-verdict"><span class="snap-badge" data-badge></span> <span data-verdict></span></p>
    <p class="snap-vs" data-vs hidden></p>
    <ul class="snap-logos snap-logos--res" data-reslogos hidden>
      {logos.map((l) => (
        <li data-sys={l.key}><span class="snap-lg"><img src={`${base}/images/ki-logos/${l.file ?? l.key}.svg`} alt="" width="30" height="30" /><i class="snap-mark" aria-hidden="true"></i></span><span class="snap-sysl">{l.label}</span><span class="snap-sysp" data-p></span></li>
      ))}
    </ul>
    <p class="snap-vorn" data-vorn hidden></p>
    <details class="snap-find" data-findbox hidden>
      <summary class="snap-find-s" data-findh>Hinweise</summary>
      <dl class="snap-find-l" data-find></dl>
    </details>
    <div class="snap-sb" data-sb hidden>
      <p class="snap-sb-h"><span>So beschreibt <span data-sbsys>ChatGPT</span> Ihr Unternehmen <small>(ohne Websuche)</small></span> <span class="snap-sb-u" data-sbu></span></p>
      <p class="snap-sb-t">„<span data-sbt></span>“</p>
    </div>
    <div class="snap-ber" data-ber hidden>
      <p class="snap-ber-h" data-berh>Weitere erkannte Geschäftsbereiche</p>
      <ul class="snap-ber-l" data-berl></ul>
    </div>
    <p class="snap-also" data-also hidden></p>
    <div class="snap-cov" data-cov hidden>
      <p class="snap-cov-t" data-covt></p>
    </div>
    <div class="snap-audit" data-audit hidden>
      <p class="snap-audit-h" data-audith><span class="snap-audit-h1">Das war nur <b>eine</b> Frage.</span><br /><span class="snap-audit-pk">Sehen Sie jetzt das ganze Bild.</span></p>
      <p class="snap-audit-c"><span class="snap-audit-ct" data-auditc>Ihre Kunden fragen zuerst die KI, und die schreibt die Shortlist. Wer dort fehlt, bekommt die Anfrage nicht. Und meist merkt man das gar nicht.</span><span data-auditbeweis hidden></span></p>
      <div class="snap-acov" data-acov hidden><div class="snap-acov-bar"><i data-acovi></i></div><p class="snap-acov-t" data-acovt></p></div>
      <p class="snap-audit-p">Ihr KI-Wettbewerbsvergleich für <b data-auditd></b> per E-Mail:</p>
      <ul class="snap-audit-l" data-auditl>
        <li>Welche Wettbewerber die KI bei Ihren wichtigsten Kundenfragen empfiehlt, und warum</li>
        <li>Bei welchen Fragen die Anfragen heute an andere gehen</li>
        <li>Ihre Position in Google und KI, direkt neben Ihren Wettbewerbern</li>
        <li>Was konkret zu tun ist, damit Sie auf die Shortlist kommen</li>
      </ul>
      <div class="snap-aform" data-aform>
        <label class="snap-amail" data-amail><input data-mail type="text" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="vorname.nachname" aria-label="Geschäftliche E-Mail-Adresse" /><span data-at></span></label>
        <button type="button" class="snap-send" data-send><span data-sendt>Wettbewerbsvergleich anfordern</span> <span aria-hidden="true">→</span></button>
        <p class="snap-aerr" data-err2 role="alert" hidden></p>
        <p class="snap-amini"><a href={`${base}/datenschutz/#visibility-snapshot`} target="_blank" rel="noopener">Datenschutzhinweise</a></p>
      </div>
      <p class="snap-adone" data-done hidden><b>Fast geschafft.</b> <span data-donet></span></p>
    </div>
    <button type="button" class="snap-again" data-again>Andere Frage prüfen</button>
    <p class="snap-disc">Stichprobe vom <span data-stand2></span>. KI-Antworten schwanken von Tag zu Tag. Wiedergegeben sind Antworten der KI-Systeme, keine Aussage von CodaAI über die genannten Unternehmen.</p>
  </div>
</div>

<style>
  .snap { --pad: 28px; width:100%; max-width:560px; border-radius:24px; background:hsl(var(--card)); border:1px solid hsl(var(--border)); box-shadow:0 20px 60px -30px hsl(var(--foreground) / .35); overflow:hidden; }
  .snap-form, .snap-load, .snap-res { padding:var(--pad); }
  .is-vf .snap-lshot-f img, .is-vf .snap-thumb img { filter: blur(16px) saturate(.7); transform: scale(1.08); }
  .snap-vf-dom { margin-bottom:18px; color:hsl(var(--muted-foreground)); font-style:italic; user-select:none; }
  .snap-hp { position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; }
  .snap-lbl { display:block; margin:0 0 6px; font-size:14px; font-weight:700; color:hsl(var(--foreground)); }
  .snap-lbl + .snap-in { margin-bottom:18px; }
  .snap-in { width:100%; border:1.5px solid hsl(var(--border)); border-radius:12px; padding:13px 14px; font-size:16px; background:hsl(var(--background)); color:hsl(var(--foreground)); }
  .snap-in:focus { outline:none; border-color:hsl(var(--cta)); box-shadow:0 0 0 3px hsl(var(--cta) / .18); }
  .snap-ta { resize:vertical; min-height:88px; line-height:1.45; }
  .snap-ta + .snap-chips, .snap-fhint + .snap-chips { margin-top:10px; }
  .snap-form :global(.snap-test) { margin:8px 0 0; text-align:center; font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#8A5A00; }
  .snap-fhint-use[hidden], .snap-fhint-skip[hidden], .snap-fhint[hidden], .snap-formel[hidden], .snap-vhint[hidden] { display:none; }
  .snap-formel { margin:-2px 0 8px; font-size:13px; line-height:1.4; color:hsl(var(--muted-foreground)); }
  .snap-lbl:has(+ .snap-formel:not([hidden])) { margin-bottom:2px; }
  .snap-vhint { margin:8px 0 16px; font-size:13px; color:hsl(var(--cta-accessible)); }
  .snap-vhint::before { content:"✦ "; }
  .snap-ta.is-typing { caret-color:transparent; }
  .snap-fhint { margin:-8px 0 18px; padding:12px 14px; border-radius:12px; background:#FDF1D8; color:#5C3D00; font-size:13.5px; line-height:1.45; }
  .snap-fhint-t { margin:0; }
  .snap-fhint-use { display:block; width:100%; margin-top:10px; padding:10px 12px; border:1px solid #E7C77E; border-radius:10px; background:#fff; color:hsl(var(--foreground)); font-size:14px; line-height:1.4; text-align:left; cursor:pointer; }
  .snap-fhint-use:hover { border-color:hsl(var(--cta)); }
  .snap-fhint-skip { margin-top:8px; padding:0; border:0; background:none; color:#5C3D00; font-size:13px; text-decoration:underline; cursor:pointer; }
  .snap-fhint-k { display:block; margin-bottom:2px; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:hsl(var(--cta-strong)); }
  .snap-chips { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:18px; }
  .snap-chip { border:1px solid hsl(var(--border)); background:hsl(var(--muted) / .35); color:hsl(var(--foreground)); border-radius:999px; padding:5px 11px; font-size:12.5px; text-align:left; cursor:pointer; }
  .snap-chip:hover { border-color:hsl(var(--cta)); }
  .snap-captcha { margin:0 0 14px; min-height:65px; }
  .snap-go, .snap-send { display:flex; width:100%; align-items:center; justify-content:center; gap:10px; border:0; border-radius:12px; padding:15px 18px; font-size:16px; font-weight:700; cursor:pointer; background:hsl(var(--cta-strong)); color:#fff; }
  .snap-go:hover, .snap-send:hover { filter:brightness(1.08); }
  .snap-go[disabled], .snap-send[disabled] { opacity:.6; cursor:wait; }
  .snap-err { margin:10px 0 0; font-size:14px; font-weight:600; color:hsl(var(--destructive, 0 70% 45%)); }
  .snap-micro { margin:10px 0 0; font-size:12.5px; text-align:center; color:hsl(var(--muted-foreground)); }

  .snap-load, .snap-res { display:none; }
  .snap[data-state="load"] .snap-form, .snap[data-state="res"] .snap-form { display:none; }
  .snap[data-state="load"] .snap-load { display:block; }
  .snap[data-state="res"] .snap-res { display:block; }
  .snap-load-h { margin:0 0 18px; font-size:18px; font-weight:700; color:hsl(var(--foreground)); }
  .snap-logos { display:flex; justify-content:space-between; gap:8px; list-style:none; margin:0; padding:0; }
  .snap-logos li { display:flex; flex-direction:column; align-items:center; gap:6px; font-size:11.5px; font-weight:600; flex:1; text-align:center; }
  .snap-logos--load li { color:hsl(var(--muted-foreground)); animation:snap-pulse 2.5s ease-in-out infinite; animation-delay:calc(var(--i) * .5s); }
  .snap-logos--load .snap-lg { width:40px; height:40px; }
  .snap-logos--load .snap-lg img { width:24px; height:24px; }
  /* Enthuellung (28.09.2026): Logos hören auf zu pulsieren und klappen nacheinander auf ✓ / ✗ */
  .snap.is-reveal .snap-logos--load li { animation:none; opacity:1; transform:none; color:hsl(var(--foreground)); }
  .snap.is-reveal .snap-logos--load li[data-ok] .snap-lg { animation:snap-flip .45s ease both; }
  .snap.is-reveal .snap-logos--load li[data-ok="0"] .snap-lg { box-shadow:0 0 0 2px #C0343C; }
  .snap.is-reveal .snap-logos--load li[data-ok="1"] .snap-lg { box-shadow:0 0 0 2px hsl(var(--confirm)); }
  @keyframes snap-flip { 0% { transform:rotateY(0); } 50% { transform:rotateY(90deg) scale(1.08); } 100% { transform:rotateY(0) scale(1); } }
  .snap-load-h :global(b) { color:hsl(var(--cta-accessible)); font-size:1.25em; }
  /* Frage füllt sich pink im Takt des Balkens */
  .snap-lq { margin:0 0 4px; font-size:19px; line-height:1.35; font-weight:700; color:hsl(var(--navy-300)); }
  .snap-lq :global(span) { transition:color .35s ease; }
  .snap-lq :global(span.is-an) { color:hsl(var(--cta-accessible)); }
  .snap.is-wait .snap-lq :global(span:not(.is-an)) { animation:snap-glimm 1.6s ease-in-out infinite; }
  @keyframes snap-glimm { 50% { color:hsl(var(--cta-accessible) / .45); } }
  .snap.is-wait .snap-bar span { animation:snap-glimm2 1.6s ease-in-out infinite; }
  @keyframes snap-glimm2 { 50% { opacity:.55; } }
  /* Screenshot mit Scanlinie */
  /* Ladebildschirm (28.09.2026): Screenshot über die volle Breite, Prüfungen darunter zweispaltig */
  .snap-load .snap-tech-g { flex-direction:column; align-items:stretch; }
  .snap-load .snap-lshot { flex:none; width:100%; }
  .snap-load .snap-tech-l { display:grid; grid-template-columns:1fr 1fr; gap:8px 18px; }
  .snap-load .snap-tech-l li { align-items:flex-start; font-size:13.5px; line-height:1.4; }
  .snap-load .snap-tech-l li i { margin-top:1px; }
  .snap-lshot-f { position:relative; aspect-ratio:2/1; overflow:hidden; background:hsl(var(--muted) / .5); }
  .snap-lshot-f img { width:100%; height:100%; object-fit:cover; object-position:top; animation:snap-in .5s ease both; }
  .snap-lshot-ph { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:11px; color:hsl(var(--muted-foreground)); }
  .snap-lshot-f img:not([hidden]) + .snap-lshot-ph { display:none; }
  .snap-scan { position:absolute; left:0; right:0; top:0; height:38%; pointer-events:none; background:linear-gradient(to bottom, hsl(var(--cta) / 0) 0%, hsl(var(--cta) / .16) 85%, hsl(var(--cta)) 100%); animation:snap-scan 2.6s cubic-bezier(.45,0,.55,1) infinite; }
  @keyframes snap-scan { 0% { transform:translateY(-100%); } 100% { transform:translateY(265%); } }
  .snap.is-reveal .snap-scan { display:none; }
  .snap[data-state="res"] .snap-res { animation:snap-in .45s ease both; }
  @keyframes snap-pulse { 0%,100% { opacity:.35; transform:translateY(0); } 20% { opacity:1; transform:translateY(-4px); } 40% { opacity:.6; transform:translateY(0); } }
  .snap-bar { margin:22px 0 14px; height:6px; border-radius:99px; background:hsl(var(--muted)); overflow:hidden; }
  .snap-bar span { display:block; height:100%; width:0; background:hsl(var(--cta)); }
  /* Breite setzt das Skript (gleiche Kurve wie die Frage) */
  @media (prefers-reduced-motion: reduce) { .snap-logos--load li { animation:none; opacity:1; } .snap-scan { display:none; } .snap.is-wait .snap-lq :global(span), .snap.is-wait .snap-bar span, .snap.is-reveal .snap-logos--load li[data-ok] .snap-lg { animation:none; } }

  /* Ergebnis: ruhig, weiss; Magenta nur als Akzent und fuer Aktionen */
  .snap-res { background:hsl(var(--card)); color:hsl(var(--foreground)); border-top:4px solid hsl(var(--cta-strong)); }
  .snap-kicker { margin:0; font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:hsl(var(--muted-foreground)); overflow-wrap:anywhere; }
  .snap-q { margin:10px 0 14px; font-size:22px; line-height:1.3; font-weight:700; }
  /* 01.10.2026: Ergebnis kompakt (Abnahme Oli) */
  .snap-qrow { display:grid; grid-template-columns:minmax(0,1fr) 128px; gap:16px; align-items:start; margin:10px 0 16px; }
  .snap-qrow .snap-q { margin:0; font-size:19px; }
  .snap-qrow .snap-thumb { margin:2px 0 0; border-radius:8px; }
  .snap-qrow .snap-thumb .snap-shot-b { padding:4px 6px; }
  .snap-qrow .snap-thumb .snap-shot-b span { display:none; }
  .snap-verdict { margin-bottom:14px !important; }
  .snap-logos--res .snap-sysl { font-size:11px; }
  .snap-vorn { margin:10px 0 0; font-size:14px; line-height:1.5; color:hsl(var(--foreground) / .85); }
  .snap-vorn[hidden] { display:none; }
  .snap-vorn :global(b) { color:hsl(var(--foreground)); }
  .snap-find { margin-top:12px !important; }
  .snap-find-s { cursor:pointer; list-style:none; font-size:13.5px; font-weight:600; color:hsl(var(--muted-foreground)); padding:6px 0; }
  .snap-find-s::-webkit-details-marker { display:none; }
  .snap-find-s::before { content:"▸"; display:inline-block; width:14px; transition:transform .2s; }
