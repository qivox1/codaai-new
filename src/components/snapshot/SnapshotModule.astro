      let limDomain = '';
      const limMail = $('[data-limmail]') as HTMLInputElement, limSend = $<HTMLButtonElement>('[data-limsend]'), limErr = $('[data-limerr]') as HTMLElement;
      ($('[data-limbtn]') as HTMLElement).addEventListener('click', () => {
        ($('[data-limbtn]') as HTMLElement).hidden = true; ($('[data-limf]') as HTMLElement).hidden = false; limMail.focus();
        dl.push({ event: 'snapshot_limit_audit_offen', lang, source: root.dataset.source });
      });
      limMail.addEventListener('input', () => ($('[data-limmailw]') as HTMLElement).classList.toggle('is-voll', limMail.value.includes('@')));
      limMail.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); limSend.click(); } });
      limSend.addEventListener('click', async () => {
        show(limErr, '');
        const v = limMail.value.trim().replace(/\s+/g, '');
        const mail = v.includes('@') ? v : (v ? `${v}@${limDomain}` : '');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail)) { limMail.focus(); return show(limErr, 'Bitte geben Sie Ihre geschäftliche E-Mail-Adresse an.'); }
        limSend.disabled = true;
        let r2: any = null;
        try {
          const r = await fetch(API + '/ai/frage/freischalten', { method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ domain: limDomain, name: '', email: mail, audit: true, icp, einwilligung_ergebnis: true,
                                   einwilligung_version: '2026-09-27-audit-v1', test_key: testKey || undefined,
                                   website_url: ($('[data-hp]') as HTMLInputElement).value }) });
          r2 = await r.json();
        } catch (e) { r2 = { status: 'error', hinweis: 'Die Verbindung ist fehlgeschlagen. Bitte erneut versuchen.' }; }
        limSend.disabled = false;
        if (!r2 || r2.status !== 'ok') return show(limErr, (r2 && r2.hinweis) || 'Das hat nicht geklappt. Bitte erneut versuchen.');
        ($('[data-limf]') as HTMLElement).hidden = true;
        const dn = $('[data-limdone]') as HTMLElement; dn.hidden = false;
        dn.textContent = `Fast geschafft. Bitte bestätigen Sie kurz den Link in der E-Mail an ${mail}. Danach ergänzen Sie noch Ihren Namen, und wir erstellen Ihren Wettbewerbsvergleich.`;
        dl.push({ event: 'snapshot_audit_anfrage', quelle: 'limit', icp, lang, source: root.dataset.source });
      });

      let auditDomain = '';
      const mailIn = $('[data-mail]') as HTMLInputElement;
      mailIn.addEventListener('input', () => ($('[data-amail]') as HTMLElement).classList.toggle('is-voll', mailIn.value.includes('@')));
      mailIn.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); send.click(); } });
      if (vf) {
        mailIn.placeholder = 'vorname.nachname';
        send.addEventListener('click', (e) => {
          e.stopImmediatePropagation();
          if (vf.wv) window.open(vf.wv, '_blank', 'noopener');
        }, true);
      }
      send.addEventListener('click', async () => {
        show(err2, '');
        const v = mailIn.value.trim().replace(/\s+/g, '');
        const mail = v.includes('@') ? v : (v ? `${v}@${auditDomain}` : '');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail)) { mailIn.focus(); return show(err2, 'Bitte geben Sie Ihre geschäftliche E-Mail-Adresse an.'); }
        send.disabled = true;
        let res: any = null;
        try {
          const r = await fetch(API + '/ai/frage/freischalten', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ check_id: checkId, name: '', email: mail, audit: true, icp, einwilligung_ergebnis: true,
                                   einwilligung_version: '2026-09-27-audit-v1', test_key: testKey || undefined,
                                   website_url: ($('[data-hp]') as HTMLInputElement).value }),
          });
          res = await r.json();
        } catch (e) { res = { status: 'error', hinweis: 'Die Verbindung ist fehlgeschlagen. Bitte erneut versuchen.' }; }
        send.disabled = false;
        if (!res || res.status !== 'ok') {
          dl.push({ event: 'snapshot_audit_fehler', grund: (res && res.feld) || 'sonst', lang, source: root.dataset.source });
          return show(err2, (res && res.hinweis) || 'Das hat nicht geklappt. Bitte erneut versuchen.');
        }
        ($('[data-donet]') as HTMLElement).textContent = `Bitte bestätigen Sie kurz den Link in der E-Mail an ${mail}. Danach ergänzen Sie noch Ihren Namen, und wir erstellen Ihren Wettbewerbsvergleich.`;
        ($('[data-aform]') as HTMLElement).hidden = true;
        ($('[data-done]') as HTMLElement).hidden = false;
        dl.push({ event: 'snapshot_audit_anfrage', icp, zustand: root.dataset.zustand, lang, source: root.dataset.source });
      });

      ($('[data-again]') as HTMLElement).addEventListener('click', () => {
        setState('idle'); frage.focus(); frage.select();
      });

      // Übergabe aus Teasern/Mails: ?d=…&q=… füllt vor und startet
      const p = new URLSearchParams(location.search);
      if (p.get('d')) dom.value = p.get('d') || '';
      if (p.get('q')) frage.value = p.get('q') || '';
      if (!vf && dom.value && frage.value.trim().length >= 25) {   // Vorführmodus: Start per Klick, nicht automatisch
        root.scrollIntoView({ block: 'center' });
        if (sitekey) autostart = true; else setTimeout(() => form.requestSubmit(), 2600);
      }
    });
  })();
</script>
