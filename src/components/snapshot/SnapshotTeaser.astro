---
/**
 * SnapshotTeaser — schlanker Verweis auf den Visibility Snapshot.
 *
 * Der Snapshot selbst liegt seit 01.10.2026 im Kopfbereich der Startseite
 * (#snapshot); /visibility-snapshot/ ist nur noch eine Weiterleitung. Dieser
 * Teaser steht auf Glossar, Leitfaden und Webinar-Seite an Stelle des früheren
 * Audit-Formulars.
 *
 * Bewusst OHNE Eingabefelder (Beschluss Oli, 01.10.2026): Wer hier schon
 * Website und Frage eintippt und dann auf der Startseite landet, erwartet ein
 * Ergebnis — der Autostart dort greift aber erst ab 25 Zeichen Frage und wirkt
 * sonst wie „nichts passiert“. Deshalb nur Text + ein Knopf, der direkt zum
 * Formular springt (die Startseite setzt den Fokus ins Website-Feld).
 *
 * Gestaltung flach im CodaAI-Design (Mist-Fläche, eine Linie, ein Magenta-Knopf).
 * dataLayer: snapshot_teaser_click {source}
 */
interface Props { source?: string }
const { source = 'teaser' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logos = [['chatgpt', 'ChatGPT'], ['claude', 'Claude'], ['gemini', 'Gemini'], ['perplexity', 'Perplexity'], ['google', 'Google AI Mode']];
---
<div role="region" class="snapt" data-snapt data-source={source} aria-labelledby={`snapt-h-${source}`}>
  <div class="snapt-copy">
    <p class="snapt-k">Visibility Snapshot · kostenlos</p>
    <h2 id={`snapt-h-${source}`} class="snapt-h">Empfiehlt die KI Sie, <span>wenn Ihre Kunden fragen?</span></h2>
    <p class="snapt-p">Stellen Sie fünf KI-Systemen die Frage Ihrer Kunden. In rund 20 Sekunden sehen Sie, ob Sie genannt werden — und wen die KI stattdessen empfiehlt.</p>
    <ul class="snapt-logos" aria-label="Geprüfte KI-Systeme">
      {logos.map(([f, l]) => <li><img src={`${base}/images/ki-logos/${f}.svg`} alt="" width="18" height="18" />{l}</li>)}
    </ul>
  </div>
  <div class="snapt-act">
    <a class="snapt-go" href={`${base}/#snapshot`} data-snapt-go>Snapshot starten <span aria-hidden="true">→</span></a>
    <p class="snapt-m">Kostenlos · ohne Anmeldung</p>
  </div>
</div>

<style>
  .snapt { margin:0 auto; max-width:1200px; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:32px; align-items:center;
    padding:32px 36px; background:hsl(var(--surface-mist)); border:1px solid hsl(var(--border)); border-radius:var(--btn-radius, 14px); color:hsl(var(--foreground)); }
  .snapt-k { margin:0 0 10px; font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:hsl(var(--cta-accessible)); }
  .snapt-h { margin:0; font-size:clamp(24px, 2.8vw, 32px); line-height:1.2; font-weight:700; letter-spacing:-.015em; color:hsl(var(--foreground)); }
  .snapt-h span { background-image:linear-gradient(135deg, hsl(var(--navy-600)), hsl(var(--cta))); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
  .snapt-p { margin:12px 0 0; font-size:16px; line-height:1.6; color:hsl(var(--muted-foreground)); max-width:40em; }
  .snapt-logos { display:flex; flex-wrap:wrap; gap:8px 16px; margin:16px 0 0; padding:0; list-style:none; }
  .snapt-logos li { display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:600; color:hsl(var(--foreground)); }
  .snapt-act { display:flex; flex-direction:column; align-items:center; gap:8px; }
  .snapt-go { display:inline-flex; align-items:center; gap:10px; padding:15px 26px; border-radius:var(--btn-radius, 14px); font-size:16px; font-weight:700;
    color:#fff; background:hsl(var(--cta-strong)); text-decoration:none; white-space:nowrap; transition:filter .2s, transform .2s; }
  .snapt-go:hover { filter:brightness(1.08); transform:translateY(-1px); }
  .snapt-m { margin:0; font-size:12.5px; color:hsl(var(--muted-foreground)); }
  @media (max-width:800px) { .snapt { grid-template-columns:1fr; padding:24px 20px; gap:20px; } .snapt-act { align-items:flex-start; } }
</style>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-snapt-go]').forEach((a) => a.addEventListener('click', () => {
    try { ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'snapshot_teaser_click', source: a.closest<HTMLElement>('[data-snapt]')?.dataset.source }); } catch (_) {}
  }));
</script>
