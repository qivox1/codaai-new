---
import { t } from '../i18n/utils';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Studien-Teaser: nur auf DE-Seiten, nicht auf /studie selbst (kein Link auf sich selbst)
// und nicht auf /webinar (Conversion-Seite ohne Exit-Pfade)
const cleanPath = Astro.url.pathname.replace(/\/$/, '');
const isStudiePage = cleanPath.endsWith('/studie');
const isWebinarPage = cleanPath.endsWith('/webinar');
const showStudyTeaser = lang === 'de' && !isStudiePage && !isWebinarPage;

// Tabler Icons as inline SVG (stroke-only, 1.5 strokeWidth)
const complianceBadges = [
  {
    label: "GDPR / DSGVO",
    svg: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11.46 20.846a12 12 0 0 1 -7.46 -10.846v-4l8 -3l8 3v4a12 12 0 0 1 -7.46 10.846"/><path d="M9 12l2 2l4 -4"/>`,
  },
  {
    label: lang === 'de' ? "In Deutschland gehostet" : "Hosted in Germany",
    svg: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><rect x="3" y="4" width="18" height="8" rx="3"/><rect x="3" y="12" width="18" height="8" rx="3"/><line x1="7" y1="8" x2="7.01" y2="8"/><line x1="7" y1="16" x2="7.01" y2="16"/>`,
  },
  {
    label: "EU AI Act",
    svg: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 20l10 0"/><path d="M6 6l6 -1l6 1"/><path d="M12 5l0 15"/><path d="M9 11l-3 -6l-3 6a3 3 0 0 0 6 0"/><path d="M21 11l-3 -6l-3 6a3 3 0 0 0 6 0"/>`,
  },
];

// EN version uses /en/ sub-paths for all legal pages
const langPrefix = lang === 'en' ? `${base}/en` : `${base}`;
const footerLinks = lang === 'en'
  ? [
      { label: t(lang, "footer.mission"), href: `${base}/en/co-create/` },
      { label: t(lang, "footer.legalNotice"), href: `${base}/en/legal-notice/` },
      { label: t(lang, "footer.privacyPolicy"), href: `${base}/en/privacy-policy/` },
      { label: t(lang, "footer.termsConditions"), href: `${base}/en/terms/` },
    ]
  : [
      { label: t(lang, "footer.mission"), href: `${base}/co-create/` },
      { label: t(lang, "footer.legalNotice"), href: `${base}/impressum/` },
      { label: t(lang, "footer.privacyPolicy"), href: `${base}/datenschutz/` },
      { label: t(lang, "footer.termsConditions"), href: `${base}/agb/` },
    ];

const currentYear = new Date().getFullYear();
---

{/* Footer auf Abyss (Navy-900), umgestellt 04.08.2026 — Beschluss F10.
    Vorher bg-background, also weiß. Nach F4 läuft die Seite auf eine magenta
    Zusagefläche zu; ein weißer Footer danach franst die Komposition aus.
    Abyss ist die tiefste Fläche und bleibt DEM FOOTER vorbehalten: mitten auf
    einer Seite liest man sie als Schwarz, am Ende setzt sie den Abschluss.
    Sie ist außerdem die einzige Fläche, auf der der radiale Magenta-Glow
    erlaubt ist.
    Alle Texte hängen an den on-dark-Rollen, nicht an der Navy-Skala. */}
<footer class="relative overflow-hidden bg-surface-abyss">
  {/* Der eine erlaubte Glow. Rein dekorativ, kein Kontrastträger. */}
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-96 w-[52rem] -translate-x-1/2"
    style="background: radial-gradient(ellipse, hsl(var(--cta) / 0.16) 0%, transparent 62%);"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-6 py-8 lg:px-8 lg:py-12">

    {showStudyTeaser && (
      <a
        href={`${base}/studie/`}
        class="group mb-10 flex flex-col items-center gap-5 rounded-3xl bg-surface-ink p-6 text-ondark transition-shadow hover:shadow-lg sm:flex-row sm:gap-7 sm:px-8"
      >
        <img
          src={`${base}/images/studie-teaser-de.webp`}
          alt="Titelseite der Studie „KI-Blindtest Mittelstand 2026“"
          width="138"
          height="180"
          loading="lazy"
          decoding="async"
          class="h-24 w-auto flex-none"
        />
        <span class="min-w-0 flex-1 text-center sm:text-left">
          <span class="block text-xs font-semibold uppercase tracking-widest text-ondark-muted">KI-Blindtest Mittelstand 2026</span>
          <span class="mt-1 block text-lg font-semibold tracking-tight sm:text-xl">Empfohlen oder <span class="text-cta-on-dark">unsichtbar</span>?</span>
          {/* Vorher opacity-70 — auf dunkler Fläche kippt der Kontrast dabei
              unbemerkt, weil die Deckkraft der Vorfahren nicht in der Farbe
              steht. Jetzt explizit Navy-200: 10,0:1 auf Ink. */}
          <span class="mt-1 block text-sm text-ondark-muted">449 Unternehmen · 3.592 Einkäuferfragen · 7.184 KI-Antworten. Die bislang umfangreichste Auswertung zur KI-Sichtbarkeit des deutschen Mittelstands.</span>
        </span>
        <span class="inline-flex flex-none items-center gap-2 rounded-[14px] bg-cta px-6 py-3 text-sm font-semibold text-white transition-opacity group-hover:opacity-90">
          Zur Studie →
        </span>
      </a>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <div>
        <a href={`${base}/`} class="flex items-center gap-2" aria-label="CodaAI – zur Startseite">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#DF41FB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="text-xl font-semibold text-ondark">CodaAI</span>
        </a>
        {/* Marken-Claim, seit 03.08.2026 „AI + HI. Amplified." — der alte
            Claim „Exzellenter Content. mehr Wert." stammte aus der Zeit als
            Content-Agentur und beschrieb ein Geschaeftsmodell, das nicht mehr
            der Schwerpunkt ist. Der Claim verlinkt bewusst auf /co-create:
            „AI + HI" erklaert sich nicht von selbst, dort steht die Herleitung.
            Die erklaerende Zeile darunter macht ihn auch ohne Klick lesbar. */}
        <div class="mt-3">
          <a
            href={lang === 'de' ? `${base}/co-create/` : `${base}/en/co-create/`}
            class="group inline-block"
            aria-label={t(lang, "footer.taglineLinkLabel")}
          >
            <p class="text-base font-semibold text-ondark transition-colors group-hover:text-cta-on-dark">
              {t(lang, "footer.tagline1")}
            </p>
            <p class="text-base font-semibold text-cta">
              {t(lang, "footer.tagline2")}
            </p>
          </a>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-ondark-muted">
            {t(lang, "footer.taglineNote")}
          </p>
        </div>
      </div>

      <div class="flex flex-col items-start">
        <p class="text-sm text-ondark-muted mb-3">
          {t(lang, "footer.compliance")}
        </p>
        {/* Compliance-Icons in Verdigris statt Magenta (F7/F10): DSGVO,
            Hosting-Standort und AI Act sind BESTÄTIGUNGEN, keine Handlungen.
            In Magenta sagten sie visuell dasselbe wie der CTA daneben.
            currentColor statt Hex — die Farbe kommt aus der Rolle. */}
        <div class="flex items-end gap-8 md:gap-10">
          {complianceBadges.map((badge) => (
            <div key={badge.label} class="flex flex-col items-center gap-1.5 text-confirm-on-dark">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={badge.svg}
              />
              <span class="text-xs text-ondark-muted text-center whitespace-nowrap">{badge.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="text-left md:text-right">
        <h3 class="text-sm font-semibold text-ondark">{t(lang, "footer.legal")}</h3>
        <ul class="mt-3 space-y-2">
          {footerLinks.map((link) => (
            <li key={link.label}>
              <a href={link.href} class="text-sm text-ondark-muted hover:text-ondark transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t border-ondark-line pt-6">
      <p class="text-xs text-ondark-muted mb-5">
        {t(lang, "footer.vatNote")}
      </p>
      <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
        <p class="text-sm text-ondark-muted">
          © {currentYear} CodaAI. {t(lang, "footer.allRightsReserved")}
        </p>
        <p class="text-sm text-ondark-muted">
          Made with <span class="text-cta" aria-hidden="true">♡</span> in Germany
        </p>
      </div>
    </div>
  </div>
</footer>
