---
import { t } from '../i18n/utils';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const complianceBadges = [
  { label: "GDPR / DSGVO", icon: "🛡️" },
  { label: lang === 'de' ? "In Deutschland gehostet" : "Hosted in Germany", icon: "🖥️" },
  { label: "EU AI Act", icon: "⚖️" },
];

// EN version uses /en/ sub-paths for all legal pages
const langPrefix = lang === 'en' ? `${base}/en` : `${base}`;
const footerLinks = [
  { label: t(lang, "footer.legalNotice"), href: `${langPrefix}/impressum` },
  { label: t(lang, "footer.privacyPolicy"), href: `${langPrefix}/datenschutz` },
  { label: t(lang, "footer.termsConditions"), href: `${langPrefix}/agb` },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-background">
  <div class="mx-auto max-w-7xl px-6 py-8 lg:px-8 lg:py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <div>
        <a href={`${base}/`} class="flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#DF41FB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="text-xl font-semibold text-foreground">CodaAI</span>
        </a>
        <div class="mt-3 text-sm text-muted-foreground">
          <p>{t(lang, "footer.tagline1")}</p>
          <p class="text-[#DF41FB]">{t(lang, "footer.tagline2")}</p>
        </div>
      </div>

      <div class="flex flex-col items-start">
        <p class="text-sm text-muted-foreground/70 mb-3">
          {t(lang, "footer.compliance")}
        </p>
        <div class="flex items-end gap-8 md:gap-10">
          {complianceBadges.map((badge) => (
            <div key={badge.label} class="flex flex-col items-center gap-1.5">
              <span class="text-2xl">{badge.icon}</span>
              <span class="text-xs text-muted-foreground/70 text-center whitespace-nowrap">{badge.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="text-left md:text-right">
        <h3 class="text-sm font-semibold text-foreground">{t(lang, "footer.legal")}</h3>
        <ul class="mt-3 space-y-2">
          {footerLinks.map((link) => (
            <li key={link.label}>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-border pt-6 md:flex-row">
      <p class="text-sm text-muted-foreground">
        © {currentYear} CodaAI. {t(lang, "footer.allRightsReserved")}
      </p>
      <p class="text-sm text-muted-foreground">
        Made with <span class="text-[#DF41FB] text-base">♡</span> in Germany
      </p>
    </div>
  </div>
</footer>
