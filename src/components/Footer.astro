---
import { t } from '../i18n/utils';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* Studien-Teaser: nicht auf der Studienseite selbst (kein Link auf sich selbst)
   und nicht auf der Webinarseite (Conversion-Seite ohne Exit-Pfade).

   04.08.2026 (EN-Relaunch): Die Sperre `lang === 'de'` ist weg. Sie war richtig,
   solange die Studie nur auf Deutsch existierte — ein Teaser hätte den
   englischen Leser auf eine deutsche Seite geschickt. Seit es /en/study/ gibt,
   läuft der Teaser in beiden Sprachen und zeigt auf die jeweils passende URL. */
const cleanPath = Astro.url.pathname.replace(/\/$/, '');
const isStudiePage = cleanPath.endsWith('/studie') || cleanPath.endsWith('/study');
const isWebinarPage = cleanPath.endsWith('/webinar');

/* 10.08.2026 — Zweiter Ausgang: Webinar.
   Anlass: /webinar hatte genau EINEN eingehenden Link und steht nicht in der
   Navigation (Befund aus dem Wochen-Report KW 33). Der Teaser liegt sitewide im
   Footer und ist damit der billigste Weg, von jeder Unterseite dorthin zu kommen.

   Die Karte war bis heute EIN grosser <a> um den gesamten Inhalt. Zwei Buttons
   darin waeren verschachtelte Links — im HTML nicht erlaubt und fuer
   Screenreader unbrauchbar. Deshalb ist der Container jetzt ein <div>, und die
   beiden Ziele sind eigene Links.

   Rangfolge (Beschluss Oli, 10.08.2026): Webinar fuehrt (magenta), Studie folgt
   als Outline. Zwei gleich starke Flaechen heben sich gegenseitig auf — der
   Design Guide erlaubt zwei Signale je Screen, und Magenta gehoert der Handlung.

   Der Teaser laeuft jetzt AUCH auf /studie: dort ist der Leser warm, und der
   Studien-Knopf faellt ohnehin weg (kein Link auf sich selbst). Auf /webinar
   bleibt er aus — Conversion-Seite ohne Exit-Pfade. */
const showTeaser = !isWebinarPage;
const showStudyBtn = !isStudiePage;

/* ⚠️ Der Webinar-Knopf verschwindet nach dem Termin von selbst. Ohne diese
   Grenze wuerde der Footer sitewide ein vergangenes Datum bewerben — schlimmer
   als gar kein Link. Naechster Termin: Datum hier hochsetzen. */
const WEBINAR_DATE = new Date('2026-09-08T12:00:00+02:00');
const showWebinarBtn = new Date() <= WEBINAR_DATE;

const studyHref = lang === 'de' ? `${base}/studie/` : `${base}/en/study/`;
const webinarHref = lang === 'de' ? `${base}/webinar/` : `${base}/en/webinar/`;
const studyCopy = lang === 'de'
  ? {
      mapAlt: 'Punktkarte Deutschlands — 449 untersuchte Unternehmen aus 258 Branchen',
      kicker: 'KI-Blindtest Mittelstand 2026',
      titleA: 'Empfohlen oder ',
      titleB: 'unsichtbar',
      note: '449 Unternehmen · 3.592 Einkäuferfragen · 7.184 KI-Antworten. Die bislang umfangreichste Auswertung zur KI-Sichtbarkeit des deutschen Mittelstands.',
      cta: 'Zur Studie →',
      ctaWebinar: 'Zum Webinar am 8. September →',
    }
  : {
      mapAlt: 'Dot map of Germany — 449 companies examined across 258 industries',
      kicker: 'AI Blind Test 2026',
      titleA: 'Recommended or ',
      titleB: 'invisible',
      note: '449 companies · 3,592 buyer questions · 7,184 AI answers. The most extensive analysis to date of AI visibility among mid-sized companies in Germany.',
      cta: 'Read the study →',
      ctaWebinar: 'Webinar, 8 September →',
    };

// Tabler Icons as inline SVG (stroke-only, 1.5 strokeWidth)
const complianceBadges = [
  {
    label: "GDPR / DSGVO",
    svg: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M11.46 20.846a12 12 0 0 1 -7.46 -10.846v-4l8 -3l8 3v4a12 12 0 0 1 -7.46 10.846"/><path d="M9 12l2 2l4 -4"/>`,
  },
  {
    label: lang === 'de' ? "In Deutschland gehostet" : "Hosted in Germany",
    svg: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><rect x="3" y="4" width="18" height="8" rx="3"/><rect x="3" y="12" width="18" height="8" rx="3"/><line x1="7" y1="8" x2="7.01" y2="8"/><line x1="7" y1="16" x2="7.01" y2="16"/>`,
  },
  {
    label: "EU AI Act",
    svg: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 20l10 0"/><path d="M6 6l6 -1l6 1"/><path d="M12 5l0 15"/><path d="M9 11l-3 -6l-3 6a3 3 0 0 0 6 0"/><path d="M21 11l-3 -6l-3 6a3 3 0 0 0 6 0"/>`,
  },
];

// EN version uses /en/ sub-paths for all legal pages
const langPrefix = lang === 'en' ? `${base}/en` : `${base}`;
const footerLinks = lang === 'en'
  ? [
      { label: t(lang, "footer.mission"), href: `${base}/en/co-create/` },
      { label: 'GEO Glossary', href: `${base}/en/knowledge/geo-glossary/` },
      { label: t(lang, "footer.legalNotice"), href: `${base}/en/legal-notice/` },
      { label: t(lang, "footer.privacyPolicy"), href: `${base}/en/privacy-policy/` },
      { label: t(lang, "footer.termsConditions"), href: `${base}/en/terms/` },
    ]
  : [
      { label: t(lang, "footer.mission"), href: `${base}/co-create/` },
      // 03.09.2026: GEO-Glossar. Der Footer ist der einzige sitewide Einstieg —
      // die Hauptnavigation bleibt bei vier Punkten (Beschluss 28.07.2026).
      // EN-Gegenstueck /en/knowledge/geo-glossary/ in der Liste oben.
      { label: 'GEO-Glossar', href: `${base}/wissen/geo-glossar/` },
      { label: t(lang, "footer.legalNotice"), href: `${base}/impressum/` },
      { label: t(lang, "footer.privacyPolicy"), href: `${base}/datenschutz/` },
      { label: t(lang, "footer.termsConditions"), href: `${base}/agb/` },
    ];

const currentYear = new Date().getFullYear();
---

{/* Footer auf Abyss (Navy-900), umgestellt 04.08.2026 — Beschluss F10.
    Vorher bg-background, also weiß. Nach F4 läuft die Seite auf eine magenta
    Zusagefläche zu; ein weißer Footer danach franst die Komposition aus.

    Statt Fläche + radialem Glow ein VERTIKALER VERLAUF von Navy-800 oben nach
    Abyss unten (Fassung 2, 04.08.2026): der Glow wirkte aufgesetzt, der Verlauf
    setzt die Abwärtsbewegung der Seite fort und endet auf der tiefsten Stufe.
    Abyss bleibt dem Footer vorbehalten — mitten auf einer Seite liest man sie
    als Schwarz, am Ende setzt sie den Abschluss.
    Alle Texte hängen an den on-dark-Rollen, nicht an der Navy-Skala. */}
<footer
  class="relative overflow-hidden"
  style="background: linear-gradient(180deg, hsl(var(--navy-800)) 0%, hsl(var(--surface-abyss)) 58%, hsl(var(--surface-abyss)) 100%);"
>
  <div class="relative mx-auto max-w-7xl px-6 py-8 lg:px-8 lg:py-12">

    {showTeaser && (
      <div
        class="mb-10 flex flex-col items-center gap-5 rounded-3xl border border-ondark-line p-6 text-ondark sm:flex-row sm:gap-7 sm:px-8"
        style="background: linear-gradient(135deg, hsl(var(--navy-600)) 0%, hsl(var(--surface-ink)) 62%, hsl(var(--navy-800)) 100%);"
      >
        {/* Punktkarte Deutschlands — seit 04.08.2026 in Code gezeichnet.

            Vorher lag hier `studie-teaser-de.webp`: eine Rasterkarte auf
            SCHWARZEM Grund, mit magenta GLUEHENDEN Punkten und einem Oliv-Stich
            im Sueden. Auf dem Footer-Verlauf zeichnete sich dadurch ein
            sichtbares schwarzes Rechteck ab (Befund F8).

            Der Design Guide fuehrt den Studien-Teaser als Motivtyp 2 (Diagramm)
            und schreibt dafuer „Code, nie eine Datei" vor — scharf in jeder
            Groesse, fuer Screenreader lesbar. Ausserdem sind Verlaeufe, Schein
            und Leuchten in Magenta im Bild ausgeschlossen; die alten
            Leuchtpunkte verstiessen doppelt dagegen.

            Die Karte ist deshalb bewusst STUMM: kein Magenta. In diesem Block
            traegt das Wort „unsichtbar" das Signal und der Knopf die Handlung —
            das Budget von zwei Signalen je Screen ist damit voll.

            `currentColor` erbt die Textfarbe, `<use>` haelt die Groesse klein
            (810 B gzip). Erzeugt von `en-relaunch-2026-08-04/studien-karte/build_map.py`. */}
        <svg
          viewBox="0 0 138 180"
          fill="currentColor"
          role="img"
          aria-label={studyCopy.mapAlt}
          class="h-24 w-auto flex-none text-ondark-muted"
        ><defs><circle id="d" r="2.35"/></defs><use href="#d" x="38" y="166"/><use href="#d" x="64" y="166"/><use href="#d" x="73" y="166"/><use href="#d" x="81" y="166"/><use href="#d" x="90" y="166"/><use href="#d" x="34" y="159"/><use href="#d" x="43" y="159"/><use href="#d" x="51" y="159"/><use href="#d" x="60" y="159"/><use href="#d" x="68" y="159"/><use href="#d" x="77" y="159"/><use href="#d" x="86" y="159"/><use href="#d" x="94" y="159"/><use href="#d" x="103" y="159"/><use href="#d" x="38" y="151"/><use href="#d" x="47" y="151"/><use href="#d" x="56" y="151"/><use href="#d" x="64" y="151"/><use href="#d" x="73" y="151"/><use href="#d" x="81" y="151"/><use href="#d" x="90" y="151"/><use href="#d" x="98" y="151"/><use href="#d" x="43" y="144"/><use href="#d" x="51" y="144"/><use href="#d" x="60" y="144"/><use href="#d" x="68" y="144"/><use href="#d" x="77" y="144"/><use href="#d" x="86" y="144"/><use href="#d" x="94" y="144"/><use href="#d" x="103" y="144"/><use href="#d" x="111" y="144"/><use href="#d" x="38" y="136"/><use href="#d" x="47" y="136"/><use href="#d" x="56" y="136"/><use href="#d" x="64" y="136"/><use href="#d" x="73" y="136"/><use href="#d" x="81" y="136"/><use href="#d" x="90" y="136"/><use href="#d" x="98" y="136"/><use href="#d" x="107" y="136"/><use href="#d" x="17" y="129"/><use href="#d" x="25" y="129"/><use href="#d" x="34" y="129"/><use href="#d" x="43" y="129"/><use href="#d" x="51" y="129"/><use href="#d" x="60" y="129"/><use href="#d" x="68" y="129"/><use href="#d" x="77" y="129"/><use href="#d" x="86" y="129"/><use href="#d" x="94" y="129"/><use href="#d" x="103" y="129"/><use href="#d" x="21" y="121"/><use href="#d" x="30" y="121"/><use href="#d" x="38" y="121"/><use href="#d" x="47" y="121"/><use href="#d" x="56" y="121"/><use href="#d" x="64" y="121"/><use href="#d" x="73" y="121"/><use href="#d" x="81" y="121"/><use href="#d" x="90" y="121"/><use href="#d" x="17" y="114"/><use href="#d" x="25" y="114"/><use href="#d" x="34" y="114"/><use href="#d" x="43" y="114"/><use href="#d" x="51" y="114"/><use href="#d" x="60" y="114"/><use href="#d" x="68" y="114"/><use href="#d" x="77" y="114"/><use href="#d" x="86" y="114"/><use href="#d" x="94" y="114"/><use href="#d" x="21" y="106"/><use href="#d" x="30" y="106"/><use href="#d" x="38" y="106"/><use href="#d" x="47" y="106"/><use href="#d" x="56" y="106"/><use href="#d" x="64" y="106"/><use href="#d" x="73" y="106"/><use href="#d" x="81" y="106"/><use href="#d" x="90" y="106"/><use href="#d" x="17" y="98"/><use href="#d" x="25" y="98"/><use href="#d" x="34" y="98"/><use href="#d" x="43" y="98"/><use href="#d" x="51" y="98"/><use href="#d" x="60" y="98"/><use href="#d" x="68" y="98"/><use href="#d" x="77" y="98"/><use href="#d" x="86" y="98"/><use href="#d" x="94" y="98"/><use href="#d" x="103" y="98"/><use href="#d" x="111" y="98"/><use href="#d" x="12" y="91"/><use href="#d" x="21" y="91"/><use href="#d" x="30" y="91"/><use href="#d" x="38" y="91"/><use href="#d" x="47" y="91"/><use href="#d" x="56" y="91"/><use href="#d" x="64" y="91"/><use href="#d" x="73" y="91"/><use href="#d" x="81" y="91"/><use href="#d" x="90" y="91"/><use href="#d" x="98" y="91"/><use href="#d" x="107" y="91"/><use href="#d" x="116" y="91"/><use href="#d" x="124" y="91"/><use href="#d" x="17" y="83"/><use href="#d" x="25" y="83"/><use href="#d" x="34" y="83"/><use href="#d" x="43" y="83"/><use href="#d" x="51" y="83"/><use href="#d" x="60" y="83"/><use href="#d" x="68" y="83"/><use href="#d" x="77" y="83"/><use href="#d" x="86" y="83"/><use href="#d" x="94" y="83"/><use href="#d" x="103" y="83"/><use href="#d" x="111" y="83"/><use href="#d" x="120" y="83"/><use href="#d" x="12" y="76"/><use href="#d" x="21" y="76"/><use href="#d" x="30" y="76"/><use href="#d" x="38" y="76"/><use href="#d" x="47" y="76"/><use href="#d" x="56" y="76"/><use href="#d" x="64" y="76"/><use href="#d" x="73" y="76"/><use href="#d" x="81" y="76"/><use href="#d" x="90" y="76"/><use href="#d" x="98" y="76"/><use href="#d" x="107" y="76"/><use href="#d" x="116" y="76"/><use href="#d" x="124" y="76"/><use href="#d" x="17" y="68"/><use href="#d" x="25" y="68"/><use href="#d" x="34" y="68"/><use href="#d" x="43" y="68"/><use href="#d" x="51" y="68"/><use href="#d" x="60" y="68"/><use href="#d" x="68" y="68"/><use href="#d" x="77" y="68"/><use href="#d" x="86" y="68"/><use href="#d" x="94" y="68"/><use href="#d" x="103" y="68"/><use href="#d" x="111" y="68"/><use href="#d" x="120" y="68"/><use href="#d" x="21" y="60"/><use href="#d" x="30" y="60"/><use href="#d" x="38" y="60"/><use href="#d" x="47" y="60"/><use href="#d" x="56" y="60"/><use href="#d" x="64" y="60"/><use href="#d" x="73" y="60"/><use href="#d" x="81" y="60"/><use href="#d" x="90" y="60"/><use href="#d" x="98" y="60"/><use href="#d" x="107" y="60"/><use href="#d" x="116" y="60"/><use href="#d" x="124" y="60"/><use href="#d" x="25" y="53"/><use href="#d" x="34" y="53"/><use href="#d" x="43" y="53"/><use href="#d" x="51" y="53"/><use href="#d" x="60" y="53"/><use href="#d" x="68" y="53"/><use href="#d" x="77" y="53"/><use href="#d" x="86" y="53"/><use href="#d" x="94" y="53"/><use href="#d" x="103" y="53"/><use href="#d" x="111" y="53"/><use href="#d" x="120" y="53"/><use href="#d" x="30" y="45"/><use href="#d" x="38" y="45"/><use href="#d" x="47" y="45"/><use href="#d" x="56" y="45"/><use href="#d" x="64" y="45"/><use href="#d" x="73" y="45"/><use href="#d" x="81" y="45"/><use href="#d" x="90" y="45"/><use href="#d" x="98" y="45"/><use href="#d" x="107" y="45"/><use href="#d" x="116" y="45"/><use href="#d" x="124" y="45"/><use href="#d" x="25" y="38"/><use href="#d" x="34" y="38"/><use href="#d" x="43" y="38"/><use href="#d" x="51" y="38"/><use href="#d" x="60" y="38"/><use href="#d" x="68" y="38"/><use href="#d" x="77" y="38"/><use href="#d" x="86" y="38"/><use href="#d" x="94" y="38"/><use href="#d" x="103" y="38"/><use href="#d" x="111" y="38"/><use href="#d" x="47" y="30"/><use href="#d" x="56" y="30"/><use href="#d" x="64" y="30"/><use href="#d" x="73" y="30"/><use href="#d" x="81" y="30"/><use href="#d" x="90" y="30"/><use href="#d" x="98" y="30"/><use href="#d" x="107" y="30"/><use href="#d" x="116" y="30"/><use href="#d" x="43" y="23"/><use href="#d" x="51" y="23"/><use href="#d" x="60" y="23"/><use href="#d" x="68" y="23"/><use href="#d" x="77" y="23"/><use href="#d" x="86" y="23"/><use href="#d" x="94" y="23"/><use href="#d" x="103" y="23"/><use href="#d" x="47" y="15"/><use href="#d" x="56" y="15"/><use href="#d" x="64" y="15"/><use href="#d" x="51" y="8"/></svg>
        <span class="min-w-0 flex-1 text-center sm:text-left">
          <span class="block text-xs font-semibold uppercase tracking-widest text-ondark-muted">{studyCopy.kicker}</span>
          <span class="mt-1 block text-lg font-semibold tracking-tight sm:text-xl">{studyCopy.titleA}<span class="text-cta-on-dark">{studyCopy.titleB}</span>?</span>
          {/* Vorher opacity-70 — auf dunkler Fläche kippt der Kontrast dabei
              unbemerkt, weil die Deckkraft der Vorfahren nicht in der Farbe
              steht. Jetzt explizit Navy-200: 10,0:1 auf Ink. */}
          <span class="mt-1 block text-sm text-ondark-muted">{studyCopy.note}</span>
        </span>
        {/* Buttons: mobil untereinander und volle Breite, ab sm nebeneinander.
            `flex-none` verhindert, dass die Spalte den Text zusammendrueckt.
            Primaer = bg-cta-strong (#C405E6): Weiss haelt dort 4,65:1, auf dem
            helleren #DF41FB waeren es nur 3,34:1 und damit unter AA.
            Sekundaer = Outline auf der bestehenden ondark-Linie, Hover legt
            eine 10-%-Weissflaeche darunter (Flaeche abtoenen, nie den Text). */}
        <span class="flex w-full flex-none flex-col gap-3 sm:w-auto sm:flex-row sm:items-center">
          {showWebinarBtn && (
            <a
              href={webinarHref}
              class="inline-flex items-center justify-center gap-2 rounded-[14px] bg-cta-strong px-6 py-3 text-center text-sm font-semibold text-white transition-opacity hover:opacity-90"
            >
              {studyCopy.ctaWebinar}
            </a>
          )}
          {showStudyBtn && (
            <a
              href={studyHref}
              class="inline-flex items-center justify-center gap-2 rounded-[14px] border border-ondark-line px-6 py-3 text-center text-sm font-semibold text-ondark transition-colors hover:bg-white/10"
            >
              {studyCopy.cta}
            </a>
          )}
        </span>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <div>
        <a
          href={lang === 'de' ? `${base}/` : `${base}/en/`}
          class="flex items-center gap-2"
          aria-label={lang === 'de' ? 'CodaAI – zur Startseite' : 'CodaAI – to the homepage'}
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#DF41FB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="text-xl font-semibold text-ondark">CodaAI</span>
        </a>
        {/* Marken-Claim, seit 03.08.2026 „AI + HI. Amplified." — der alte
            Claim „Exzellenter Content. mehr Wert." stammte aus der Zeit als
            Content-Agentur und beschrieb ein Geschaeftsmodell, das nicht mehr
            der Schwerpunkt ist. Der Claim verlinkt bewusst auf /co-create:
            „AI + HI" erklaert sich nicht von selbst, dort steht die Herleitung.
            Die erklaerende Zeile darunter macht ihn auch ohne Klick lesbar. */}
        <div class="mt-3">
          {/* Kein aria-label am Link (04.08.2026): Ein Label, das den sichtbaren
              Text ersetzt, verstoesst gegen WCAG 2.5.3 — Sprachsteuerung kennt
              dann nur „Das CoCreate-Prinzip", waehrend der Nutzer „AI + HI.
              Amplified." vorliest. Weil der Footer sitewide steht, zaehlte das
              47 Mal als Fehler. Der Zusatz haengt jetzt als sr-only HINTER dem
              sichtbaren Text, der zugaengliche Name enthaelt ihn damit. Gleiche
              Loesung wie beim Studien-Teaser am 03.08.2026. */}
          <a
            href={lang === 'de' ? `${base}/co-create/` : `${base}/en/co-create/`}
            class="group inline-block"
          >
            {/* Eine Zeile, zwei Gewichte (Beschluss Oli 04.08.2026): „AI + HI."
                traegt den Satz normal, „Amplified." setzt die Pointe — fett und
                magenta. Vorher standen beide fett und untereinander, dadurch
                betonte die Zeile zweimal und die Steigerung ging verloren. */}
            <p class="text-base text-ondark transition-colors group-hover:text-cta-on-dark">
              <span class="font-normal">{t(lang, "footer.tagline1")}</span>{' '}
              <span class="font-bold text-cta">{t(lang, "footer.tagline2")}</span>
              <span class="sr-only"> — {t(lang, "footer.taglineLinkLabel")}</span>
            </p>
          </a>
          {/* Zwei gesetzte Zeilen: Leistung und Lenkung stehen einander gegenueber,
              der Umbruch faellt deshalb nie mitten in eine der beiden Haelften. */}
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-ondark-muted">
            <span class="block">{t(lang, "footer.taglineNote1")}</span>
            <span class="block">{t(lang, "footer.taglineNote2")}</span>
          </p>
        </div>
      </div>

      <div class="flex flex-col items-start">
        <p class="text-sm text-ondark-muted mb-3">
          {t(lang, "footer.compliance")}
        </p>
        {/* Compliance-Icons in Verdigris statt Magenta (F7/F10): DSGVO,
            Hosting-Standort und AI Act sind BESTÄTIGUNGEN, keine Handlungen.
            In Magenta sagten sie visuell dasselbe wie der CTA daneben.
            currentColor statt Hex — die Farbe kommt aus der Rolle. */}
        <div class="flex items-end gap-8 md:gap-10">
          {complianceBadges.map((badge) => (
            <div key={badge.label} class="flex flex-col items-center gap-1.5 text-confirm-on-dark">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={badge.svg}
              />
              <span class="text-xs text-ondark-muted text-center whitespace-nowrap">{badge.label}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="text-left md:text-right">
