---
import { t } from '../i18n/utils';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const home = lang === 'de' ? `${base}/` : `${base}/en/`;

/*
 * Hauptnavigation — Umpositionierung „Digital Visibility" (22.07.2026, Entscheidung Oli):
 *
 * Die DE-Startseite ist die neue Premium-Version (Sektionen #programm/#schauplaetze/#faq,
 * KEIN #features / #team mehr). Die EN-Startseite läuft noch das alte Content-Agentur-Design
 * (#features + #team existieren dort weiter). Deshalb sind DE- und EN-Nav BEWUSST getrennt:
 *
 *   DE (neu):  Leistungen · Preise · Blog · FAQ · Kontakt
 *              — „Wie es funktioniert" → „Digital Visibility" (interim) → seit 27.07.2026
 *                „Leistungen" (/leistungen/ — die 14 Bausteine)
 *              — „Team" entfernt (keine Team-Seite mehr auf der neuen Site)
 *   EN (alt):  unverändert, bis die EN-Premium-Welle kommt (sonst tote #features/#team-Links)
 *
 * ⚠️ Deploy-Kopplung: Der DE-Punkt „Leistungen" zeigt auf /leistungen/. Diese Navbar geht
 *    daher nur GEMEINSAM mit src/pages/leistungen.astro live (nicht vorher — sonst 404).
 * 📌 To-do (später): „Über uns" als DE-Nav-Punkt ergänzen, sobald eine Über-uns-/Team-Seite
 *    existiert. Bis dahin bewusst weggelassen.
 */
const navItemsDe = [
  // 27.07.2026 (Entscheidung Oli): „Digital Visibility" raus, „Leistungen" rein — die
  // Seite mit den 14 Bausteinen. /digital-visibility/ wird nicht mehr gebaut.
  { label: 'Leistungen', href: `${base}/leistungen/` },
  { label: 'Preise', href: `${base}/preise/` },
  { label: 'Blog', href: `${base}/blog/` },
  { label: t('de', "navbar.faq"), href: `${base}/faq/` },
  { label: 'Kontakt', href: `${base}/kontakt/` },
];

const navItemsEn = [
  { label: t('en', "navbar.how"), href: `${home}#features` },
  { label: t('en', "navbar.team"), href: `${home}#team` },
  { label: 'Pricing', href: `${base}/en/pricing/` },
  { label: 'Blog', href: `${base}/en/blog/` },
  { label: t('en', "navbar.faq"), href: `${home}#faq` },
  { label: 'Contact', href: `${base}/en/contact/` },
];

const navItems = lang === 'de' ? navItemsDe : navItemsEn;

// Language toggle: DE â /en/, EN â /
const langToggleHref = lang === 'de' ? `${base}/en/` : `${base}/`;
const langToggleLabel = lang === 'de' ? 'EN' : 'DE';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border/40">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <a href={home} class="flex items-center gap-2" aria-label={lang === 'de' ? 'CodaAI Homepage DE' : 'CodaAI Homepage EN'}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#DF41FB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="text-xl font-semibold text-foreground">CodaAI</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden lg:flex lg:items-center lg:gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-lg hover:bg-muted/50"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Desktop right side -->
    <div class="hidden lg:flex lg:items-center lg:gap-3">
      <a
        href={langToggleHref}
        class="relative flex h-8 items-center gap-1.5 px-2.5 rounded-full border border-border hover:border-primary/50 bg-muted/50 hover:bg-muted transition-all duration-200 group no-underline"
        aria-label={lang === 'de' ? 'Switch to English' : 'Zu Deutsch wechseln'}
        title={lang === 'de' ? 'Switch to English' : 'Zu Deutsch wechseln'}
      >
        <svg class="size-3.5 text-muted-foreground group-hover:text-primary transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <span class="text-[11px] font-semibold uppercase tracking-wider text-foreground w-5 text-center">
          {langToggleLabel}
        </span>
      </a>
    </div>

    <!-- Mobile menu button -->
    <div class="lg:hidden flex items-center gap-2">
      <button
        id="mobile-menu-btn"
        class="p-2 rounded-lg hover:bg-muted/50"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 12h18M3 6h18M3 18h18"/>
        </svg>
        <svg id="menu-icon-close" class="size-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu dropdown -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-border/40 bg-background/95 backdrop-blur-md"
  >
    <div class="mx-auto max-w-7xl px-6 py-4 flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-3 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-lg hover:bg-muted/50 mobile-nav-link"
        >
          {item.label}
        </a>
      ))}
      <div class="border-t border-border/40 mt-2 pt-3 flex items-center justify-between">
        <a
          href={langToggleHref}
          class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors rounded-lg hover:bg-muted/50 no-underline"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          {langToggleLabel}
        </a>
        </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close menu when clicking a nav link (for anchor links)
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
