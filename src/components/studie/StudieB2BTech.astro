<script define:vars={{ numLocale: de ? 'de-DE' : 'en-GB' }}>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var dl = function (name, params) { window.dataLayer = window.dataLayer || []; window.dataLayer.push(Object.assign({ event: name, study: 'b2b-tech' }, params || {})); };

    // Kennzahlen zählen nacheinander hoch (wie auf der Mittelstand-Studie)
    var counters = Array.prototype.slice.call(document.querySelectorAll('[data-count]'));
    var fmt = new Intl.NumberFormat(numLocale);
    if (!reduce && 'IntersectionObserver' in window && counters.length) {
      counters.forEach(function (el) { el.textContent = '0'; });
      var run = function (i) {
        if (i >= counters.length) return;
        var el = counters[i], target = Number(el.dataset.count || 0), t0 = performance.now(), dur = 1800;
        var tick = function (t) {
          var p = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt.format(Math.round(target * e));
          if (p < 1) requestAnimationFrame(tick); else setTimeout(function () { run(i + 1); }, 400);
        };
        requestAnimationFrame(tick);
      };
      var io = new IntersectionObserver(function (ents) { if (ents.some(function (e) { return e.isIntersecting; })) { io.disconnect(); run(0); } }, { threshold: 0.4 });
      io.observe(counters[0]);
    }

    // Balken laufen beim Einscrollen ein
    var bars = Array.prototype.slice.call(document.querySelectorAll('.tx-seg, .tx-q'));
    if (!reduce && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('tx-anim');
      var ioB = new IntersectionObserver(function (ents) {
        ents.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('tx-in'); ioB.unobserve(e.target); } });
      }, { threshold: 0.3 });
      bars.forEach(function (b) { ioB.observe(b); });
    }

    // Domain-Check (personalisiert per ?d=firma.de)
    var normalize = function (v) { return v.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0]; };
    var form = document.getElementById('domain-check-form');
    var input = document.getElementById('domain-input');
    var known = document.getElementById('domain-known');
    var knownName = document.getElementById('domain-known-name');
    var knownLink = document.getElementById('domain-known-link');
    var resp = document.getElementById('domain-response');
    var respName = document.getElementById('domain-response-name');
    var param = new URLSearchParams(location.search).get('d');
    if (param && known && input) {
      var d0 = normalize(param);
      if (/^[a-z0-9.-]+\.[a-z]{2,}$/.test(d0)) {
        input.value = d0; knownName.textContent = d0; knownLink.href = 'https://audit.codaai.ai/' + d0;
        known.classList.remove('hidden'); dl('study_personalized_view', { study_domain: d0 });
      }
    }
    if (form) form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var dom = normalize(input.value);
      if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(dom)) { input.focus(); input.setAttribute('aria-invalid', 'true'); return; }
      input.removeAttribute('aria-invalid');
      if (known) known.classList.add('hidden');
      respName.textContent = dom; resp.classList.remove('hidden');
      resp.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      dl('study_domain_check', { study_domain: dom });
    });

    // Zitat kopieren
    document.querySelectorAll('.cite-copy').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var el = document.getElementById(btn.dataset.copy || '');
        if (!navigator.clipboard) return;
        navigator.clipboard.writeText((el && el.textContent || '').trim()).then(function () {
          btn.textContent = btn.dataset.copied;
          setTimeout(function () { btn.textContent = btn.dataset.label; }, 2000);
          dl('study_cite_copy');
        }).catch(function () {});
      });
    });
  })();
</script>

<style>
  /* Zahlenkarten: ruhige Navy-50-Fläche, Bezugsgröße unten (wie /webinar) */
  .tx-card { background: hsl(var(--navy-50)); }
  .tx-base { border-top: 1px solid hsl(var(--navy-200)); }
  .tx-navy { background: hsl(var(--navy-700)); color: #fff; }
  .tx-light { background: hsl(var(--navy-200)); color: hsl(var(--navy-700)); }
  /* Segmentvergleich und Quellen: Balken; einziges Magenta = Systemhaus-Balken */
  .tx-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; }
  .tx-q { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; }
  .tx-track { position: relative; height: 14px; border-radius: 7px; background: hsl(var(--navy-50)); overflow: hidden; }
  .tx-bar { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: 7px; background: hsl(var(--navy-700)); }
  .tx-bar.tx-hot { background: hsl(var(--cta-strong)); }
  @media (min-width: 768px) {
    .tx-row { grid-template-columns: 380px minmax(0, 1fr) 230px; align-items: center; gap: 20px; }
    .tx-q { grid-template-columns: 300px minmax(0, 1fr) 110px; align-items: center; gap: 20px; }
  }
  :global(html.tx-anim) .tx-bar { width: 0; transition: width 1.1s cubic-bezier(.22, 1, .36, 1) .2s; }
  :global(html.tx-anim) .tx-in .tx-bar { width: var(--w); }
  /* Konzern / Mittelständler */
  .tx-key { display: inline-block; width: 14px; height: 14px; border-radius: 4px; margin-right: 8px; vertical-align: -2px; }
  .tx-stack-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; }
  .tx-stack { display: flex; height: 36px; border-radius: 10px; overflow: hidden; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .tx-stack span { display: flex; align-items: center; padding: 0 12px; white-space: nowrap; }
  .tx-stack span + span { justify-content: flex-end; }
  @media (min-width: 768px) { .tx-stack-row { grid-template-columns: 300px minmax(0, 1fr); align-items: center; gap: 20px; } }
</style>
