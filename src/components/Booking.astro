---
import BookingWidget from './react/BookingWidget';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;

/* Anker des Termin-Blocks. Bis 04.08.2026 trug die Sektion in beiden Sprachen
   `id="termin"`. Das war unauffällig, solange es kaum englische Seiten gab —
   mit dem EN-Relaunch verlinken sechs Seiten hierher, und ein deutscher Anker
   in einer englischen URL passt nicht zu einer Version, die sonst vollständig
   übersetzt ist. Wer die Sektion verlinkt, nimmt `#termin` bzw. `#appointment`;
   einen zusätzlichen Wrapper-<div> braucht es dafür nicht mehr. */
const sectionId = lang === 'de' ? 'termin' : 'appointment';

const copy = {
  de: {
    eyebrow: 'Kostenloses Erstgespräch',
    title: '30 Minuten Webmeeting oder Telefonat.',
    lead: 'In einem kurzen Gespräch zeigen wir Ihnen schwarz auf weiß, wo Ihr Unternehmen in ChatGPT, der Google KI-Übersicht und der klassischen Suche heute sichtbar ist — und wo stattdessen Ihr Wettbewerber empfohlen wird. Kein Verkaufsgespräch, sondern ein klarer Befund.',
    points: [
      'Ihr KI-Sichtbarkeits-Status — live in ChatGPT & Google KI-Übersicht gezeigt',
      'In welchen Einkäuferfragen Sie fehlen — und was Sie das an Anfragen kostet',
      'Direkt einen Slot wählen – kein Formular-Umweg',
    ],
  },
  /* 04.08.2026 (EN-Relaunch): Die englische Fassung sprach noch von
     „content production" und „cuts your marketing costs" — das war die
     Positionierung als Content-Agentur und stand im Widerspruch zur
     deutschen Seite daneben. Jetzt dieselbe Aussage wie im Deutschen:
     ein Befund, kein Verkaufsgespräch. */
  en: {
    eyebrow: 'Free intro call',
    title: '30 minutes — web meeting or phone.',
    lead: 'In a short call we show you in black and white where your company is visible today in ChatGPT, Google AI Overviews and classic search — and where your competitor is being recommended instead. Not a sales pitch. A clear finding.',
    points: [
      'Your AI visibility status — shown live in ChatGPT and Google AI Overviews',
      'Which buyer questions you are missing from — and what that costs you in enquiries',
      'Pick a slot directly — no form detour',
    ],
  },
}[lang];
---

<section id={sectionId} class="scroll-mt-24 py-24 lg:scroll-mt-28 lg:py-32 border-t border-border bg-muted/30">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cta-accessible">{copy.eyebrow}</p>
        <h2 class="cai-h2 text-foreground">{copy.title}</h2>
        <p class="mt-6 text-lg leading-relaxed text-muted-foreground">{copy.lead}</p>
        <ul class="mt-8 space-y-4">
          {copy.points.map((p) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-6 w-6 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 11 3 3L22 4" />
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
              </svg>
              <span class="text-foreground">{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <BookingWidget lang={lang} client:visible />
      </div>
    </div>
  </div>
</section>
