---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
  heroImage?: string;
  heroImageAlt?: string;
  slug: string;
  lang: 'de' | 'en';
  author: string;
  featured?: boolean;
  loading?: "lazy" | "eager";
}

const {
  title,
  description,
  pubDate,
  category,
  tags,
  heroImage,
  heroImageAlt,
  slug,
  lang,
  author,
  featured = false,
  loading = "lazy",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = lang === 'de' ? `${base}/blog/${slug}/` : `${base}/en/blog/${slug}/`;

const formattedDate = pubDate.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article
  class:list={[
    "group relative flex flex-col rounded-2xl border border-border bg-card overflow-hidden transition-shadow hover:shadow-lg hover:border-cta/30",
    featured && "md:col-span-2 md:flex-row",
  ]}
  aria-label={title}
>
  {heroImage && (
    <div class:list={["overflow-hidden bg-muted", featured ? "md:w-1/2 h-56 md:h-auto" : "h-48"]}>
      <img
        src={heroImage}
        alt={heroImageAlt ?? title}
        width={1584}
        height={672}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading={loading}
        fetchpriority={loading === "eager" ? "high" : "auto"}
        decoding="async"
      />
    </div>
  )}

  {!heroImage && (
    <div class:list={["flex items-center justify-center bg-gradient-to-br from-cta/10 to-cta/5", featured ? "md:w-1/2 h-56 md:h-auto" : "h-48"]}>
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#DF41FB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  )}

  <div class="flex flex-col flex-1 p-6">
    <div class="flex items-center gap-2 mb-3 flex-wrap">
      <span class="text-xs font-semibold uppercase tracking-widest text-cta-accessible">
        {category}
      </span>
    </div>

    <h2 class="text-lg font-semibold text-foreground leading-snug mb-3 group-hover:text-cta transition-colors">
      <a href={href} class="after:absolute after:inset-0">
        {title}
      </a>
    </h2>

    <p class="text-sm text-muted-foreground leading-relaxed flex-1 line-clamp-3">
      {description}
    </p>

    <div class="mt-4 pt-4 border-t border-border flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-2 text-xs text-muted-foreground">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{author}</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded-full bg-muted text-muted-foreground">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</article>
