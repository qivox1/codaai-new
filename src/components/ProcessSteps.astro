---
import { t, getTranslations } from '../i18n/utils';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const steps = translations.process.steps;
---

<section class="py-24 lg:py-32 bg-background overflow-visible min-h-[500px] md:min-h-[600px]">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-5xl mx-auto mb-16">
      <p class="text-sm font-medium text-primary uppercase tracking-wider mb-4">
        {t(lang, "process.badge")}
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-foreground tracking-tight">
        {t(lang, "process.title")}
      </h2>
      <p class="mt-6 text-lg text-muted-foreground">
        {t(lang, "process.subtitle")}
      </p>
    </div>

    {/* Desktop: Horizontal Timeline */}
    <div class="hidden lg:block">
      <div class="relative">
        <div class="absolute top-5 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-cta/40 via-cta/30 to-cta/40"></div>

        <div class="grid grid-cols-4 gap-6">
          {steps.map((step: any, index: number) => {
            const stepNum = index + 1;
            return (
              <div
                key={stepNum}
                class="flex flex-col items-center text-center group"
              >
                <div class="cursor-pointer flex flex-col items-center relative">
                  <div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cta text-cta-foreground font-bold text-lg shadow-lg shadow-cta/30 group-hover:scale-110 transition-transform">
                    {stepNum}
                  </div>
                  <h3 class="mt-3 text-base font-semibold text-foreground group-hover:text-cta transition-colors whitespace-nowrap">
                    {step.title}
                  </h3>

                  <div class="absolute top-full mt-4 left-1/2 -translate-x-1/2 z-20 opacity-0 group-hover:opacity-100 -translate-y-2 group-hover:translate-y-0 pointer-events-none group-hover:pointer-events-auto transition-all duration-200">
                    <div class="w-64 p-4 rounded-xl bg-card border border-cta/30">
                      <span class="inline-block text-xs font-medium px-2.5 py-1 rounded-full bg-cta/10 text-cta border border-cta/20 mb-3">
                        {step.duration}
                      </span>
                      <p class="text-sm text-muted-foreground leading-relaxed">
                        {step.description}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    {/* Mobile/Tablet: Vertical Layout */}
    <div class="lg:hidden">
      <div class="relative max-w-md mx-auto">
        <div class="absolute left-5 top-0 bottom-0 w-0.5 bg-gradient-to-b from-cta/30 via-cta/20 to-transparent"></div>

        <div class="space-y-6">
          {steps.map((step: any, index: number) => {
            const stepNum = index + 1;
            return (
              <div key={stepNum} class="relative">
                <div class="flex gap-4 items-center cursor-pointer">
                  <div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cta text-cta-foreground font-bold text-lg shadow-lg shadow-cta/30">
                    {stepNum}
                  </div>
                  <h3 class="text-lg font-semibold text-foreground">
                    {step.title}
                  </h3>
                </div>

                <div class="ml-14 pt-3 pb-2">
                  <span class="inline-block text-xs font-medium px-2.5 py-1 rounded-full bg-cta/10 text-cta border border-cta/20 mb-2">
                    {step.duration}
                  </span>
                  <p class="text-sm text-muted-foreground leading-relaxed">
                    {step.description}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
