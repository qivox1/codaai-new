---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import PremiumHome from '../components/premium/Home.astro';
import { getTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';
import Booking from '../components/Booking.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { faqAllgemein } from '../data/faq';

const language = 'de' as const;
const tr = getTranslations(language);

const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

// Neueste 3 DE-Artikel für die Homepage-Sektion
const allDePosts = await getCollection('blog', ({ data }) => data.lang === 'de' && !data.noindex);
const recentPosts = allDePosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// SoftwareApplication schema — enables App rich results in Google Search
const softwareSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CodaAI',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Digital Visibility Platform',
  operatingSystem: 'Web',
  url: `${SITE_URL}/`,
  description: 'Digital-Visibility-Programm für den B2B-Mittelstand: Sichtbarkeit in ChatGPT, Google KI-Übersicht und klassischer Suche – SEO, AEO und GEO plus KI-gestützte Content-Produktion.',
  inLanguage: ['de', 'en'],
  offers: {
    '@type': 'Offer',
    price: '1470',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '1470',
      priceCurrency: 'EUR',
      unitText: 'MONTH',
    },
  },
  featureList: [
    'Digital Visibility Audit',
    'KI-Sichtbarkeits-Monitoring mit Monatsreport',
    'SEO inklusive Bing-Optimierung',
    'Technische KI-Zugänglichkeit (GEO/AEO)',
    'SEO-optimierte Blogartikel bis 4.000 Wörter',
    'KI-generierte Grafiken und Videos',
    'Digital-PR und Markennennungen',
  ],
  screenshot: `${SITE_URL}/images/og-image.png`,
  provider: {
    '@id': `${SITE_URL}/#organization`,
  },
});

/* FAQPage-Schema fuer die allgemeinen Fragen. Es steht bewusst HIER und nicht
   zusaetzlich auf /faq: Jede Frage soll genau einmal ausgezeichnet im Index
   stehen, und zwar auf der Seite, auf der sie thematisch beantwortet wird
   (Beschluss Oli, 03.08.2026). Preis-, Visibility- und Webinarfragen tragen
   ihr Schema entsprechend auf /preise, /digital-visibility und /webinar. */
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqAllgemein.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

// Service schema — Digital-Visibility-Programm mit den drei buchbaren Stufen
const visibilityServiceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Digital-Visibility-Programm',
  serviceType: 'Digital Visibility (SEO, AEO, GEO)',
  provider: {
    '@id': `${SITE_URL}/#organization`,
  },
  areaServed: 'DE',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'B2B-Mittelstand',
  },
  description: 'Digital-Visibility-Programm für den B2B-Mittelstand: Sichtbarkeit in ChatGPT, Google KI-Übersicht und klassischer Suche – SEO, AEO und GEO plus KI-gestützte Content-Produktion. Drei Stufen: Basis, Aktiv, Dominanz.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Digital-Visibility-Stufen',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Stufe 1 · Gefunden',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '490',
          priceCurrency: 'EUR',
          unitText: 'MONTH',
        },
      },
      {
        '@type': 'Offer',
        name: 'Stufe 2 · Empfohlen',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '990',
          priceCurrency: 'EUR',
          unitText: 'MONTH',
        },
      },
      {
        '@type': 'Offer',
        name: 'Stufe 3 · Zitiert',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '1790',
          priceCurrency: 'EUR',
          unitText: 'MONTH',
        },
      },
    ],
  },
});

---

<Layout
  lang={language}
  title="Digital Visibility: sichtbar in ChatGPT & Google | CodaAI"
  description="Einkäufer fragen zuerst die KI. CodaAI macht B2B-Unternehmen dort sichtbar: ChatGPT, Google KI-Übersicht, klassische Suche — SEO, AEO & GEO plus Content."
  jsonLd={[softwareSchema, visibilityServiceSchema, faqSchema]}
>
  <Navbar lang={language} />
  <main id="main-content">
    {/* Sektionsrhythmus (Prototyp Nr. 9): weiß (Hero) → dunkel (Problem) → weiß (SEO/AEO/GEO)
        → grau (Programm-Bento) → weiß (Outcome-Funnel, neu) → getönt (Beweis)
        → … restliche Sektionen unverändert. Jede in-scope Sektion steckt in einem
        Reveal-Wrapper (fx/Reveal) für den scroll-getriggerten Einblendeffekt.
        Navbar/Footer/Booking/TeamSection/Blog bleiben unangetastet und daher auch
        ungewrappt.
        Feinschliff-Welle E1 (Review Oli, 20.07.2026): StufenTeaser ist von der
        Startseite auf die Preisseiten gewandert (siehe preise.astro / en/pricing.astro,
        dort jetzt als volle Sektion statt schmalem Kurven-Band). ProcessSteps ist von
        der Startseite entfernt — der kombinierte Prozess-/Outcome-Verlauf lebt jetzt
        gebündelt auf /digital-visibility (Sektion „Der komplette Verlauf"). Die
        Agentur-Vergleichs-Sektion (Pricing.astro) ist auf Olis Wunsch ausgeblendet
        (siehe Kommentar unten). ProcessSteps.astro und Pricing.astro selbst bleiben
        unverändert und ungelöscht im Repo. */}
    <PremiumHome />
    {/* AP5 (25.07.2026): Die FAQ ist von der Startseite auf /faq gewandert — die Seite
        hat jetzt genau einen Hauptausgang (Audit) und einen Nebenausgang (Termin).
        Das FAQPage-Schema liegt entsprechend auf /faq, nicht mehr hier. */}
    <Booking lang={language} />

    {/* ── Fragen zu CodaAI und zur Zusammenarbeit ─────────────────────────────
        Zurueck auf der Startseite seit 03.08.2026, aber nur die allgemeinen
        Fragen: Was macht CodaAI, wie faengt man an, wie verhaelt sich das zur
        eigenen Agentur. Alles zu Preis, Technik und Webinar steht auf der
        jeweiligen Seite. Position ist Absicht — nach dem Termin-Teaser raeumt
        der Block die letzten Einwaende aus, bevor der Blog folgt. */}
    <FaqAccordion
      items={faqAllgemein}
      eyebrow="Häufige Fragen"
      title="Was Interessenten uns vorher fragen"
      intro="Fragen zu Preis, Laufzeit und Technik beantworten wir auf den jeweiligen Seiten — hier steht, was zu CodaAI selbst und zur Zusammenarbeit immer wieder kommt."
      id="faq"
      idPrefix="faq-home"
      tone="muted"
    >
      <p slot="after" class="mt-10 text-sm text-muted-foreground">
        Ihre Frage steht nicht dabei?
        <a href="/faq/" class="font-semibold text-cta-accessible transition-colors hover:text-cta">Alle Fragen &amp; Antworten →</a>
      </p>
    </FaqAccordion>

    {/* ── Neueste Artikel ───────────────────────────────────────────────────── */}
    <section aria-labelledby="blog-section-heading" class="py-20 lg:py-28 bg-background border-t border-border">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mb-10 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-2">Blog</p>
            <h2 id="blog-section-heading" class="cai-h2 text-foreground">
              Neueste Artikel
            </h2>
          </div>
          <a
            href="/blog/"
            class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-cta-accessible hover:text-cta transition-colors"
          >
            Alle Artikel →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {recentPosts.map((post) => (
            <article class="group relative flex flex-col rounded-2xl border border-border bg-card overflow-hidden transition-shadow hover:shadow-lg hover:border-cta/30">
              {post.data.heroImage ? (
                <div class="h-44 overflow-hidden bg-muted">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt ?? post.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="176"
                  />
                </div>
              ) : (
                <div class="h-44 flex items-center justify-center bg-gradient-to-br from-cta/10 to-cta/5">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#DF41FB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              )}
              <div class="flex flex-col flex-1 p-5">
                <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-2">{post.data.category}</p>
                <h3 class="text-base font-semibold text-foreground leading-snug mb-2 group-hover:text-cta transition-colors">
                  <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2 flex-1">
                  {post.data.description}
                </p>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="mt-4 text-xs text-muted-foreground"
                >
                  {post.data.pubDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/blog/" class="text-sm font-semibold text-cta-accessible hover:text-cta transition-colors">
            Alle Artikel ansehen →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={language} />
</Layout>
