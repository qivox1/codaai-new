  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />

  <style>
    /* Dezentes Raster für den Ehrlichkeits-Block — identisch zu /preise. */
    .cai-dvdark {
      background-image:
        linear-gradient(hsl(var(--foreground) / 0.05) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--foreground) / 0.05) 1px, transparent 1px);
      background-size: 44px 44px;
    }

    /* ── Hero: Zeilen laufen beim Laden nacheinander ein ────────────────── */
    .cai-line {
      opacity: 0;
      transform: translateY(18px);
      animation: caiLineIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--d, 0) * 110ms);
    }
    h1 .cai-line:nth-child(2) { --d: 1; }
    @keyframes caiLineIn { to { opacity: 1; transform: none; } }

    /* ── Stufen-Linie ───────────────────────────────────────────────────
       Läuft links neben den drei Karten mit und füllt sich beim Scrollen —
       das macht sichtbar, was der Text sagt: jede Stufe enthält die darunter.
       Position und Höhe setzt das Skript, damit sie exakt von der ersten zur
       dritten Zahl reicht. Unter 1024px ausgeblendet (kein Platz).          */
    .cai-spine {
      position: absolute;
      left: -26px;
      width: 2px;
      border-radius: 2px;
      background: hsl(var(--border));
      opacity: 0;
      display: none;
      pointer-events: none;
    }
    @media (min-width: 1024px) {
      .cai-spine.is-ready { display: block; opacity: 1; }
    }
    .cai-spine-fill {
      display: block;
      width: 100%;
      height: 0;
      border-radius: 2px;
      background: hsl(var(--cta));
      transition: height 0.12s linear;
    }

    /* ── Akkordeon ──────────────────────────────────────────────────────
       Ohne JavaScript ist alles offen (kein Inhalt geht verloren). Erst die
       Klasse .cai-js, die das Skript setzt, aktiviert das Zuklappen.        */
    .cai-head { cursor: default; }
    .cai-js .cai-head { cursor: pointer; }
    .cai-chev { transition: transform 0.35s ease, color 0.2s ease; }
    .cai-js .cai-stufe:not(.is-open) .cai-chev { transform: rotate(-90deg); }
    .cai-js .cai-head:hover .cai-chev { color: hsl(var(--cta)); }

    .cai-stufe {
      transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }
    .cai-js .cai-stufe:not(.is-open):hover,
    .cai-js .cai-stufe:not(.is-open):focus-within {
      border-color: hsl(var(--cta) / 0.5);
      transform: translateY(-2px);
      box-shadow: 0 10px 30px -18px hsl(var(--cta) / 0.55);
    }

    /* Die Zahl ist das Signal: beim Überfahren und im geöffneten Zustand
       füllt sie sich magenta. */
    .cai-nr {
      transition: background-color 0.22s ease, border-color 0.22s ease, color 0.22s ease,
        transform 0.22s ease;
    }
    .cai-js .cai-head:hover .cai-nr,
    .cai-js .cai-head:focus-visible .cai-nr,
    .cai-js .cai-stufe.is-open .cai-nr {
      background: hsl(var(--cta));
      border-color: hsl(var(--cta));
      color: #fff;
    }
    .cai-js .cai-head:hover .cai-nr { transform: translateY(-1px); }

    .cai-hint {
      opacity: 0;
      transform: translateX(6px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      pointer-events: none;
    }
    .cai-js .cai-stufe:not(.is-open) .cai-head:hover .cai-hint,
    .cai-js .cai-stufe:not(.is-open) .cai-head:focus-visible .cai-hint {
      opacity: 1;
      transform: none;
    }

    .cai-js .cai-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cai-js .cai-stufe.is-open .cai-panel { max-height: 2600px; }

    /* Bausteine blenden gestaffelt ein, sobald die Stufe geöffnet wird. */
    .cai-js .cai-item {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.22s ease,
        box-shadow 0.22s ease;
    }
    .cai-js .cai-stufe.is-open .cai-item {
      opacity: 1;
      transform: none;
      transition-delay: calc(120ms + var(--i) * 70ms);
    }
    .cai-stufe.is-open { border-color: hsl(var(--cta) / 0.45); }

    /* Karten-Hover — höhere Spezifität als die Einblend-Regel darüber. */
    .cai-item { outline: none; }
    .cai-js .cai-stufe.is-open .cai-item:hover,
    .cai-js .cai-stufe.is-open .cai-item:focus-visible,
    .cai-item:hover,
    .cai-item:focus-visible {
      border-color: hsl(var(--cta) / 0.55);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px -16px hsl(var(--cta) / 0.5);
      transition-delay: 0ms;
    }

    /* Piktogramm-Kachel */
    .cai-ico {
      background: hsl(var(--cta) / 0.1);
      color: hsl(var(--cta-accessible));
      transition: background-color 0.22s ease, transform 0.22s ease;
    }
    .cai-item:hover .cai-ico,
    .cai-item:focus-visible .cai-ico {
      background: hsl(var(--cta) / 0.2);
      transform: translateY(-1px) scale(1.05);
    }

    /* Beleg — liegt still in der Karte und erscheint beim Überfahren.
       Auf Touch-Geräten (kein Hover) steht er dauerhaft da, sonst wäre die
       Zahl dort nicht erreichbar. */
    .cai-beleg {
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      margin-top: 0;
      padding-top: 0;
      border-top: 1px solid transparent;
      transition: max-height 0.35s ease, opacity 0.3s ease, margin-top 0.35s ease,
        padding-top 0.35s ease, border-color 0.3s ease;
    }
    .cai-item:hover .cai-beleg,
    .cai-item:focus-visible .cai-beleg {
      max-height: 14rem;
      opacity: 1;
      margin-top: 0.85rem;
      padding-top: 0.75rem;
      border-top-color: hsl(var(--cta) / 0.45);
    }
    @media (hover: none) {
      .cai-beleg {
        max-height: none;
        opacity: 1;
        margin-top: 0.85rem;
        padding-top: 0.75rem;
        border-top-color: hsl(var(--cta) / 0.45);
      }
    }

    /* ── Matrix ─────────────────────────────────────────────────────────
       Häkchen zeichnen sich spaltenweise, sobald die Tabelle ins Bild kommt.
       Ohne JS (keine .cai-anim-Klasse) stehen sie einfach da.               */
    .cai-matrix.cai-anim .cai-check path {
      stroke-dasharray: 26;
      stroke-dashoffset: 26;
    }
    .cai-matrix.cai-anim.is-drawn .cai-check path {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.45s ease;
      transition-delay: calc(140ms + var(--c) * 180ms);
    }
    .cai-matrix td { transition: background-color 0.18s ease; }
    .cai-matrix[data-hl='0'] td:nth-child(2),
    .cai-matrix[data-hl='1'] td:nth-child(3),
    .cai-matrix[data-hl='2'] td:nth-child(4) {
      background: hsl(var(--cta) / 0.08);
    }

    @media (prefers-reduced-motion: reduce) {
      .cai-line { opacity: 1; transform: none; animation: none; }
      .cai-js .cai-panel { transition: none; }
      .cai-js .cai-item { opacity: 1; transform: none; transition: none; }
      .cai-chev,
      .cai-stufe,
      .cai-nr,
      .cai-ico,
      .cai-beleg,
      .cai-spine-fill { transition: none; }
      .cai-js .cai-stufe:not(.is-open):hover { transform: none; }
      .cai-matrix.cai-anim .cai-check path { stroke-dashoffset: 0; }
    }
  </style>

  <script is:inline>
    (function () {
      var reduced = false;
      try {
        reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      } catch (e) {}

      /* ── 1 · Akkordeon ───────────────────────────────────────────────
         Bewusst ohne Scroll-Automatik: Es ist immer genau das offen, was der
         Nutzer geöffnet hat. Beim Laden ist das Stufe 1 — oder die Stufe,
         auf die ein Anker zeigt. */
      var acc = document.querySelector('[data-acc]');
      if (acc) {
        var stufen = Array.prototype.slice.call(acc.querySelectorAll('[data-stufe]'));
        acc.classList.add('cai-js');

        var setOpen = function (el, open) {
          el.classList.toggle('is-open', open);
          var head = el.querySelector('[data-head]');
          if (head) head.setAttribute('aria-expanded', open ? 'true' : 'false');
        };

        var hash = (location.hash || '').replace('#', '');
        var target = null;
        stufen.forEach(function (el) { if (el.id === hash) target = el; });
        stufen.forEach(function (el, i) {
          setOpen(el, target ? el === target : i === 0);
        });

        stufen.forEach(function (el) {
          var head = el.querySelector('[data-head]');
          if (!head) return;
          head.addEventListener('click', function () {
            setOpen(el, !el.classList.contains('is-open'));
            window.setTimeout(layoutSpine, 620);
          });
        });
      }

      /* ── 2 · Stufen-Linie ────────────────────────────────────────────
         Reicht von der Mitte der ersten Zahl bis zur Mitte der letzten und
         füllt sich, während die Stufen durchs Bild laufen. */
      var spine = document.querySelector('.cai-spine');
      var fill = spine && spine.querySelector('.cai-spine-fill');
      var spineTop = 0;
      var spineH = 0;

      function layoutSpine() {
        if (!spine || !acc) return;
        var nrs = acc.querySelectorAll('.cai-nr');
        if (nrs.length < 2) return;
        var accR = acc.getBoundingClientRect();
        var first = nrs[0].getBoundingClientRect();
        var last = nrs[nrs.length - 1].getBoundingClientRect();
        spineTop = first.top - accR.top + first.height / 2;
        spineH = last.top - accR.top + last.height / 2 - spineTop;
        spine.style.top = spineTop + 'px';
        spine.style.height = spineH + 'px';
        spine.classList.add('is-ready');
        paintSpine();
      }

      function paintSpine() {
        if (!fill || !spineH) return;
        var accR = acc.getBoundingClientRect();
        var anchor = window.innerHeight * 0.55;
        var p = (anchor - (accR.top + spineTop)) / spineH;
        p = p < 0 ? 0 : p > 1 ? 1 : p;
        fill.style.height = (p * 100).toFixed(1) + '%';
      }

      /* ── 3 · Zähler im Kennzahlen-Band ──────────────────────────────── */
      function startCounters(box) {
        var els = box.querySelectorAll('[data-count]');
        Array.prototype.forEach.call(els, function (el, i) {
          var goal = parseInt(el.getAttribute('data-count'), 10) || 0;
          if (reduced) { el.textContent = String(goal); return; }
          el.textContent = '0';
          var dur = 900;
          var delay = i * 170;
          window.setTimeout(function () {
            var t0 = 0;
            var step = function (ts) {
              if (!t0) t0 = ts;
              var k = Math.min(1, (ts - t0) / dur);
              var eased = 1 - Math.pow(1 - k, 3);
              el.textContent = String(Math.round(eased * goal));
              if (k < 1) window.requestAnimationFrame(step);
            };
            window.requestAnimationFrame(step);
          }, delay);
        });
      }

      /* ── 4 · Matrix: Häkchen zeichnen + Spalten-Hover ────────────────── */
      var matrix = document.querySelector('[data-matrix]');
      if (matrix) {
        if (!reduced) matrix.classList.add('cai-anim');
        var cols = matrix.querySelectorAll('[data-col]');
        Array.prototype.forEach.call(cols, function (a, i) {
          var on = function () { matrix.setAttribute('data-hl', String(i)); };
          var off = function () { matrix.removeAttribute('data-hl'); };
          a.addEventListener('mouseenter', on);
          a.addEventListener('focus', on);
          a.addEventListener('mouseleave', off);
          a.addEventListener('blur', off);
        });
      }

      /* ── 5 · Beobachter + Scroll ─────────────────────────────────────── */
      if ('IntersectionObserver' in window) {
        var once = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              once.unobserve(e.target);
              if (e.target.hasAttribute('data-counters')) startCounters(e.target);
              else e.target.classList.add('is-drawn');
            });
          },
          { threshold: 0.25 }
        );
        var band = document.querySelector('[data-counters]');
        if (band) once.observe(band);
        if (matrix) once.observe(matrix);
      } else {
        if (matrix) matrix.classList.add('is-drawn');
      }

      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          paintSpine();
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', layoutSpine);
      window.addEventListener('load', layoutSpine);
      layoutSpine();
    })();
  </script>

  <Footer lang={lang} />
</Layout>
