---
// 22.09.2026 (Beschluss Oli, Blog-Redaktionsplan 2026/27, Abschnitt 6): Artikel
// aufgelöst — er argumentierte über Content-Produktion und Kosten statt über
// KI-Sichtbarkeit. Diese Seite hält die alte URL am Leben.
// Bauart wie /kontakt und /leistungen: noindex, follow · Canonical auf das Ziel.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/wissen/geo-optimierung/`;
const canonical = 'https://www.codaai.ai/wissen/geo-optimierung/';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Weitergeleitet: Leitfaden GEO-Optimierung | CodaAI</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center;">
    <p><a href={target} style="color: #9904B4; font-weight: 600;">Dieser Beitrag ist aufgegangen im Leitfaden GEO-Optimierung</a></p>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)});`} />
  </body>
</html>
