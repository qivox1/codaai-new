---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

const DATENSTAND = 'Juni/Juli 2026';
const VERSION = '1.0';
// Webinar-Modul erst mit Live-Gang von /webinar aktivieren (Olis Entscheidung 14.07.2026)
const SHOW_WEBINAR = true;

// ── Kennzahlen (Quelle: geo_v2_export, Auswertung 13.07.2026 — vor Go-Live Refresh!) ──
const K = {
  unternehmen: 449,
  fragen: 3592,
  antworten: 7184,
  ohneNennung: 54.7,        // % aller Fragen ohne Nennung des Unternehmens
  ersetzt: 46.8,            // % Firmen: KI empfiehlt Wettbewerber, Firma fehlt mehrheitlich
  seoParadox: 34.9,         // % der SEO-starken Firmen (≥100 Top-10) in ChatGPT unsichtbar
  seoStarkN: 361,
  komplettUnsichtbar: 12.9, // % Firmen: 0 von 8 Fragen
  kategorieBlind: 25.6,     // % Firmen: bei Marktfrage zum eigenen Kerngeschäft unsichtbar
  chatgptAvg: 24.9,
  googleAvg: 39.4,
  nieChatgpt: 39.6,
  nieGoogle: 15.1,
  nieZitiert: 39.0,
  platz1: 23.8,
  avgPosition: '1,8',
  verlustMedian: '47.000',
};

const reportSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Report',
  name: 'KI-Blindtest Mittelstand 2026 — Auswertung zur KI-Sichtbarkeit mittelständischer Unternehmen',
  alternativeName: 'Empfohlen oder unsichtbar?',
  url: `${SITE_URL}/studie/`,
  datePublished: '2026-07-14',
  dateModified: '2026-07-14',
  inLanguage: 'de',
  version: VERSION,
  publisher: { '@id': `${SITE_URL}/#organization` },
  description:
    'Auswertung von 7.184 KI-Antworten (ChatGPT und Google KI-Übersicht) auf 3.592 realistische Einkäuferfragen zu 449 mittelständischen Unternehmen: 54,7 % der Fragen bleiben ohne Nennung des jeweiligen Unternehmens; bei 46,8 % der Unternehmen empfiehlt die KI namentlich Wettbewerber.',
  about: [
    { '@type': 'Thing', name: 'Generative Engine Optimization (GEO)' },
    { '@type': 'Thing', name: 'KI-Sichtbarkeit' },
    { '@type': 'Thing', name: 'Mittelstand' },
  ],
});

const datasetSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'KI-Blindtest Mittelstand 2026 — Rohdaten-Aggregat',
  description:
    '449 mittelständische Unternehmen × 8 qualifizierte Einkäuferfragen, abgefragt auf ChatGPT und Google KI-Übersicht (7.184 dokumentierte Antworten). Erhoben Juni/Juli 2026. Aggregierte Kennzahlen öffentlich; Einzeldaten unternehmensbezogen und zugangsgeschützt.',
  url: `${SITE_URL}/studie/`,
  creator: { '@id': `${SITE_URL}/#organization` },
  temporalCoverage: '2026-06/2026-07',
  spatialCoverage: 'DACH',
  isAccessibleForFree: true,
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Ist diese Auswertung repräsentativ für den deutschen Mittelstand?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nein, und das behaupten wir bewusst nicht. Die 449 Unternehmen stammen aus unserer eigenen Audit-Praxis und sind B2B-lastig. Die Auswertung ist nach unserer Recherche jedoch die bislang umfangreichste ihrer Art im deutschsprachigen Raum — kleinere Erhebungen (24 bzw. 150 Unternehmen) kommen unabhängig von uns zu ähnlichen Ergebnissen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wie wurden die Einkäuferfragen erstellt?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pro Unternehmen wurden 8 qualifizierte deutsche Fragen in drei Archetypen generiert (Marktübersicht, Anwendungsfall, Wettbewerbsvergleich) — auf Basis einer automatisierten Analyse der Website, der Branche und des Wettbewerbsumfelds, mit anschließender Qualitätsprüfung. Die Fragensätze sind eingefroren und damit für Verlaufsmessungen wiederholbar.',
      },
    },
    {
      '@type': 'Question',
      name: 'Welche KI-Systeme wurden abgefragt?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ChatGPT (Modellantworten ohne Live-Websuche) und die Google KI-Übersicht (deutsche Lokalisierung). Beide Oberflächen wurden mit identischen Fragen abgefragt; erfasst wurden Markennennung, Position der Nennung, genannte Wettbewerber und ob die eigene Website als Quelle zitiert wird.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kann ich die Sichtbarkeit meines eigenen Unternehmens prüfen lassen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Mit derselben Methodik erstellen wir ein individuelles Sichtbarkeits-Audit für Ihr Unternehmen — mit Ihren realen Einkäuferfragen, den echten KI-Antworten und den Wettbewerbern, die statt Ihnen empfohlen werden. Geben Sie dazu oben auf dieser Seite Ihre Domain ein.',
      },
    },
  ],
});

// Anonymisierte Echt-Beispiele aus dem Datensatz (Branche statt Firmenname, Wettbewerber anonymisiert)
const beispiele = [
  {
    branche: 'Hersteller von Not- und Sicherheitsbeleuchtung',
    kontext: 'ca. 880 Top-10-Rankings bei Google — organisch gut sichtbar',
    frage: 'Welche LED-Notleuchten sind für den Einsatz in gewerblichen Flucht- und Rettungswegen nach aktueller Norm empfehlenswert?',
    ergebnis: 'Das Unternehmen wird nicht genannt. Stattdessen empfehlen die KI-Systeme über den gesamten Fragensatz hinweg zwei direkte Wettbewerber je fünfmal.',
  },
  {
    branche: 'Maschinenbauer für Fabrikautomation und Fördertechnik',
    kontext: 'ca. 640 Top-10-Rankings — KI-Sichtbarkeit: 0 von 8 Fragen',
    frage: 'Welche Hersteller von Aluminium-Profilsystemen für die Fabrikautomation gelten als führend in Europa?',
    ergebnis: 'Keine Nennung in ChatGPT und Google KI-Übersicht. Der meistgenannte Wettbewerber erscheint in den Antworten siebenmal — ein DAX-naher Großkonzern dominiert die Kategorie.',
  },
  {
    branche: 'Anbieter von Galvanotechnik und Oberflächenveredelung',
    kontext: 'über 1.200 Top-10-Rankings — KI-Sichtbarkeit: 0 von 8 Fragen',
    frage: 'Welche Anbieter für galvanische Metallveredelung in Deutschland gelten als besonders zuverlässig?',
    ergebnis: 'Das Unternehmen taucht in keiner Antwort auf — obwohl es bei klassischen Google-Suchen zu denselben Themen auf Seite 1 rankt. Empfohlen werden zwei internationale Gruppen.',
  },
];
---

<Layout
  lang="de"
  title="KI-Blindtest Mittelstand 2026: Empfohlen oder unsichtbar? | CodaAI"
  description="7.184 KI-Antworten zu 449 mittelständischen Unternehmen: In 55 % der Einkäuferfragen fällt der Firmenname nicht — bei 47 % empfiehlt die KI Wettbewerber."
  jsonLd={[reportSchema, datasetSchema, faqSchema]}
>
  <Navbar lang="de" />
  <main id="main-content" class="pt-24 lg:pt-28">

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-border bg-background">
      <div aria-hidden="true" class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full bg-cta/10 blur-3xl"></div>
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">
        <Breadcrumb items={[{ label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` }, { label: 'KI-Blindtest 2026' }]} class="mb-8" />

        <div class="max-w-3xl">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cta-accessible">
            Datenauswertung · KI-Blindtest Mittelstand 2026
          </p>
          <h1 class="cai-h1 cai-kipp text-foreground">
            <span class="k1 block">Wir haben 449 Unternehmen gefragt.</span>
            <span class="k2 block">Empfohlen oder unsichtbar?</span>
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-muted-foreground lg:text-xl">
            Wir haben KI-Assistenten die Fragen echter Einkäufer gestellt — zu 449 mittelständischen
            Unternehmen. Das Ergebnis ist die nach unserer Kenntnis bislang umfangreichste Auswertung
            zur KI-Sichtbarkeit des Mittelstands im deutschsprachigen Raum. Es ist kein beruhigendes Ergebnis.
          </p>
        </div>

        <!-- Kennzahlen-Band -->
        <dl class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-3">
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-foreground lg:text-5xl" data-count="449">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">untersuchte Unternehmen</span><span class="block">aus 258 Branchen</span></dt>
          </div>
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-foreground lg:text-5xl" data-count="3592">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">firmenspezifische Einkäuferfragen</span><span class="block">zu Produkten &amp; Leistungen</span></dt>
          </div>
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-cta lg:text-5xl" data-count="7184">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">dokumentierte KI-Antworten</span><span class="block">aus ChatGPT &amp; Google KI-Übersicht</span></dt>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Datenstand: {DATENSTAND}
          </span>
          <span>Version {VERSION}</span>
          <a href="#methodik" class="font-medium text-cta-accessible transition-colors hover:text-cta">Methodik ↓</a>
          <a href="#limitationen" class="font-medium text-cta-accessible transition-colors hover:text-cta">Limitationen ↓</a>
          <a href="#zitieren" class="font-medium text-cta-accessible transition-colors hover:text-cta">Zitieren ↓</a>
        </div>
      </div>
    </section>

    <!-- ── Zentrale Befunde (Teaser, Boxen wie /webinar in Studien-Ton) ── -->
    <section aria-labelledby="h-befunde-teaser" class="border-b border-border bg-background">
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Zentrale Befunde</p>
        <h2 id="h-befunde-teaser" class="cai-h2 text-foreground">Potenzielle Käufer fragen zuerst die KI — und die Unternehmen erfahren nichts davon.</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {[
            { n: '55 %', t: 'der Einkäuferfragen bleiben ohne Nennung', d: 'In über der Hälfte der Fragen taucht das untersuchte Unternehmen in keiner KI-Antwort auf — und niemand merkt es, denn diese Nicht-Nennung erscheint in keiner Statistik.' },
            { n: 'fast 1/2', t: 'werden durch namentlich empfohlene Wettbewerber ersetzt', d: 'Bei fast jedem zweiten Unternehmen empfiehlt die KI konkret die Konkurrenz, während das Unternehmen selbst bei der Mehrheit seiner Kernfragen zum Produkt- und Leistungsspektrum fehlt.' },
            { n: '> 1/3', t: 'trotz guter Google-Rankings unsichtbar', d: 'Über ein Drittel der Firmen mit mehr als 100 Top-10-Rankings ist in ChatGPT komplett unsichtbar. Klassische SEO-Stärke schützt nicht.' },
          ].map((b) => (
            <article class="flex flex-col rounded-2xl border border-border bg-card p-8">
              <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">{b.n}</span>
              <h3 class="mt-4 text-lg font-semibold leading-snug text-foreground">{b.t}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{b.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Inhalt + TOC ─────────────────────────────────────────────────── -->
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16">

        <!-- TOC (Desktop) -->
        <aside class="hidden lg:block">
          <nav aria-label="Inhaltsverzeichnis" class="sticky top-28 py-16 text-sm">
            <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Inhalt</p>
            <ol class="space-y-3 border-l border-border">
              <li><a href="#zusammenfassung" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Zusammenfassung</a></li>
              <li><a href="#ergebnisse" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Kernergebnisse</a></li>
              <li><a href="#plattformen" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">ChatGPT vs. Google KI</a></li>
              <li><a href="#beispiele" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Beispiele</a></li>
              <li><a href="#domain-check" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Domain-Check</a></li>
              <li><a href="#methodik" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Methodik</a></li>
              <li><a href="#limitationen" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Limitationen</a></li>
              <li><a href="#faq" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Häufige Fragen</a></li>
            </ol>
          </nav>
        </aside>

        <div class="min-w-0">

          <!-- ── Zusammenfassung ──────────────────────────────────────── -->
          <section id="zusammenfassung" aria-labelledby="h-zusammenfassung" class="scroll-mt-28 py-16">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Abstract</p>
            <h2 id="h-zusammenfassung" class="cai-h2 text-foreground">Zusammenfassung</h2>
            <div class="mt-8 rounded-2xl border-l-4 border-cta bg-muted/30 p-8">
              <p class="text-lg leading-relaxed text-foreground">
                B2B-Kaufentscheidungen beginnen zunehmend in KI-Antworten — lange bevor ein Anbieter kontaktiert wird.
                Diese Auswertung misst, ob mittelständische Unternehmen dort vorkommen. Dazu wurden je Unternehmen
                acht realistische Einkäuferfragen an ChatGPT und die Google KI-Übersicht gestellt und die Antworten
                systematisch ausgewertet: Wird das Unternehmen genannt? An welcher Position? Wer wird stattdessen
                empfohlen? Wird die eigene Website als Quelle zitiert?
              </p>
              <p class="mt-4 text-lg leading-relaxed text-foreground">
                Das Ergebnis: In <strong>{K.ohneNennung.toLocaleString('de-DE')} %</strong> aller Fragen wird das
                betroffene Unternehmen nicht genannt. Bei <strong>{K.ersetzt.toLocaleString('de-DE')} %</strong> der
                Unternehmen empfehlen die KI-Systeme namentlich Wettbewerber, während das Unternehmen selbst bei der
                Mehrheit seiner Kernfragen fehlt. Und selbst starke Google-Rankings schützen nicht:
                <strong>{K.seoParadox.toLocaleString('de-DE')} %</strong> der organisch gut sichtbaren Unternehmen
                sind in ChatGPT vollständig unsichtbar.
              </p>
            </div>
          </section>

          <!-- ── Kernergebnisse ───────────────────────────────────────── -->
          <section id="ergebnisse" aria-labelledby="h-ergebnisse" class="scroll-mt-28 border-t border-border py-16">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Ergebnisse</p>
            <h2 id="h-ergebnisse" class="cai-h2 text-foreground">Vier Befunde, die wehtun</h2>

            <div class="mt-10 grid gap-6 sm:grid-cols-2">

              <!-- Befund 1 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">55&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">der Einkäuferfragen bleiben ohne Nennung</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  In 1.965 von 3.592 Fragen taucht das jeweilige Unternehmen in keiner der beiden
                  KI-Antworten auf. Die Mehrheit der Kaufanbahnungen findet damit ohne das Unternehmen statt —
                  und niemand merkt es, denn diese Nicht-Nennung erscheint in keiner Statistik.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="54,7 Prozent der Fragen ohne Nennung">
                  <div class="h-full rounded-full bg-cta" style="width:54.7%"></div>
                </div>
              </article>

              <!-- Befund 2 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">47&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">werden durch Wettbewerber ersetzt</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  Bei 210 von 449 Unternehmen empfehlen die KI-Systeme namentlich Wettbewerber, während das
                  Unternehmen selbst bei der Mehrheit seiner Fragen fehlt. {K.komplettUnsichtbar.toLocaleString('de-DE')} %
                  sind vollständig ersetzt: null Nennungen bei acht Fragen — die Konkurrenz steht in jeder Antwort.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="46,8 Prozent der Unternehmen werden durch Wettbewerber ersetzt">
                  <div class="h-full rounded-full bg-cta" style="width:46.8%"></div>
                </div>
              </article>

              <!-- Befund 3 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">35&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">Das SEO-Paradox: Gute Rankings schützen nicht</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  {K.seoStarkN} der untersuchten Unternehmen haben mehr als 100 Top-10-Rankings bei Google.
                  Jedes dritte davon ({K.seoParadox.toLocaleString('de-DE')} %) ist in ChatGPT trotzdem komplett
                  unsichtbar. Klassische SEO-Stärke und KI-Sichtbarkeit sind zwei verschiedene Disziplinen.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="34,9 Prozent der SEO-starken Unternehmen sind in ChatGPT unsichtbar">
                  <div class="h-full rounded-full bg-cta" style="width:34.9%"></div>
                </div>
              </article>

              <!-- Befund 4 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">26&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">unsichtbar beim eigenen Kerngeschäft</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  Jedes vierte Unternehmen wird selbst bei der Marktübersichts-Frage zu seiner
                  <em>eigenen</em> Kategorie nicht genannt („Welche Anbieter für … gelten als führend?").
                  Wer hier fehlt, existiert für die Discovery-Phase seiner Branche nicht.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="25,6 Prozent bei der eigenen Kategorie-Frage unsichtbar">
                  <div class="h-full rounded-full bg-cta" style="width:25.6%"></div>
                </div>
              </article>
            </div>

            <p class="mt-6 text-xs leading-relaxed text-muted-foreground">
              Ergänzende Kennzahlen: Wo Unternehmen genannt werden, stehen sie im Schnitt an Position {K.avgPosition};
              in {K.platz1.toLocaleString('de-DE')} % aller Fragen erreicht das Unternehmen Platz 1.
              Bei {K.nieZitiert.toLocaleString('de-DE')} % der Unternehmen wird die eigene Website in keiner Antwort
              als Quelle zitiert — die KI beschreibt diese Firmen ausschließlich auf Basis Dritter.
              Eine konservative Modellrechnung beziffert die mediane Opportunität auf rund {K.verlustMedian} € pro
              Unternehmen und Jahr (<a href="#limitationen" class="underline decoration-border underline-offset-2 hover:text-foreground">Einordnung</a>).
            </p>
          </section>

          <!-- ── Plattform-Vergleich ──────────────────────────────────── -->
          <section id="plattformen" aria-labelledby="h-plattformen" class="scroll-mt-28 border-t border-border py-16">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Plattform-Vergleich</p>
            <h2 id="h-plattformen" class="cai-h2 text-foreground">ChatGPT ist deutlich blinder als die Google KI-Übersicht</h2>
            <p class="mt-4 max-w-2xl text-muted-foreground">
              Dieselben Fragen, zwei Systeme, zwei Realitäten: ChatGPT antwortet überwiegend aus Trainingsdaten —
              wer dort fehlt, fehlt strukturell und kann das kurzfristig kaum korrigieren. Die Google KI-Übersicht
              greift stärker auf den Live-Index zu.
            </p>

            <div class="mt-10 space-y-8 rounded-2xl border border-border bg-card p-8">
              <div>
                <div class="mb-2 flex items-baseline justify-between gap-4">
                  <span class="text-sm font-semibold text-foreground">Ø Sichtbarkeit in ChatGPT</span>
