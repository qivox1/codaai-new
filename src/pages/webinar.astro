---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WebinarSignup from '../components/premium/WebinarSignup.astro';
import FlipWords from '../components/react/FlipWords';
import { faqWebinar } from '../data/faq';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Audit-Scroll-Animation auf /webinar vorerst ausgeblendet (Oli 25.07.2026) —
// Markup + Styles + JS bleiben erhalten fuer spaetere Wiederverwendung an anderer Stelle.
const SHOW_AUDIT_PIN = false;

const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

// Apps-Script-Backend (gleiche Web-App wie Buchungs-Widget, Aktionen webinar_code / webinar_register)
const WEBINAR_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyr-OljJObRAtbuujuCIAyv5StyK2hgN_sxiaQZo2RzauxIsizjzSFx5Ij3KJ2t8pvb/exec';

// Rotierende Konsequenz-Zeile der H1 (FlipWords-Effekt wie im Startseiten-Hero)
const h1FlipWords = [
  { text: 'wird nicht angefragt.', color: '#DF41FB' },
  { text: 'fehlt auf der Shortlist.', color: '#DF41FB' },
  { text: 'verliert den Auftrag.', color: '#DF41FB', duration: 10000 },
];

const slots = [
  { id: '2026-09-08', day: 'Dienstag', date: '8. September 2026', time: '11:00–12:00 Uhr', iso: '2026-09-08T11:00:00+02:00' },
];

// Schmerzpunkte (Problem-Sektion) — jede Zahl aus der eigenen Studie belegt
const painStats = [
  { n: '55 %', t: 'der Einkäuferfragen bleiben ohne Nennung', d: 'In über der Hälfte der Fragen taucht das untersuchte Unternehmen in keiner KI-Antwort auf — und niemand merkt es, denn diese Nicht-Nennung erscheint in keiner Statistik.' },
  { n: 'fast 1/2', t: 'werden durch namentlich empfohlene Wettbewerber ersetzt', d: 'Bei fast jedem zweiten Unternehmen empfiehlt die KI konkret die Konkurrenz, während das Unternehmen selbst bei der Mehrheit seiner Kernfragen zum Produkt- und Leistungsspektrum fehlt.' },
  { n: '> 1/3', t: 'trotz guter Google-Rankings unsichtbar', d: 'Über ein Drittel der Firmen mit mehr als 100 Top-10-Rankings ist in ChatGPT komplett unsichtbar. Klassische SEO-Stärke schützt nicht.' },
];
const painDaily = [
  'Ihre Anfragen kommen über Empfehlungen und Bestandskunden — und werden spürbar weniger.',
  'Sie sind führend in Ihrer Nische, aber außerhalb Ihres Netzwerks kennt Sie kaum jemand.',
  'Sie wissen nicht, was ChatGPT antwortet, wenn Einkäufer nach Ihrer Leistung fragen — und niemand sagt es Ihnen.',
  'Ihre Website spricht 20 Sprachen — aber was die KI in Ihren Exportmärkten über Sie antwortet, hat noch nie jemand geprüft.',
];

// Learnings = die Antworten auf die Schmerzpunkte (Problem → Lösung)
const learnings = [
  {
    t: 'Verstehen, wo Ihre Aufträge heute entschieden werden',
    d: 'Die stille Vorentscheidung entschlüsselt: wie Einkäufer heute recherchieren und ihre Shortlist bilden, warum die Entscheidung vor dem Erstkontakt fällt — und an welcher Stelle Ihr Unternehmen sichtbar sein muss.',
  },
  {
    t: 'Sehen, was die KI über Firmen wie Ihre sagt',
    d: 'Live-Audit vor Ihren Augen: echte Mittelstands-Marken in ChatGPT & Google KI-Übersicht, geprüft mit der Methodik der 8 Einkäuferfragen — auf Wunsch anonym auch Firmen aus dem Publikum.',
  },
  {
    t: 'Wissen, wie Sie empfohlen werden statt zu fehlen',
    d: 'Der Fahrplan gegen die Unsichtbarkeit: die 5 Hebel von Sichtbarkeit bis Auftrag — was Sie mit Bordmitteln selbst tun können und wo die Grenze liegt.',
  },
];

const agenda = [
  { min: '20 Min.', t: 'Die stille Vorentscheidung — wie Buying Center heute recherchieren und warum Relevanz lange vor dem Erstkontakt entsteht', d: 'Norbert Schuster über Dark Funnel, Buying Center und die Entscheider, die Sie nie treffen: wie B2B-Kaufprozesse heute wirklich ablaufen — und warum die Weichen fallen, lange bevor Ihr Vertrieb ins Spiel kommt. Start mit einer kurzen Live-Umfrage.' },
  { min: '25 Min.', t: 'Live-Audit: empfohlen oder unsichtbar?', d: 'Echte Mittelstands-Marken live in ChatGPT + Google KI-Übersicht, geprüft mit der Methodik der 8 Einkäuferfragen und den typischen Befunden aus hunderten Audits — plus, was Sie mit ChatGPT oder Copilot selbst prüfen können und wo die Grenze liegt.' },
  { min: '15 Min.', t: 'Offene Fragerunde (Q&A)', d: 'Ihre konkreten Fälle im Dialog mit Norbert Schuster und Oliver Parrizas: die 5 Hebel im Zusammenspiel — von sichtbar werden bis Aufträge gewinnen — und wie es nach dem Webinar weitergeht.' },
];

/* Fragen aus der gemeinsamen Quelle src/data/faq.ts (Neuverteilung 03.08.2026). */
const webinarFaq = faqWebinar;


const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: webinarFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const eventSchema = JSON.stringify(slots.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Empfohlen oder unsichtbar? — Warum Ihre nächsten Aufträge in ChatGPT & Co. entschieden werden',
  startDate: s.iso,
  endDate: s.iso.replace('T11:00', 'T12:00'),
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'VirtualLocation', url: `${SITE_URL}/webinar/` },
  organizer: { '@type': 'Organization', name: 'CodaAI', url: SITE_URL },
  performer: [
    { '@type': 'Person', name: 'Norbert Schuster' },
    { '@type': 'Person', name: 'Oliver Parrizas' },
  ],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: `${SITE_URL}/webinar/` },
  description: 'Kostenloses Live-Webinar: Warum B2B-Aufträge heute in KI-Antworten entschieden werden — mit Live-Audits echter Firmen und persönlichem Sichtbarkeits-Audit auf Wunsch.',
})));
---

<Layout
  lang="de"
  title="Live-Webinar: Empfohlen oder unsichtbar? | CodaAI"
  description="Live-Webinar mit Norbert Schuster: Warum B2B-Aufträge heute in ChatGPT & Co. entschieden werden — mit Live-Audits und Ihrem persönlichen Sichtbarkeits-Audit."
  jsonLd={[eventSchema, faqSchema]}
  ogImage="https://www.codaai.ai/images/og-webinar.jpg"
>
  <Navbar lang="de" />

  <!-- ── Motion-Layer: Fortschrittsbalken + Grain (additiv, wfx-*) ──────── -->
  <div class="wfx-progress" aria-hidden="true"><i id="wfx-prog"></i></div>
  <div class="wfx-grain" aria-hidden="true"></div>
  <script is:inline>
    /* Motion-Gate so früh wie möglich setzen (verhindert Reveal-Flash).
       Ohne JS oder mit reduced-motion bleibt die Seite exakt wie zuvor sichtbar. */
    if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.body.classList.add('wfx-on');
    }
  </script>

  <main id="main-content" class="pt-24 lg:pt-28">

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-border bg-background">
      <div aria-hidden="true" class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full bg-cta/10 blur-3xl"></div>
      <div class="wfx-aurora" aria-hidden="true"><span class="wfx-blob wb1"></span><span class="wfx-blob wb2"></span><span class="wfx-blob wb3"></span></div>
      <div class="wfx-spot" id="wfx-herospot" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-6 pb-16 pt-4 lg:px-8 lg:pb-24 lg:pt-5">
        <Breadcrumb items={[{ label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` }, { label: 'Live-Webinar' }]} class="mb-8" />

        <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_480px] lg:items-center">
        <div class="max-w-3xl">
          <p class="mb-6 inline-flex flex-wrap items-center gap-x-3 gap-y-2 text-sm font-semibold uppercase tracking-widest text-cta-accessible">
            <span class="inline-flex items-center gap-2">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-cta"></span>
              </span>
              Live-Webinar
            </span>
            <span class="text-border" aria-hidden="true">/</span>
            <span class="text-foreground">Di 08.09.2026 · 11:00 Uhr</span>
            <span class="text-border" aria-hidden="true">/</span>
            <span>60 Minuten</span>
          </p>
          <h1 class="cai-h1 cai-kipp text-foreground">
            <span class="k1 block">Wen die KI nicht nennt,</span>
            <span class="k2 block"><FlipWords words={h1FlipWords} client:idle /></span>
          </h1>
          <p class="mt-8 text-xl font-semibold leading-relaxed text-foreground lg:text-2xl">
            Warum Ihre nächsten Aufträge in ChatGPT &amp; Co. entschieden werden — bevor Ihr Vertrieb davon erfährt.
          </p>

          <div class="mt-8 scroll-mt-28" id="anmeldung">
            <WebinarSignup label="Jetzt zum Webinar am 08.09. anmelden" />
            <p class="mt-3 text-xs text-muted-foreground"><span id="w-seats" class="font-semibold text-cta" hidden></span>Begrenzte Teilnehmerzahl · Aufzeichnung für Angemeldete · kostenlos</p>
          </div>

          <!-- Sprecher: Webinare werden ueber Personen gebucht. Diskretionsregel bis 30.10.2026 -> nur Norbert. -->
          <div class="mt-9 flex items-center gap-4 border-t border-border pt-6">
            <img src={`${base}/images/speaker-norbert-schuster.webp`} alt="" width="52" height="52" loading="lazy" decoding="async"
                 class="shrink-0 rounded-full object-cover grayscale" style="height:52px;width:52px" />
            <p class="text-sm leading-relaxed text-muted-foreground">
              Mit <a href="https://www.linkedin.com/in/norbertschuster/" target="_blank" rel="noopener" class="font-semibold text-foreground underline decoration-border underline-offset-2 transition-colors hover:text-cta-accessible">Norbert Schuster</a><br />
              Strategieberater, Autor &amp; Speaker
            </p>
          </div>
        </div>

        <!-- ── Prüfstand ────────────────────────────────────────────────────
             Eigenständiges Werkzeug: Website eingeben, Befund erhalten.
             Der Befund führt in die Anmeldung links und gibt die Domain dorthin
             weiter. Bewusst ohne Quellenangabe.                              -->
        <aside id="pruefstand" data-mode="idle" aria-label="Live-Prüfung: erscheint Ihre Marke in KI-Antworten?">

          <div class="ps-ask rounded-3xl border-2 border-cta bg-card p-7 shadow-xl sm:p-8">
            <p class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-cta-accessible">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-cta"></span>
              </span>
              Live-Check
            </p>
            <p class="ps-h2 font-bold leading-tight text-foreground">Prüfen Sie jetzt, ob die KI Ihre Marke kennt.</p>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">Website eingeben — die Antwort steht in Sekunden.</p>

            <div class="ps-line mt-6">
              <input class="ps-in" id="ps-in" type="text" inputmode="url" spellcheck="false" autocomplete="off"
                     placeholder="ihrefirma.de" aria-label="Ihre Website" />
              <button type="button" class="ps-go" id="ps-go" aria-label="Marke prüfen">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <p class="ps-err mt-3 text-sm font-medium text-cta-accessible" hidden></p>
          </div>

          <div class="ps-work rounded-3xl border-2 border-cta bg-card p-7 shadow-xl sm:p-8">
            <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-cta-accessible">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-cta"></span>
              </span>
              <span class="ps-work-lab">Prüfe …</span>
            </p>
            <span class="ps-scan" aria-hidden="true"></span>
            <div class="space-y-3" aria-hidden="true">
              <span class="ps-bar"></span><span class="ps-bar"></span><span class="ps-bar"></span>
            </div>
          </div>

          <!-- Befund: vollflächig, weiße Schrift auf tiefem Magenta (Weiß hält dort 4,65:1) -->
          <div class="ps-res rounded-3xl p-7 shadow-xl sm:p-8" aria-live="polite">
            <p class="ps-res-kicker text-xs font-bold uppercase tracking-[0.2em]">Geprüft</p>
            <p class="ps-dom mt-2 break-all font-bold leading-none tracking-tight"></p>
            <p class="ps-head mt-6 font-bold leading-[0.95] tracking-tight"></p>
            <p class="ps-lead mt-6 text-lg font-semibold leading-snug"></p>
            <p class="ps-sub mt-3 text-base leading-relaxed"></p>
            <button type="button" class="ps-cta mt-7" id="ps-cta">Platz im Webinar sichern →</button>
            <button type="button" class="ps-again mt-4" id="ps-again">Andere Website prüfen</button>
          </div>

        </aside>
        </div>

        <!-- Studien-Zeile: leitet den Zahlenblock ein (unterhalb der KI-Karte) -->
        <p class="mt-12 text-base leading-relaxed text-muted-foreground lg:text-lg">
          <strong class="text-foreground">Echte Studie, harte Fakten</strong> — erhoben im Juni/Juli 2026.
          <a href={`${base}/studie/`} class="font-medium text-cta-accessible underline decoration-border underline-offset-2 transition-colors hover:text-cta">Zur Studie&nbsp;→</a>
        </p>

        <!-- Kennzahlen-Band (identisch zu /studie) -->
        <dl class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-3">
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-foreground lg:text-5xl" data-count="449">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">untersuchte Unternehmen</span><span class="block">aus 258 Branchen</span></dt>
          </div>
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-foreground lg:text-5xl" data-count="3592">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">firmenspezifische Einkäuferfragen</span><span class="block">zu Produkten &amp; Leistungen</span></dt>
          </div>
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-cta lg:text-5xl" data-count="7184">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">dokumentierte KI-Antworten</span><span class="block">aus ChatGPT &amp; Google KI-Übersicht</span></dt>
          </div>
        </dl>

      </div>
    </section>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <!-- ── Das Problem (Schmerzpunkte) ──────────────────────────────── -->
      <section aria-labelledby="h-problem" class="py-16">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Das Problem</p>
        <h2 id="h-problem" class="cai-h2 wfx-reveal text-foreground">Potenzielle Käufer fragen zuerst die KI — und Sie erfahren nichts davon.</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {painStats.map((p) => (
            <article class="wfx-reveal flex flex-col rounded-2xl border border-border bg-card p-8">
              <span class="wfx-pnum text-5xl font-bold tabular-nums tracking-tight text-cta">{p.n}</span>
              <h3 class="mt-4 text-lg font-semibold leading-snug text-foreground">{p.t}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{p.d}</p>
            </article>
          ))}
        </div>
        <p class="mt-8 max-w-3xl font-medium text-foreground">Und im Alltag fühlt sich das so an:</p>
        <ul class="mt-4 max-w-3xl space-y-3">
          {painDaily.map((t) => (
            <li class="wfx-reveal flex items-start gap-3 leading-relaxed text-muted-foreground">
              <svg class="mt-1 h-5 w-5 shrink-0 text-cta-accessible" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 max-w-3xl text-sm text-muted-foreground">Alle Zahlen aus unserer Auswertung von 7.184 KI-Antworten zu 449 Unternehmen — <a href={`${base}/studie/`} class="font-medium text-cta-accessible underline decoration-border underline-offset-2 hover:text-cta">zur Studie</a>.</p>
      </section>

      <!-- ── Die Lösung / Das erwartet Sie ────────────────────────────── -->
      <section aria-labelledby="h-learnings" class="border-t border-border py-16">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Die Lösung — im Live-Webinar</p>
        <h2 id="h-learnings" class="cai-h2 wfx-reveal text-foreground">Drei Antworten, die Sie aus dem Webinar mitnehmen</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {learnings.map((l, i) => (
            <article class="wfx-reveal flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-cta/10 text-sm font-bold text-cta-accessible">{i + 1}</span>
              <h3 class="mt-4 text-lg font-semibold text-foreground">{l.t}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{l.d}</p>
            </article>
          ))}
        </div>
        <div class="mt-10">
          <WebinarSignup label="Jetzt zum Webinar anmelden" />
        </div>
      </section>

      <!-- ── Ergebnis / Outcome mit Scroll-Audit ──────────────────────── -->
      <section aria-labelledby="h-outcome" class="border-t border-border py-16">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Ihr Ergebnis</p>
        <h2 id="h-outcome" class="cai-h2 wfx-reveal text-foreground">Nach 45 Minuten haben Sie:</h2>
        <ul class="wfx-reveal mt-8 max-w-3xl space-y-4">
          {[
            ['Klarheit, ob ChatGPT & Google-KI Sie empfehlen', ' — und wen die KI stattdessen nennt.'],
            ['Die 5 Hebel, sortiert nach Wirkung', ' — von sichtbar werden bis Aufträge gewinnen.'],
            ['Die Einordnung', ' — was die Ergebnisse von 449 untersuchten Unternehmen aus 258 Branchen für Unternehmen wie Ihres bedeuten.'],
            ['Auf Wunsch: Ihr persönliches Sichtbarkeits-Audit', ' — Ihr individuelles Dashboard zeigt, wie Ihr Unternehmen derzeit in der KI dasteht. Den Zugang senden wir aus Datenschutzgründen persönlich per SMS.'],
          ].map(([t, d]) => (
            <li class="flex items-start gap-3 leading-relaxed text-muted-foreground">
              <svg class="mt-1 h-5 w-5 shrink-0 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
              <span><strong class="text-foreground">{t}</strong>{d}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <WebinarSignup label="Jetzt zum Webinar anmelden" />
        </div>

        {/* Scroll-Bühne (vorerst ausgeblendet auf /webinar, Oli 25.07.2026 — Code bleibt fuer spaetere Wiederverwendung) */}
        {SHOW_AUDIT_PIN && (
        <div class="audit-pin" id="audit-pin">
          <div class="audit-scene">
            <div class="audit-fit" id="audit-fit">
              <div class="audit-card">
                <img id="audit-img" src={`${base}/images/audit-full.webp`} width="1500" height="5678" alt="Komplettes CodaAI Digital Visibility Audit eines mittelständischen Herstellers (anonymisiert): Unternehmensprofil, 27 Sprachversionen, SEO-Kennzahlen, Keyword-Entwicklung, GEO-Score und Einkäuferfragen" loading="lazy" decoding="async" />
              </div>
            </div>
            <p class="audit-title" aria-hidden="true"><span class="at-c">CodaAI</span> <span class="at-p">Digital Visibility Audit</span></p>
            <div class="audit-labels" aria-hidden="true">
              {['Sistrix-KPIs', 'Keyword-Entwicklung', 'Ranking-Verteilung', 'Marktwettbewerb', 'SEO-Wettbewerb', 'KI-Sichtbarkeit', 'Fragen & Antworten aus der KI', 'Erkenntnisse & Diagnose'].map((l) => (
                <span class="audit-label">{l}</span>
              ))}
            </div>
            <div class="audit-bar" aria-hidden="true"><i id="audit-bar-i"></i></div>
            <p class="audit-caption">Echtes Digital Visibility Audit aus dem Studien-Datensatz (anonymisiert)</p>
          </div>
        </div>
        )}
      </section>

      <!-- ── Agenda ───────────────────────────────────────────────────── -->
      <section aria-labelledby="h-agenda" class="border-t border-border py-16">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Ablauf &amp; Sprecher</p>
        <h2 id="h-agenda" class="cai-h2 wfx-reveal text-foreground">Webinar-Agenda</h2>
        <ol id="wfx-agenda" class="wfx-agenda mt-10 space-y-4">
          {agenda.map((a) => (
            <li class="wfx-reveal wfx-agitem flex flex-col gap-2 rounded-2xl border border-border bg-card p-6 sm:flex-row sm:items-baseline sm:gap-6">
              <span class="w-20 shrink-0 text-sm font-bold tabular-nums text-cta-accessible">{a.min}</span>
              <div>
                <h3 class="font-semibold text-foreground">{a.t}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{a.d}</p>
              </div>
            </li>
          ))}
