</Layout>

<script>
  const ENDPOINT = 'https://script.google.com/macros/s/AKfycbyr-OljJObRAtbuujuCIAyv5StyK2hgN_sxiaQZo2RzauxIsizjzSFx5Ij3KJ2t8pvb/exec';

  const dl = (name: string, params: Record<string, string> = {}) => {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: name, ...params });
  };
  dl('webinar_view');

  const $ = (id: string) => document.getElementById(id);
  const form = $('webinar-form') as HTMLFormElement;
  const codeBox = $('webinar-code');
  const codeForm = $('webinar-code-form') as HTMLFormElement;
  const successBox = $('webinar-success');
  const errBox = $('w-error');
  const codeErrBox = $('w-code-error');
  const submitBtn = $('w-submit') as HTMLButtonElement;
  const verifyBtn = $('w-verify') as HTMLButtonElement;
  const resendBtn = $('w-resend') as HTMLButtonElement;

  const ERR: Record<string, string> = {
    name_missing: 'Bitte geben Sie Ihren Namen an.',
    email_invalid: 'Bitte prüfen Sie Ihre E-Mail-Adresse.',
    domain_invalid: 'Bitte prüfen Sie die Domain (z. B. ihre-firma.de).',
    phone_invalid: 'Bitte prüfen Sie die Handynummer (z. B. +49 170 1234567).',
    slot_invalid: 'Bitte wählen Sie einen Termin.',
    consent_missing: 'Bitte bestätigen Sie die Einwilligung.',
    too_many_codes: 'Zu viele Code-Anforderungen — bitte versuchen Sie es in einer Stunde erneut.',
    sms_send_failed: 'SMS-Versand aktuell nicht möglich. Bitte melden Sie sich per E-Mail an: hi@codaai.ai',
    code_missing: 'Bitte geben Sie den 6-stelligen Code ein.',
    code_expired: 'Der Code ist abgelaufen. Bitte fordern Sie einen neuen an.',
    code_invalid: 'Der Code stimmt nicht. Bitte prüfen Sie Ihre Eingabe.',
    code_attempts: 'Zu viele Fehlversuche. Bitte fordern Sie einen neuen Code an.',
    network: 'Verbindung fehlgeschlagen. Bitte erneut versuchen — oder per E-Mail an hi@codaai.ai anmelden.',
  };
  const msg = (k: string) => ERR[k] || ERR.network;

  let payload: Record<string, any> = {};
  let token = '';

  const showErr = (box: HTMLElement | null, key: string) => {
    if (!box) return;
    box.textContent = msg(key);
    box.classList.remove('hidden');
  };

  const post = async (body: Record<string, any>) => {
    const res = await fetch(ENDPOINT, { method: 'POST', body: JSON.stringify(body) });
    return res.json();
  };

  const startResendTimer = () => {
    let s = 60;
    resendBtn.disabled = true;
    const t = setInterval(() => {
      s -= 1;
      resendBtn.textContent = s > 0 ? `Code erneut senden (${s}s)` : 'Code erneut senden';
      if (s <= 0) { clearInterval(t); resendBtn.disabled = false; }
    }, 1000);
  };

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    errBox?.classList.add('hidden');
    if (($('w-hp') as HTMLInputElement)?.value) return; // Honeypot

    const name = ($('w-name') as HTMLInputElement).value.trim();
    const email = ($('w-email') as HTMLInputElement).value.trim();
    const domain = ($('w-domain') as HTMLInputElement).value.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0];
    const phone = ($('w-phone') as HTMLInputElement).value.trim();
    const position = ($('w-position') as HTMLInputElement | null)?.value.trim() ?? '';
    const slot = '2026-09-08';
    const consent = ($('w-consent') as HTMLInputElement).checked;
    const livetest = ($('w-livetest') as HTMLInputElement).checked;

    if (!name) return showErr(errBox, 'name_missing');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return showErr(errBox, 'email_invalid');
    if (!/^[a-z0-9][a-z0-9.-]*\.[a-z]{2,}$/.test(domain)) return showErr(errBox, 'domain_invalid');
    if (!/^\+?[\d\s/()-]{7,20}$/.test(phone)) return showErr(errBox, 'phone_invalid');
    if (!slot) return showErr(errBox, 'slot_invalid');
    if (!consent) return showErr(errBox, 'consent_missing');

    payload = { action: 'webinar_register', name, email, domain, phone, position, slot, consent, livetest };
    submitBtn.disabled = true;
    submitBtn.textContent = 'Code wird gesendet …';
    try {
      const r = await post({ action: 'webinar_code', phone });
      if (!r.ok) { showErr(errBox, r.error); return; }
      token = r.token;
      form.classList.add('hidden');
      codeBox?.classList.remove('hidden');
      const echo = $('w-phone-echo'); if (echo) echo.textContent = r.phone || phone;
      ($('w-code') as HTMLInputElement)?.focus();
      startResendTimer();
    } catch {
      showErr(errBox, 'network');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'SMS-Code anfordern →';
    }
  });

  codeForm?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    codeErrBox?.classList.add('hidden');
    const code = ($('w-code') as HTMLInputElement).value.trim();
    if (!/^\d{6}$/.test(code)) return showErr(codeErrBox, 'code_missing');
    verifyBtn.disabled = true;
    verifyBtn.textContent = 'Wird geprüft …';
    try {
      const r = await post({ ...payload, token, code });
      if (!r.ok) { showErr(codeErrBox, r.error); return; }
      codeBox?.classList.add('hidden');
      successBox?.classList.remove('hidden');
      const when = $('w-success-when'); if (when) when.textContent = r.when || '';
      dl('webinar_signup', { webinar_slot: payload.slot });
      successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      showErr(codeErrBox, 'network');
    } finally {
      verifyBtn.disabled = false;
      verifyBtn.textContent = 'Anmeldung abschließen';
    }
  });

  resendBtn?.addEventListener('click', async () => {
    codeErrBox?.classList.add('hidden');
    try {
      const r = await post({ action: 'webinar_code', phone: payload.phone });
      if (!r.ok) { showErr(codeErrBox, r.error); return; }
      token = r.token;
      startResendTimer();
    } catch {
      showErr(codeErrBox, 'network');
    }
  });

  $('w-back')?.addEventListener('click', () => {
    codeBox?.classList.add('hidden');
    form?.classList.remove('hidden');
  });

  // ── Countdown zum nächsten Termin ────────────────────────────────────────
  const slotDates = ['2026-09-08T11:00:00+02:00'].map((d) => new Date(d));
  const cdBox = $('w-countdown');
  const pad = (n: number) => String(n).padStart(2, '0');
  const tickCd = () => {
    const now = Date.now();
    const next = slotDates.find((d) => d.getTime() > now);
    if (!next || !cdBox) { cdBox?.setAttribute('hidden', ''); return; }
    cdBox.removeAttribute('hidden');
    let rest = Math.floor((next.getTime() - now) / 1000);
    const dd = Math.floor(rest / 86400); rest -= dd * 86400;
    const hh = Math.floor(rest / 3600); rest -= hh * 3600;
    const mm = Math.floor(rest / 60);
    const ss = rest - mm * 60;
    const vals = [String(dd), pad(hh), pad(mm), pad(ss)];
    vals.forEach((v, i) => { const el = $(`cd-${i}`); if (el) el.textContent = v; });
  };
  tickCd();
  setInterval(tickCd, 1000);

  // ── Scroll-Pinning: komplettes Audit läuft durch die 3D-Ebene ───────────
  const pinWrap = $('audit-pin');
  const pinImg = $('audit-img') as HTMLImageElement | null;
  const pinScene = document.querySelector<HTMLElement>('.audit-scene');
  const pinBar = $('audit-bar-i');
  const pinLabels = Array.from(document.querySelectorAll('.audit-label'));
  const CARD_H = 932;
  const fitScale = () => {
    if (!pinScene) return;
    const s = Math.min(window.innerWidth / 1600, window.innerHeight / 1000) * 1.04;
    pinScene.style.setProperty('--s', String(s));
  };
  fitScale();
  if (pinWrap && pinImg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pinTicking = false;
    const pinUpdate = () => {
      pinTicking = false;
      const total = pinWrap.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const p = Math.max(0, Math.min(1, -pinWrap.getBoundingClientRect().top / total));
      const range = pinImg.offsetHeight - CARD_H;
      pinImg.style.transform = `translateY(${-p * range}px)`;
      if (pinBar) pinBar.style.width = `${p * 100}%`;
      if (pinLabels.length) {
        const li = Math.min(pinLabels.length - 1, Math.floor(p * pinLabels.length));
        pinLabels.forEach((el, i) => el.classList.toggle('on', i === li));
      }
    };
    const onPinScroll = () => { if (!pinTicking) { pinTicking = true; requestAnimationFrame(pinUpdate); } };
    window.addEventListener('scroll', onPinScroll, { passive: true });
    window.addEventListener('resize', () => { fitScale(); onPinScroll(); });
    if (pinImg.complete) pinUpdate(); else pinImg.addEventListener('load', pinUpdate);
  }

  // ── Zähler-Animation im Kennzahlen-Band: langsam + nacheinander ──────────
  // 449 zählt hoch → 1 s Pause → 3.592 → 1 s Pause → 7.184
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
  const fmt = new Intl.NumberFormat('de-DE');
  const animate = (el: HTMLElement) => new Promise<void>((resolve) => {
    const target = Number(el.dataset.count ?? '0');
    const dur = 2400;
    const t0 = performance.now();
    const tick = (t: number) => {
      const p = Math.min((t - t0) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt.format(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick); else resolve();
    };
    requestAnimationFrame(tick);
  });
  if (counters.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      for (const c of counters) {
        await animate(c);
        await new Promise((r) => setTimeout(r, 1000));
      }
    }, { threshold: 0.4 });
    io.observe(counters[0]);
  } else {
    counters.forEach((c) => (c.textContent = fmt.format(Number(c.dataset.count ?? '0'))));
  }

  // ── KI-Antwort-Karte: Sequenz-Animation (Frame → Frage tippen → KI denkt → Ergebnisse → Punchline) ──
  const kcard = document.getElementById('ki-card');
  if (kcard && kcard.classList.contains('kianim')) {
    const kwait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const ktext = kcard.querySelector<HTMLElement>('.kq-text');
    const kfull = '„Welche Anbieter sollten wir für unsere Ausschreibung in die engere Wahl nehmen?"';
    (async () => {
      await kwait(500);
      kcard.classList.add('k-frame');            // 1) Grundrahmen + Überschrift
      await kwait(800);
      kcard.classList.add('k-q');                 // 2) Frage-Bubble erscheint
      await kwait(450);
      if (ktext) {                                // 3) Frage wird getippt
        for (let i = 1; i <= kfull.length; i++) {
          ktext.textContent = kfull.slice(0, i);
          await kwait(20 + Math.random() * 24);
        }
      }
      await kwait(400);
      kcard.classList.add('k-think');             // 4) KI "arbeitet"
      await kwait(1600);
      kcard.classList.remove('k-think');
      for (const r of kcard.querySelectorAll('.kres')) {  // Ergebnisse 1–3
        r.classList.add('k-in');
        await kwait(300);
      }
      await kwait(500);
      kcard.querySelector('.kpunch')?.classList.add('k-in');  // 5) Punchline
      await kwait(500);
      kcard.querySelector('.kfoot')?.classList.add('k-in');
      kcard.querySelector('.kcap')?.classList.add('k-in');
      await kwait(1400);
      kcard.classList.add('k-done');              // Caret aus
    })();
  }
</script>

