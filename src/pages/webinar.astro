  var reveals = Array.prototype.slice.call(document.querySelectorAll('.wfx-reveal'));
  reveals.forEach(function(el){
    var sibs = Array.prototype.filter.call(el.parentNode.children, function(c){
      return c.classList && c.classList.contains('wfx-reveal');
    });
    var idx = sibs.indexOf(el);
    if (idx > 0) el.style.transitionDelay = Math.min(idx * 90, 360) + 'ms';
  });
  if (hasIO) {
    var ioR = new IntersectionObserver(function(ents){
      ents.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('wfx-in'); ioR.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function(el){ ioR.observe(el); });
  } else {
    reveals.forEach(function(el){ el.classList.add('wfx-in'); });
  }

  /* ---------- Count-up NUR für echte Zahlen (.wfx-pnum) ---------- */
  var fmtN = new Intl.NumberFormat('de-DE');
  function countUp(el){
    var raw = (el.textContent || '').trim();
    var m = raw.match(/^(\d[\d.  ,]*)\s*(.*)$/);
    if(!m) return;                            // "fast 1/2", "> 1/3" → bleibt unverändert
    var target = parseInt(m[1].replace(/[^\d]/g, ''), 10);
    if(!isFinite(target)) return;
    var suffix = m[2] ? ' ' + m[2] : '';
    var dur = 1200, t0 = null;
    function step(ts){
      if(t0 === null) t0 = ts;
      var p = Math.min(1, (ts - t0) / dur), e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmtN.format(Math.round(target * e)) + suffix;
      if(p < 1) requestAnimationFrame(step); else el.textContent = fmtN.format(target) + suffix;
    }
    requestAnimationFrame(step);
  }
  var pnums = Array.prototype.slice.call(document.querySelectorAll('.wfx-pnum'));
  if (pnums.length && hasIO) {
    var ioC = new IntersectionObserver(function(ents){
      ents.forEach(function(e){ if(e.isIntersecting){ ioC.unobserve(e.target); countUp(e.target); } });
    }, { threshold: 0.5 });
    pnums.forEach(function(el){ ioC.observe(el); });
  }

  /* ---------- Hero: Cursor-Spotlight + KI-Karten-Tilt (innerer Container) ---------- */
  (function(){
    var hero = document.querySelector('#main-content > section');
    var spot = document.getElementById('wfx-herospot');
    var ki = document.getElementById('ki-card');
    var kinner = ki ? ki.querySelector('.rounded-3xl') : null;
    if (ki) ki.classList.add('wfx-ki');
    if (!hero) return;
    hero.addEventListener('pointermove', function(e){
      var r = hero.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
      if (spot){ spot.style.setProperty('--mx', (x*100)+'%'); spot.style.setProperty('--my', (y*100)+'%'); spot.style.opacity = '1'; }
      if (kinner){ kinner.style.transform = 'rotateY(' + ((x-0.5)*7) + 'deg) rotateX(' + ((0.5-y)*7) + 'deg)'; }
    });
    hero.addEventListener('pointerleave', function(){
      if (spot) spot.style.opacity = '0';
      if (kinner) kinner.style.transform = '';
    });
  })();

  /* ---------- Magnetische CTA-Buttons ---------- */
  document.querySelectorAll('#main-content a[href="#anmeldung"]').forEach(function(b){
    b.classList.add('wfx-mag');
