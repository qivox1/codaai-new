---
/* ── /leistungen — Weiterleitung ───────────────────────────────────────────────
   Die Seite heißt seit 28.07.2026 /digital-visibility/ (gleicher Name wie Audit,
   Dashboard und Service-Schema). Diese Datei bleibt nur stehen, damit alte
   Links, Lesezeichen und die kurzzeitig indexierte URL nicht ins Leere laufen.
   GitHub Pages kann kein 301 — deshalb Meta-Refresh + location.replace, dazu
   noindex und ein Canonical auf das neue Ziel. Aus der Sitemap ausgeschlossen
   (Filter in astro.config.mjs).                                                */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/digital-visibility/`;
const canonical = 'https://www.codaai.ai/digital-visibility/';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Weitergeleitet zu Digital Visibility | CodaAI</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center;">
    <p>
      Diese Seite heißt jetzt
      <a href={target} style="color: #B01FD1; font-weight: 600;">Digital Visibility</a>.
    </p>
    <script is:inline set:html={`location.replace(${JSON.stringify(target)});`} />
  </body>
</html>
