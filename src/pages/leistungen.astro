---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Booking from '../components/Booking.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Reveal from '../components/fx/Reveal.astro';

const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* ── /leistungen — die 14 Bausteine (Beschluss 27.07.2026, C3/AP10) ────────────
   Überarbeitung 27.07.2026 (Entscheidung Oli):
   · H1 aus Kundensicht — nicht „was wir liefern", sondern „was Sie brauchen".
     Einleitung erklärt die Logik: Niemand kennt die Formel, aber die belegten
     Faktoren sind bekannt und stecken vollständig im Programm.
   · Wording vereinheitlicht: durchgehend „Stufe 1/2/3" (nie „Ebene"/„Bereich"),
     identisch zu /preise → Stufe 1 · Fundament (Basis) usw.
   · Die Belegzahlen sind bewusst NICHT mehr auf der Seite — sie sind richtig,
     aber in Summe zu viel Lesestoff für den Erstkontakt. Sie bleiben als Feld
     `beleg`/`quelle` hier stehen und gehören ins Verkaufsgespräch und ins
     Angebot. Vollständige Fassung inkl. Studien:
     umbau-digital-visibility/leistungsumfang-14-bausteine.html
   · Darstellung als Akkordeon: Man sieht zuerst die drei Stufen, beim
     Einscrollen öffnet sich die jeweilige Stufe und die Bausteine blenden
     gestaffelt ein. Ohne JavaScript sind alle Stufen offen.
   Lieferentscheidungen 27.07.2026: Vergleichsartikel ehrlich getrennt ·
   YouTube nur eigene Videos · LinkedIn: wir schreiben, Kunde postet ·
   Branchenstudie: wir erheben, Kunde ist Herausgeber · Wikidata statt Wikipedia. */

const stufen = [
  {
    id: 'lesbar',
    nr: 1,
    kicker: 'Stufe 1 · Fundament',
    name: 'Basis',
    frage: 'Kann die KI mein Unternehmen überhaupt lesen und zitieren?',
    antwort:
      'Ihre Website wird für KI-Systeme lesbar, findbar und zitierfähig — und Sie sehen jeden Monat, wo Sie genannt werden und wer statt Ihnen. Diese sechs Bausteine stecken in jeder Stufe.',
    preiszeile: '2–3 Fachbeiträge pro Monat · 490 € je Beitrag · Programm +490 € · ab 1.470 € / Monat',
    bausteine: [
      {
        name: 'Fachbeiträge',
        zusatz: 'der Motor des Programms',
        tut: 'Wir recherchieren, schreiben und veröffentlichen Fachbeiträge von 1.500 bis 4.000 Wörtern — mit Statistiken, Quellenangaben und Expertenzitaten, je Beitrag drei Bilder oder eine Infografik. Wie viele es pro Monat sind, bestimmt Ihre Stufe: 2–3 in Basis, 4–7 in Aktiv, 8–12 in Dominanz.',
        beleg: 'Statistiken, Zitate und Quellenangaben steigern die Sichtbarkeit in KI-Antworten um 30–40 %.',
        quelle: 'Princeton GEO, KDD 2024, 10.000 Abfragen',
      },
      {
        name: 'Monatliche Messung',
        tut: 'Ein beim Start eingefrorener Satz von acht echten Einkäuferfragen wird jeden Monat in ChatGPT und der Google-KI-Übersicht gestellt. Gemessen wird, ob Sie genannt werden, an welcher Stelle, welche Ihrer Seiten als Quelle zitiert werden — und welcher Wettbewerber statt Ihnen dasteht.',
        beleg: 'Ohne Messung kein beweisbarer Erfolg. Vergleichbare Monitoring-Werkzeuge kosten allein 89–499 € pro Monat.',
        quelle: 'Marktvergleich GEO-Monitoring DACH, 07/2026',
      },
      {
        name: 'Google- und Bing-Optimierung',
        tut: 'Klassisches SEO für Ihre Beiträge und Ihre Kernseiten — ausdrücklich inklusive Bing: Bing Webmaster Tools, IndexNow-Anbindung, Indexierungskontrolle. Bing ist kein Nebenschauplatz, sondern die Quelle, aus der ChatGPT seine Belege zieht.',
        beleg: '87 % der SearchGPT-Zitate stammen aus den Bing-Top-Ergebnissen; Google-Seite-1 korreliert mit r ≈ 0,65 mit ChatGPT-Nennungen.',
        quelle: 'Seer Interactive, n > 500',
      },
      {
        name: 'Technische KI-Zugänglichkeit',
        tut: 'Wir prüfen, ob KI-Crawler Ihre Seiten überhaupt lesen können: serverseitiges Rendering, Crawler-Freigaben in der robots.txt, sichtbarer HTML-Text statt PDF oder Bild. Sie bekommen eine Liste umsetzungsreifer Korrekturen für Ihr Web-Team — wir greifen nicht selbst in Ihre Systeme ein.',
        beleg: 'Kein großer KI-Crawler führt JavaScript aus — client-gerenderte Inhalte sind für ChatGPT unsichtbar.',
        quelle: 'Vercel / MERJ, über 500 Mio. GPTBot-Abrufe',
      },
      {
        name: 'Aktualisierung der Bestandsseiten',
        tut: 'Ihre vorhandenen Seiten werden in festen Zyklen inhaltlich aktualisiert und neu datiert, nicht nur neue geschrieben. Anhand der Messung entscheiden wir, welche Seite einen Refresh braucht und welche trägt.',
        beleg: 'KI-Assistenten zitieren 25,7 % frischere Inhalte als die organische Google-Suche; 51,6 % der B2B-Zitate tragen die Jahreszahl im Titel.',
        quelle: 'Ahrefs, 17 Mio. Zitate',
      },
      {
        name: 'Maßnahmenplan aus Ihrem Audit',
        tut: 'Einmalig beim Start wird aus Ihrem Digital Visibility Audit ein priorisierter Plan: was in welcher Reihenfolge, mit welcher Wirkungserwartung. Das Audit selbst bleibt kostenlos — bezahlt wird die Einordnung und der Fahrplan daraus.',
        beleg: 'Grundlage ist die Auswertung von 449 Unternehmen und 7.184 KI-Antworten aus dem eigenen KI-Blindtest.',
        quelle: 'CodaAI-Studie „KI-Blindtest Mittelstand 2026"',
      },
    ],
  },
  {
    id: 'quellen',
    nr: 2,
    kicker: 'Stufe 2 · Skalierung',
    name: 'Aktiv',
    frage: 'Bin ich dort präsent, wo die KI ihre Belege holt?',
    antwort:
      'Die Empfehlung kommt nicht mehr nur von Ihnen selbst. Vier Bausteine außerhalb Ihrer Website — zusätzlich zu allem aus Stufe 1.',
    preiszeile: '4–7 Fachbeiträge pro Monat · 420 € je Beitrag · Programm +990 € · ab 2.670 € / Monat',
    bausteine: [
      {
        name: 'Markennennungen auf Drittseiten',
        zusatz: 'Digital-PR',
        tut: 'Wir platzieren Ihr Unternehmen in Fachportalen, Branchenmedien und Verzeichnissen: Themenrecherche, Redaktionsansprache, fertige Beitragsangebote. Ziel ist die Erwähnung, nicht der Link — deshalb zählen für uns auch Nennungen ohne Verlinkung.',
        beleg: 'Markennennungen korrelieren mit r = 0,664 mit KI-Sichtbarkeit — Backlinks nur mit 0,218.',
        quelle: 'Ahrefs, 75.000 Marken',
      },
      {
        name: 'Vergleichsartikel und Anbieter-Listen',
        tut: 'Wir schreiben und pflegen Ihre eigenen datierten Vergleichs- und Auswahlinhalte — das ist die Leistung, die wir zusagen. Für die Aufnahme in fremde „Beste Anbieter"-Artikel recherchieren wir die Redaktionen, sprechen sie an und liefern die Fakten; über die Aufnahme entscheidet die Redaktion, nicht wir.',
        beleg: '70,8 % aller Zitate bei B2B-Kaufprompts stammen aus „Beste"- und „Top"-Listen.',
        quelle: 'Overthink Group, 1.263 Prompts',
      },
      {
        name: 'Bewertungsplattformen',
        tut: 'Wir legen Ihre Profile auf den Plattformen an und pflegen sie, aus denen KI-Systeme in Ihrer Branche zitieren — ProvenExpert, Trustpilot, Google, bei Software-Nähe G2 und Capterra. Es geht um Vollständigkeit und Aktualität des Profils, nicht um das Sammeln von Bewertungsmassen.',
        beleg: '100 % der von ChatGPT empfohlenen B2B-Werkzeuge hatten ein Capterra-Profil, 99 % ein G2-Profil — die Anzahl der Bewertungen korrelierte nicht.',
        quelle: 'Quoleady',
      },
      {
        name: 'YouTube-Veröffentlichung Ihrer Videos',
        tut: 'Die Social Videos, die wir aus Ihren Fachbeiträgen produzieren, veröffentlichen wir YouTube-gerecht: Titel, Beschreibung, Kapitelmarken und Transkript. Ihren bestehenden Kanal und Ihre älteren Videos fassen wir nicht an — das wäre ein eigenes Projekt.',
        beleg: 'YouTube-Nennungen sind das stärkste Einzelsignal für KI-Sichtbarkeit (r ≈ 0,737); YouTube ist in rund 40 % aller deutschen AI-Mode-Antworten verlinkt.',
        quelle: 'Ahrefs 2026 · SISTRIX',
      },
    ],
  },
  {
    id: 'quelle-werden',
    nr: 3,
    kicker: 'Stufe 3 · Marktführerschaft',
    name: 'Dominanz',
    frage: 'Zitiert die KI mich, weil andere mich zitieren?',
    antwort:
      'Ihr Markt beruft sich auf Ihre Zahlen. Vier Bausteine, die aus einem Anbieter eine Quelle machen — zusätzlich zu allem aus den Stufen 1 und 2.',
    preiszeile: '8–12 Fachbeiträge pro Monat · 390 € je Beitrag · Programm +1.790 € · ab 4.910 € / Monat',
    bausteine: [
      {
        name: 'Eigene Branchenstudie',
        tut: 'Einmal im Jahr entsteht eine Studie, bei der Ihr Unternehmen als Herausgeber auftritt: Wir konzipieren die Fragestellung, erheben die Daten — aus einer Marktbefragung oder aus Ihren vorhandenen Zahlen — und bereiten sie als Studienseite mit Grafiken und Pressetext auf. Verbreitet wird sie über die Digital-PR aus Stufe 2.',
        beleg: 'Eigene Daten-Assets sind der stärkste zitierfähige Inhaltstyp — unsere eigene Studie mit 449 Unternehmen ist der Beweis in eigener Sache.',
        quelle: 'Princeton GEO · CodaAI-Studie 2026',
      },
      {
        name: 'Wissensdatenbanken',
        tut: 'Konkret sind das drei Dinge: ein Wikidata-Eintrag Ihres Unternehmens als maschinenlesbares Strukturwissen, ein vollständiges Google-Unternehmensprofil und die Wissensbasen Ihres Branchensegments. Wikipedia versprechen wir ausdrücklich nicht — die Relevanzkriterien schließen die meisten Mittelständler aus, und ein bezahlter Artikel wird gelöscht.',
        beleg: 'Wissensdatenbanken sind die meistzitierte Einzelquelle in ChatGPT — Wikipedia allein stellt 7,8 % aller Zitate.',
        quelle: 'Semrush · Profound',
      },
      {
        name: 'LinkedIn Ihrer Führungskräfte',
        tut: 'Aus jedem Fachbeitrag entstehen fertige LinkedIn-Beiträge im Namen Ihrer Köpfe, dazu die Optimierung der Profile selbst. Veröffentlicht wird von der Person — wir arbeiten nicht mit fremden Account-Zugängen.',
        beleg: 'LinkedIn erscheint in rund 15 % der AI-Mode-Antworten — im B2B deutlich stärker als Reddit mit 1,4 %.',
        quelle: 'SISTRIX, AI-Mode-Quellen DE',
      },
      {
        name: 'Wettbewerbs-Beobachtung',
        tut: 'Zusätzlich zu Ihren eigenen Nennungen läuft ein monatlicher Vergleich gegen namentlich benannte Wettbewerber: Wer wird in Ihren Einkäuferfragen wie oft empfohlen, und wie verschiebt sich das über die Monate. Dieselbe Datengrundlage wie Ihre Messung, nur mit dem Markt daneben.',
        beleg: 'Basiert auf demselben eingefrorenen Fragensatz wie Ihre Messung — vergleichbar über die gesamte Laufzeit.',
        quelle: 'CodaAI-Messverfahren',
      },
    ],
  },
];

/* Matrix: dieselben 14 Bausteine, kumulativ. Spalten führen in den Preisrechner. */
const matrix = stufen.flatMap((g) =>
  g.bausteine.map((b) => ({
    name: b.name,
    basis: g.nr === 1,
    aktiv: g.nr <= 2,
    dominanz: true,
  })),
);

const spalten = [
  { key: 'basis', label: 'Basis', sub: 'Stufe 1', preis: 'ab 1.470 €', artikel: '2–3' },
  { key: 'aktiv', label: 'Aktiv', sub: 'Stufe 2', preis: 'ab 2.670 €', artikel: '4–7' },
  { key: 'dominanz', label: 'Dominanz', sub: 'Stufe 3', preis: 'ab 4.910 €', artikel: '8–12' },
];

const nichtImAngebot = [
  {
    t: 'llms.txt als bezahlte Leistung',
    d: 'Eine Loganalyse über 137.000 Domains zeigt: 97 % dieser Dateien erhielten null Abrufe. Wir legen sie kostenlos mit an — verkaufen sie aber nicht.',
  },
  {
    t: 'Schema-Markup als „KI-Zitat-Booster"',
    d: 'Im kontrollierten Experiment kein messbarer Effekt auf KI-Zitate. Gehört zur SEO-Basis, ist aber kein Premium-Posten.',
  },
  {
    t: 'Jede Form von Platzierungs-Garantie',
    d: 'KI-Antworten sind nicht deterministisch. „Platz 1 in ChatGPT garantiert" ist das Erkennungszeichen unseriöser Anbieter — buchbare Platzierungen existieren bei keinem KI-System.',
  },
  {
    t: 'Reddit- und Foren-Seeding',
    d: 'Dominiert Verbraucherfragen, im B2B-Nischenkontext aber nur 1,4 % der Zitate — und die Muster schwanken extrem.',
  },
  {
    t: 'Wikipedia-Artikel',
    d: 'Die Relevanzkriterien schließen die meisten Mittelständler aus, bezahlte Artikel werden gelöscht. Wir versprechen Wikidata, nicht Wikipedia.',
  },
  {
    t: '„KI-Traffic ersetzt SEO"',
    d: 'KI-Verweise machen rund 1 % des Traffics aus. Das ehrliche Argument ist die Vorentscheidung im Kaufprozess — nicht das Besuchervolumen.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'CodaAI Digital Visibility',
  serviceType: 'KI-Sichtbarkeit (GEO) und SEO für B2B-Unternehmen',
  provider: { '@id': 'https://www.codaai.ai/#organization' },
  areaServed: 'DE',
  description:
    'Managed Service für Sichtbarkeit in KI-Antworten: 14 Bausteine in drei Stufen — von der technischen Lesbarkeit der Website über Markennennungen auf Drittquellen bis zur eigenen Branchenstudie.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Leistungsbausteine',
    itemListElement: stufen.map((g) => ({
      '@type': 'OfferCatalog',
      name: `${g.kicker} (${g.name})`,
      itemListElement: g.bausteine.map((b) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: b.name, description: b.tut },
      })),
    })),
  },
};
---

<Layout
  lang={lang}
  title="Leistungen – was Ihr Unternehmen für KI-Sichtbarkeit braucht | CodaAI"
  description="Niemand kennt die Formel, nach der ChatGPT & Co. empfehlen. Die belegten Faktoren kennt man — wir haben alle 14 in ein Programm mit drei Stufen gepackt."
>
  <Navbar lang={lang} />
  <main class="pt-0">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-24 lg:pt-28 pb-0">
      <Breadcrumb
        items={[
          { label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` },
          { label: 'Preise', href: `${base}/preise/` },
          { label: 'Leistungen' },
        ]}
        class="mb-0"
      />
    </div>

    <!-- ── 1 · Hero ─────────────────────────────────────────────────────── -->
    <Reveal as="div" class="mx-auto max-w-7xl px-6 lg:px-8 pt-8 lg:pt-10 pb-14 lg:pb-16">
      <h1 class="max-w-4xl text-3xl sm:text-4xl lg:text-5xl font-semibold text-foreground tracking-tight leading-tight sm:leading-tight lg:leading-tight">
        Was Ihr Unternehmen braucht, um in KI-Antworten empfohlen zu werden
      </h1>
      <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-muted-foreground">
        <p>
          Niemand kennt die Formel, nach der ChatGPT, Perplexity oder die Google-KI entscheiden, wen sie
          empfehlen — so wenig, wie vor zwanzig Jahren jemand den Google-Algorithmus kannte. Was man
          kennt, sind die Faktoren, die messbar damit zusammenhängen.
        </p>
        <p>
          Genau die haben wir zusammengetragen: <strong class="font-semibold text-foreground">14 Bausteine</strong>,
          jeder einzelne durch Daten gedeckt, verteilt auf drei Stufen. Stufe 1 macht Ihre Website für
          KI-Systeme lesbar. Stufe 2 bringt Sie auf die Quellen, aus denen die KI ihre Belege holt.
          Stufe 3 macht Sie selbst zu dieser Quelle.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={`${base}/preise/#rechner`}
          class="inline-flex items-center gap-2 rounded-xl bg-cta px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          Preis konfigurieren →
        </a>
        <p class="text-sm text-muted-foreground">
          Programme starten bei <strong class="font-semibold text-foreground">1.470 € pro Monat</strong> · netto · 6 Monate Mindestlaufzeit
        </p>
      </div>
    </Reveal>

    <!-- ── 2 · Die drei Stufen als Akkordeon ────────────────────────────── -->
    <section aria-label="Die drei Stufen und ihre Bausteine" class="border-t border-border bg-muted/20 py-16 lg:py-20">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <Reveal as="div" class="mb-10">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cta-accessible">Das Programm</p>
          <h2 class="max-w-[26ch] text-2xl sm:text-3xl font-semibold tracking-tight text-foreground leading-[1.25] sm:leading-[1.25]">
            Drei Stufen. Vierzehn Bausteine. Eine Rechnung.
          </h2>
          <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-muted-foreground">
            Jede Stufe enthält vollständig, was die Stufe darunter enthält. Klappen Sie auf, was Sie
            interessiert — oder scrollen Sie einfach weiter, dann öffnet es sich von selbst.
          </p>
        </Reveal>

        <div class="cai-acc space-y-4" data-acc>
          {stufen.map((g) => (
            <section id={g.id} class="cai-stufe scroll-mt-24 overflow-hidden rounded-2xl border border-border bg-card lg:scroll-mt-28" data-stufe>
              <h3>
                <button
                  type="button"
                  class="cai-head flex w-full items-start gap-4 p-6 text-left lg:gap-6 lg:p-7"
                  aria-expanded="true"
                  aria-controls={`panel-${g.nr}`}
                  data-head
                >
                  <span class="cai-nr mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-cta/40 bg-cta/10 text-lg font-bold text-foreground">
                    {g.nr}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-[11.5px] font-bold uppercase tracking-widest text-cta-accessible">{g.kicker}</span>
                    <span class="mt-1 block text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
                      {g.name} — {g.frage}
                    </span>
                    <span class="mt-2 block text-[13px] text-muted-foreground">{g.preiszeile}</span>
                  </span>
                  <svg class="cai-chev mt-1 h-5 w-5 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              </h3>

              <div id={`panel-${g.nr}`} class="cai-panel" data-panel>
                <div class="border-t border-border px-6 pb-7 pt-6 lg:px-7">
                  <p class="max-w-[64ch] text-[15px] leading-relaxed text-muted-foreground">{g.antwort}</p>

                  <div class="mt-6 grid gap-4 md:grid-cols-2">
                    {g.bausteine.map((b, i) => (
                      <article class="cai-item rounded-xl border border-border bg-background p-5" style={`--i:${i}`}>
                        <h4 class="text-base font-semibold tracking-tight text-foreground">
                          {b.name}
                          {b.zusatz && (
                            <span class="mt-0.5 block text-[12px] font-normal text-muted-foreground">{b.zusatz}</span>
                          )}
                        </h4>
                        <p class="mt-2.5 text-[14px] leading-relaxed text-muted-foreground">{b.tut}</p>
                      </article>
                    ))}
                  </div>

                  <a
                    href={`${base}/preise/?stufe=${g.name.toLowerCase()}#rechner`}
                    class="mt-6 inline-flex items-center gap-1 text-[13px] font-semibold text-cta-accessible transition-colors hover:text-cta"
                  >
                    Stufe {g.name} im Preisrechner öffnen →
                  </a>
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 3 · Matrix — Spalten führen in den Rechner ───────────────────── -->
    <section id="matrix" aria-label="Alle Bausteine je Stufe" class="border-t border-border py-16 lg:py-24 scroll-mt-24 lg:scroll-mt-28">
      <div class="mx-auto max-w-4xl px-6 lg:px-8">
        <Reveal as="div">
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-foreground leading-[1.25] sm:leading-[1.25]">
            Alle Bausteine auf einen Blick
          </h2>
          <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-muted-foreground">
            Klicken Sie auf eine Spalte — der Preisrechner öffnet sich mit dieser Stufe.
          </p>
        </Reveal>

        <Reveal as="div" delay={90} class="mt-8 overflow-x-auto">
          <table class="cai-matrix w-full min-w-[560px] border-collapse text-left">
            <thead>
              <tr>
                <th scope="col" class="border-b-2 border-border pb-3 pr-4 text-[11px] font-bold uppercase tracking-widest text-muted-foreground">
                  Baustein
                </th>
                {spalten.map((s) => (
                  <th scope="col" class="border-b-2 border-border px-2 pb-3 text-center align-bottom">
                    <a
                      href={`${base}/preise/?stufe=${s.key}#rechner`}
                      class="group block rounded-lg px-2 py-2 transition-colors hover:bg-cta/10"
                    >
                      <span class="block text-[10.5px] font-bold uppercase tracking-widest text-muted-foreground">{s.sub}</span>
                      <span class="mt-0.5 block text-[15px] font-semibold text-foreground">{s.label}</span>
                      <span class="mt-0.5 block text-[12px] text-muted-foreground">{s.preis}</span>
                      <span class="mt-1 block text-[11px] font-semibold text-cta-accessible opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
                        rechnen →
                      </span>
                    </a>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {matrix.map((m) => (
                <tr class="border-b border-border">
                  <th scope="row" class="py-3 pr-4 text-[14px] font-medium text-foreground">{m.name}</th>
                  {[m.basis, m.aktiv, m.dominanz].map((on, ci) => (
                    <td class="px-3 py-3 text-center">
                      <span class="sr-only">{['Basis', 'Aktiv', 'Dominanz'][ci]}: {on ? 'enthalten' : 'nicht enthalten'}</span>
                      {on ? (
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-cta-accessible" aria-hidden="true">
                          <path d="M20 6L9 17l-5-5" />
                        </svg>
                      ) : (
                        <span class="text-muted-foreground/40" aria-hidden="true">—</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
              <tr>
                <th scope="row" class="pt-4 pr-4 text-[13px] font-semibold text-muted-foreground">Fachbeiträge pro Monat</th>
                {spalten.map((s) => (
                  <td class="px-3 pt-4 text-center text-[13px] font-semibold text-foreground">{s.artikel}</td>
                ))}
              </tr>
              <tr>
                <th scope="row" class="pt-2 pr-4 text-[13px] font-semibold text-muted-foreground">Ab Monatspreis</th>
                {spalten.map((s) => (
                  <td class="px-3 pt-2 text-center text-[13px] font-semibold text-foreground">{s.preis.replace('ab ', '')}</td>
                ))}
              </tr>
            </tbody>
          </table>
        </Reveal>

        <Reveal as="p" delay={140} class="mt-6 text-sm text-muted-foreground">
          Übersetzungen kosten 99 € je Sprache und Beitrag, Social Videos 120 € je Video — in jeder Stufe
          gleich. <a href={`${base}/preise/#rechner`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">Zum Preisrechner →</a>
        </Reveal>
      </div>
    </section>

    <!-- ── 4 · Bewusst nicht im Angebot ─────────────────────────────────── -->
    <section id="nicht-im-angebot" data-theme="dark" class="cai-dvdark border-t border-border bg-background py-16 lg:py-24 scroll-mt-24 lg:scroll-mt-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <Reveal as="div">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cta-accessible">Aus über 25 Jahren Erfahrung</p>
          <h2 class="max-w-[24ch] text-2xl sm:text-3xl font-semibold tracking-tight text-foreground leading-[1.25] sm:leading-[1.25]">
            Sechs Dinge, die wir bewusst nicht anbieten
          </h2>
          <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-muted-foreground lg:text-lg">
            Sie stehen in vielen Angeboten dieser Branche. Bei uns nicht — und zwar mit Begründung.
          </p>
        </Reveal>

        <div class="mt-10 grid gap-x-10 gap-y-7 lg:grid-cols-2">
          {nichtImAngebot.map((n, i) => (
            <Reveal as="div" delay={(i % 2) * 80} class="border-l-[3px] border-cta pl-6">
              <h3 class="text-base font-semibold text-foreground">{n.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{n.d}</p>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 5 · Termin ───────────────────────────────────────────────────── -->
    <Booking lang={lang} />

    <!-- ── 6 · Abschluss ────────────────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl border-t border-border px-6 py-14 text-center lg:px-8">
      <Reveal as="div">
        <p class="text-base leading-relaxed text-muted-foreground">
          Welche Stufe zu Ihnen passt, hängt davon ab, wie sichtbar Sie heute sind.
          <a href={`${base}/#angebot`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">Audit kostenlos anfordern →</a>
        </p>
        <p class="mt-3 text-sm text-muted-foreground">
          Oder direkt <a href={`${base}/preise/`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">zu den Preisen</a>.
        </p>
      </Reveal>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />

  <style>
    /* Dezentes Raster für den Ehrlichkeits-Block — identisch zu /preise. */
    .cai-dvdark {
      background-image:
        linear-gradient(hsl(var(--foreground) / 0.05) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--foreground) / 0.05) 1px, transparent 1px);
      background-size: 44px 44px;
    }

    /* ── Akkordeon ──────────────────────────────────────────────────────
       Ohne JavaScript ist alles offen (kein Inhalt geht verloren). Erst die
       Klasse .cai-js, die das Skript setzt, aktiviert das Zuklappen.        */
    .cai-head { cursor: default; }
    .cai-js .cai-head { cursor: pointer; }
    .cai-js .cai-head:hover .cai-chev { color: hsl(var(--foreground)); }
    .cai-chev { transition: transform 0.35s ease, color 0.2s ease; }
    .cai-js .cai-stufe:not(.is-open) .cai-chev { transform: rotate(-90deg); }

    .cai-js .cai-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cai-js .cai-stufe.is-open .cai-panel { max-height: 2400px; }

    /* Bausteine blenden gestaffelt ein, sobald die Stufe geöffnet wird. */
    .cai-js .cai-item {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .cai-js .cai-stufe.is-open .cai-item {
      opacity: 1;
      transform: none;
      transition-delay: calc(120ms + var(--i) * 70ms);
    }

    .cai-stufe.is-open { border-color: hsl(var(--cta) / 0.45); }

    @media (prefers-reduced-motion: reduce) {
      .cai-js .cai-panel { transition: none; }
      .cai-js .cai-item { opacity: 1; transform: none; transition: none; }
      .cai-chev { transition: none; }
    }
  </style>

  <script is:inline>
    (function () {
      var acc = document.querySelector('[data-acc]');
      if (!acc) return;
      var stufen = Array.prototype.slice.call(acc.querySelectorAll('[data-stufe]'));
      if (!stufen.length) return;

      acc.classList.add('cai-js');

      function setOpen(el, open) {
        el.classList.toggle('is-open', open);
        var head = el.querySelector('[data-head]');
        if (head) head.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      // Start: alles zu — außer die Stufe, auf die ein Anker zeigt.
      var hash = (location.hash || '').replace('#', '');
      stufen.forEach(function (el) { setOpen(el, el.id === hash); });

      // Klick öffnet/schließt und markiert die Stufe als "vom Nutzer angefasst",
      // damit der Scroll-Trigger eine bewusste Entscheidung nicht überschreibt.
      stufen.forEach(function (el) {
        var head = el.querySelector('[data-head]');
        if (!head) return;
        head.addEventListener('click', function () {
          el.dataset.touched = '1';
          setOpen(el, !el.classList.contains('is-open'));
        });
      });

      // Scroll-Trigger: Eine Stufe öffnet sich, sobald sie ins Bild kommt — aber
      // immer nur EINE pro Durchgang. Sonst klappen im ersten Callback alle drei
      // gleichzeitig auf (zugeklappt sind sie flach genug, dass alle sichtbar
      // sind). Die geöffnete Stufe schiebt die folgenden nach unten aus dem
      // Trigger-Bereich; die kommen beim Weiterscrollen von selbst dran.
      if ('IntersectionObserver' in window) {
        var open1 = function (el) {
          io.unobserve(el);
          if (el.dataset.touched !== '1') setOpen(el, true);
        };

        var io = new IntersectionObserver(
          function (entries) {
            var hits = entries
              .filter(function (e) { return e.isIntersecting; })
              .map(function (e) { return e.target; })
              .sort(function (a, b) {
                return a.getBoundingClientRect().top - b.getBoundingClientRect().top;
              });
            if (!hits.length) return;
            open1(hits[0]);

            // Sicherheitsnetz für sehr hohe Fenster: Wenn die nachrückenden
            // Stufen nach dem Aufklappen immer noch im Trigger-Bereich stehen,
            // würden sie kein neues Crossing mehr auslösen.
            window.setTimeout(function () {
              var limit = window.innerHeight * 0.65;
              hits.slice(1).forEach(function (el) {
                if (!el.isConnected || el.classList.contains('is-open')) return;
                var r = el.getBoundingClientRect();
                if (r.top < limit && r.bottom > 0) open1(el);
              });
            }, 900);
          },
          { rootMargin: '0px 0px -35% 0px', threshold: 0.1 }
        );
        stufen.forEach(function (el) { if (el.id !== hash) io.observe(el); });
      } else {
        stufen.forEach(function (el) { setOpen(el, true); });
      }
    })();
  </script>

  <Footer lang={lang} />
</Layout>
