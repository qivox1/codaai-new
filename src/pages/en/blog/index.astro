---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import BlogCard from '../../../components/BlogCard.astro';
import BlogReihenFilter from '../../../components/BlogReihenFilter.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import HeroHeadline from '../../../components/HeroHeadline.astro';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.noindex && data.inUebersicht !== false);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0]; // always the newest article
const rest = posts.slice(1);

const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

const collectionSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'CodaAI Blog – AI Visibility for B2B Companies',
  description: 'Evidence-based articles on how B2B companies get named in ChatGPT, Google AI Overviews and Perplexity – in four series: Readable for AI, Citable Content, Getting Mentioned, Measure & Steer.',
  url: `${SITE_URL}/en/blog/`,
  publisher: {
    '@type': 'Organization',
    name: 'CodaAI',
    url: `${SITE_URL}/`,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/og-image.png` },
  },
  hasPart: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: `${SITE_URL}/en/blog/${p.id.replace(/^en\//, '')}/`,
    datePublished: p.data.pubDate.toISOString(),
    author: { '@type': 'Person', name: p.data.author },
  })),
});
---

<Layout
  heroImage={featured?.data.heroImage}
  lang={lang}
  title="Blog – AI Visibility, GEO & SEO for B2B | CodaAI"
  description="How B2B companies get named in ChatGPT, Google AI Overviews and Perplexity: evidence-based articles in four series, every figure checked against the full source."
  jsonLd={[collectionSchema]}
>
  <Navbar lang={lang} />

  <main id="main-content">
    <section class="pt-32 pb-16 lg:pt-40 lg:pb-20 bg-background">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div>
          <Breadcrumb items={[{ label: 'Home', ariaLabel: 'Go to Homepage', href: `${base}/en/` }, { label: 'Blog' }]} class="mb-6" />
          <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-4">Blog</p>
          {/* Kippsatz wie im Deutschen (Beschluss Oli, 10.08.2026). */}
          <HeroHeadline
            line1="The rules of AI visibility keep changing."
            line2="Read them here first."
            class="mb-5 max-w-5xl"
          />
          <p class="max-w-2xl text-lg text-muted-foreground">
            How B2B companies get named in AI answers – in four series, from technology to measurement.
            Every figure checked against the full text of its source.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-background">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">

        {posts.length === 0 && (
          <p class="text-muted-foreground text-center py-20">
            Articles coming soon. Check back shortly!
          </p>
        )}

        <BlogReihenFilter lang={lang} />

        {posts.length > 0 && (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {featured && (
              <BlogCard
                title={featured.data.title}
                description={featured.data.description}
                pubDate={featured.data.pubDate}
                category={featured.data.category}
                reihe={featured.data.reihe}
                tags={featured.data.tags}
                heroImage={featured.data.heroImage}
                heroImageAlt={featured.data.heroImageAlt}
                slug={featured.id.replace(/^en\//, '')}
                lang={lang}
                author={featured.data.author}
                featured={true}
                loading="eager"
              />
            )}
            {rest.map((post, idx) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                reihe={post.data.reihe}
                tags={post.data.tags}
                heroImage={post.data.heroImage}
                heroImageAlt={post.data.heroImageAlt}
                slug={post.id.replace(/^en\//, '')}
                lang={lang}
                author={post.data.author}
              loading={idx < 2 ? "eager" : "lazy"}
              />
            ))}
          </div>
        )}

      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
