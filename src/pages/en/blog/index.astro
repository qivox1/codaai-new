---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import BlogCard from '../../../components/BlogCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.noindex);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);

const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

const collectionSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'CodaAI Blog – AI Content Marketing & SEO',
  description: 'Expert knowledge on AI content, SEO, GEO and content marketing. Practical strategies for better visibility in Google and AI search engines.',
  url: `${SITE_URL}/en/blog/`,
  publisher: {
    '@type': 'Organization',
    name: 'CodaAI',
    url: `${SITE_URL}/`,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/og-image.png` },
  },
  hasPart: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: `${SITE_URL}/en/blog/${p.id}/`,
    datePublished: p.data.pubDate.toISOString(),
    author: { '@type': 'Person', name: p.data.author },
  })),
});
---

<Layout
  lang={lang}
  title="Blog – AI Content Marketing, SEO & GEO | CodaAI"
  description="Expert knowledge on AI content, SEO and Generative Engine Optimization. Practical strategies for better visibility in Google and AI search engines like ChatGPT and Perplexity."
  jsonLd={[collectionSchema]}
>
  <Navbar lang={lang} />

  <main id="main-content">
    <section class="pt-32 pb-16 lg:pt-40 lg:pb-20 bg-background">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-2xl">
          <Breadcrumb items={[{ label: 'Home', href: `${base}/en/` }, { label: 'Blog' }]} class="mb-6" />
          <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-4">Blog</p>
          <h1 class="text-4xl sm:text-5xl font-semibold text-foreground tracking-tight mb-5">
            AI Content Marketing,<br />SEO & GEO
          </h1>
          <p class="text-lg text-muted-foreground">
            Expert knowledge that boosts your visibility in Google <em>and</em> AI search engines.
            From strategy to execution – immediately applicable.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 bg-background">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">

        {posts.length === 0 && (
          <p class="text-muted-foreground text-center py-20">
            Articles coming soon. Check back shortly!
          </p>
        )}

        {posts.length > 0 && (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {featured && (
              <BlogCard
                title={featured.data.title}
                description={featured.data.description}
                pubDate={featured.data.pubDate}
                category={featured.data.category}
                tags={featured.data.tags}
                heroImage={featured.data.heroImage}
                heroImageAlt={featured.data.heroImageAlt}
                slug={featured.id}
                lang={lang}
                author={featured.data.author}
                featured={true}
              />
            )}
            {rest.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                tags={post.data.tags}
                heroImage={post.data.heroImage}
                heroImageAlt={post.data.heroImageAlt}
                slug={post.id}
                lang={lang}
                author={post.data.author}
              />
            ))}
          </div>
        )}

      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
