    a.addEventListener('click', function(e){
      var id = a.getAttribute('href');
      if (id && id.length > 1 && id.charAt(0) === '#') {
        var el = document.querySelector(id);
        if (el) { e.preventDefault(); lenis.scrollTo(el, { offset: -90 }); }
      }
    });
  });

  /* ---------- Agenda: selbstzeichnende Timeline + aufleuchtende Dots ---------- */
  (function(){
    if (window.matchMedia('(max-width: 639px)').matches) return;   // Timeline nur ab sm
    var ol = document.getElementById('wfx-agenda'); if(!ol) return;
    var items = Array.prototype.slice.call(ol.querySelectorAll('.wfx-agitem'));
    if(!items.length) return;
    var rail = document.createElement('i'); rail.className = 'wfx-agrail';
    var fill = document.createElement('b'); rail.appendChild(fill); ol.appendChild(rail);
    var dots = items.map(function(li){
      var d = document.createElement('span'); d.className = 'wfx-agdot'; li.appendChild(d); return d;
    });
    ScrollTrigger.create({
      trigger: ol, start: 'top 78%', end: 'bottom 62%', scrub: 0.5,
      onUpdate: function(self){
        fill.style.transform = 'scaleY(' + self.progress.toFixed(3) + ')';
        var lit = Math.round(self.progress * dots.length);
        dots.forEach(function(d, i){ d.classList.toggle('wfx-lit', i < lit); });
      }
    });
  })();

  /* ---------- Speaker-Porträts: sanfter Scroll-Parallax ---------- */
  gsap.utils.toArray('.wfx-parallax').forEach(function(img){
    gsap.fromTo(img, { y: -8 }, {
      y: 8, ease: 'none',
      scrollTrigger: { trigger: img.closest('article') || img, start: 'top bottom', end: 'bottom top', scrub: 0.6 }
    });
  });

  /* ---------- Positionen neu berechnen, wenn Fonts/Bilder das Layout verschieben ---------- */
  ScrollTrigger.refresh();
  window.addEventListener('load', function(){ ScrollTrigger.refresh(); });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ ScrollTrigger.refresh(); });
  window.addEventListener('resize', function(){ ScrollTrigger.refresh(); });
  setTimeout(function(){ ScrollTrigger.refresh(); }, 800);
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', wfxMotionInit);
} else {
  wfxMotionInit();
}


  /* ── Prüfstand: Verhalten ──────────────────────────────────────────────
     Eigenständiges Werkzeug rechts im Hero. Fragt audit.codaai.ai, zeigt den
     Befund vollflächig und übergibt die Domain an die Anmeldung links.
     Die Datenquelle wird bewusst nirgends genannt.                        */
  (function () {
    var root = document.getElementById('pruefstand');
    if (!root) return;

    var ENDPOINT = 'https://audit.codaai.ai/ai/mentions';
    var inp = document.getElementById('ps-in'),
        go = document.getElementById('ps-go'),
        again = document.getElementById('ps-again'),
        cta = document.getElementById('ps-cta'),
        err = root.querySelector('.ps-err'),
        lab = root.querySelector('.ps-work-lab'),
        elDom = root.querySelector('.ps-dom'),
        elHead = root.querySelector('.ps-head'),
        elLead = root.querySelector('.ps-lead'),
        elSub = root.querySelector('.ps-sub');

    var RE = /^[a-z0-9][a-z0-9.-]*\.[a-z]{2,}$/;
    var cache = {}, last = '';

    var norm = function (raw) {
      var s = (raw || '').trim().toLowerCase();
      s = s.replace(/^https?:\/\//, '').replace(/^www\./, '');
      return s.split(/[/?#]/)[0].trim();
    };
    var setMode = function (m) { root.setAttribute('data-mode', m); };
    var showErr = function (m) { if (err) { err.textContent = m; err.hidden = false; } };
    var clearErr = function () { if (err) err.hidden = true; };

    var countUp = function (to) {
      elHead.classList.add('is-num');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        elHead.textContent = to.toLocaleString('en-GB'); return;
      }
      var t0 = 0, dur = 950;
      var step = function (ts) {
        if (!t0) t0 = ts;
        var p = Math.min(1, (ts - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        elHead.textContent = Math.round(to * e).toLocaleString('en-GB');
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    var render = function (dom, d) {
      elDom.textContent = dom;
      if (d.status === 'found') {
        elHead.textContent = '';
        countUp(d.count || 0);
        elLead.textContent = 'AI answers mention your brand.';
        // Auch der Treffer muss unbequem enden — sonst liest sich eine hohe
        // Zahl als Entwarnung, obwohl sie nichts über die Rangfolge sagt.
        elSub.textContent = 'That number says nothing about where you stand in the answer. '
          + 'Whether you are recommended or merely mentioned, you will see live on 8 September.';
      } else {
        elHead.classList.remove('is-num');
        elHead.textContent = 'Not found.';
        elLead.textContent = 'Not a single AI answer mentions your brand.';
        elSub.textContent = 'Anyone asking about what you do is given other names. '
          + 'Which ones, we show live on 8 September.';
      }
      setMode('result');
      // Domain an die Anmeldung weitergeben
      try {
        document.querySelectorAll('[data-wacta] [data-url]').forEach(function (f) { f.value = dom; });
      } catch (_) {}
    };

    var check = function () {
      var dom = norm(inp ? inp.value : '');
      if (!dom || !RE.test(dom)) { showErr('Please enter a valid website — e.g. yourcompany.com'); if (inp) inp.focus(); return; }
      clearErr();
      last = dom;
      if (cache[dom]) { render(dom, cache[dom]); return; }

      if (lab) lab.textContent = 'Checking ' + dom + ' …';
      setMode('working');

      var ctrl = null, sig;
      try { ctrl = new AbortController(); sig = ctrl.signal; } catch (_) {}
      var bail = setTimeout(function () { try { ctrl && ctrl.abort(); } catch (_) {} }, 12000);
      var t0 = Date.now();

      fetch(ENDPOINT + '?domain=' + encodeURIComponent(dom), { signal: sig, cache: 'reload' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          clearTimeout(bail);
          if (!d || (d.status !== 'found' && d.status !== 'none')) {
            setMode('idle');
            showErr(d && d.status === 'ratelimited'
              ? 'You have checked a lot of websites just now — please try again in an hour.'
              : 'That did not work. Please try again in a moment.');
            return;
          }
          cache[dom] = d;
          // Eine Antwort nach 200 ms wirkt wie ein Trick, nicht wie eine Prüfung.
          var wait = Math.max(0, 1100 - (Date.now() - t0));
          setTimeout(function () { if (last === dom) render(dom, d); }, wait);
        })
        .catch(function () {
          clearTimeout(bail);
          setMode('idle');
          showErr('That did not work. Please try again in a moment.');
        });
    };

    if (go) go.addEventListener('click', check);
    if (inp) inp.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); check(); }
    });
    if (again) again.addEventListener('click', function () {
      setMode('idle'); clearErr();
      if (inp) { inp.value = ''; inp.focus(); }
    });
    if (cta) cta.addEventListener('click', function () {
      var box = document.getElementById('register');
      if (!box) return;
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
      var w = box.querySelector('[data-wacta]');
      if (!w) return;
      // Domain ist bereits bekannt -> direkt zu den Kontaktdaten
      var f = w.querySelector('[data-url]');
      if (f && f.value) { w.setAttribute('data-state', 'contact'); }
      else { var b = w.querySelector('[data-open]'); if (b) b.click(); }
      setTimeout(function () {
        var n = w.querySelector('[data-firstname]');
        if (n) n.focus();
      }, 600);
    });
  })();

</script>
