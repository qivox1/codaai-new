function wfxMotionInit(){
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) return;                       // reduced-motion: Motion-Schicht komplett aus

  var hasIO = 'IntersectionObserver' in window;

  /* ---------- Fortschrittsbalken ---------- */
  var prog = document.getElementById('wfx-prog');
  function onScrollProg(){
    if(!prog) return;
    var h = document.documentElement.scrollHeight - window.innerHeight;
    var p = h > 0 ? (window.scrollY || window.pageYOffset) / h : 0;
    prog.style.width = (Math.max(0, Math.min(1, p)) * 100) + '%';
  }
  window.addEventListener('scroll', onScrollProg, { passive: true });
  window.addEventListener('resize', onScrollProg);
  onScrollProg();

  /* ---------- Reveals (IntersectionObserver, one-shot, mit Geschwister-Stagger) ---------- */
  var reveals = Array.prototype.slice.call(document.querySelectorAll('.wfx-reveal'));
  reveals.forEach(function(el){
    var sibs = Array.prototype.filter.call(el.parentNode.children, function(c){
      return c.classList && c.classList.contains('wfx-reveal');
    });
    var idx = sibs.indexOf(el);
    if (idx > 0) el.style.transitionDelay = Math.min(idx * 90, 360) + 'ms';
