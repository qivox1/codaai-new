    }, { threshold: 0.5 });
    pnums.forEach(function(el){ ioC.observe(el); });
  }

  /* ---------- Hero: Cursor-Spotlight + KI-Karten-Tilt (innerer Container) ---------- */
  (function(){
    var hero = document.querySelector('#main-content > section');
    var spot = document.getElementById('wfx-herospot');
    var ki = document.getElementById('ki-card');
    var kinner = ki ? ki.querySelector('.rounded-3xl') : null;
    if (ki) ki.classList.add('wfx-ki');
    if (!hero) return;
    hero.addEventListener('pointermove', function(e){
      var r = hero.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
      if (spot){ spot.style.setProperty('--mx', (x*100)+'%'); spot.style.setProperty('--my', (y*100)+'%'); spot.style.opacity = '1'; }
      if (kinner){ kinner.style.transform = 'rotateY(' + ((x-0.5)*7) + 'deg) rotateX(' + ((0.5-y)*7) + 'deg)'; }
    });
    hero.addEventListener('pointerleave', function(){
      if (spot) spot.style.opacity = '0';
