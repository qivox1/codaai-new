---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WebinarSignup from '../../components/premium/WebinarSignup.astro';
import FlipWords from '../../components/react/FlipWords';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { faqWebinarEn } from '../../data/faq.en';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Audit-Scroll-Animation auf /webinar vorerst ausgeblendet (Oli 25.07.2026) —
// Markup + Styles + JS bleiben erhalten fuer spaetere Wiederverwendung an anderer Stelle.
const SHOW_AUDIT_PIN = false;

const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

// Apps-Script-Backend (gleiche Web-App wie Buchungs-Widget, Aktionen webinar_code / webinar_register)
const WEBINAR_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyr-OljJObRAtbuujuCIAyv5StyK2hgN_sxiaQZo2RzauxIsizjzSFx5Ij3KJ2t8pvb/exec';

/* ── Der eine Punkt, an dem die englische Seite bewusst NICHT spiegelt ──────
   Das Webinar am 08.09.2026 wird auf Deutsch gehalten: beide Sprecher sprechen
   Deutsch, die Fragerunde laeuft auf Deutsch. Wer das ueberliest, verliert eine
   Stunde — deshalb steht der Hinweis an drei sichtbaren Stellen (Hero,
   unmittelbar ueber der Anmeldung, erste FAQ-Frage) und nicht im
   Kleingedruckten. Nuechtern formuliert, ohne Entschuldigung, und jeweils mit
   dem Ausweg: Audit und 30-Minuten-Gespraech gibt es jederzeit auf Englisch.  */
const LANG_NOTE_SHORT = 'Held in German';

// Rotierende Konsequenz-Zeile der H1 (FlipWords-Effekt wie im Startseiten-Hero)
// Kippsatz: Zeile 1 stellt die Bedingung fest, Zeile 2 dreht sie in die Folge.
const h1FlipWords = [
  { text: 'nobody asks.', color: '#DF41FB' },
  { text: 'you are off the shortlist.', color: '#DF41FB' },
  { text: 'you lose the deal.', color: '#DF41FB', duration: 10000 },
];

const slots = [
  { id: '2026-09-08', day: 'Tuesday', date: '8 September 2026', time: '11:00–12:00 CEST', iso: '2026-09-08T11:00:00+02:00' },
];

// Schmerzpunkte (Problem-Sektion) — jede Zahl aus der eigenen Studie belegt
const painStats = [
  { n: '55%', t: 'of buyer questions produce no mention at all', d: 'In more than half of the questions, the company under review appears in no AI answer at all — and nobody notices, because a non-mention shows up in no statistic.' },
  { n: 'almost 1/2', t: 'are displaced by competitors named outright', d: 'For almost one company in two, the AI recommends the competition by name, while the company itself is missing from the majority of the core questions about its own products and services.' },
  { n: '> 1/3', t: 'invisible despite strong Google rankings', d: 'More than a third of the companies with over 100 top-10 rankings are completely invisible in ChatGPT. Classic SEO strength is no protection.' },
];
const painDaily = [
  'Your enquiries come through referrals and existing customers — and they are noticeably thinning out.',
  'You lead your niche, but outside your own network hardly anyone knows you.',
  'You do not know what ChatGPT answers when buyers ask about what you do — and nobody tells you.',
  'Your website speaks 20 languages — but what the AI says about you in your export markets has never been checked.',
];

// Learnings = die Antworten auf die Schmerzpunkte (Problem → Lösung)
const learnings = [
  {
    t: 'Understand where your deals are decided today',
    d: 'The silent pre-decision, decoded: how buyers research and build their shortlist today, why the decision falls before the first contact — and where your company has to be visible.',
  },
  {
    t: 'See what the AI says about companies like yours',
    d: 'A live audit in front of you: real mid-sized brands in ChatGPT and Google AI Overviews, checked with the methodology of the 8 buyer questions — on request anonymously, including companies from the audience.',
  },
  {
    t: 'Know how to be recommended instead of missing',
    d: 'The roadmap out of invisibility: the 5 levers from visibility to the order — what you can do yourself with the resources you already have, and where the limit is.',
  },
];

const agenda = [
  { min: '20 min', t: 'The silent pre-decision — how buying centres research today and why relevance is built long before the first contact', d: 'Norbert Schuster on the dark funnel, the buying centre and the decision-makers you never meet: how B2B buying processes really run today — and why the course is set long before your sales team comes into play. Starts with a short live poll.' },
  { min: '25 min', t: 'Live audit: recommended or invisible?', d: 'Real mid-sized brands live in ChatGPT and Google AI Overviews, checked with the methodology of the 8 buyer questions and the typical findings from hundreds of audits — plus what you can check yourself with ChatGPT or Copilot, and where the limit is.' },
  { min: '15 min', t: 'Open Q&A', d: 'Your own cases in conversation with Norbert Schuster and Oliver Parrizas: the 5 levers working together — from becoming visible to winning orders — and what happens after the webinar.' },
];

/* Fragen aus der gemeinsamen Quelle src/data/faq.en.ts (Neuverteilung 03.08.2026).
   Die erste Frage ist der Sprachhinweis — sie steht bewusst an erster Stelle. */
const webinarFaq = faqWebinarEn;


const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: webinarFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

/* Einzelnes Event-Objekt statt Array: Layout.astro parst jede jsonLd-Zeichenkette und legt sie
   als Objekt in den @graph — ein Array wurde dort zu {"0":{…}} und war für Google unwirksam.
   Auf der deutschen Seite am 13.08.2026 behoben (44ce29a), hier am 17.08.2026 nachgezogen.
   Es gibt genau einen Termin (slots[0]). */
const eventSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Recommended or invisible? — Why your next orders are decided in ChatGPT and Google AI Overviews',
  startDate: slots[0].iso,
  endDate: slots[0].iso.replace('T11:00', 'T12:00'),
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  /* Das Webinar wird auf Deutsch gehalten. Das gehoert auch ins Schema —
     nicht nur in den sichtbaren Text. */
  inLanguage: 'de',
  location: { '@type': 'VirtualLocation', url: `${SITE_URL}/en/webinar/` },
  organizer: { '@type': 'Organization', name: 'CodaAI', url: SITE_URL },
  performer: [
    { '@type': 'Person', name: 'Norbert Schuster' },
    { '@type': 'Person', name: 'Oliver Parrizas' },
  ],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: `${SITE_URL}/en/webinar/` },
  description: 'Free live webinar, held in German: why B2B orders are decided in AI answers today — with live audits of real companies and a personal visibility audit on request.',
});
---

<Layout
  lang={lang}
  title="Live webinar: Recommended or invisible? | CodaAI"
  description="Free live webinar on why B2B orders are decided in ChatGPT and Google AI Overviews — with live audits of real companies. Held in German."
  jsonLd={[eventSchema, faqSchema]}
  ogImage="https://www.codaai.ai/images/og-webinar.jpg"
>
  <Navbar lang={lang} />

  <!-- ── Motion-Layer: Fortschrittsbalken + Grain (additiv, wfx-*) ──────── -->
  <div class="wfx-progress" aria-hidden="true"><i id="wfx-prog"></i></div>
  <div class="wfx-grain" aria-hidden="true"></div>
  <script is:inline>
    /* Motion-Gate so früh wie möglich setzen (verhindert Reveal-Flash).
       Ohne JS oder mit reduced-motion bleibt die Seite exakt wie zuvor sichtbar. */
    if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.body.classList.add('wfx-on');
    }
  </script>

  <main id="main-content" class="pt-24 lg:pt-28">

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-border bg-background">
      <div aria-hidden="true" class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full bg-cta/10 blur-3xl"></div>
      <div class="wfx-aurora" aria-hidden="true"><span class="wfx-blob wb1"></span><span class="wfx-blob wb2"></span><span class="wfx-blob wb3"></span></div>
      <div class="wfx-spot" id="wfx-herospot" aria-hidden="true"></div>
      <div class="relative z-10 mx-auto max-w-7xl px-6 pb-12 pt-4 lg:px-8 lg:pb-14 lg:pt-5">
        <Breadcrumb items={[{ label: 'Home', ariaLabel: 'Go to homepage', href: `${base}/en/` }, { label: 'Live webinar' }]} class="mb-8" />

        {/* Die Kicker-Zeile steht ueber dem Grid, nicht in der linken Spalte:
            nur so beginnt die linke Spalte mit der H1 — und der Pruefstand
            rechts kann exakt von der H1-Oberkante bis zur Sprecher-Unterkante
            laufen (Wunsch Oli, 03.08.2026). */}
        <p class="mb-6 inline-flex flex-wrap items-center gap-x-3 gap-y-2 text-sm font-semibold uppercase tracking-widest text-cta-accessible">
            <span class="inline-flex items-center gap-2">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-cta"></span>
              </span>
              Live webinar
            </span>
            <span class="text-border" aria-hidden="true">/</span>
            <span class="text-foreground">Tue 8 Sept 2026 · 11:00 CEST</span>
            <span class="text-border" aria-hidden="true">/</span>
            <span>60 minutes</span>
            <span class="text-border" aria-hidden="true">/</span>
            {/* Sprachhinweis 1 von 3 — direkt neben dem Termin, damit ihn
                niemand uebersieht. Siehe LANG_NOTE_SHORT im Frontmatter. */}
            <span class="text-foreground">{LANG_NOTE_SHORT}</span>
        </p>

        <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center">
        <div class="max-w-3xl">
          <h1 class="cai-h1 cai-kipp text-foreground">
            <span class="k1 block">If the AI does not name you,</span>
            <span class="k2 k2-flip block"><FlipWords words={h1FlipWords} gradient client:idle /></span>
          </h1>
          <p class="mt-6 text-xl font-semibold leading-relaxed text-foreground lg:text-2xl">
            Why your next orders are decided in ChatGPT and Google AI Overviews — before your sales team hears about it.
          </p>

          {/* Der ausfuehrliche Sprachhinweis mit dem Ausweg. Bewusst im Hero
              und nicht erst in der FAQ: Wer ihn spaeter liest, hat sich schon
              angemeldet. */}
          <p class="mt-5 max-w-2xl rounded-2xl border border-border bg-muted px-5 py-4 text-sm leading-relaxed text-muted-foreground">
            <strong class="font-semibold text-foreground">This webinar is held in German.</strong>
            Both speakers present in German and the Q&amp;A runs in German. If you would rather have it
            in English: the <a href={`${base}/en/digital-visibility/`} class="font-medium text-cta-accessible underline decoration-border underline-offset-2 transition-colors hover:text-cta">Digital Visibility Audit</a>
            and the 30-minute intro call are available in English at any time.
          </p>

        </div>

        <!-- ── Anmeldekarte ─────────────────────────────────────────────────
             Klassische Webinar-Aufteilung: links das Versprechen, rechts die
             Anmeldung. Der Live-Check ist am 03.08.2026 aus dem Hero gewandert
             (Oli: „immer noch sehr voll") — er wirkt weiter unten ohnehin
             staerker, weil der Leser dann weiss, warum ihn das Ergebnis angeht.
             Norberts Portraet sitzt im Kopf der Karte als Vertrauensanker,
             bewusst klein: Die Datei ist 400 x 400 px, ein grosses Teaserbild
             wuerde auf Retina-Displays weich aussehen.                      -->
        <aside id="register" class="scroll-mt-28">
          <div class="rounded-3xl border-2 border-cta bg-card p-7 shadow-xl sm:p-8">

            <div class="flex items-center gap-4">
              {/* Alt-Text statt alt="" (04.08.2026): Das Portraet ist hier der
                  Vertrauensanker der Anmeldekarte, kein Dekorationsbild — wer
                  es nicht sieht, verliert sonst die Information, dass ein
                  namhafter Gast das Webinar mittraegt. */}
              <img src={`${base}/images/speaker-norbert-schuster-128.webp`} srcset={`${base}/images/speaker-norbert-schuster-128.webp 2x`} alt="Norbert Schuster" width="64" height="64" decoding="async"
                   class="shrink-0 rounded-full object-cover grayscale" style="height:64px;width:64px" />
              <p class="text-sm leading-relaxed text-muted-foreground">
                With <a href="https://www.linkedin.com/in/norbertschuster/" target="_blank" rel="noopener" class="font-semibold text-foreground underline decoration-border underline-offset-2 transition-colors hover:text-cta-accessible">Norbert Schuster</a><br />
                Author of the Haufe standard reference “Digitalisierung in Marketing und Vertrieb”
              </p>
            </div>

            <dl class="mt-6 space-y-2 border-y border-border py-5 text-sm">
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-muted-foreground">Date</dt>
                <dd class="font-semibold text-foreground">Tue, 8 September 2026 · 11:00 CEST</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-muted-foreground">Duration</dt>
                <dd class="font-semibold text-foreground">60 minutes</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-muted-foreground">Attendance</dt>
                <dd class="font-semibold text-foreground">free of charge</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-muted-foreground">Language</dt>
                <dd class="font-semibold text-foreground">German</dd>
              </div>
            </dl>

            <div class="mt-6">
              {/* Sprachhinweis 2 von 3 — unmittelbar ueber dem Anmeldefeld,
                  also an der Stelle, an der die Entscheidung faellt. */}
              <p class="mb-4 rounded-xl bg-muted px-4 py-3 text-xs leading-relaxed text-muted-foreground">
                <strong class="font-semibold text-foreground">This webinar is held in German.</strong>
                The audit and the 30-minute intro call are available in English at any time.
              </p>
              <WebinarSignup label="Secure your place now" lang={lang} />
              {/* Anmeldungen-Zaehler: bis 50 Anmeldungen unsichtbar, traegt seinen
                  Text selbst — ohne ihn frisst keine leere Zeile Platz. */}
              <p id="w-seats" class="mt-3 text-xs font-semibold text-cta" hidden></p>
            </div>

          </div>
        </aside>

        </div>

        {/* Das grosse Kennzahlen-Band ist am 03.08.2026 aus dem Hero geflogen
            („Das Auge ist ueberfordert") — die Zahlen selbst nicht. Sie stehen
            jetzt eine Etage tiefer im Belegband unter dieser Sektion, genau da,
            wo vergleichbare Landingpages ihre Kundenlogos setzen. */}

      </div>
    </section>

    <!-- ── Belegband ────────────────────────────────────────────────────────
         Wir haben vor dem ersten Webinar keine Teilnehmerstimmen und keine
         Kundenlogos — und erfinden auch keine. Was wir haben, ist die eigene
         Messung. Deshalb steht hier kein „andere vertrauen uns", sondern
         „wir haben die Arbeit gemacht, ueber die wir reden".
         Bewusst eine schmale Zeile statt drei grosser Zahlenkacheln: Der
         Beleg soll tragen, nicht schreien (Oli, 03.08.2026).                -->
    <!-- Hintergrund: volles --muted (Navy-50) statt bg-muted/30. Dieselbe helle
         Blaufläche wie die Sektion „Diese Entscheidung fällt an drei Stellen"
         auf der Startseite (.rooms{background:var(--muted)}) — dezente
         Hervorhebung ohne eigene Farbe (Oli, 04.08.2026). -->
    <section aria-label="Evidence base" class="border-b border-border bg-muted">
      <div class="mx-auto flex max-w-7xl flex-col gap-x-8 gap-y-3 px-6 py-5 lg:flex-row lg:items-baseline lg:px-8">
        <p class="shrink-0 text-xs font-semibold uppercase tracking-widest text-cta-accessible">
          The basis of this webinar
        </p>
        <p class="text-sm leading-relaxed text-muted-foreground">
          Study run in June and July 2026:
          <strong class="font-semibold text-foreground">449 companies</strong> across 258 industries,
          <strong class="font-semibold text-foreground">3,592 company-specific buyer questions</strong>,
          <strong class="font-semibold text-foreground">7,184 documented AI answers</strong>
          from ChatGPT and Google AI Overviews.
          <a href={`${base}/en/study/`} class="whitespace-nowrap font-medium text-cta-accessible underline decoration-border underline-offset-2 transition-colors hover:text-cta">Read the study&nbsp;→</a>
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <!-- ── Das Problem (Schmerzpunkte) ──────────────────────────────── -->
      <section aria-labelledby="h-problem" class="py-16">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">The problem</p>
        <h2 id="h-problem" class="cai-h2 wfx-reveal text-foreground">Potential buyers ask the AI first — and you never hear about it.</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {painStats.map((p) => (
            <article class="wfx-reveal flex flex-col rounded-2xl border border-border bg-card p-8">
              <span class="wfx-pnum text-5xl font-bold tabular-nums tracking-tight text-cta">{p.n}</span>
              <h3 class="mt-4 text-lg font-semibold leading-snug text-foreground">{p.t}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{p.d}</p>
            </article>
          ))}
        </div>
        <p class="mt-8 max-w-3xl font-medium text-foreground">Day to day, it feels like this:</p>
        <ul class="mt-4 max-w-3xl space-y-3">
          {painDaily.map((t) => (
            <li class="wfx-reveal flex items-start gap-3 leading-relaxed text-muted-foreground">
              <svg class="mt-1 h-5 w-5 shrink-0 text-cta-accessible" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 max-w-3xl text-sm text-muted-foreground">All figures from our analysis of 7,184 AI answers on 449 companies — <a href={`${base}/en/study/`} class="font-medium text-cta-accessible underline decoration-border underline-offset-2 hover:text-cta">read the study</a>.</p>
      </section>

      <!-- ── Die Lösung / Das erwartet Sie ────────────────────────────── -->
      <section aria-labelledby="h-learnings" class="border-t border-border py-16">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">The answer — in the live webinar</p>
        <h2 id="h-learnings" class="cai-h2 wfx-reveal text-foreground">Three answers you take away from the webinar</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {learnings.map((l, i) => (
            <article class="wfx-reveal flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-cta/10 text-sm font-bold text-cta-accessible">{i + 1}</span>
              <h3 class="mt-4 text-lg font-semibold text-foreground">{l.t}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{l.d}</p>
            </article>
          ))}
        </div>
        <div class="mt-10">
          <WebinarSignup label="Register for the webinar" lang={lang} />
        </div>
      </section>

      <!-- ── Live-Check als Band ──────────────────────────────────────────
           Stand bis zum 03.08.2026 im Hero. Dort beantwortete er eine Frage,
           die der Leser noch nicht gestellt hatte. Hier — nach dem Problem und
           den drei Antworten — ist die Frage gestellt, und der eigene Befund
           beantwortet sie; der naechste Abschnitt liefert direkt danach die
           Aufloesung. Dunkler Grund als Bruch im hellen Lesefluss, gleiches
           Muster wie „Sechs Dinge, die wir nicht anbieten" auf
           /digital-visibility.                                              -->
      <section class="cai-psband" aria-label="Live check">
        <!-- Eigenständiges Werkzeug: Website eingeben, Befund erhalten. Der
             Befund führt in die Anmeldung im Hero und gibt die Domain dorthin
             weiter. Bewusst ohne Quellenangabe.                              -->
        <aside id="pruefstand" data-mode="idle" aria-label="Live check: does your brand appear in AI answers?">

          <!-- Zwei Spalten ab lg: links die Frage, rechts das Feld. Die
               Wrapper sind Pflicht — ohne sie landet jedes einzelne Element
               in einer eigenen Rasterzelle. -->
          <div class="ps-ask rounded-3xl border-2 border-cta bg-card p-7 shadow-xl sm:p-8">
            <div class="ps-col-text">
              <p class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-cta-accessible">
                <span class="relative flex h-2 w-2" aria-hidden="true">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-60"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-cta"></span>
                </span>
                Live check
              </p>
              <p class="ps-h2 font-bold leading-tight text-foreground">Check right now whether the AI knows your brand.</p>
              <p class="mt-3 text-base leading-relaxed text-muted-foreground">Enter your website — the answer is there in seconds.</p>
            </div>

            <div class="ps-col-line mt-6 lg:mt-0">
              <div class="ps-line">
                <input class="ps-in" id="ps-in" type="text" inputmode="url" spellcheck="false" autocomplete="off"
                       placeholder="yourcompany.com" aria-label="Your website" />
                <button type="button" class="ps-go" id="ps-go" aria-label="Check brand">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              <p class="ps-err mt-3 text-sm font-medium text-cta-accessible" hidden></p>
            </div>
          </div>

          <div class="ps-work rounded-3xl border-2 border-cta bg-card p-7 shadow-xl sm:p-8">
            <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-cta-accessible">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-cta"></span>
              </span>
              <span class="ps-work-lab">Checking …</span>
            </p>
            <span class="ps-scan" aria-hidden="true"></span>
            <div class="space-y-3" aria-hidden="true">
              <span class="ps-bar"></span><span class="ps-bar"></span><span class="ps-bar"></span>
            </div>
          </div>

          <!-- Befund: vollflächig, weiße Schrift auf tiefem Magenta (Weiß hält dort 4,65:1) -->
          <div class="ps-res rounded-3xl p-7 shadow-xl sm:p-8" aria-live="polite">
            <p class="ps-res-kicker text-xs font-bold uppercase tracking-[0.2em]">Checked</p>
            <p class="ps-dom mt-2 break-all font-bold leading-none tracking-tight"></p>
            <p class="ps-head mt-6 font-bold leading-[0.95] tracking-tight"></p>
