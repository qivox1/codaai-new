<script>
  const ENDPOINT = 'https://script.google.com/macros/s/AKfycbyr-OljJObRAtbuujuCIAyv5StyK2hgN_sxiaQZo2RzauxIsizjzSFx5Ij3KJ2t8pvb/exec';

  const dl = (name: string, params: Record<string, string> = {}) => {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: name, ...params });
  };
  dl('webinar_view');

  const $ = (id: string) => document.getElementById(id);
  const form = $('webinar-form') as HTMLFormElement;
  const successBox = $('webinar-success');
  const errBox = $('w-error');
  const submitBtn = $('w-submit') as HTMLButtonElement;

  const ERR: Record<string, string> = {
    name_missing: 'Please enter your first and last name.',
    email_invalid: 'Please check your email address.',
    consent_missing: 'Please confirm your consent.',
    network: 'Connection failed. Please try again — or register by email at hi@codaai.ai.',
  };
  const msg = (k: string) => ERR[k] || ERR.network;

  const showErr = (box: HTMLElement | null, key: string) => {
    if (!box) return;
    box.textContent = msg(key);
    box.classList.remove('hidden');
  };

  const post = async (body: Record<string, any>) => {
    const res = await fetch(ENDPOINT, { method: 'POST', cache: 'reload', body: JSON.stringify(body) });
    return res.json();
  };

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    errBox?.classList.add('hidden');
    if (($('w-hp') as HTMLInputElement)?.value) return; // Honeypot

    const firstname = ($('w-name') as HTMLInputElement).value.trim();
    const lastname = ($('w-lastname') as HTMLInputElement).value.trim();
    const email = ($('w-email') as HTMLInputElement).value.trim();
    const slot = '2026-09-08';
    const consent = ($('w-consent') as HTMLInputElement).checked;
    const livetest = ($('w-livetest') as HTMLInputElement).checked;

    if (!firstname || !lastname) return showErr(errBox, 'name_missing');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return showErr(errBox, 'email_invalid');
    if (!consent) return showErr(errBox, 'consent_missing');

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending …';
    try {
      const r = await post({ action: 'webinar_register', name: `${firstname} ${lastname}`, email, domain: '', phone: '', position: '', slot, consent, livetest });
      if (!r.ok) { showErr(errBox, r.error); return; }
      form.classList.add('hidden');
      successBox?.classList.remove('hidden');
      const when = $('w-success-when'); if (when) when.textContent = r.when || '';
      dl('webinar_signup', { webinar_slot: slot });
      successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      showErr(errBox, 'network');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send registration →';
    }
  });

  // ── Countdown zum nächsten Termin ────────────────────────────────────────
  // Bewusst erst ab 2 Wochen vor dem Termin sichtbar (Entscheidung Oli × Norbert 17.07.):
  // bei 50+ Tagen Restlaufzeit wirkt ein Countdown kontraproduktiv.
  const CD_SHOW_FROM = new Date('2026-08-25T00:00:00+02:00').getTime();
  const slotDates = ['2026-09-08T11:00:00+02:00'].map((d) => new Date(d));
  const cdBox = $('w-countdown');
  const pad = (n: number) => String(n).padStart(2, '0');
  const tickCd = () => {
    const now = Date.now();
    const next = slotDates.find((d) => d.getTime() > now);
    if (!next || now < CD_SHOW_FROM) { cdBox?.setAttribute('hidden', ''); return; }
    cdBox?.removeAttribute('hidden');
    let rest = Math.floor((next.getTime() - now) / 1000);
    const dd = Math.floor(rest / 86400); rest -= dd * 86400;
    const hh = Math.floor(rest / 3600); rest -= hh * 3600;
    const mm = Math.floor(rest / 60);
    const ss = rest - mm * 60;
    const vals = [String(dd), pad(hh), pad(mm), pad(ss)];
    vals.forEach((v, i) => {
      const el = $(`cd-${i}`); if (el) el.textContent = v;
    });
  };
  tickCd();
  setInterval(tickCd, 1000);

  // ── Anmeldungen-Zähler (Social Proof) — erscheint erst ab 50 Anmeldungen ─
  fetch(`${ENDPOINT}?action=webinar_seats`, { cache: 'reload' })
    .then((r) => r.json())
    .then((j) => {
      const el = $('w-seats');
      if (el && j?.ok && Number(j.count) >= 50) {
        el.textContent = `Already ${new Intl.NumberFormat('en-GB').format(j.count)} registrations`;
        el.removeAttribute('hidden');
      }
    })
    .catch(() => {});

  // ── Scroll-Pinning: komplettes Audit läuft durch die 3D-Ebene ───────────
  const pinWrap = $('audit-pin');
  const pinImg = $('audit-img') as HTMLImageElement | null;
  const pinScene = document.querySelector<HTMLElement>('.audit-scene');
  const pinBar = $('audit-bar-i');
  const pinLabels = Array.from(document.querySelectorAll('.audit-label'));
  const CARD_H = 932;
  const fitScale = () => {
    if (!pinScene) return;
    const s = Math.min(window.innerWidth / 1600, window.innerHeight / 1000) * 1.04;
    pinScene.style.setProperty('--s', String(s));
    requestAnimationFrame(() => {
      const t = pinScene.querySelector('.audit-title');
      const l = pinScene.querySelector<HTMLElement>('.audit-labels');
      if (t && l) {
        const sr = pinScene.getBoundingClientRect();
        const tr = t.getBoundingClientRect();
        l.style.right = `${Math.max(30, Math.round(sr.right - tr.left))}px`;
      }
      // Overlap-Schutz (Norbert-Feedback 17.07.): Ragt die gekippte Karte bis unter
      // Titel/Labels, bekommen beide einen dunklen Chip-Hintergrund — lesbar statt Kollision.
      const card = pinScene.querySelector('.audit-card');
      if (t && card) {
        const cr = card.getBoundingClientRect();
        const tr2 = t.getBoundingClientRect();
        pinScene.classList.toggle('labels-clash', cr.right > tr2.left - 12);
      }
    });
  };
  fitScale();
  if (document.fonts?.ready) document.fonts.ready.then(fitScale);
  if (pinWrap && pinImg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pinTicking = false;
    const pinUpdate = () => {
      pinTicking = false;
      const total = pinWrap.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const p = Math.max(0, Math.min(1, -pinWrap.getBoundingClientRect().top / total));
      const range = pinImg.offsetHeight - CARD_H;
      pinImg.style.transform = `translateY(${-p * range}px)`;
      if (pinBar) pinBar.style.width = `${p * 100}%`;
      if (pinLabels.length) {
        const li = Math.min(pinLabels.length - 1, Math.floor(p * pinLabels.length));
        pinLabels.forEach((el, i) => el.classList.toggle('on', i === li));
      }
    };
    const onPinScroll = () => { if (!pinTicking) { pinTicking = true; requestAnimationFrame(pinUpdate); } };
    window.addEventListener('scroll', onPinScroll, { passive: true });
    window.addEventListener('resize', () => { fitScale(); onPinScroll(); });
    if (pinImg.complete) pinUpdate(); else pinImg.addEventListener('load', pinUpdate);
  }

  // Die Zaehler-Animation fuer das Kennzahlen-Band ist mit dem Band selbst
  // entfallen (03.08.2026). Wer das Band zurueckholt, braucht sie wieder —
  // sie steht in der Versionsgeschichte zu diesem Commit.

  // ── KI-Antwort-Karte: Sequenz-Animation (Frame → Frage tippen → KI denkt → Ergebnisse → Punchline) ──
  const kcard = document.getElementById('ki-card');
  if (kcard && kcard.classList.contains('kianim')) {
    const kwait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const ktext = kcard.querySelector<HTMLElement>('.kq-text');
    const kfull = '“Which providers should we shortlist for our tender?”';
    (async () => {
      await kwait(500);
      kcard.classList.add('k-frame');            // 1) Grundrahmen + Überschrift
      await kwait(800);
      kcard.classList.add('k-q');                 // 2) Frage-Bubble erscheint
      await kwait(450);
      if (ktext) {                                // 3) Frage wird getippt
        for (let i = 1; i <= kfull.length; i++) {
          ktext.textContent = kfull.slice(0, i);
          await kwait(20 + Math.random() * 24);
        }
      }
      await kwait(400);
      kcard.classList.add('k-think');             // 4) KI "arbeitet"
      await kwait(1600);
      kcard.classList.remove('k-think');
      for (const r of kcard.querySelectorAll('.kres')) {  // Ergebnisse 1–3
        r.classList.add('k-in');
        await kwait(300);
      }
      await kwait(500);
      kcard.querySelector('.kpunch')?.classList.add('k-in');  // 5) Punchline
      await kwait(500);
      kcard.querySelector('.kfoot')?.classList.add('k-in');
      kcard.querySelector('.kcap')?.classList.add('k-in');
      await kwait(1400);
      kcard.classList.add('k-done');              // Caret aus
    })();
  }
</script>

<style>
  /* ── Scroll-Audit-Bühne (Geometrie identisch zum Video-Render) ── */
  .audit-pin { height: 300vh; position: relative; margin-top: 3.5rem; }
  /* 100svh (kleine Viewport-Hoehe) statt 100vh: Auf Mobiltelefonen meint 100vh
     die Hoehe OHNE Adressleiste — die Buehne war dadurch hoeher als das Sichtfeld,
     der untere Rand lag hinter der Leiste und jedes Ein- und Ausfahren loeste ein
     resize samt ScrollTrigger-Neuberechnung aus (das Springen beim Scrollen).
     100vh bleibt als Rueckfallwert davor stehen.
     Befund A2 des Mobil-Audits vom 04.08.2026.                                */
  .audit-scene { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: hsl(var(--surface-ink)); border-radius: 24px; }
  .audit-scene::before {
    content: "";
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(42% 46% at 62% 68%, rgba(120, 10, 140, 0.55), transparent 70%),
      radial-gradient(30% 34% at 78% 30%, rgba(90, 8, 105, 0.4), transparent 70%);
    filter: blur(60px);
  }
  .audit-fit { position: absolute; left: 50%; top: 50%; width: 1600px; height: 1000px; transform: translate(-50%, -50%) scale(var(--s, 0.5)); }
  .audit-card {
    position: absolute; left: 0; top: 0; width: 1100px; height: 932px; overflow: hidden;
    border-radius: 26px; border: 2px solid rgba(255, 255, 255, 0.28); background: #fff;
    transform-origin: 0 0;
    transform: matrix3d(0.716517, 0.145607, 0, -0.00010973, -0.36913, 0.48935, 0, -0.00005871, 0, 0, 1, 0, 500, 130, 0, 1);
    box-shadow: -40px 70px 90px rgba(0, 0, 0, 0.55);
  }
  .audit-card img { display: block; width: 100%; will-change: transform; }
  .audit-foot {
    position: absolute; left: 24px; right: 24px; bottom: 22px; z-index: 2;
    display: flex; flex-direction: column; gap: 10px; align-items: flex-start;
  }
  .audit-caption { color: rgba(255, 255, 255, 0.65); font-size: 13px; margin: 0; }
  /* Titel-Oberkante auf Höhe der Karten-Oberkante (Stage-y 130), Labels entlang der
     unteren Kartenkante (BL 165/620 → BR 1145/905, Neigung ~16.2°) — Positionen und
     Schriftgrößen skalieren über --s mit der Grafik mit. */
  .audit-title {
    position: absolute; top: calc(50% + var(--s, 0.5) * -370px); right: 30px; z-index: 2; margin: 0;
    text-align: right; font-size: max(14px, calc(var(--s, 0.5) * 40px)); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2;
  }
  .audit-title .at-c { color: #fff; }
  .audit-title .at-p { color: hsl(var(--cta-on-dark)); }
  .audit-labels {
    position: absolute; z-index: 2; right: 30px; /* wird per JS auf die linke Titelkante gesetzt */
    bottom: calc(50% + var(--s, 0.5) * -405px);
    width: min(60%, 700px); text-align: right;
    font-size: max(14px, calc(var(--s, 0.5) * 40px));
  }
  .audit-label {
    position: absolute; right: 0; bottom: 0;
    font-weight: 600; letter-spacing: -0.01em; color: #fff; line-height: 1.25;
    opacity: 0; transform: translateY(12px);
    transition: opacity .45s ease, transform .45s cubic-bezier(.22, 1, .36, 1);
  }
  .audit-label.on { opacity: 1; transform: none; }
  /* Overlap-Schutz: wenn die Karte bis unter die Texte ragt (schmale Fenster),
     bekommen Titel + Labels einen dunklen Chip — Overlay statt unlesbarer Kollision. */
  .labels-clash .audit-title,
  .labels-clash .audit-label {
