---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  lang="en"
  title="Legal Notice – CodaAI | Provider Information"
  description="Legal notice of CodaAI: Provider information, contact details, commercial register entry and responsible person pursuant to § 5 TMG (German Telemedia Act)."
>
  <Navbar lang="en" />
  <main class="pt-24 lg:pt-28" id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-16 lg:py-24">
      <Breadcrumb items={[{ label: 'Home', href: `${base}/en/` }, { label: 'Legal Notice' }]} class="mb-8" />
      <h1 class="text-4xl font-bold text-foreground mb-2">Legal Notice</h1>
      <p class="text-muted-foreground mb-12">
        Information pursuant to § 5 DDG (German Digital Services Act)
      </p>

      <div class="space-y-10">
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Service Provider
          </h2>
          <div class="text-muted-foreground space-y-1">
            <p class="font-medium text-foreground">CodaAI – a brand of AMP Beratung</p>
            <p>Owner: Anja Miebach</p>
            <p>Langer Weg 7b</p>
            <p>33332 Gütersloh</p>
            <p>Germany</p>
          </div>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Contact
          </h2>
          <div class="text-muted-foreground space-y-1">
            <p>Phone: +49 (0) 151 53 40 69 69</p>
            <p>
              E-mail: <a href="mailto:hi@codaai.ai" class="text-cta hover:underline">hi@codaai.ai</a>
            </p>
          </div>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            VAT Identification Number
          </h2>
          <p class="text-muted-foreground">
            VAT identification number pursuant to § 27a of the German Value Added Tax Act (UStG): DE275655431
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Editorially Responsible
          </h2>
          <div class="text-muted-foreground space-y-1">
            <p>Anja Miebach</p>
            <p>Langer Weg 7b</p>
            <p>33332 Gütersloh, Germany</p>
          </div>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            EU Dispute Resolution
          </h2>
          <p class="text-muted-foreground">
            The European Commission provides a platform for online dispute resolution (ODR):&nbsp;
            <a
              href="https://ec.europa.eu/consumers/odr/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-cta hover:underline"
            >
              https://ec.europa.eu/consumers/odr/
            </a>. Our e-mail address can be found above.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Consumer Dispute Resolution
          </h2>
          <p class="text-muted-foreground">
            We are neither willing nor obliged to participate in dispute resolution proceedings before a consumer arbitration board.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Professional Liability Insurance
          </h2>
          <div class="text-muted-foreground space-y-4">
            <div>
              <p class="font-medium text-foreground mb-1">Name and registered office of the insurer:</p>
              <p>Allianz Versicherungs-AG</p>
              <p>Königinstraße 28</p>
              <p>80802 Munich, Germany</p>
            </div>
            <div>
              <p class="font-medium text-foreground mb-1">Territorial scope of insurance:</p>
              <p>Germany</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
  <Footer lang="en" />
</Layout>
