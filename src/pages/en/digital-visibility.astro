---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Booking from '../../components/Booking.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Reveal from '../../components/fx/Reveal.astro';
import HeroHeadline from '../../components/HeroHeadline.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { faqVisibilityEn } from '../../data/faq.en';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* ── /en/digital-visibility — the 14 building blocks ──────────────────────────
   English mirror of `src/pages/digital-visibility.astro` (EN relaunch,
   04.08.2026). Same sections, same order, same classes, IDs, data attributes
   and scripts — only visible text, anchors and links are English. This is a
   translation, not a redesign: anything changed here has to be changed in the
   German file too, and vice versa.

   Conventions applied (en-relaunch-2026-08-04/KONVENTIONEN.md):
   · Stufe → tier · Baustein → building block · Grundpreis → base fee
   · Tier 1 · Found / Tier 2 · Recommended / Tier 3 · Cited
   · The AI is always "it", never "she"/"they"
   · No "programme", no "guarantee" in connection with visibility
   · Anchors: #lesbar → #readable · #quellen → #sources ·
     #quelle-werden → #become-the-source · #matrix → #matrix ·
     #nicht-im-angebot → #not-included
   · Calculator links use `tier=` (the EN query parameter); the values
     basis|aktiv|dominanz are internal keys and stay untranslated.

   `Booking.astro` became bilingual on 04.08.2026 and emits `id="appointment"`
   for English, so the anchor map holds on this page too. */

const stufen = [
  {
    id: 'readable',
    nr: 1,
    key: 'basis',
    kumuliert: 6,
    kicker: 'Tier 1',
    name: 'Found',
    frage: 'Can the AI read and cite my company at all?',
    antwort:
      'Your website becomes readable and citable for AI systems. These six building blocks are part of every tier.',
    preiszeile: '2–3 expert articles per month · from €1,470 / month',
    bausteine: [
      {
        name: 'Action plan from your audit',
        tut: 'Your free audit turns into a prioritised plan for the start: what comes first, what comes after.',
        beleg:
          'The basis is the analysis of 449 companies and 7,184 AI answers from our own AI blind test.',
        quelle: 'CodaAI study “AI Blind Test 2026”',
      },
      {
        name: 'Technical AI accessibility',
        tut: 'We check whether AI crawlers can read your pages and hand your web team the list of fixes.',
        beleg:
          'No major AI crawler executes JavaScript — client-rendered content is invisible to ChatGPT.',
        quelle: 'Vercel / MERJ, over 500 million GPTBot requests',
      },
      {
        name: 'Expert articles',
        tut: 'We research, write and publish articles that AI systems can cite as a source.',
        beleg:
          'Statistics, quotations and cited sources raise visibility in AI answers by 30–40%.',
        quelle: 'Princeton GEO, KDD 2024, 10,000 queries',
      },
      {
        name: 'Updates to your existing pages',
        tut: 'Your existing pages are refreshed on a fixed cycle — not just new ones written.',
        beleg: 'AI assistants cite content 25.7% fresher than organic Google search does.',
        quelle: 'Ahrefs, 17 million citations',
      },
      {
        name: 'Google and Bing optimisation',
        tut: 'Classic SEO for your pages, explicitly including Bing — that is where ChatGPT pulls its evidence from.',
        beleg: '87% of SearchGPT citations come from the Bing top results.',
        quelle: 'Seer Interactive, n > 500',
      },
      {
        name: 'Monthly measurement',
        tut: 'Eight real buyer questions, put to ChatGPT and Google’s AI every month — you see who gets mentioned.',
        beleg:
          'No measurement, no provable result. Comparable monitoring tools alone cost €89–499 per month.',
        quelle: 'GEO monitoring market comparison DACH, 07/2026',
      },
    ],
  },
  {
    id: 'sources',
    nr: 2,
    key: 'aktiv',
    kumuliert: 10,
    kicker: 'Tier 2',
    name: 'Recommended',
    frage: 'Am I present where the AI sources its evidence?',
    antwort:
      'The recommendation no longer comes from you alone. Four building blocks away from your website — on top of everything in Tier 1.',
    preiszeile: '4–7 expert articles per month · from €2,670 / month',
    bausteine: [
      {
        name: 'Brand mentions on third-party sites',
        zusatz: 'Digital PR',
        tut: 'We place your company on trade portals and in industry media — the mention counts, not the link.',
        beleg:
          'Brand mentions correlate with AI visibility at r = 0.664 — backlinks only at 0.218.',
        quelle: 'Ahrefs, 75,000 brands',
      },
      {
        name: 'Comparison articles and provider lists',
        tut: 'We write your own comparison content and put you in front of editors for their provider lists.',
        beleg: '70.8% of all citations on B2B buying prompts come from “best” and “top” lists.',
        quelle: 'Overthink Group, 1,263 prompts',
      },
      {
        name: 'Review platforms',
        tut: 'We set up and maintain the profiles AI systems cite from in your industry.',
        beleg:
          '100% of the B2B tools recommended by ChatGPT had a Capterra profile, 99% a G2 profile.',
        quelle: 'Quoleady',
      },
      {
        name: 'YouTube publishing for your videos',
        tut: 'We publish the videos from your articles the way YouTube expects — with title, chapters and transcript.',
        beleg:
          'YouTube mentions are the single strongest signal for AI visibility (r ≈ 0.737).',
        quelle: 'Ahrefs 2026 · SISTRIX',
      },
    ],
  },
  {
    id: 'become-the-source',
    nr: 3,
    key: 'dominanz',
    kumuliert: 14,
    kicker: 'Tier 3',
    name: 'Cited',
    frage: 'Do others cite my figures?',
    antwort:
      'Your market cites your figures. Four building blocks that turn a provider into a source — on top of Tiers 1 and 2.',
    preiszeile: '8–12 expert articles per month · from €4,910 / month',
    bausteine: [
      {
        name: 'Knowledge bases',
        tut: 'Wikidata entry, Google Business Profile and the knowledge bases of your industry segment.',
        beleg: 'Knowledge bases are the single most cited source in ChatGPT.',
        quelle: 'Semrush · Profound',
      },
      {
        name: 'LinkedIn for your leadership',
        tut: 'Finished LinkedIn posts that pay into your business goals — published by your leadership team or by any colleague in the company.',
        beleg:
          'LinkedIn appears in around 15% of AI Mode answers — far stronger in B2B than Reddit at 1.4%.',
        quelle: 'SISTRIX, AI Mode sources DE',
      },
      {
        name: 'An industry study of your own',
        tut: 'Once a year a study with your company as the publisher — we run it and design it.',
        beleg: 'Proprietary data assets are the strongest citable content type there is.',
        quelle: 'Princeton GEO · CodaAI study 2026',
      },
      {
        name: 'Competitor monitoring',
        tut: 'A monthly comparison against named competitors: who gets recommended in your questions, and how often?',
        beleg:
          'Based on the same frozen question set as your measurement — comparable across the whole term.',
        quelle: 'CodaAI measurement method',
      },
    ],
  },
];

/* ── Pictograms ────────────────────────────────────────────────────────────
   One line icon per building block, 24×24 grid, stroke width 1.75, round caps —
   the same visual language as the audit dashboards. Deliberately NO brand logos
   (YouTube, LinkedIn): they break the style and are legally unnecessary.
   Keyed by the building block name, so the data objects above stay untouched.
   A name missing from the table simply renders a card without a tile.
   The paths are identical to the German page — only the keys are English. */
const ICON: Record<string, string> = {
  'Expert articles':
    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h10M7 17h6"/>',
  'Monthly measurement':
    '<path d="M4 5v14h16"/><path d="M7 15l4-5 3 3 5-7"/>',
  'Google and Bing optimisation':
    '<circle cx="11" cy="11" r="6"/><path d="M15.5 15.5L20 20"/>',
  'Technical AI accessibility':
    '<path d="M9 8l-4 4 4 4"/><path d="M15 8l4 4-4 4"/><path d="M13 6l-2 12"/>',
  'Updates to your existing pages':
    '<path d="M20 12a8 8 0 1 1-2.5-5.8"/><path d="M20 4v4h-4"/>',
  'Action plan from your audit':
    '<path d="M4 7l1.8 1.8L9 5.6"/><path d="M4 16l1.8 1.8L9 14.6"/><path d="M13 8h7M13 17h7"/>',
  'Brand mentions on third-party sites':
    '<path d="M9.5 7C7.6 7 6 8.6 6 10.5S7.6 14 9.5 14c0 2-1.4 3.4-3 4"/><path d="M18.5 7C16.6 7 15 8.6 15 10.5s1.6 3.5 3.5 3.5c0 2-1.4 3.4-3 4"/>',
  'Comparison articles and provider lists':
    '<path d="M8 4h8v3.5a4 4 0 0 1-8 0z"/><path d="M8 5.5H5.5V7A3 3 0 0 0 8.5 10"/><path d="M16 5.5h2.5V7A3 3 0 0 1 15.5 10"/><path d="M12 11.5V15"/><path d="M9.5 20h5"/><path d="M10.5 15h3v5h-3z"/>',
  'Review platforms':
    '<path d="M12 4.5l2.3 4.7 5.2.8-3.75 3.65.9 5.15L12 16.4l-4.65 2.4.9-5.15L4.5 10l5.2-.8z"/>',
  'YouTube publishing for your videos':
    '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10.5 9.3l4.7 2.7-4.7 2.7z"/>',
  'An industry study of your own':
    '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 14v3M12 10.5v6.5M15 12.5v4.5"/>',
  'Knowledge bases':
    '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.66 3.13 3 7 3s7-1.34 7-3V6"/><path d="M5 12v6c0 1.66 3.13 3 7 3s7-1.34 7-3v-6"/>',
  'LinkedIn for your leadership':
    '<circle cx="9.5" cy="8" r="3"/><path d="M4 20a5.5 5.5 0 0 1 11 0"/><path d="M16 5.6a3 3 0 0 1 0 4.8"/><path d="M17.5 14.6A5.5 5.5 0 0 1 21 19.8"/>',
  'Competitor monitoring':
    '<path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.6"/>',
};

/* Matrix: the same 14 building blocks, cumulative. Columns lead into the calculator. */
const matrix = stufen.flatMap((g) =>
  g.bausteine.map((b) => ({
    name: b.name,
    basis: g.nr === 1,
    aktiv: g.nr <= 2,
    dominanz: true,
  })),
);

/* Sits at the end of every tier: this is not an off-the-shelf catalogue. */
const individualHinweis =
  'How heavily each building block is weighted is decided by your audit — not by a list. We align the focus and the intensity with your goals before we start.';

/* Figures band below the hero.
   ⚠️ Every number here can be recalculated — as of 28.07.2026:
   · 525 = boards with a completed GEO measurement in /opt/codaai-dashboard/dashboards
   · 12% = 62 of 514 boards with geo_visibility_pct == 0, i.e. mentioned by no AI
     system in any of their eight buyer questions
   · 8–12 weeks = already published experience value (see FAQ on /en/pricing/)
   Effect figures (“after x months, y% more mentions”) are deliberately NOT here:
   the pipeline stores only one measurement point per domain, and a fresh collect
   overwrites it. No time series, no provable change. Once the monthly
   measurements are historised, real before/after values belong in this exact
   spot.                                                                        */
const kennzahlen = [
  { wert: '525', label: 'companies measured', sub: 'the basis for the three tiers' },
  { wert: '12%', label: 'are never mentioned', sub: 'in not one of their eight buyer questions' },
  { wert: '8–12', label: 'weeks', sub: 'until the first change shows' },
];

const spalten = [
  { key: 'basis', label: 'Found', sub: 'Tier 1', preis: 'from €1,470', artikel: '2–3' },
  { key: 'aktiv', label: 'Recommended', sub: 'Tier 2', preis: 'from €2,670', artikel: '4–7' },
  { key: 'dominanz', label: 'Cited', sub: 'Tier 3', preis: 'from €4,910', artikel: '8–12' },
];

const nichtImAngebot = [
  {
    t: 'llms.txt as a paid service',
    d: 'A log analysis across 137,000 domains shows that 97% of these files received no requests at all. We add one free of charge — we just do not sell it.',
  },
  {
    t: 'Schema markup as an “AI citation booster”',
    d: 'No measurable effect on AI citations in a controlled experiment. It belongs to the SEO basics, but it is not a premium item.',
  },
  {
    t: 'Any kind of placement guarantee',
    d: 'AI answers are not deterministic. “Number one in ChatGPT, guaranteed” is the calling card of a dubious provider — bookable placements exist in no AI system.',
  },
  {
    t: 'Reddit and forum seeding',
    d: 'It dominates consumer questions, but accounts for only 1.4% of citations in a B2B niche context — and the patterns swing wildly.',
  },
  {
    t: 'Wikipedia articles',
    d: 'The notability criteria rule out most mid-sized companies, and paid articles get deleted. We promise Wikidata, not Wikipedia.',
  },
  {
    t: '“AI traffic replaces SEO”',
    d: 'AI referrals account for around 1% of traffic. The honest argument is the decision that is made long before you are contacted — not visitor volume.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'CodaAI Digital Visibility',
  serviceType: 'AI visibility (GEO) and SEO for B2B companies',
  provider: { '@id': 'https://www.codaai.ai/#organization' },
  areaServed: 'DE',
  description:
    'Managed service for visibility in AI answers: 14 building blocks across three tiers — from the technical readability of your website through brand mentions on third-party sources to an industry study of your own.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Building blocks',
    itemListElement: stufen.map((g) => ({
      '@type': 'OfferCatalog',
      name: `${g.kicker} (${g.name})`,
      itemListElement: g.bausteine.map((b) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: b.name, description: b.tut },
      })),
    })),
  },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqVisibilityEn.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  lang={lang}
  title="Digital Visibility: recommended in AI answers | CodaAI"
  description="Being mentioned is never an accident. Nobody knows the formula AI systems use — but we know what they draw on. Three tiers, measured every month."
>
  <Navbar lang={lang} />
  <main class="pt-0">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-24 lg:pt-28 pb-0">
      <Breadcrumb
        items={[
          { label: 'Home', ariaLabel: 'To the homepage', href: `${base}/en/` },
          { label: 'Pricing', href: `${base}/en/pricing/` },
          { label: 'Digital Visibility' },
        ]}
        class="mb-0"
      />
    </div>

    <!-- ── 1 · Hero ─────────────────────────────────────────────────────
         The H1 is a tipping sentence (see CLAUDE.md, “H1-Kippsatz”): line 1
         states a condition, line 2 turns it, line 2 is shorter than line 1.
         The German reads “Genannt zu werden ist kein Zufall. / Es ist
         konsequente Arbeit in 3 Stufen.” — literally “no coincidence” does not
         work in English, so the turn is rebuilt rather than bent: accident →
         consistent work. Figure and full stop kept exactly as in the German.
         No figures band with delivery numbers: they described scope, not
         benefit. In their place a result sentence without an effect figure —
         provable before/after values do not exist yet, and invented ones would
         break with “no placement guarantee”.                                 -->
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-8 lg:pt-10 pb-14 lg:pb-16">
      <HeroHeadline
        line1="Being mentioned is never an accident."
        line2="It is consistent work, in 3 tiers."
        class="max-w-5xl"
      />

      <div class="cai-line mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-muted-foreground" style="--d:2">
        <p>
          No provider knows the formula by which ChatGPT, Perplexity or Google’s AI decides
          whom to recommend. Neither do we.
        </p>
        <p>
          What is known is the material those systems draw on. That is exactly where our
          three tiers start — from a readable website to an industry study of your own.
          <strong class="font-semibold text-foreground">There is one that fits every company.</strong>
        </p>
      </div>

      <div class="cai-line mt-12 grid gap-10 sm:grid-cols-3" style="--d:3" data-counters>
        {kennzahlen.map((k) => (
          <div>
            <div class="cai-stat text-cta">{k.wert}</div>
            <div class="mt-3 text-base font-bold tracking-tight text-foreground">{k.label}</div>
            <div class="mt-0.5 text-sm leading-relaxed text-muted-foreground">{k.sub}</div>
          </div>
        ))}
      </div>
      <p class="cai-line mt-4 text-[12.5px] text-muted-foreground" style="--d:4">
        Our own measurements, as of July 2026. You can see how your own figures move over
        the months in your dashboard.
      </p>
    </div>

    <!-- ── 2 · The three tiers as an accordion ──────────────────────────── -->
    <section aria-label="The three tiers and their building blocks" class="py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <Reveal as="div" class="mb-10">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cta-accessible">The three visibility tiers</p>
          <h2 class="cai-h2 max-w-4xl text-foreground">
            Three questions decide whether the AI recommends you.
          </h2>
          <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-muted-foreground">
            One tier answers each question. Every tier contains everything below it in full —
            open up whatever interests you.
          </p>
        </Reveal>

        <div class="cai-acc relative space-y-4" data-acc>
          <!-- Tier line: connects the three numbers, fills as you scroll.
               Purely decorative, positioned and filled by the script. -->
          <span class="cai-spine" aria-hidden="true"><span class="cai-spine-fill"></span></span>
          {stufen.map((g) => (
            <section id={g.id} class="cai-stufe scroll-mt-24 overflow-hidden rounded-2xl border border-border bg-card lg:scroll-mt-28" data-stufe>
              <h3>
                <button
                  type="button"
                  class="cai-head flex w-full items-start gap-4 p-6 text-left lg:gap-6 lg:p-7"
                  aria-expanded="true"
                  aria-controls={`panel-${g.nr}`}
                  data-head
                >
                  <span class="cai-nr mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-cta/40 bg-cta/10 text-lg font-bold text-foreground">
                    {g.nr}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-[11.5px] font-bold uppercase tracking-widest text-cta-accessible">{g.kicker}</span>
                    <span class="mt-1 block text-xl font-semibold tracking-tight text-foreground sm:text-2xl">
                      {g.name} — {g.frage}
                    </span>
                    <span class="cai-preis mt-2 block text-[13px] font-medium">{g.preiszeile}</span>
                  </span>
                  <svg class="cai-chev mt-1 h-5 w-5 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              </h3>

              <div id={`panel-${g.nr}`} class="cai-panel" data-panel>
                <div class="px-6 pb-7 pt-2 lg:px-7">
                  <p class="max-w-[64ch] text-[15px] leading-relaxed text-muted-foreground">{g.antwort}</p>

                  <!-- Coverage: makes it visible that the tiers build on each other. -->
                  <div class="cai-cov mt-5 max-w-sm">
                    <div class="flex items-baseline justify-between text-[12.5px] font-semibold text-foreground">
                      <span>{g.kumuliert} of 14 building blocks</span>
                      <span class="font-normal text-muted-foreground">{g.kicker}</span>
                    </div>
                    <div class="cai-cov-track mt-2" aria-hidden="true">
                      <span class="cai-cov-fill" style={`--w:${Math.round((g.kumuliert / 14) * 100)}%`}></span>
                    </div>
                  </div>

                  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {g.bausteine.map((b, i) => (
                      <article class="cai-item rounded-xl border border-border bg-background p-5" style={`--i:${i}`}>
                        {ICON[b.name] && (
                          <span class="cai-ico mb-3 flex h-10 w-10 items-center justify-center rounded-[10px]" aria-hidden="true">
                            <svg
                              viewBox="0 0 24 24"
                              width="21"
                              height="21"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.75"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              set:html={ICON[b.name]}
                            />
                          </span>
                        )}
                        <h4 class="text-base font-semibold tracking-tight text-foreground">
                          {b.name}
                          {b.zusatz && (
                            <span class="mt-0.5 block text-[12px] font-normal text-muted-foreground">{b.zusatz}</span>
                          )}
                        </h4>
                        <p class="mt-2.5 text-[14px] leading-relaxed text-muted-foreground">{b.tut}</p>
                      </article>
                    ))}

                    <!-- Note and button sit in the gap of the last card row: with
                         4 building blocks (Tiers 2 and 3) they stand to the right
                         of the single card, with 6 (Tier 1) they run full width
                         underneath. Saves a whole screen height. -->
                    <div
                      class="cai-foot flex flex-col justify-center gap-4 rounded-xl bg-muted/40 p-5"
                      style={`--span:${(3 - (g.bausteine.length % 3)) % 3 || 3}`}
                    >
                      <p class="text-[13.5px] leading-relaxed text-muted-foreground">
                        {individualHinweis}
                      </p>
                      <a
                        href={`${base}/en/pricing/?tier=${g.key}#calculator`}
                        class="inline-flex w-fit items-center gap-2 rounded-[14px] bg-cta-strong px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
                      >
                        Calculate the price for Tier {g.nr} →
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 3 · Matrix — columns lead into the calculator ─────────────────── -->
    <section id="matrix" aria-label="All building blocks by tier" class="py-16 lg:py-24 scroll-mt-24 lg:scroll-mt-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <Reveal as="div">
          <h2 class="cai-h2 text-foreground">
            All building blocks at a glance
          </h2>
          <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-muted-foreground">
            Click a column — the calculator opens with that tier selected.
          </p>
        </Reveal>

        <Reveal as="div" delay={90} class="mt-8 max-w-4xl overflow-x-auto">
          <table class="cai-matrix w-full min-w-[560px] border-collapse text-left" data-matrix>
            <thead>
              <tr>
                <th scope="col" class="border-b-2 border-border pb-3 pr-4 text-[11px] font-bold uppercase tracking-widest text-muted-foreground">
                  Building block
                </th>
                {spalten.map((s) => (
                  <th scope="col" class="border-b-2 border-border px-2 pb-3 text-center align-bottom">
                    <a
                      href={`${base}/en/pricing/?tier=${s.key}#calculator`}
                      class="group block rounded-lg px-2 py-2 transition-colors hover:bg-cta/10"
                      data-col
                    >
                      <span class="block text-[10.5px] font-bold uppercase tracking-widest text-muted-foreground">{s.sub}</span>
                      <span class="mt-0.5 block text-[15px] font-semibold text-foreground">{s.label}</span>
                      <span class="mt-0.5 block text-[12px] text-muted-foreground">{s.preis}</span>
                      <span class="mt-1 block text-[11px] font-semibold text-cta-accessible opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
                        calculate →
                      </span>
                    </a>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {matrix.map((m) => (
                <tr class="border-b border-border">
                  <th scope="row" class="py-3 pr-4 text-[14px] font-medium text-foreground">{m.name}</th>
                  {[m.basis, m.aktiv, m.dominanz].map((on, ci) => (
                    <td class="px-3 py-3 text-center">
                      <span class="sr-only">{['Found', 'Recommended', 'Cited'][ci]}: {on ? 'included' : 'not included'}</span>
                      {on ? (
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="cai-check mx-auto text-cta-accessible" style={`--c:${ci}`} aria-hidden="true">
                          <path d="M20 6L9 17l-5-5" />
                        </svg>
                      ) : (
                        <span class="text-muted-foreground/40" aria-hidden="true">—</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
              <tr>
                <th scope="row" class="pt-4 pr-4 text-[13px] font-semibold text-muted-foreground">Expert articles per month</th>
                {spalten.map((s) => (
                  <td class="px-3 pt-4 text-center text-[13px] font-semibold text-foreground">{s.artikel}</td>
                ))}
              </tr>
              <tr>
                <th scope="row" class="pt-2 pr-4 text-[13px] font-semibold text-muted-foreground">Monthly price from</th>
                {spalten.map((s) => (
                  <td class="px-3 pt-2 text-center text-[13px] font-semibold text-foreground">{s.preis.replace('from ', '')}</td>
                ))}
              </tr>
            </tbody>
          </table>
        </Reveal>

        <Reveal as="p" delay={140} class="mt-6 max-w-4xl text-sm text-muted-foreground">
          Translations cost €99 per language and article, social videos €120 per video — the same
          in every tier. <a href={`${base}/en/pricing/#calculator`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">To the calculator →</a>
        </Reveal>
      </div>
    </section>

    <!-- ── 4 · Deliberately not on offer ────────────────────────────────── -->
    <section id="not-included" data-theme="dark" class="cai-dvdark bg-background py-16 lg:py-24 scroll-mt-24 lg:scroll-mt-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <Reveal as="div">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cta-accessible">From over 25 years of experience</p>
          <h2 class="cai-h2 max-w-4xl text-foreground">
            Six things we deliberately do not offer
          </h2>
          <p class="mt-5 max-w-[62ch] text-base leading-relaxed text-muted-foreground lg:text-lg">
            They appear in a lot of offers in this industry. Not in ours — and here is why.
          </p>
        </Reveal>

        <div class="mt-10 grid gap-x-10 gap-y-7 lg:grid-cols-2">
          {nichtImAngebot.map((n, i) => (
            <Reveal as="div" delay={(i % 2) * 80} class="border-l-[3px] border-cta pl-6">
              <h3 class="text-base font-semibold text-foreground">{n.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{n.d}</p>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 5 · Questions of substance ───────────────────────────────────
         Deliberately AFTER “not on offer” and BEFORE the appointment: anyone
         who has read this far has subject-matter questions, and those should
         be answered before the appointment question comes. Price questions
         live on /en/pricing/. -->
    <FaqAccordion
      items={faqVisibilityEn}
      eyebrow="Common questions"
      title="What decision-makers ask at this point"
      intro="How AI visibility comes about, how we measure it — and why we do not promise a placement."
      id="faq"
      idPrefix="faq-dv"
    >
      <p slot="after" class="mt-10 text-center text-sm text-muted-foreground">
        Questions about price and term are answered by
        <a href={`${base}/en/pricing/#faq`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">the pricing page</a>.
      </p>
    </FaqAccordion>

    <!-- ── 6 · Appointment ──────────────────────────────────────────────── -->
    <Booking lang={lang} />

    <!-- ── 7 · Close ────────────────────────────────────────────────────── -->
    <section class="mx-auto max-w-3xl px-6 py-14 text-center lg:px-8">
      <Reveal as="div">
        <p class="text-base leading-relaxed text-muted-foreground">
          Which tier fits you depends on how visible you are today.
          <a href={`${base}/en/#offer`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">Request your free audit →</a>
        </p>
        <p class="mt-3 text-sm text-muted-foreground">
          Or go straight <a href={`${base}/en/pricing/`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">to the pricing</a>.
        </p>
      </Reveal>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  {/* FAQPage only here, not additionally on /en/faq — every question should be
      marked up exactly once in the index (decision Oli, 03.08.2026). */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  <style>
    /* Subtle grid for the honesty block — identical to /preise. */
    .cai-dvdark {
      background-image:
        linear-gradient(hsl(var(--foreground) / 0.05) 1px, transparent 1px),
        linear-gradient(90deg, hsl(var(--foreground) / 0.05) 1px, transparent 1px);
      background-size: 44px 44px;
    }

    /* ── Hero: lines run in one after another on load ───────────────────── */
    .cai-line {
      opacity: 0;
      transform: translateY(18px);
      animation: caiLineIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--d, 0) * 110ms);
    }
    h1 .cai-line:nth-child(2) { --d: 1; }
    @keyframes caiLineIn { to { opacity: 1; transform: none; } }

    /* ── Tier line ──────────────────────────────────────────────────────
       Runs alongside the three cards to the left and fills as you scroll —
       it makes visible what the text says: every tier contains the ones below.
       The script sets position and height so it reaches exactly from the first
       number to the third. Hidden below 1024px (no room).                   */
    .cai-spine {
      position: absolute;
      left: -26px;
      width: 2px;
      border-radius: 2px;
      background: hsl(var(--border));
      opacity: 0;
      display: none;
      pointer-events: none;
    }
    @media (min-width: 1024px) {
      .cai-spine.is-ready { display: block; opacity: 1; }
    }
    .cai-spine-fill {
      display: block;
      width: 100%;
      height: 0;
      border-radius: 2px;
      background: hsl(var(--cta));
      transition: height 0.12s linear;
    }

    /* ── Accordion ──────────────────────────────────────────────────────
       Without JavaScript everything is open (no content is lost). Only the
       class .cai-js, set by the script, enables collapsing.                  */
    .cai-head { cursor: default; }
    .cai-js .cai-head { cursor: pointer; }
    .cai-chev { transition: transform 0.35s ease, color 0.2s ease; }
    .cai-js .cai-stufe:not(.is-open) .cai-chev { transform: rotate(-90deg); }
    .cai-js .cai-head:hover .cai-chev { color: hsl(var(--cta)); }

    /* Deliberately only ONE hover signal (decision Oli, 28.07.2026): before,
       the number filled AND the border went magenta AND the card lifted AND a
       hint appeared — four stimuli at once. What stayed is the number; it sits
       at the start of the line and is signal enough.                          */
    .cai-stufe { transition: border-color 0.25s ease; }

    /* The number is the signal: on hover and in the open state it fills
       magenta. */
    .cai-nr {
      transition: background-color 0.22s ease, border-color 0.22s ease, color 0.22s ease,
        transform 0.22s ease;
    }
    .cai-js .cai-head:hover .cai-nr,
    .cai-js .cai-head:focus-visible .cai-nr,
    .cai-js .cai-stufe.is-open .cai-nr {
      background: hsl(var(--cta));
      border-color: hsl(var(--cta));
      color: #fff;
    }

    .cai-js .cai-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cai-js .cai-stufe.is-open .cai-panel { max-height: 2600px; }

    /* Building blocks fade in staggered as soon as the tier opens. */
    .cai-js .cai-item {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.22s ease,
        box-shadow 0.22s ease;
    }
    .cai-js .cai-stufe.is-open .cai-item {
      opacity: 1;
      transform: none;
      transition-delay: calc(120ms + var(--i) * 70ms);
    }
    .cai-stufe.is-open { border-color: hsl(var(--cta) / 0.45); }

    /* Card hover — higher specificity than the fade-in rule above. */
    /* ── Card hover: full area in CodaAI magenta ─────────────────────────
       Oli's request (28.07.2026): on hover the whole card takes colour, text
       and pictogram go white. The selectors are deliberately this long — the
       fade-in rule above (`.cai-js .cai-stufe.is-open .cai-item`) has four
       classes and would otherwise win.                                       */
    .cai-item {
      outline: none;
      transition: background-color 0.22s ease, border-color 0.22s ease,
        box-shadow 0.22s ease, opacity 0.5s ease, transform 0.5s ease;
    }
    .cai-js .cai-stufe.is-open .cai-item:hover,
    .cai-item:hover {
      /* Deeper magenta instead of #DF41FB (decision Oli, 28.07.2026): white on
         the light pink reaches only ~3:1 contrast, at this depth ~7:1. Same
         colour family, but the card text stays readable.                     */
      background: hsl(var(--cta-accessible));
      border-color: hsl(var(--cta-accessible));
      box-shadow: 0 14px 34px -18px hsl(var(--cta-accessible) / 0.6);
      transition-delay: 0ms;
    }
    .cai-js .cai-stufe.is-open .cai-item:hover h4,
    .cai-item:hover h4,
    .cai-js .cai-stufe.is-open .cai-item:hover h4 span,
    .cai-item:hover h4 span {
      color: #fff;
    }
    .cai-js .cai-stufe.is-open .cai-item:hover p,
    .cai-item:hover p {
      color: rgba(255, 255, 255, 0.92);
    }

    /* Pictogram tile */
    .cai-ico {
      background: hsl(var(--cta) / 0.1);
      color: hsl(var(--cta-accessible));
      transition: background-color 0.22s ease, transform 0.22s ease;
    }
    .cai-js .cai-stufe.is-open .cai-item:hover .cai-ico,
    .cai-item:hover .cai-ico {
      background: rgba(255, 255, 255, 0.22);
      color: #fff;
    }

    /* Price line: appears only when the head is hovered, in magenta — the same
       colour as number and chevron, so the head has one handwriting. The space
       is always reserved (only the opacity changes), otherwise the card would
       jump on hover. On touch devices the line stands permanently, otherwise
       the price would be unreachable there.                                  */
    .cai-preis {
      color: hsl(var(--cta-accessible));
      opacity: 0;
      transform: translateY(-2px);
      transition: opacity 0.22s ease, transform 0.22s ease;
    }
    .cai-js .cai-head:hover .cai-preis,
    .cai-js .cai-head:focus-visible .cai-preis,
    .cai-js .cai-stufe.is-open .cai-preis {
      opacity: 1;
      transform: none;
    }
    @media (hover: none) {
      .cai-preis { opacity: 1; transform: none; }
    }

    /* ── Pictograms draw themselves ─────────────────────────────────────
       The script sets pathLength="1" on every shape, which normalises the
       stroke length so all icons draw at the same speed — regardless of how
       long the path actually is. Without JS (no .cai-js) the icons are simply
       finished.                                                             */
    .cai-js .cai-ico svg > * {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .cai-js .cai-stufe.is-open .cai-ico svg > * {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.75s ease;
      transition-delay: calc(200ms + var(--i) * 70ms);
    }
    /* On hover the icon draws itself once more. */
    .cai-js .cai-stufe.is-open .cai-item:hover .cai-ico svg > * {
      animation: caiDraw 0.75s ease;
    }
    @keyframes caiDraw {
      from { stroke-dashoffset: 1; }
      to { stroke-dashoffset: 0; }
    }

    /* The note-and-button field fills the gap in the last card row. Below
       1024px it runs full width, above it takes exactly the columns left free
       in the last row (--span). */
    .cai-foot { grid-column: 1 / -1; }
    @media (min-width: 1024px) {
      .cai-foot { grid-column: span var(--span) / span var(--span); }
    }

    /* ── Coverage bar in the panel ──────────────────────────────────────── */
    .cai-cov-track {
      height: 4px;
      width: 100%;
      overflow: hidden;
      border-radius: 999px;
      background: hsl(var(--border));
    }
    .cai-cov-fill {
      display: block;
      height: 100%;
      width: 0;
      border-radius: 999px;
      background: hsl(var(--cta));
    }
    .cai-js .cai-stufe.is-open .cai-cov-fill {
      width: var(--w);
      transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
    }
    /* Without JS the bar sits at its target value straight away. */
    .cai-cov-fill { width: var(--w); }
    .cai-js .cai-cov-fill { width: 0; }

    /* ── Matrix ─────────────────────────────────────────────────────────
       Ticks draw themselves column by column as soon as the table comes into
       view. Without JS (no .cai-anim class) they simply sit there.           */
    .cai-matrix.cai-anim .cai-check path {
      stroke-dasharray: 26;
      stroke-dashoffset: 26;
    }
    .cai-matrix.cai-anim.is-drawn .cai-check path {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.45s ease;
      transition-delay: calc(140ms + var(--c) * 180ms);
    }
    .cai-matrix td { transition: background-color 0.18s ease; }
    .cai-matrix[data-hl='0'] td:nth-child(2),
    .cai-matrix[data-hl='1'] td:nth-child(3),
    .cai-matrix[data-hl='2'] td:nth-child(4) {
      background: hsl(var(--cta) / 0.08);
    }

    @media (prefers-reduced-motion: reduce) {
      .cai-line { opacity: 1; transform: none; animation: none; }
      .cai-js .cai-panel { transition: none; }
      .cai-js .cai-item { opacity: 1; transform: none; transition: none; }
      .cai-chev,
      .cai-stufe,
      .cai-nr,
      .cai-ico,
      .cai-spine-fill { transition: none; }
      .cai-preis { transition: none; }
      .cai-item { transition: none; }
      .cai-js .cai-ico svg > * { stroke-dashoffset: 0; transition: none; }
      .cai-js .cai-stufe.is-open .cai-item:hover .cai-ico svg > * { animation: none; }
      .cai-js .cai-cov-fill { width: var(--w); transition: none; }
      .cai-matrix.cai-anim .cai-check path { stroke-dashoffset: 0; }
    }
  </style>

  <script is:inline>
    (function () {
      var reduced = false;
      try {
        reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      } catch (e) {}

      /* ── 1 · Accordion ───────────────────────────────────────────────
         On load EVERYTHING is closed (decision Oli, 28.07.2026) — you first
         see the three tiers next to each other and decide yourself what to
         open. Exception: an anchor in the URL opens its tier. */
      var acc = document.querySelector('[data-acc]');
      if (acc) {
        var stufen = Array.prototype.slice.call(acc.querySelectorAll('[data-stufe]'));
        acc.classList.add('cai-js');

        var setOpen = function (el, open) {
          el.classList.toggle('is-open', open);
          var head = el.querySelector('[data-head]');
          if (head) head.setAttribute('aria-expanded', open ? 'true' : 'false');
        };

        var hash = (location.hash || '').replace('#', '');
        var target = null;
        stufen.forEach(function (el) { if (el.id === hash) target = el; });
        stufen.forEach(function (el) {
          setOpen(el, target ? el === target : false);
        });

        /* Only ever ONE tier open (Oli's wish, 28.07.2026): opening one closes
           the others. A second click on the same head closes it again. */
        stufen.forEach(function (el) {
          var head = el.querySelector('[data-head]');
          if (!head) return;
          head.addEventListener('click', function () {
            var willOpen = !el.classList.contains('is-open');
            stufen.forEach(function (other) { setOpen(other, false); });
            setOpen(el, willOpen);
            window.setTimeout(layoutSpine, 620);
          });
        });
      }

      /* Normalise stroke lengths so every pictogram draws at the same speed —
         a circle would otherwise be done in a fraction of the time. */
      document.querySelectorAll('.cai-ico svg > *').forEach(function (el) {
        el.setAttribute('pathLength', '1');
      });

      /* ── 2 · Tier line ───────────────────────────────────────────────
         Runs from the centre of the first number to the centre of the last and
         fills while the tiers pass through the viewport. */
      var spine = document.querySelector('.cai-spine');
      var fill = spine && spine.querySelector('.cai-spine-fill');
      var spineTop = 0;
      var spineH = 0;

      function layoutSpine() {
        if (!spine || !acc) return;
        var nrs = acc.querySelectorAll('.cai-nr');
        if (nrs.length < 2) return;
        var accR = acc.getBoundingClientRect();
        var first = nrs[0].getBoundingClientRect();
        var last = nrs[nrs.length - 1].getBoundingClientRect();
        spineTop = first.top - accR.top + first.height / 2;
        spineH = last.top - accR.top + last.height / 2 - spineTop;
        spine.style.top = spineTop + 'px';
        spine.style.height = spineH + 'px';
        spine.classList.add('is-ready');
        paintSpine();
      }

      function paintSpine() {
        if (!fill || !spineH) return;
        var accR = acc.getBoundingClientRect();
        var anchor = window.innerHeight * 0.55;
        var p = (anchor - (accR.top + spineTop)) / spineH;
        p = p < 0 ? 0 : p > 1 ? 1 : p;
        fill.style.height = (p * 100).toFixed(1) + '%';
      }

      /* ── 3 · Counters in the figures band ───────────────────────────── */
      function startCounters(box) {
        var els = box.querySelectorAll('[data-count]');
        Array.prototype.forEach.call(els, function (el, i) {
          var goal = parseInt(el.getAttribute('data-count'), 10) || 0;
          if (reduced) { el.textContent = String(goal); return; }
          el.textContent = '0';
          var dur = 900;
          var delay = i * 170;
          window.setTimeout(function () {
            var t0 = 0;
            var step = function (ts) {
              if (!t0) t0 = ts;
              var k = Math.min(1, (ts - t0) / dur);
              var eased = 1 - Math.pow(1 - k, 3);
              el.textContent = String(Math.round(eased * goal));
              if (k < 1) window.requestAnimationFrame(step);
            };
            window.requestAnimationFrame(step);
          }, delay);
        });
      }

      /* ── 4 · Matrix: draw ticks + column hover ───────────────────────── */
      var matrix = document.querySelector('[data-matrix]');
      if (matrix) {
        if (!reduced) matrix.classList.add('cai-anim');
        var cols = matrix.querySelectorAll('[data-col]');
        Array.prototype.forEach.call(cols, function (a, i) {
          var on = function () { matrix.setAttribute('data-hl', String(i)); };
          var off = function () { matrix.removeAttribute('data-hl'); };
          a.addEventListener('mouseenter', on);
          a.addEventListener('focus', on);
          a.addEventListener('mouseleave', off);
          a.addEventListener('blur', off);
        });
      }

      /* ── 5 · Observer + scroll ───────────────────────────────────────── */
      if ('IntersectionObserver' in window) {
        var once = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              once.unobserve(e.target);
              if (e.target.hasAttribute('data-counters')) startCounters(e.target);
              else e.target.classList.add('is-drawn');
            });
          },
          { threshold: 0.25 }
        );
        var band = document.querySelector('[data-counters]');
        if (band) once.observe(band);
        if (matrix) once.observe(matrix);
      } else {
        if (matrix) matrix.classList.add('is-drawn');
      }

      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          paintSpine();
          ticking = false;
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', layoutSpine);
      window.addEventListener('load', layoutSpine);
      layoutSpine();
    })();
  </script>

  <Footer lang={lang} />
</Layout>
