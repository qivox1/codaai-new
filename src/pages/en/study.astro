---
/* Weiterleitung (06.11.2026): Die Mittelstand-Studie liegt jetzt unter /en/study-b2b-mittelstand/
   — seit es mit dem KI-Blindtest B2B-Tech 2026 eine zweite Studie gibt. Diese
   Datei bleibt stehen, weil Nurture-Links mit ?d=firma.de, Lesezeichen und
   Zitate auf die alte URL zeigen. GitHub Pages kann kein 301: deshalb
   location.replace MIT Query und Anker, Meta-Refresh als Rückfall, noindex und
   Canonical auf das neue Ziel. Aus der Sitemap ausgeschlossen (astro.config.mjs). */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/en/study-b2b-mittelstand/`;
const canonical = 'https://www.codaai.ai/en/study-b2b-mittelstand/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <script is:inline set:html={`location.replace(${JSON.stringify(target)} + location.search + location.hash);`} />
    <meta http-equiv="refresh" content={`1; url=${target}`} />
    <title>Redirected to the AI Blind Test 2026 (Mittelstand) | CodaAI</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center;">
    <p>
      This page has moved to
      <a href={target} style="color: hsl(var(--cta-accessible)); font-weight: 600;">AI Blind Test 2026 (Mittelstand)</a>.
    </p>
  </body>
</html>
