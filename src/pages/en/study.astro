---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

const DATENSTAND = 'June/July 2026';
const VERSION = '1.0';
// Webinar-Modul erst mit Live-Gang von /en/webinar aktivieren (Olis Entscheidung 14.07.2026)
const SHOW_WEBINAR = true;

// ── Kennzahlen (Quelle: geo_v2_export, Auswertung 13.07.2026 — vor Go-Live Refresh!) ──
const K = {
  unternehmen: 449,
  fragen: 3592,
  antworten: 7184,
  ohneNennung: 54.7,        // % aller Fragen ohne Nennung des Unternehmens
  ersetzt: 46.8,            // % Firmen: KI empfiehlt Wettbewerber, Firma fehlt mehrheitlich
  seoParadox: 34.9,         // % der SEO-starken Firmen (≥100 Top-10) in ChatGPT unsichtbar
  seoStarkN: 361,
  komplettUnsichtbar: 12.9, // % Firmen: 0 von 8 Fragen
  kategorieBlind: 25.6,     // % Firmen: bei Marktfrage zum eigenen Kerngeschäft unsichtbar
  chatgptAvg: 24.9,
  googleAvg: 39.4,
  nieChatgpt: 39.6,
  nieGoogle: 15.1,
  nieZitiert: 39.0,
  platz1: 23.8,
  avgPosition: '1.8',
  verlustMedian: '47,000',
};

const reportSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Report',
  name: 'AI Blind Test 2026 — analysis of AI visibility among mid-sized companies in Germany',
  alternativeName: 'KI-Blindtest Mittelstand 2026',
  url: `${SITE_URL}/en/study/`,
  datePublished: '2026-07-14',
  dateModified: '2026-07-14',
  inLanguage: 'en',
  version: VERSION,
  publisher: { '@id': `${SITE_URL}/#organization` },
  description:
    'Analysis of 7,184 AI answers (ChatGPT and Google AI Overviews) to 3,592 realistic buyer questions about 449 mid-sized companies in Germany: 54.7 % of the questions produce no mention of the company in question; for 46.8 % of the companies the AI recommends competitors by name.',
  about: [
    { '@type': 'Thing', name: 'Generative Engine Optimization (GEO)' },
    { '@type': 'Thing', name: 'AI visibility' },
    { '@type': 'Thing', name: 'Mid-sized B2B companies' },
  ],
});

const datasetSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'AI Blind Test 2026 — raw data aggregate',
  description:
    '449 mid-sized companies in Germany × 8 qualified buyer questions, queried on ChatGPT and Google AI Overviews (7,184 documented answers). Collected in June/July 2026. Aggregated metrics are public; company-level data is access-restricted.',
  url: `${SITE_URL}/en/study/`,
  creator: { '@id': `${SITE_URL}/#organization` },
  temporalCoverage: '2026-06/2026-07',
  spatialCoverage: 'Germany',
  isAccessibleForFree: true,
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is this analysis representative of mid-sized companies in Germany?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No, and we deliberately do not claim that it is. The 449 companies come from our own audit practice and are B2B-heavy. That said, our research suggests it is the most comprehensive analysis of its kind in the German-speaking market so far — smaller surveys (24 and 150 companies) arrive at similar results independently of us.',
      },
    },
    {
      '@type': 'Question',
      name: 'How were the buyer questions created?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For each company, 8 qualified German questions were generated across three archetypes (market overview, use case, competitor comparison) — based on an automated analysis of the website, the industry and the competitive landscape, followed by a quality check. The question sets are frozen and can therefore be repeated for tracking over time.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which AI systems were queried?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ChatGPT (model answers without live web search) and Google AI Overviews (German localisation). Both interfaces were queried with identical questions; we recorded the brand mention, the position of that mention, the competitors named and whether the company website is cited as a source.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I have my own company checked?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Using the same methodology we build an individual visibility audit for your company — with your real buyer questions, the actual AI answers and the competitors recommended in your place. Enter your domain at the top of this page.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the study relevant for companies outside Germany?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We measured 449 companies in Germany, in German, on ChatGPT and Google AI Overviews. The mechanism behind it is not country-specific: AI systems answer from the same kinds of sources everywhere. The figures apply to the German market — the pattern travels, the evidence for that is still outstanding.',
      },
    },
  ],
});

// Anonymisierte Echt-Beispiele aus dem Datensatz (Branche statt Firmenname, Wettbewerber anonymisiert)
const beispiele = [
  {
    branche: 'Manufacturer of emergency and safety lighting',
    kontext: 'approx. 880 top-10 rankings on Google — organically well visible',
    frage: 'Which LED emergency luminaires are recommended for commercial escape and rescue routes under the current standard?',
    ergebnis: 'The company is not mentioned. Instead, across the full question set, the AI systems recommend two direct competitors five times each.',
  },
  {
    branche: 'Mechanical engineering firm for factory automation and conveyor systems',
    kontext: 'approx. 640 top-10 rankings — AI visibility: 0 out of 8 questions',
    frage: 'Which manufacturers of aluminium profile systems for factory automation are considered leaders in Europe?',
    ergebnis: 'No mention in ChatGPT or Google AI Overviews. The most frequently named competitor appears in the answers seven times — a DAX-adjacent corporation dominates the category.',
  },
  {
    branche: 'Provider of electroplating and surface finishing',
    kontext: 'more than 1,200 top-10 rankings — AI visibility: 0 out of 8 questions',
    frage: 'Which providers of electroplated metal finishing in Germany are considered particularly reliable?',
    ergebnis: 'The company appears in no answer at all — even though it ranks on page 1 in classic Google searches on the same topics. Two international groups are recommended instead.',
  },
];
---

<Layout
  lang="en"
  title="AI Blind Test 2026: Recommended or Invisible? | CodaAI"
  description="7,184 AI answers on 449 companies in Germany: in 55% of buyer questions the company is not named — for 47%, the AI recommends competitors."
  jsonLd={[reportSchema, datasetSchema, faqSchema]}
>
  <Navbar lang="en" />
  <main id="main-content" class="pt-24 lg:pt-28">

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden border-b border-border bg-background">
      <div aria-hidden="true" class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full bg-cta/10 blur-3xl"></div>
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24">
        <Breadcrumb items={[{ label: 'Home', ariaLabel: 'To the homepage', href: `${base}/en/` }, { label: 'AI Blind Test 2026' }]} class="mb-8" />

        <div class="max-w-3xl">
          <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-cta-accessible">
            Data analysis · AI Blind Test 2026
          </p>
          <h1 class="cai-h1 cai-kipp text-foreground">
            <span class="k1 block">We asked the AI about 449 companies.</span>
            <span class="k2 block">Recommended or invisible?</span>
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-muted-foreground lg:text-xl">
            We put the questions of real buyers to AI assistants — about 449 mid-sized companies in
            Germany. The result is, to our knowledge, the most comprehensive analysis of AI visibility
            among mid-sized companies in the German-speaking market to date. It is not a reassuring one.
          </p>
        </div>

        <!-- Kennzahlen-Band -->
        <dl class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-3">
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-foreground lg:text-5xl" data-count="449">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">companies analysed</span><span class="block">across 258 industries</span></dt>
          </div>
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-foreground lg:text-5xl" data-count="3592">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">company-specific buyer questions</span><span class="block">on products &amp; services</span></dt>
          </div>
          <div class="bg-card px-8 py-8 text-center">
            <dd class="text-4xl font-bold tabular-nums tracking-tight text-cta lg:text-5xl" data-count="7184">0</dd>
            <dt class="mt-2 text-sm font-medium text-muted-foreground"><span class="block">documented AI answers</span><span class="block">from ChatGPT &amp; Google AI Overviews</span></dt>
          </div>
        </dl>

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            Data as of: {DATENSTAND}
          </span>
          <span>Version {VERSION}</span>
          <a href="#methodik" class="font-medium text-cta-accessible transition-colors hover:text-cta">Methodology ↓</a>
          <a href="#limitationen" class="font-medium text-cta-accessible transition-colors hover:text-cta">Limitations ↓</a>
          <a href="#zitieren" class="font-medium text-cta-accessible transition-colors hover:text-cta">Citation ↓</a>
        </div>
      </div>
    </section>

    <!-- ── Zentrale Befunde (Teaser, Boxen wie /webinar in Studien-Ton) ── -->
    <section aria-labelledby="h-befunde-teaser" class="border-b border-border bg-background">
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Key findings</p>
        <h2 id="h-befunde-teaser" class="cai-h2 text-foreground">Potential buyers ask the AI first — and companies never hear about it.</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {[
            { n: '55 %', t: 'of buyer questions produce no mention', d: 'In more than half of the questions, the company under review appears in no AI answer at all — and nobody notices, because a non-mention shows up in no statistic.' },
            { n: 'almost 1/2', t: 'are replaced by competitors named outright', d: 'For almost every second company the AI recommends the competition by name, while the company itself is missing from the majority of its core questions on its own products and services.' },
            { n: '> 1/3', t: 'invisible despite strong Google rankings', d: 'More than a third of the companies with over 100 top-10 rankings are completely invisible in ChatGPT. Classic SEO strength is no protection.' },
          ].map((b) => (
            <article class="flex flex-col rounded-2xl border border-border bg-card p-8">
              <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">{b.n}</span>
              <h3 class="mt-4 text-lg font-semibold leading-snug text-foreground">{b.t}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{b.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Inhalt + TOC ─────────────────────────────────────────────────── -->
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-16">

        <!-- TOC (Desktop) -->
        <aside class="hidden lg:block">
          <nav aria-label="Table of contents" class="sticky top-28 py-16 text-sm">
            <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">Contents</p>
            <ol class="space-y-3 border-l border-border">
              <li><a href="#zusammenfassung" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Summary</a></li>
              <li><a href="#ergebnisse" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Key results</a></li>
              <li><a href="#plattformen" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">ChatGPT vs. Google AI</a></li>
              <li><a href="#beispiele" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Examples</a></li>
              <li><a href="#domain-check" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Domain check</a></li>
              <li><a href="#methodik" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Methodology</a></li>
              <li><a href="#limitationen" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">Limitations</a></li>
              <li><a href="#faq" class="-ml-px block border-l-2 border-transparent pl-4 text-muted-foreground transition-colors hover:border-cta hover:text-foreground">FAQ</a></li>
            </ol>
          </nav>
        </aside>

        <div class="min-w-0">

          <!-- ── Zusammenfassung ──────────────────────────────────────── -->
          <section id="zusammenfassung" aria-labelledby="h-zusammenfassung" class="scroll-mt-28 py-16">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Abstract</p>
            <h2 id="h-zusammenfassung" class="cai-h2 text-foreground">Summary</h2>
            <div class="mt-8 rounded-2xl border-l-4 border-cta bg-muted/30 p-8">
              <p class="text-lg leading-relaxed text-foreground">
                B2B buying decisions increasingly start inside AI answers — long before any supplier is contacted.
                This analysis measures whether mid-sized companies appear there. For each company, eight realistic
                buyer questions were put to ChatGPT and Google AI Overviews, and the answers were evaluated
                systematically: is the company mentioned? In which position? Who is recommended instead? Is the
                company's own website cited as a source?
              </p>
              <p class="mt-4 text-lg leading-relaxed text-foreground">
                The result: in <strong>{K.ohneNennung.toLocaleString('en-GB')} %</strong> of all questions the
                company in question is not mentioned. For <strong>{K.ersetzt.toLocaleString('en-GB')} %</strong> of
                the companies, the AI systems recommend competitors by name while the company itself is missing from
                the majority of its core questions. And even strong Google rankings are no protection:
                <strong>{K.seoParadox.toLocaleString('en-GB')} %</strong> of the organically well-visible companies
                are completely invisible in ChatGPT.
              </p>
            </div>
          </section>

          <!-- ── Kernergebnisse ───────────────────────────────────────── -->
          <section id="ergebnisse" aria-labelledby="h-ergebnisse" class="scroll-mt-28 border-t border-border py-16">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Results</p>
            <h2 id="h-ergebnisse" class="cai-h2 text-foreground">Four findings that hurt</h2>

            <div class="mt-10 grid gap-6 sm:grid-cols-2">

              <!-- Befund 1 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">55&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">of buyer questions produce no mention</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  In 1,965 of 3,592 questions, the company in question appears in neither of the two
                  AI answers. The majority of buying journeys therefore happen without the company —
                  and nobody notices, because a non-mention shows up in no statistic.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="54.7 % of questions produce no mention">
                  <div class="h-full rounded-full bg-cta" style="width:54.7%"></div>
                </div>
              </article>

              <!-- Befund 2 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">47&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">are replaced by competitors</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  For 210 of 449 companies, the AI systems recommend competitors by name while the company
                  itself is missing from the majority of its questions. {K.komplettUnsichtbar.toLocaleString('en-GB')} %
                  are replaced entirely: zero mentions across eight questions — the competition stands in every answer.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="46.8 % of companies are replaced by competitors">
                  <div class="h-full rounded-full bg-cta" style="width:46.8%"></div>
                </div>
              </article>

              <!-- Befund 3 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">35&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">The SEO paradox: good rankings are no protection</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  {K.seoStarkN} of the companies analysed have more than 100 top-10 rankings on Google.
                  One in three of them ({K.seoParadox.toLocaleString('en-GB')} %) is still completely invisible
                  in ChatGPT. Classic SEO strength and AI visibility are two different disciplines.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="34.9 % of SEO-strong companies are invisible in ChatGPT">
                  <div class="h-full rounded-full bg-cta" style="width:34.9%"></div>
                </div>
              </article>

              <!-- Befund 4 -->
              <article class="flex flex-col rounded-2xl border border-border bg-card p-8 transition-shadow hover:shadow-lg">
                <div class="flex items-baseline gap-3">
                  <span class="text-5xl font-bold tabular-nums tracking-tight text-cta">26&thinsp;%</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-foreground">invisible in their own core business</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">
                  Every fourth company is not mentioned even in the market-overview question about its
                  <em>own</em> category ("Which providers of … are considered leading?").
                  Whoever is missing here does not exist for the discovery phase of their industry.
                </p>
                <div class="mt-6 h-2 overflow-hidden rounded-full bg-muted" role="img" aria-label="25.6 % invisible on the question about their own category">
                  <div class="h-full rounded-full bg-cta" style="width:25.6%"></div>
                </div>
              </article>
            </div>

            <p class="mt-6 text-xs leading-relaxed text-muted-foreground">
              Additional metrics: where companies are mentioned, they stand at position {K.avgPosition} on average;
              in {K.platz1.toLocaleString('en-GB')} % of all questions the company reaches first place.
              For {K.nieZitiert.toLocaleString('en-GB')} % of the companies, their own website is cited as a source
              in no answer at all — the AI describes these firms exclusively on the basis of third parties.
              A conservative model calculation puts the median opportunity at around €{K.verlustMedian} per
              company per year (<a href="#limitationen" class="underline decoration-border underline-offset-2 hover:text-foreground">context</a>).
            </p>
          </section>

          <!-- ── Plattform-Vergleich ──────────────────────────────────── -->
          <section id="plattformen" aria-labelledby="h-plattformen" class="scroll-mt-28 border-t border-border py-16">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">Platform comparison</p>
            <h2 id="h-plattformen" class="cai-h2 text-foreground">ChatGPT is considerably blinder than Google AI Overviews</h2>
            <p class="mt-4 max-w-2xl text-muted-foreground">
              The same questions, two systems, two realities: ChatGPT answers mostly from training data —
              whoever is missing there is missing structurally and can hardly correct that in the short term.
              Google AI Overviews draws more heavily on the live index.
            </p>

            <div class="mt-10 space-y-8 rounded-2xl border border-border bg-card p-8">
              <div>
                <div class="mb-2 flex items-baseline justify-between gap-4">
                  <span class="text-sm font-semibold text-foreground">Avg. visibility in ChatGPT</span>
                  <span class="text-2xl font-bold tabular-nums text-foreground">24.9&thinsp;%</span>
                </div>
                <div class="h-3 overflow-hidden rounded-full bg-muted">
                  <div class="h-full rounded-full bg-cta" style="width:24.9%"></div>
                </div>
                <p class="mt-2 text-xs text-muted-foreground">{K.nieChatgpt.toLocaleString('en-GB')} % of the companies are <strong>never</strong> mentioned by ChatGPT.</p>
              </div>
              <div>
                <div class="mb-2 flex items-baseline justify-between gap-4">
                  <span class="text-sm font-semibold text-foreground">Avg. visibility in Google AI Overviews</span>
                  <span class="text-2xl font-bold tabular-nums text-foreground">39.4&thinsp;%</span>
                </div>
                <div class="h-3 overflow-hidden rounded-full bg-muted">
                  <div class="h-full rounded-full bg-cta/60" style="width:39.4%"></div>
                </div>
                <p class="mt-2 text-xs text-muted-foreground">{K.nieGoogle.toLocaleString('en-GB')} % of the companies appear in no answer here either.</p>
              </div>
            </div>
          </section>

          <!-- ── Beispiele ────────────────────────────────────────────── -->
          <section id="beispiele" aria-labelledby="h-beispiele" class="scroll-mt-28 border-t border-border py-16">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-cta-accessible">From the dataset</p>
            <h2 id="h-beispiele" class="cai-h2 text-foreground">Three real cases — anonymised</h2>
            <p class="mt-4 max-w-2xl text-muted-foreground">
              Original questions from the survey, translated from German. Company and competitor names are
              anonymised out of fairness — in the individual audits they appear in plain text.
            </p>

            <div class="mt-10 space-y-4">
              {beispiele.map((b) => (
                <details class="cai-acc group rounded-2xl border border-border bg-card open:border-cta/40 open:shadow-sm">
                  <summary class="cai-acc-head flex cursor-pointer list-none items-center justify-between gap-4 p-6 [&::-webkit-details-marker]:hidden">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible">{b.branche}</p>
                      <p class="mt-1 text-sm text-muted-foreground">{b.kontext}</p>
                    </div>
                    <svg class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="border-t border-border px-6 py-6">
                    <p class="text-sm font-medium text-muted-foreground">Buyer question asked:</p>
                    <blockquote class="mt-2 rounded-xl bg-muted/40 p-4 text-foreground">"{b.frage}"</blockquote>
                    <p class="mt-4 text-sm font-medium text-muted-foreground">Result:</p>
                    <p class="mt-2 leading-relaxed text-foreground">{b.ergebnis}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- ── Domain-Check ─────────────────────────────────────────── -->
