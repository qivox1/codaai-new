<script>
  // ── Zähler-Animation im Hero: langsam + nacheinander (wie /webinar) ──────
  // 449 zählt hoch → 1 s Pause → 3,592 → 1 s Pause → 7,184
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
  const fmt = new Intl.NumberFormat('en-GB');
  const animate = (el: HTMLElement) => new Promise<void>((resolve) => {
    const target = Number(el.dataset.count ?? '0');
    const dur = 2400;
    const t0 = performance.now();
    const tick = (t: number) => {
      const p = Math.min((t - t0) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt.format(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(tick); else resolve();
    };
    requestAnimationFrame(tick);
  });
  if (counters.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      for (const c of counters) {
        await animate(c);
        await new Promise((r) => setTimeout(r, 1000));
      }
    }, { threshold: 0.4 });
    io.observe(counters[0]);
  } else {
    counters.forEach((c) => (c.textContent = fmt.format(Number(c.dataset.count ?? '0'))));
  }

  // ── Scroll-Pinning: komplettes Audit läuft durch die 3D-Ebene (wie /webinar) ──
  const $id = (id: string) => document.getElementById(id);
  const pinWrap = $id('audit-pin');
  const pinImg = $id('audit-img') as HTMLImageElement | null;
  const pinScene = document.querySelector<HTMLElement>('.audit-scene');
  const pinBar = $id('audit-bar-i');
  const pinLabels = Array.from(document.querySelectorAll('.audit-label'));
  const CARD_H = 932;
  const fitScale = () => {
    if (!pinScene) return;
    const w = pinScene.getBoundingClientRect().width || window.innerWidth;
    const s = Math.min(w / 1600, window.innerHeight / 1000) * 1.04;
    pinScene.style.setProperty('--s', String(s));
    requestAnimationFrame(() => {
      const t = pinScene.querySelector('.audit-title');
      const l = pinScene.querySelector<HTMLElement>('.audit-labels');
      if (t && l) {
        const sr = pinScene.getBoundingClientRect();
        const tr = t.getBoundingClientRect();
        l.style.right = `${Math.max(30, Math.round(sr.right - tr.left))}px`;
      }
      // Overlap-Schutz (Norbert-Feedback 17.07.): Ragt die gekippte Karte bis unter
      // Titel/Labels, bekommen beide einen dunklen Chip-Hintergrund — lesbar statt Kollision.
      const card = pinScene.querySelector('.audit-card');
      if (t && card) {
        const cr = card.getBoundingClientRect();
        const tr2 = t.getBoundingClientRect();
        pinScene.classList.toggle('labels-clash', cr.right > tr2.left - 12);
      }
    });
  };
  fitScale();
  if (document.fonts?.ready) document.fonts.ready.then(fitScale);
  if (pinWrap && pinImg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pinTicking = false;
    const pinUpdate = () => {
      pinTicking = false;
      const total = pinWrap.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const p = Math.max(0, Math.min(1, -pinWrap.getBoundingClientRect().top / total));
      const range = pinImg.offsetHeight - CARD_H;
      pinImg.style.transform = `translateY(${-p * range}px)`;
      if (pinBar) pinBar.style.width = `${p * 100}%`;
      if (pinLabels.length) {
        const li = Math.min(pinLabels.length - 1, Math.floor(p * pinLabels.length));
        pinLabels.forEach((el, i) => el.classList.toggle('on', i === li));
      }
    };
    const onPinScroll = () => { if (!pinTicking) { pinTicking = true; requestAnimationFrame(pinUpdate); } };
    window.addEventListener('scroll', onPinScroll, { passive: true });
    window.addEventListener('resize', () => { fitScale(); onPinScroll(); });
    if (pinImg.complete) pinUpdate(); else pinImg.addEventListener('load', pinUpdate);
  }

  // ── Domain-Check ─────────────────────────────────────────────────────────
  const normalize = (v: string) =>
    v.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0];

  const form = document.getElementById('domain-check-form') as HTMLFormElement | null;
  const input = document.getElementById('domain-input') as HTMLInputElement | null;
  const known = document.getElementById('domain-known');
  const knownName = document.getElementById('domain-known-name');
  const knownLink = document.getElementById('domain-known-link') as HTMLAnchorElement | null;
  const resp = document.getElementById('domain-response');
  const respName = document.getElementById('domain-response-name');

  const dl = (name: string, params: Record<string, string> = {}) => {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: name, ...params });
  };

  // Personalisierter Einstieg aus Nurture-Links: /en/study?d=firma.de
  const param = new URLSearchParams(location.search).get('d');
  if (param && known && knownName && knownLink && input) {
    const dom = normalize(param);
    if (/^[a-z0-9.-]+\.[a-z]{2,}$/.test(dom)) {
      input.value = dom;
      knownName.textContent = dom;
      knownLink.href = `https://audit.codaai.ai/${dom}`;
      known.classList.remove('hidden');
      dl('study_personalized_view', { study_domain: dom });
    }
  }

  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (!input || !resp || !respName) return;
    const dom = normalize(input.value);
    if (!/^[a-z0-9.-]+\.[a-z]{2,}$/.test(dom)) {
      input.focus();
      input.setAttribute('aria-invalid', 'true');
      return;
    }
    input.removeAttribute('aria-invalid');
    known?.classList.add('hidden');
    respName.textContent = dom;
    resp.classList.remove('hidden');
    resp.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    dl('study_domain_check', { study_domain: dom });
  });

  // ── Zitat kopieren ───────────────────────────────────────────────────────
  const citeBtn = document.getElementById('cite-copy');
  const citeText = document.getElementById('cite-text');
  citeBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(citeText?.textContent?.trim() ?? '');
      citeBtn.textContent = 'Copied ✓';
      setTimeout(() => (citeBtn.textContent = 'Copy'), 2000);
      dl('study_cite_copy');
    } catch {
      /* Clipboard nicht verfügbar — kein Fallback nötig */
    }
  });
</script>

<style>
  /* ── Scroll-Audit-Bühne (identisch zu /webinar, Geometrie aus dem Video-Render) ── */
  .audit-pin { height: 300vh; position: relative; margin-top: 2.5rem; }
  /* 100svh (kleine Viewport-Hoehe) statt 100vh: Auf Mobiltelefonen meint 100vh
     die Hoehe OHNE Adressleiste — die Buehne war dadurch hoeher als das Sichtfeld,
     der untere Rand lag hinter der Leiste und jedes Ein- und Ausfahren loeste ein
     resize samt ScrollTrigger-Neuberechnung aus (das Springen beim Scrollen).
     100vh bleibt als Rueckfallwert davor stehen.
     Befund A2 des Mobil-Audits vom 04.08.2026.                                */
  .audit-scene { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: hsl(var(--surface-ink)); border-radius: 24px; }
  .audit-scene::before {
    content: "";
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(42% 46% at 62% 68%, rgba(120, 10, 140, 0.55), transparent 70%),
      radial-gradient(30% 34% at 78% 30%, rgba(90, 8, 105, 0.4), transparent 70%);
    filter: blur(60px);
  }
  .audit-fit { position: absolute; left: 50%; top: 50%; width: 1600px; height: 1000px; transform: translate(-50%, -50%) scale(var(--s, 0.5)); }
  .audit-card {
    position: absolute; left: 0; top: 0; width: 1100px; height: 932px; overflow: hidden;
