---
/* Englische Startseite — Spiegelung von src/pages/index.astro (Stand 04.08.2026).
   Ersetzt das alte Content-Agentur-Design (Hero/Features/Pricing/TeamSection …),
   das noch die Positionierung „AI content platform, from 149 €/month" trug.
   Sektionsfolge, Komponenten und Schema-Blöcke sind identisch zur deutschen
   Seite; übersetzt sind nur die Textfelder. Regeln: en-relaunch-2026-08-04/
   KONVENTIONEN.md (tier / base fee / building block / Google AI Overviews /
   commitment statt guarantee / die KI ist immer „it"). */
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import PremiumHome from '../../components/premium/Home.astro';
import { getCollection } from 'astro:content';
import Booking from '../../components/Booking.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { faqGeneralEn } from '../../data/faq.en';

const language = 'en' as const;

const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

// Neueste 3 EN-Artikel für die Homepage-Sektion
const allEnPosts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.noindex);
const recentPosts = allEnPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// SoftwareApplication schema — enables App rich results in Google Search
const softwareSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CodaAI',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Digital Visibility Platform',
  operatingSystem: 'Web',
  url: `${SITE_URL}/en/`,
  description: 'Digital Visibility for mid-sized B2B companies: visibility in ChatGPT, Google AI Overviews and classic search – SEO, AEO and GEO plus AI-assisted content production.',
  inLanguage: ['en', 'de'],
  offers: {
    '@type': 'Offer',
    price: '1470',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '1470',
      priceCurrency: 'EUR',
      unitText: 'MONTH',
    },
  },
  featureList: [
    'Digital Visibility Audit',
    'AI visibility monitoring with a monthly report',
    'SEO including Bing optimisation',
    'Technical AI accessibility (GEO/AEO)',
    'SEO-optimised blog articles up to 4,000 words',
    'AI-generated graphics and videos',
    'Digital PR and brand mentions',
  ],
  screenshot: `${SITE_URL}/images/og-image.png`,
  provider: {
    '@id': `${SITE_URL}/#organization`,
  },
});

/* FAQPage-Schema fuer die allgemeinen Fragen. Es steht bewusst HIER und nicht
   zusaetzlich auf /en/faq: Jede Frage soll genau einmal ausgezeichnet im Index
   stehen, und zwar auf der Seite, auf der sie thematisch beantwortet wird
   (Beschluss Oli, 03.08.2026). Preis-, Visibility- und Webinarfragen tragen
   ihr Schema entsprechend auf /en/pricing, /en/digital-visibility und
   /en/webinar. */
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGeneralEn.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

// Service schema — Digital Visibility mit den drei buchbaren Stufen
const visibilityServiceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Digital Visibility',
  serviceType: 'Digital Visibility (SEO, AEO, GEO)',
  provider: {
    '@id': `${SITE_URL}/#organization`,
  },
  areaServed: 'DE',
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Mid-sized B2B companies',
  },
  description: 'Digital Visibility for mid-sized B2B companies: visibility in ChatGPT, Google AI Overviews and classic search – SEO, AEO and GEO plus AI-assisted content production. Three tiers: Found, Recommended, Cited.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Digital Visibility tiers',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Tier 1 · Found',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '490',
          priceCurrency: 'EUR',
          unitText: 'MONTH',
        },
      },
      {
        '@type': 'Offer',
        name: 'Tier 2 · Recommended',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '990',
          priceCurrency: 'EUR',
          unitText: 'MONTH',
        },
      },
      {
        '@type': 'Offer',
        name: 'Tier 3 · Cited',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: '1790',
          priceCurrency: 'EUR',
          unitText: 'MONTH',
        },
      },
    ],
  },
});

---

<Layout
  lang={language}
  title="Digital Visibility: Visible in ChatGPT & Google | CodaAI"
  description="Buyers ask AI first. CodaAI makes B2B companies visible there: ChatGPT, Google AI Overviews, classic search — SEO, AEO & GEO plus content."
  jsonLd={[softwareSchema, visibilityServiceSchema, faqSchema]}
>
  <Navbar lang={language} />
  <main id="main-content">
    {/* Gleiche Sektionsfolge wie auf der deutschen Startseite:
        PremiumHome (Hero → Problem → drei Stellen → Spiegel → Angebot → Outcome)
        → Booking → FAQ → Blog-Teaser. Die Seite hat genau einen Hauptausgang
        (Audit) und einen Nebenausgang (Termin). */}
    <PremiumHome lang={language} />
    <Booking lang={language} />

    {/* ── Fragen zu CodaAI und zur Zusammenarbeit ─────────────────────────────
        Nur die allgemeinen Fragen: Was macht CodaAI, wie faengt man an, wie
        verhaelt sich das zur eigenen Agentur. Alles zu Preis, Technik und
        Webinar steht auf der jeweiligen Seite. */}
    <FaqAccordion
      items={faqGeneralEn}
      eyebrow="Common questions"
      title="What prospects ask us first"
      intro="Questions about price, term and technology are answered on the pages where they belong — here is what keeps coming up about CodaAI itself and about working together."
      id="faq"
      idPrefix="faq-home"
      tone="muted"
    >
      <p slot="after" class="mt-10 text-sm text-muted-foreground">
        Your question is not here?
        <a href="/en/faq/" class="font-semibold text-cta-accessible transition-colors hover:text-cta">All questions &amp; answers →</a>
      </p>
    </FaqAccordion>

    {/* ── Neueste Artikel ───────────────────────────────────────────────────── */}
    <section aria-labelledby="blog-section-heading" class="py-20 lg:py-28 bg-background border-t border-border">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mb-10 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-2">Blog</p>
            <h2 id="blog-section-heading" class="cai-h2 text-foreground">
              Latest articles
            </h2>
          </div>
          <a
            href="/en/blog/"
            class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-cta-accessible hover:text-cta transition-colors"
          >
            All articles →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {recentPosts.map((post) => (
            <article class="group relative flex flex-col rounded-2xl border border-border bg-card overflow-hidden transition-shadow hover:shadow-lg hover:border-cta/30">
              {post.data.heroImage ? (
                <div class="h-44 overflow-hidden bg-muted">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt ?? post.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="176"
                  />
                </div>
              ) : (
                <div class="h-44 flex items-center justify-center bg-gradient-to-br from-cta/10 to-cta/5">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="#DF41FB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              )}
              <div class="flex flex-col flex-1 p-5">
                <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-2">{post.data.category}</p>
                <h3 class="text-base font-semibold text-foreground leading-snug mb-2 group-hover:text-cta transition-colors">
                  <a href={`/en/blog/${post.id.replace(/^en\//, '')}/`} class="after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h3>
                <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2 flex-1">
                  {post.data.description}
                </p>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="mt-4 text-xs text-muted-foreground"
                >
                  {post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/en/blog/" class="text-sm font-semibold text-cta-accessible hover:text-cta transition-colors">
            View all articles →
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={language} />
</Layout>
