---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import TeamSection from '../../components/TeamSection.astro';
import Pricing from '../../components/Pricing.astro';
import FAQ from '../../components/FAQ.astro';
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import { getTranslations } from '../../i18n/utils';
import RoutineWork from '../../components/RoutineWork.astro';
import GlobalReach from '../../components/GlobalReach.astro';
import Booking from '../../components/Booking.astro';

const language = 'en' as const;
const tr = getTranslations(language);

const SITE_URL = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');

const softwareSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CodaAI',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Content Marketing Platform',
  operatingSystem: 'Web',
  url: `${SITE_URL}/en/`,
  description: 'AI-powered content platform that handles your entire content production – SEO articles, graphics and videos. Up to 88% cheaper than a traditional content agency.',
  inLanguage: ['en', 'de'],
  offers: {
    '@type': 'Offer',
    price: '1470',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '1470',
      priceCurrency: 'EUR',
      unitText: 'MONTH',
    },
  },
  featureList: [
    'AI-powered editorial planning',
    'SEO-optimised blog articles up to 4,000 words',
    'AI-generated graphics and infographics',
    'GEO optimisation for AI search engines',
    'Automatic social media videos',
    'Multi-channel content distribution',
  ],
  screenshot: `${SITE_URL}/images/og-image.png`,
  provider: {
    '@id': `${SITE_URL}/#organization`,
  },
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tr.faq.items.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
});
---

<Layout
  lang={language}
  title="CodaAI – AI Content Platform for SEO, Design & Video"
  description="Save over €100,000 per year. CodaAI handles your entire content production – SEO articles, graphics and videos. Everything from one AI platform."
  jsonLd={[softwareSchema, faqSchema]}
>
  <Navbar lang={language} />
  <main id="main-content">
    <Hero lang={language} />
    <Features lang={language} />
    <ProcessSteps lang={language} />
    <TeamSection lang={language} />
    <Pricing lang={language} />
    <RoutineWork lang={language} />
    <GlobalReach lang={language} />
    <FAQ lang={language} />
    <Booking lang={language} />
  </main>
  <Footer lang={language} />
</Layout>
