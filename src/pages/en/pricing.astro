---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PricingCalculator from '../../components/react/PricingCalculator';
import Breadcrumb from '../../components/Breadcrumb.astro';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  lang={lang}
  title="Pricing – CodaAI Content Packages"
  description="Flexible content packages from €449/month. SEO articles, graphics and videos. Compare CodaAI with agency costs and save over 90%."
>
  <Navbar lang={lang} />
  <main class="pt-0">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-24 lg:pt-28 pb-0">
      <Breadcrumb items={[{ label: 'Home', href: `${base}/en/` }, { label: 'Pricing' }]} class="mb-0" />
    </div>
    <PricingCalculator lang={lang} base={base} client:load />
  </main>
  <Footer lang={lang} />
</Layout>
