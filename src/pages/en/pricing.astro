---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Booking from '../../components/Booking.astro';
import PricingCalculatorV2 from '../../components/react/PricingCalculatorV2';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Reveal from '../../components/fx/Reveal.astro';
import HeroHeadline from '../../components/HeroHeadline.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { faqPricingEn } from '../../data/faq.en';

/* ─────────────────────────────────────────────────────────────────────────────
   /en/pricing/ — English mirror of /preise/ (state of 04.08.2026).

   Rebuilt in the EN relaunch of 04.08.2026. The previous English version still
   carried the old positioning (tiers called Basis/Active/Dominance, a fixed
   "programme" fee, a promise that the calculator hands out a quote PDF). All of
   that is gone: the tiers are Found / Recommended / Cited, the fixed monthly
   amount is the base fee, and the calculator has exactly two exits — the
   30-minute intro call and the appointment section below it.

   Structure, classes, IDs, animation logic and scripts are taken over 1:1 from
   the German page. Only visible text is translated.
   Conventions: en-relaunch-2026-08-04/KONVENTIONEN.md
   ────────────────────────────────────────────────────────────────────────── */

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* ── The three tiers ──────────────────────────────────────────────────────────
   Visibility is the product, content is the dosage. The cards only tease —
   description, result, base amount, number of building blocks, link. The full
   building-block lists live on /en/digital-visibility/ and are not repeated
   here.                                                                       */
const tiers = [
  {
    level: 'Tier 1',
    name: 'Found',
    anchor: 'readable',
    result: 'The AI can read you — and every month you see where you stand',
    blocks: '6 building blocks',
    from: 'from €1,470',
    recommended: false,
  },
  {
    level: 'Tier 2',
    name: 'Recommended',
    anchor: 'sources',
    result: 'Your name also comes up where the AI collects its evidence',
    blocks: '10 building blocks',
    from: 'from €2,670',
    /* The German card carries the badge "Empfohlen" above a tier also called
       "Empfohlen". In English that would read as the same word twice, so the
       badge says "We recommend" — a statement we can stand behind, unlike
       "most popular", which we have no figures for. */
    recommended: true,
  },
  {
    level: 'Tier 3',
    name: 'Cited',
    anchor: 'become-the-source',
    result: 'Your market cites your figures',
    blocks: '14 building blocks',
    from: 'from €4,910',
    recommended: false,
  },
];

/* ── FAQ — price, term and contract only.
      Subject-matter questions sit on /en/digital-visibility/, questions about
      CodaAI itself on the homepage. Single source: src/data/faq.en.ts. Since
      10.08.2026 the markup is shared too (FaqAccordion.astro). ── */
const faqs = faqPricingEn;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  lang={lang}
  title="Pricing – so the next enquiry lands with you | CodaAI"
  description="Transparently calculated instead of “on request”: three visibility tiers from €1,470 per month, with a price calculator whose total you can check."
>
  <Navbar lang={lang} />
  <main class="pt-0">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-24 lg:pt-28 pb-0">
      <Breadcrumb items={[{ label: 'Home', ariaLabel: 'Go to the homepage', href: `${base}/en/` }, { label: 'Pricing' }]} class="mb-0" />
    </div>

    <!-- ── 1 · Hero ─────────────────────────────────────────────────────
         Benefit, not cost: decision-makers are not buying articles, they
         want the next enquiry. Phrased as a purpose, not as a promise of
         success — we refuse placement and success guarantees.               -->
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-8 lg:pt-10 pb-16 lg:pb-20">
      <HeroHeadline
        line1="So the next enquiry lands with you."
        line2="Not with a competitor."
        class="max-w-5xl"
      />
      <p class="pr-line mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground" style="--d:2">
        Before anyone gets in touch, they ask the AI. We make sure your name turns up where that
        answer is formed — and show you every month whether it does.
      </p>
      <div class="pr-line mt-8" style="--d:3">
        <a
          href="#calculator"
          class="inline-flex items-center gap-2 rounded-[14px] bg-cta-strong px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          Configure your price →
        </a>
      </div>
    </div>

    <!-- ── 2 · The three tiers — details on /en/digital-visibility/ ──────────── -->
    <section id="tiers" aria-label="The three visibility tiers" class="py-20 lg:py-28 scroll-mt-24 lg:scroll-mt-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <Reveal as="div">
          <h2 class="cai-h2 max-w-5xl text-foreground">
            Three tiers. The higher you go, the more places the AI finds you.
          </h2>
        </Reveal>

        <!-- Rail: fills magenta as you scroll and marks the three tiers — the
             same mechanism as the tier line on /en/digital-visibility/, laid
             out horizontally here. Purely decorative. -->
        <div class="pr-rail mt-12 hidden lg:block" aria-hidden="true" data-rail>
          <span class="pr-rail-fill"></span>
          <span class="pr-dot" style="--x:16.6%"></span>
          <span class="pr-dot" style="--x:50%"></span>
          <span class="pr-dot" style="--x:83.3%"></span>
        </div>

        <div class="mt-8 grid gap-6 lg:mt-6 lg:grid-cols-3">
          {tiers.map((s, i) => (
            <Reveal
              as="div"
              delay={i * 110}
              class={`pr-card relative flex flex-col rounded-2xl border bg-card p-6 lg:p-7 ${['lg:mt-10', 'lg:mt-5', 'lg:mt-0'][i]} ${s.recommended ? 'border-price shadow-[0_10px_40px_hsl(var(--price)/0.18)]' : 'border-border'}`}
            >
              {s.recommended && (
                <span class="absolute -top-3 left-6 rounded-md bg-price px-2.5 py-1 text-[10.5px] font-bold uppercase tracking-widest text-foreground">
                  We recommend
                </span>
              )}
              <p class="text-[11.5px] font-bold uppercase tracking-widest text-cta-accessible">{s.level}</p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">{s.name}</h3>
              <p class="mt-3 flex-1 text-[15px] font-semibold leading-snug text-foreground">{s.result}</p>

              <p class="mt-6">
                <span class="text-3xl font-bold tracking-tight text-foreground">{s.from}</span>
                <span class="text-sm text-muted-foreground">/ month</span>
              </p>

              <a
                href={`${base}/en/digital-visibility/#${s.anchor}`}
                class="mt-4 inline-flex items-center gap-1 text-[13px] font-semibold text-cta-accessible transition-colors hover:text-cta"
              >
                {s.blocks} →
              </a>
            </Reveal>
          ))}
        </div>

        <Reveal as="p" delay={360} class="mt-10 max-w-2xl text-sm leading-relaxed text-muted-foreground">
          We write down just as plainly what we deliberately do <strong class="font-semibold text-foreground">not</strong> offer — six points, each with a reason:
          <a href={`${base}/en/digital-visibility/#not-included`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">read them →</a>
        </Reveal>

        <!-- Handover to the calculator: one button, and below it the line that
             draws itself as you scroll. -->
        <Reveal as="div" delay={420} class="mt-12 flex flex-col items-center">
          <a
            href="#calculator"
            class="inline-flex items-center gap-2 rounded-[14px] bg-cta-strong px-6 py-4 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            Configure your price →
          </a>
          <span class="pr-drop mt-6" aria-hidden="true" data-drop><span class="pr-drop-fill"></span></span>
        </Reveal>
      </div>
    </section>

    <!-- ── 3 · Price calculator (carries both exits) ─────────────────────
         Section id is `calculator` in English, `rechner` in German — see the
         anchor map in KONVENTIONEN.md.                                      -->
    <PricingCalculatorV2 lang={lang} base={base} bookingHref={`${base}/en/pricing/#appointment`} client:load />

    <!-- ── 4 · Appointment ───────────────────────────────────────────────
         Booking.astro emits `id="appointment"` for English since 04.08.2026,
         so the anchor comes from the component itself. The wrapper div that
         used to supply it was removed — it would now duplicate the id.    -->
    <Booking lang={lang} />

    {/* ── 5 · FAQ ────────────────────────────────────────────────────────
         Shared component since 10.08.2026 — see preise.astro for the reasoning.
         The page-specific `pr-f…` copy is gone. */}
    <FaqAccordion
      items={faqs}
      title="Frequently asked questions about pricing"
      id="faq"
      idPrefix="faq"
      level={3}
    >
      <p slot="after" class="mt-10 text-sm text-muted-foreground">
        No figures for your company yet?
        <a href={`${base}/en/#offer`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">Request a free audit →</a>
      </p>
    </FaqAccordion>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />


  <style>
    /* ── Hero: lines run in on load (as on /en/digital-visibility/) ─────── */
    .pr-line {
      opacity: 0;
      transform: translateY(18px);
      animation: prLineIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--d, 0) * 110ms);
    }
    h1.pr-line { --d: 0; }
    @keyframes prLineIn { to { opacity: 1; transform: none; } }

    /* ── Tier rail ──────────────────────────────────────────────────────── */
    .pr-rail {
      position: relative;
      height: 2px;
      border-radius: 2px;
      background: hsl(var(--border));
    }
    .pr-rail-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: 0;
      border-radius: 2px;
      background: hsl(var(--cta));
      transition: width 0.12s linear;
    }
    .pr-dot {
      position: absolute;
      top: 50%;
      left: var(--x);
      height: 10px;
      width: 10px;
      margin: -5px 0 0 -5px;
      border-radius: 999px;
      border: 2px solid hsl(var(--border));
      background: hsl(var(--background));
      transition: border-color 0.3s ease, background-color 0.3s ease, transform 0.3s ease;
    }
    .pr-dot.is-lit {
      border-color: hsl(var(--cta));
      background: hsl(var(--cta));
      transform: scale(1.25);
    }

    /* ── Cards ──────────────────────────────────────────────────────────── */
    .pr-card { transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
    .pr-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--cta) / 0.6);
      box-shadow: 0 16px 40px -20px hsl(var(--cta) / 0.55);
    }

    /* The FAQ accordion lives in components/FaqAccordion.astro since
       10.08.2026 — its CSS and script sit there. */


    /* ── Handover: the line draws itself into the calculator ────────────── */
    .pr-drop {
      display: block;
      position: relative;
      width: 2px;
      height: 72px;
      border-radius: 2px;
      background: hsl(var(--border));
      overflow: hidden;
    }
    .pr-drop-fill {
      position: absolute;
      inset: 0 0 auto 0;
      height: 0;
      border-radius: 2px;
      background: hsl(var(--cta));
      transition: height 0.12s linear;
    }

    @media (prefers-reduced-motion: reduce) {
      .pr-line { opacity: 1; transform: none; animation: none; }
      .pr-rail-fill, .pr-drop-fill, .pr-dot, .pr-card { transition: none; }
      .pr-card:hover { transform: none; }
    }
  </style>

  <script is:inline>
    (function () {
      /* Rail and handover line fill depending on scroll position. Both purely
         decorative — without JS they simply stay grey. */
      var rail = document.querySelector('[data-rail]');
      var railFill = rail && rail.querySelector('.pr-rail-fill');
      var dots = rail ? Array.prototype.slice.call(rail.querySelectorAll('.pr-dot')) : [];
      var drop = document.querySelector('[data-drop]');
      var dropFill = drop && drop.querySelector('.pr-drop-fill');

      function pct(el, startAt, endAt) {
        var r = el.getBoundingClientRect();
        var h = window.innerHeight;
        var p = (h * startAt - r.top) / (h * (startAt - endAt) || 1);
        return p < 0 ? 0 : p > 1 ? 1 : p;
      }

      function paint() {
        if (railFill) {
          var p = pct(rail, 0.9, 0.45);
          railFill.style.width = (p * 100).toFixed(1) + '%';
          dots.forEach(function (d, i) {
            var at = [0.166, 0.5, 0.833][i];
            d.classList.toggle('is-lit', p >= at);
          });
        }
        if (dropFill) {
          dropFill.style.height = (pct(drop, 0.95, 0.6) * 100).toFixed(1) + '%';
        }
      }

      /* The FAQ accordion brings its own script (FaqAccordion.astro). */

      var ticking = false;
      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () { paint(); ticking = false; });
      }, { passive: true });
      window.addEventListener('resize', paint);
      paint();
    })();
  </script>

  <Footer lang={lang} />
</Layout>
