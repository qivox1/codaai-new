---
/* /en/check/ — Weiterleitung (seit 01.10.2026, Beschluss Oli).
   Der „KI-Sichtbarkeits-Check" (Audit-Formular, AuditCTA) ist auf der
   deutschen Seite durch den Visibility Snapshot ersetzt, der jetzt im
   Kopfbereich der Startseite liegt (/#snapshot). Die Datei bleibt, weil
   Blogartikel, Footer-Altstände und geteilte Links auf /check/ zeigen.
   ?d=… wird mitgenommen (der Snapshot füllt die Website vor).
   noindex, Canonical auf die Startseite, aus der Sitemap ausgeschlossen.
   Englische Fassung von /check/ (seit 01.10.2026).
   Früherer Seiteninhalt: Git-Historie bis 2f8c965 (CheckPage.astro besteht weiter). */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/en/#snapshot`;
const canonical = 'https://www.codaai.ai/en/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <script is:inline set:html={`location.replace(${JSON.stringify(base + '/en/')} + location.search + '#snapshot');`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecting to the Visibility Snapshot | CodaAI</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center;">
    <p>
      The free check is now the Visibility Snapshot on our
      <a href={target} style="color: hsl(var(--cta-accessible)); font-weight: 600;">homepage</a>.
    </p>
  </body>
</html>
