---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  lang={lang}
  title="Order Successful – CodaAI"
  description="Your CodaAI subscription has been successfully activated."
>
  <Navbar lang={lang} />
  <main class="min-h-screen flex items-center justify-center px-6 py-24">
    <div class="text-center max-w-lg mx-auto">

      <!-- Success Icon -->
      <div class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full bg-cta/10 ring-1 ring-cta/30">
        <svg
          class="h-10 w-10 text-cta"
          viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6L9 17l-5-5"/>
        </svg>
      </div>

      <h1 class="cai-h1 text-foreground mb-4">
        Welcome to CodaAI! 🎉
      </h1>

      <p class="text-muted-foreground text-lg mb-6">
        Your subscription is active. Our team will be in touch shortly
        to prepare everything for your production kick-off.
      </p>

      <div class="bg-card border border-border rounded-2xl p-6 mb-8 text-left space-y-4">
        <div class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-cta/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-3 h-3 text-cta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-foreground">Confirmation email sent</p>
            <p class="text-xs text-muted-foreground mt-0.5">You will receive an email with all details of your subscription.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-muted flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-3 h-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-foreground">Onboarding materials to follow</p>
            <p class="text-xs text-muted-foreground mt-0.5">You will receive further information to get started shortly.</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-muted flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-3 h-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-foreground">Personal contact within 24 h</p>
            <p class="text-xs text-muted-foreground mt-0.5">We will reach out within one business day.</p>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`${base}/en/`}
          class="inline-flex items-center justify-center h-12 px-6 rounded-[14px] bg-cta-strong text-white font-semibold text-sm hover:bg-cta-strong/90 transition-colors"
        >
          Back to Home
        </a>
        <a
          href="mailto:hi@codaai.ai"
          class="inline-flex items-center justify-center h-12 px-6 rounded-[14px] border border-border text-foreground font-medium text-sm hover:bg-muted/50 transition-colors"
        >
          hi@codaai.ai
        </a>
      </div>

    </div>
  </main>
  <Footer lang={lang} />

  {/* GA4 Conversion: Stripe checkout completed → Customer */}
  {/* Reads ?session_id, ?amount, ?currency from Stripe success_url; */}
  {/* dedupes via sessionStorage so reloads don't double-count. */}
  <script is:inline>
    (function () {
      try {
        var params    = new URLSearchParams(window.location.search);
        var sessionId = params.get('session_id') || '';
        var amount    = params.get('amount') || '';
        var currency  = (params.get('currency') || 'EUR').toUpperCase();

        // Idempotency: never fire twice for the same Stripe session_id
        var firedKey = 'ga4_new_customer_fired_' + sessionId;
        if (sessionId && sessionStorage.getItem(firedKey)) return;

        window.dataLayer = window.dataLayer || [];
        var payload = { event: 'new_customer' };
        if (sessionId) payload.transaction_id = sessionId;
        if (amount) {
          var amountNum = parseFloat(amount);
          if (!isNaN(amountNum)) {
            payload.value = amountNum;
            payload.currency = currency;
          }
        }
        window.dataLayer.push(payload);

        if (sessionId) sessionStorage.setItem(firedKey, '1');
      } catch (_) {}
    })();
  </script>
</Layout>
