---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContentRequestForm from '../../components/react/ContentRequestForm';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE_URL = 'https://qivox1.github.io/codaai-new';

// ── E-E-A-T: Person schema (Anja Miebach) ─────────────────────────────────
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/co-create/#anja-miebach`,
  name: 'Anja Miebach',
  givenName: 'Anja',
  familyName: 'Miebach',
  jobTitle: 'Founder & Owner',
  description: 'Anja Miebach is the founder and owner of CodaAI. She combines entrepreneurial clarity and strategic thinking with cutting-edge AI technology to create sustainable visibility for B2B companies.',
  image: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/images/team/anja-miebach.webp`,
    width: 800,
    height: 800,
  },
  worksFor: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'CodaAI',
  },
  knowsAbout: [
    'AI-powered Content Marketing',
    'B2B Content Strategy',
    'Generative Engine Optimization (GEO)',
    'Search Engine Optimization (SEO)',
    'Marketing Automation',
    'Digital Transformation',
    'B2B Marketing',
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'AI Marketing Strategist',
    occupationLocation: {
      '@type': 'City',
      name: 'Gütersloh',
    },
    skills: 'AI Content Marketing, SEO, GEO, B2B Strategy, Marketing Automation',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Gütersloh',
    postalCode: '33332',
    addressCountry: 'DE',
  },
  url: `${SITE_URL}/en/co-create/`,
  sameAs: [],
};

// ── AboutPage schema ───────────────────────────────────────────────────────
const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${SITE_URL}/en/co-create/#webpage`,
  name: 'Mission & CoCreate Principle – CodaAI',
  description: 'CodaAI combines 20+ years of marketing expertise with AI efficiency. Learn about the CoCreate principle and founder Anja Miebach.',
  url: `${SITE_URL}/en/co-create/`,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'CodaAI',
    url: `${SITE_URL}/`,
  },
  about: [
    { '@id': `${SITE_URL}/co-create/#anja-miebach` },
    { '@type': 'Organization', '@id': `${SITE_URL}/#organization` },
  ],
  author: { '@id': `${SITE_URL}/co-create/#anja-miebach` },
  datePublished: '2024-01-01',
  dateModified: '2026-03-01',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Co-Create', item: `${SITE_URL}/en/co-create/` },
    ],
  },
};
---

<Layout
  heroImage={`${SITE_URL}/images/team/anja-miebach.webp`}
  lang="en"
  title="Mission & CoCreate Principle – CodaAI"
  description="20+ years of marketing expertise meets AI efficiency. Learn about the CodaAI CoCreate principle and founder Anja Miebach."
  jsonLd={[JSON.stringify(personSchema), JSON.stringify(aboutPageSchema)]}
>
  <Navbar lang="en" />

  <main class="overflow-hidden">

    {/* ── HERO ─────────────────────────────────────────────────────────── */}
    <section class="relative pt-28 pb-20 lg:pt-36 lg:pb-28">
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-gradient-to-br from-background via-background to-background"></div>
        <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-cta/8 rounded-full blur-[120px] -translate-y-1/2"></div>
        <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-cta/8 rounded-full blur-[100px] translate-y-1/4"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <Breadcrumb items={[{ label: 'Home', ariaLabel: 'Go to Homepage', href: `${base}/en/` }, { label: 'Co-Create' }]} class="mb-8" />

        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cta/10 border border-cta/20 text-cta text-xs font-medium mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
              CodaAI CoCreate
            </div>

            <h1 class="text-4xl lg:text-5xl font-bold text-foreground leading-tight mb-6">
              Where human expertise<br/>
              <span class="bg-gradient-to-r from-cta to-violet-600 bg-clip-text text-transparent">
                and AI efficiency
              </span><br/>
              converge
            </h1>

            <p class="text-lg text-muted-foreground leading-relaxed mb-8">
              Human intuition, 20+ years of marketing expertise and relentless AI power:
              That is CodaAI.
            </p>

            <div class="grid grid-cols-3 gap-4">
              {[
                { value: '20+', label: 'Years of\nMarketing Experience' },
                { value: '94%', label: 'Less expensive than\ntraditional agencies' },
                { value: '7,184', label: 'AI answers\nanalysed' },
              ].map(stat => (
                <div class="p-4 rounded-xl bg-card border border-border text-center">
                  <div class="text-2xl font-bold text-cta mb-1">{stat.value}</div>
                  <div class="text-xs text-muted-foreground leading-tight whitespace-pre-line">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="flex justify-center lg:justify-end">
            <div class="relative">
              <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-cta/25 to-pink-500/20 blur-2xl scale-105"></div>
              <div class="relative rounded-2xl overflow-hidden border border-cta/20 shadow-2xl shadow-cta/20 w-full max-w-sm">
                <img
                  src={`${base}/images/team/anja-miebach.webp`}
                  srcset={`${base}/images/team/anja-miebach.webp 480w, ${base}/images/team/anja-miebach.webp 240w`}
                  sizes="(max-width: 640px) 240px, 480px"
                  alt="Anja Miebach – Gründerin & Inhaberin von CodaAI"
                  width="480"
                  height="480"
                  loading="eager"
                  class="w-full h-auto object-cover"
                />
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-6 py-5">
                  <p class="text-white font-semibold text-lg leading-tight">Anja</p>
                  <p class="text-white/80 text-sm">Founder & Owner, CodaAI</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── COCREATE PRINCIPLE ──────────────────────────────────────────────── */}
    <section class="py-20 lg:py-28 bg-card/30">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-bold text-foreground mb-4">
            Marketing reimagined:<br/>
            <span class="bg-gradient-to-r from-cta to-violet-600 bg-clip-text text-transparent">
              The Era of CoCreation
            </span>
          </h2>
          <p class="text-muted-foreground text-lg">
            AI alone is not enough. Real strength emerges where computing power meets human intuition,
            strategic foresight and deep business understanding.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {[
            {
              icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>`,
              title: 'Human Expertise',
              description: 'The CodaAI team brings years of professional marketing experience to the table: guiding strategy, ensuring quality, and giving every piece of content the human touch that makes it authentic and effective.',
              items: ['Strategic direction', 'Quality assurance', 'Industry knowledge', 'Entrepreneurial clarity'],
              accent: 'violet',
            },
            {
              icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>`,
              title: 'AI Efficiency',
              description: 'Our AI handles data-driven analysis, accelerates processes and efficiently generates high-quality content – exponentially expanding your potential.',
              items: ['Scalable production', 'Data-driven analysis', 'Automated processes', 'Consistently high quality'],
              accent: 'indigo',
            },
          ].map(card => (
            <div class="relative p-8 rounded-2xl bg-card border border-border overflow-hidden group hover:border-cta/30 transition-colors duration-300">
              <div class={`absolute top-0 right-0 w-48 h-48 bg-cta/5 rounded-full blur-2xl group-hover:bg-cta/10 transition-colors duration-500`}></div>
              <div class="relative">
                <div class={`w-12 h-12 rounded-xl bg-cta/10 border border-cta/20 flex items-center justify-center mb-5`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                    stroke='#df41fb'
                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                    set:html={card.icon} aria-hidden="true"
                  />
                </div>
                <h3 class="text-xl font-semibold text-foreground mb-3">{card.title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed mb-5">{card.description}</p>
                <ul class="space-y-2">
                  {card.items.map(item => (
                    <li class="flex items-center gap-2 text-sm text-muted-foreground">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                        stroke='#df41fb'
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12l5 5l10 -10"/>
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── FOUNDER BIO (E-E-A-T) ───────────────────────────────────────────── */}
    <section class="py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid lg:grid-cols-5 gap-12 items-start">
          <div class="lg:col-span-3 space-y-6">
            <div>
              <p class="text-cta text-sm font-medium uppercase tracking-widest mb-3">About the Founder</p>
              <h2 class="text-3xl lg:text-4xl font-bold text-foreground mb-5">
                Anja –<br/>
                <span class="bg-gradient-to-r from-cta to-violet-600 bg-clip-text text-transparent">
                  Entrepreneur with Focus
                </span>
              </h2>
            </div>

            <p class="text-muted-foreground leading-relaxed text-base">
              Anja is the founder and owner of CodaAI. As an entrepreneur with a clear focus, she has
              specialised in three things: optimising processes, creating real value and delivering
              measurable results.
            </p>

            <p class="text-muted-foreground leading-relaxed text-base">
              Her expertise lies in entrepreneurial clarity and strategic understanding of the
              requirements of modern B2B companies. From this perspective she identified a major
              opportunity: companies, agencies and marketing teams possess enormous knowledge and
              experience – what they lack is an intelligent system that consistently amplifies and
              scales these strengths.
            </p>

            <p class="text-muted-foreground leading-relaxed text-base">
              The answer is CodaAI – driven by the CoCreate idea. We combine the best of both worlds.
              Our AI handles data-driven analysis, accelerates processes and efficiently generates
              high-quality content. The heart of what we do remains our team: with deep, long-standing
              marketing expertise we guide strategy, ensure quality and give every piece of
              content the human touch that makes it authentic and effective.
            </p>

            <p class="text-muted-foreground leading-relaxed text-base">
              Through this intelligent collaboration between human and machine we offer professional
              content marketing that is up to <strong class="text-foreground font-semibold">94% less expensive</strong> than
              traditional models – with full cost control, maximum reach and the certainty that your
              company benefits from the most powerful combination the market has to offer:
              <em class="text-cta not-italic font-medium">Experience that steers, AI that delivers.</em>
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              {['AI Content Marketing', 'B2B Strategy', 'GEO Optimization', 'SEO', 'Marketing Automation', 'Digital Transformation'].map(tag => (
                <span class="px-3 py-1 text-xs font-medium rounded-full bg-cta/10 border border-cta/20 text-cta">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <div class="lg:col-span-2 space-y-4">
            <h3 class="text-sm font-semibold text-foreground uppercase tracking-widest">Expertise & Experience</h3>

            {[
              {
                icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 21l18 0"/><path d="M3 7v1a3 3 0 0 0 6 0v-1m0 1a3 3 0 0 0 6 0v-1m0 1a3 3 0 0 0 6 0v-1h-18l2 -4h14l2 4"/><path d="M5 21l0 -10.15"/><path d="M19 21l0 -10.15"/><path d="M9 21v-4a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v4"/>`,
                title: '20+ Years of Team Marketing Experience',
                desc: 'The CodaAI team combines deep expertise from B2B and B2C projects for SMEs across the DACH region',
              },
              {
                icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>`,
                title: 'AI & Generative Engine Optimization',
                desc: 'Specialised in content strategies for Google, ChatGPT, Perplexity and Google AI Overviews',
              },
              {
                icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11l3 3l8 -8"/><path d="M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9"/>`,
                title: 'Measurable Results',
                desc: 'Strategies aligned to KPIs – organic reach, visibility and qualified leads',
              },
              {
                icon: `<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 20l10 0"/><path d="M6 6l6 -1l6 1"/><path d="M12 5l0 15"/><path d="M9 11l-3 -6l-3 6a3 3 0 0 0 6 0"/><path d="M21 11l-3 -6l-3 6a3 3 0 0 0 6 0"/>`,
                title: 'EU AI Act & GDPR Compliant',
                desc: 'All processes and content are aligned with EU data protection, the AI Act and legal requirements',
              },
            ].map(item => (
              <div class="flex gap-4 p-5 rounded-xl bg-card border border-border hover:border-cta/25 transition-colors duration-200 group">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-cta/10 flex items-center justify-center group-hover:bg-cta/15 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="#df41fb" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                    set:html={item.icon} aria-hidden="true"
                  />
                </div>
                <div>
                  <p class="text-sm font-semibold text-foreground leading-snug mb-1">{item.title}</p>
                  <p class="text-xs text-muted-foreground leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── MISSION STATEMENT ───────────────────────────────────────────────── */}
    <section class="py-20 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-gradient-to-r from-cta/5 via-background to-pink-900/5"></div>
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-cta/8 rounded-full blur-[100px]"></div>
      </div>
      <div class="mx-auto max-w-4xl px-6 lg:px-8 text-center">
        <p class="text-cta text-sm font-medium uppercase tracking-widest mb-6">Our Promise</p>
        <blockquote class="text-2xl lg:text-3xl font-semibold text-foreground leading-relaxed mb-8">
          "The only meaningful path to the future of marketing is the symbiosis of
          human strength and AI efficiency:
          <span class="bg-gradient-to-r from-cta to-violet-600 bg-clip-text text-transparent">
            CodaAI CoCreate.
          </span>"
        </blockquote>
        <div class="flex items-center justify-center gap-3">
          <img
            src={`${base}/images/team/anja-miebach.webp`}
            alt="Anja Miebach, founder of CodaAI, in the team section"
            width="44"
            height="44"
            class="rounded-full w-11 h-11 object-cover border-2 border-cta/30"
          />
          <div class="text-left">
            <p class="text-sm font-semibold text-foreground">Anja Miebach</p>
            <p class="text-xs text-muted-foreground">Founder & Owner, CodaAI</p>
          </div>
        </div>
      </div>
    </section>

    {/* ── CTA ─────────────────────────────────────────────────────────────── */}
    <section class="py-16 lg:py-20 border-t border-border">
      <div class="mx-auto max-w-2xl px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-foreground mb-4">
          Ready to transform your marketing?
        </h2>
        <p class="text-muted-foreground mb-8">
          Discover how the CoCreate principle can advance your business –
          transparent pricing, measurable results, no surprises.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={`${base}/en/pricing/`} class="inline-flex items-center justify-center gap-2 btn-cta h-14 px-8 text-base">
            View pricing
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l14 0"/><path d="M13 18l6 -6"/><path d="M13 6l6 6"/></svg>
          </a>
          <ContentRequestForm lang="en" triggerClassName="btn-secondary h-14 px-8 text-base" client:idle />
        </div>
      </div>
    </section>

  </main>

  <Footer lang="en" />
</Layout>
