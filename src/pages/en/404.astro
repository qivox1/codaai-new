---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  lang={lang}
  title="Page Not Found – CodaAI"
  description="The page you are looking for does not exist. Back to the CodaAI homepage."
  article={{ noindex: true }}
>
  <Navbar lang={lang} />
  <main class="min-h-screen flex items-center justify-center px-6 py-24">
    <div class="text-center max-w-lg mx-auto">

      <p class="text-8xl font-semibold text-cta mb-6" aria-hidden="true">404</p>

      <h1 class="cai-h1 text-foreground mb-4">
        Page Not Found
      </h1>

      <p class="text-muted-foreground text-lg mb-10">
        The page you are looking for doesn't exist or has been moved.
        No worries – let's get you back on track.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`${base}/en/`}
          class="inline-flex items-center justify-center h-12 px-6 rounded-lg bg-cta text-white font-semibold text-sm hover:bg-cta/90 transition-colors"
        >
          Back to Home
        </a>
        <a
          href="mailto:hi@codaai.ai"
          class="inline-flex items-center justify-center h-12 px-6 rounded-lg border border-border text-foreground font-medium text-sm hover:bg-muted/50 transition-colors"
        >
          Help: hi@codaai.ai
        </a>
      </div>

    </div>
  </main>
  <Footer lang={lang} />
</Layout>
