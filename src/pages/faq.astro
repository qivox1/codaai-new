---
/*
 * /faq — die Sammelseite.
 *
 * Seit der Neuverteilung am 03.08.2026 ist das nicht mehr der einzige Ort für
 * Fragen: Jede Frage steht auf der Seite, auf der sie im Kopf des Lesers
 * auftaucht (Startseite, /digital-visibility, /preise, /webinar). Diese Seite
 * bleibt, weil sie in der Navigation steht und weil Leute, die „FAQ" klicken,
 * Antworten erwarten und keine Linkliste — sie zeigt alle vier Gruppen
 * untereinander und verlinkt jeweils auf die zugehörige Seite.
 *
 * KEIN FAQPage-Schema hier. Das liegt auf den Themenseiten, damit dieselbe
 * Frage nicht zweimal ausgezeichnet im Index steht. Wer hier eines ergänzt,
 * erzeugt genau diese Dublette.
 *
 * Inhalte: src/data/faq.ts — dort steht auch die Regel, in welche Gruppe eine
 * neue Frage gehört.
 */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import { faqGroups } from '../data/faq';

const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const total = faqGroups.reduce((n, g) => n + g.items.length, 0);
---

<Layout
  lang={lang}
  title="Fragen & Antworten – CodaAI | Digital Visibility, Preise, Zusammenarbeit"
  description="Alle Antworten auf einen Blick: CodaAI und die Zusammenarbeit, wie KI-Sichtbarkeit gemessen wird, Preise und Laufzeiten sowie das Live-Webinar."
>
  <Navbar lang={lang} />
  {/* id="main-content" nachgetragen 04.08.2026: Der Sprunglink im Layout zeigt
      auf dieses Ziel — hier fehlte es, der Link lief also ins Leere. */}
  <main id="main-content" class="pt-24 lg:pt-28">
    {/* Seitenspalte max-w-7xl wie überall sonst — vorher stand hier 3xl, was
        linksbündig gegen die Fragenblöcke versetzt gewesen wäre und dem
        Kippsatz bei 48 px zu wenig Raum für eine Zeile gelassen hätte. */}
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-4 pb-2">
      <Breadcrumb
        items={[{ label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` }, { label: 'Fragen & Antworten' }]}
        class="mb-8"
      />
      {/* Kippsatz statt Etikett (Beschluss Oli, 10.08.2026). Die Zahl kommt aus
          faq.ts und zieht mit, wenn Fragen dazukommen. */}
      <HeroHeadline
        line1={`${total} Fragen hören wir immer wieder.`}
        line2="Hier stehen Ihre Antworten."
      />
      <p class="mt-5 max-w-2xl text-lg text-muted-foreground leading-relaxed">
        Vier Bereiche — von der Zusammenarbeit über die Messung der
        KI-Sichtbarkeit bis zu Preis und Laufzeit. Fehlt Ihre?
        <a href="mailto:hi@codaai.ai" class="text-cta-accessible hover:text-cta font-medium">Schreiben Sie uns.</a>
      </p>

      <nav aria-label="Bereiche" class="mt-8 flex flex-wrap gap-2">
        {faqGroups.map((g) => (
          <a
            href={`#${g.id}`}
            class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-cta/50 hover:text-cta-accessible"
          >
            {g.title}
          </a>
        ))}
      </nav>
    </div>

    {faqGroups.map((g) => (
      <FaqAccordion
        items={g.items}
        title={g.title}
        intro={g.intro}
        id={g.id}
        idPrefix={`faq-${g.id}`}
        level={3}
      >
        <p slot="after" class="mt-8 text-sm text-muted-foreground">
          <a
            href={`${base}${g.href}`}
            class="font-semibold text-cta-accessible transition-colors hover:text-cta"
          >
            {g.hrefLabel} →
          </a>
        </p>
      </FaqAccordion>
    ))}

    <section class="mx-auto max-w-7xl px-6 pb-20 pt-4 lg:px-8">
      <p class="max-w-2xl text-base leading-relaxed text-muted-foreground">
        Am schnellsten beantwortet sich die wichtigste Frage von selbst:
        <a href={`${base}/#angebot`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">
          Audit kostenlos anfordern →
        </a>
      </p>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
