---
/* /wissen/geo-glossar/<slug>/ — eine Seite je Begriff (DE). Aufbau und Schema
   in src/components/glossar/GlossarTerm.astro. */
import { getCollection } from 'astro:content';
import GlossarTerm from '../../../components/glossar/GlossarTerm.astro';

export async function getStaticPaths() {
  const terms = await getCollection('glossar', ({ data }) => data.lang === 'de');
  return terms.map((term) => ({ params: { slug: term.id }, props: { term } }));
}
const { term } = Astro.props;
---

<GlossarTerm lang="de" term={term} />
