---
/*
 * /wissen/geo-glossar/<slug>/ — eine Seite je Begriff.
 *
 * Aufbau (bewusst starr, damit jede Seite dasselbe Extraktionsmuster bietet):
 *   1. H1 = der Begriff. Einzeilig und dunkel — Glossarseiten sind
 *      „Einwortseiten" im Sinne der Kippsatz-Regel, kein Farbwechsel ohne Wendung.
 *   2. Lead = shortDefinition (data-speakable), darunter Synonyme.
 *   3. Autorin, Datum, Stufe.
 *   4. Markdown-Body: Definition zuerst, dann H2 im Frageformat.
 *   5. Verwandte Begriffe (Chips) — die interne Verlinkung des Clusters.
 *   6. FAQ aus dem Frontmatter, als FAQPage ausgezeichnet.
 *   7. Audit-CTA im Band.
 *
 * Schema je Seite: DefinedTerm (im DefinedTermSet der Übersicht), Article mit
 * Autorin und dateModified (Freshness), BreadcrumbList, FAQPage.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AuditCTA from '../../../components/premium/AuditCTA.astro';
import {
  GLOSSAR_PATH,
  GLOSSAR_AUTHOR,
  STUFE_ANCHOR,
  categoryTitle,
} from '../../../data/glossar';

export async function getStaticPaths() {
  const terms = await getCollection('glossar');
  return terms.map((term) => ({ params: { slug: term.id }, props: { term } }));
}

const { term } = Astro.props;
const { Content, headings } = await render(term);
const {
  title, seoTitle, shortDefinition, synonyms, category, stufe, related,
  pubDate, updatedDate, faq, noindex,
} = term.data;

const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE_URL = 'https://www.codaai.ai';
const hubUrl = `${SITE_URL}${GLOSSAR_PATH}`;
const pageUrl = `${hubUrl}${term.id}/`;

// Verwandte Begriffe: nur die, die es wirklich gibt — ein Tippfehler im
// Frontmatter darf keinen toten Link erzeugen.
const all = await getCollection('glossar');
const byId = new Map(all.map((t) => [t.id, t]));
const relatedTerms = related
  .map((slug) => byId.get(slug))
  .filter((t): t is NonNullable<typeof t> => Boolean(t) && !t!.data.noindex);

const wordCount = (term.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const fmt = (d: Date) => d.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });
const modified = updatedDate ?? pubDate;

const stufeInfo = stufe ? STUFE_ANCHOR[stufe] : null;
const stufeHref = stufeInfo ? `${base}/digital-visibility/#${stufeInfo.anchor}` : `${base}/digital-visibility/`;

const tocHeadings = headings.filter((h) => h.depth === 2);

// Meta-Description: shortDefinition darf bis 240 Zeichen lang sein (Lead und
// Schema), Google zeigt aber nur rund 160. Erster Satz, wenn er passt; sonst an
// der Wortgrenze gekürzt.
function metaDescription(text: string, max = 158): string {
  if (text.length <= max) return text;
  const firstSentence = text.match(/^[^.!?]+[.!?](?=\s|$)/)?.[0];
  if (firstSentence && firstSentence.length >= 60 && firstSentence.length <= max) return firstSentence;
  const cut = text.slice(0, max - 1);
  return `${cut.slice(0, cut.lastIndexOf(' '))}…`;
}
const description = metaDescription(shortDefinition);

// ── JSON-LD ────────────────────────────────────────────────────────────────
const definedTermSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': `${pageUrl}#begriff`,
  name: title,
  ...(synonyms.length > 0 && { alternateName: synonyms }),
  description: shortDefinition,
  url: pageUrl,
  inDefinedTermSet: { '@type': 'DefinedTermSet', '@id': `${hubUrl}#glossar`, name: 'GEO-Glossar: Begriffe der KI-Suche', url: hubUrl },
});

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#artikel`,
  headline: `${title}: Definition und Bedeutung für die KI-Sichtbarkeit`,
  description: shortDefinition,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  about: { '@id': `${pageUrl}#begriff` },
  datePublished: pubDate.toISOString(),
  dateModified: modified.toISOString(),
  inLanguage: 'de',
  wordCount,
  articleSection: categoryTitle(category),
  author: {
    '@type': 'Person',
    '@id': GLOSSAR_AUTHOR.id,
    name: GLOSSAR_AUTHOR.name,
    jobTitle: GLOSSAR_AUTHOR.jobTitle,
    url: GLOSSAR_AUTHOR.url,
    worksFor: { '@id': `${SITE_URL}/#organization` },
  },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@id': `${hubUrl}#glossar` },
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['[data-speakable]'] },
});

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'GEO-Glossar', item: hubUrl },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
});

const faqSchema = faq.length > 0
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    })
  : null;

const schemas = [definedTermSchema, articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Layout
  lang={lang}
  title={`${seoTitle ?? title} – GEO-Glossar | CodaAI`}
  description={description}
  jsonLd={schemas}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: modified.toISOString(),
    author: GLOSSAR_AUTHOR.name,
    tags: [title, ...synonyms, 'GEO', 'KI-Sichtbarkeit'],
    canonicalUrl: pageUrl,
    noindex,
  }}
>
  <Navbar lang={lang} />
  <main id="main-content" class="pt-24 lg:pt-28">

    <header class="mx-auto max-w-7xl px-6 lg:px-8 pt-4 pb-8">
      <Breadcrumb
        items={[
          { label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` },
          { label: 'GEO-Glossar', href: `${base}${GLOSSAR_PATH}` },
          { label: title },
        ]}
        class="mb-6"
      />
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-3">
          {categoryTitle(category)}
        </p>
        <h1 class="cai-h1 text-foreground">{title}</h1>
        <p class="mt-5 text-lg text-foreground leading-relaxed" data-speakable>{shortDefinition}</p>
        {synonyms.length > 0 && (
          <p class="mt-3 text-sm text-muted-foreground">
            <span class="font-medium text-foreground">Auch:</span> {synonyms.join(' · ')}
          </p>
        )}
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-5 border-y border-border">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 justify-between">
        <div class="flex items-center gap-3">
          <img src={GLOSSAR_AUTHOR.image} alt="" width="40" height="40" class="size-10 rounded-full object-cover flex-shrink-0" loading="lazy" decoding="async" />
          <div>
            <p class="text-sm font-semibold text-foreground">
              <a href={`${base}/co-create/`} class="hover:text-cta-accessible transition-colors">{GLOSSAR_AUTHOR.name}</a>
            </p>
            <p class="text-xs text-muted-foreground">{GLOSSAR_AUTHOR.jobTitle}</p>
          </div>
        </div>
        <div class="flex items-center gap-4 text-xs text-muted-foreground flex-wrap">
          <span>
            Stand: <time datetime={modified.toISOString()} class="text-foreground font-medium">{fmt(modified)}</time>
          </span>
          <span>{readingMinutes} Min. Lesezeit</span>
          {stufeInfo && (
            <a href={stufeHref} class="px-2.5 py-0.5 rounded-full bg-cta/10 text-cta-accessible font-medium hover:bg-cta/20 transition-colors">
              {stufeInfo.label}
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-12">
      <div class="lg:grid lg:grid-cols-[1fr_300px] lg:gap-16 items-start">
        <div>
          {tocHeadings.length > 2 && (
            <nav aria-label="Inhalt" class="mb-10 p-5 rounded-xl border border-border bg-muted/30">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">Auf dieser Seite</p>
              <ol class="space-y-1.5">
                {tocHeadings.map((h) => (
                  <li class="text-sm">
                    <a href={`#${h.slug}`} class="text-muted-foreground hover:text-foreground transition-colors">{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <article
            class="prose prose-slate max-w-none
              prose-headings:font-semibold prose-headings:tracking-tight
              prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
              prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
              prose-p:text-foreground prose-p:leading-relaxed
              prose-a:text-cta-accessible prose-a:no-underline hover:prose-a:underline
              prose-strong:text-foreground
              prose-blockquote:border-l-cta prose-blockquote:bg-muted/30 prose-blockquote:rounded-r-lg prose-blockquote:py-1
              prose-table:text-sm prose-th:text-foreground prose-td:align-top
              prose-ul:my-4 prose-li:my-1"
          >
            <Content />
          </article>

          {relatedTerms.length > 0 && (
            <nav aria-label="Verwandte Begriffe" class="mt-12">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">Verwandte Begriffe</p>
              <ul class="flex flex-wrap gap-2">
                {relatedTerms.map((t) => (
                  <li>
                    <a
                      href={`${base}${GLOSSAR_PATH}${t.id}/`}
                      class="inline-block rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-cta/50 hover:text-cta-accessible"
                      title={t.data.shortDefinition}
                    >
                      {t.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          {faq.length > 0 && (
            <aside class="mt-12 rounded-2xl border border-border bg-muted/20 p-6" aria-labelledby="faq-h">
              <h2 id="faq-h" class="text-xl font-semibold text-foreground mb-6">Häufige Fragen zu {title}</h2>
              <dl class="space-y-6">
                {faq.map(({ q, a }) => (
                  <div>
                    <dt class="font-semibold text-foreground mb-2">{q}</dt>
                    <dd class="text-muted-foreground text-sm leading-relaxed">{a}</dd>
                  </div>
                ))}
              </dl>
            </aside>
          )}
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-28 space-y-6">
            <div class="rounded-2xl border border-border bg-card p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">Im Angebot</p>
              <p class="text-sm text-foreground leading-relaxed">
                {stufeInfo
                  ? `Dieser Begriff gehört zu ${stufeInfo.label}. Auf der Leistungsseite steht, welche der 14 Bausteine daran arbeiten.`
                  : 'Auf der Leistungsseite steht, welche der 14 Bausteine an den Faktoren arbeiten, die dieses Glossar erklärt.'}
              </p>
              <a href={stufeHref} class="mt-4 inline-block text-sm font-medium text-cta-accessible hover:underline">
                Zu Digital Visibility →
              </a>
            </div>
            <div class="rounded-2xl border border-border bg-card p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">Alle Begriffe</p>
              <p class="text-sm text-muted-foreground leading-relaxed">
                Die Übersicht ordnet alle Begriffe entlang des Wegs, den ein Inhalt in eine KI-Antwort nimmt.
              </p>
              <a href={`${base}${GLOSSAR_PATH}`} class="mt-4 inline-block text-sm font-medium text-cta-accessible hover:underline">
                Zum GEO-Glossar →
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <section class="mx-auto max-w-7xl px-6 lg:px-8 pb-16">
      <div class="rounded-2xl border border-border bg-muted/20 p-6 lg:p-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-2">Vom Begriff zur Zahl</p>
        <h2 class="cai-h2">Wie steht Ihr Unternehmen bei diesem Faktor da?</h2>
        <p class="mt-4 max-w-3xl text-muted-foreground leading-relaxed">
          Das Digital Visibility Audit misst zu echten Einkäuferfragen, ob ChatGPT und die Google
          KI-Übersicht Ihr Unternehmen nennen — und woran es liegt, wenn nicht.
        </p>
        <div class="mt-6">
          <AuditCTA lang={lang} variant="band" />
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
