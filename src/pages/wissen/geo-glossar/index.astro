---
/*
 * /wissen/geo-glossar/ — die Übersicht des GEO-Glossars.
 *
 * Hub eines Themen-Clusters (seit 03.09.2026): jeder Begriff hat seine eigene
 * URL darunter, diese Seite listet alle mit einem Definitionssatz und ordnet
 * sie in sieben Gruppen — in der Reihenfolge, in der ein Inhalt den Weg in eine
 * KI-Antwort nimmt. Der Definitionssatz steht hier UND auf der Begriffsseite;
 * das ist gewollt: die Übersicht beantwortet die kurze Frage, die Begriffsseite
 * die lange.
 *
 * Schema: DefinedTermSet mit allen Begriffen als hasDefinedTerm. Das
 * FAQPage-Schema liegt ausschließlich auf den Begriffsseiten (Regel vom
 * 03.08.2026: eine Frage in genau einem FAQPage).
 *
 * Der Pfad /wissen/ hat bewusst keine eigene Seite — sie hätte nichts zu sagen.
 * Der Breadcrumb führt deshalb direkt von Start zum Glossar.
 */
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import HeroHeadline from '../../../components/HeroHeadline.astro';
import AuditCTA from '../../../components/premium/AuditCTA.astro';
import { GLOSSAR_CATEGORIES, GLOSSAR_PATH, GLOSSAR_AUTHOR, termSort } from '../../../data/glossar';

const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE_URL = 'https://www.codaai.ai';
const hubUrl = `${SITE_URL}${GLOSSAR_PATH}`;

const terms = (await getCollection('glossar', ({ data }) => !data.noindex)).sort(termSort);
const total = terms.length;

const groups = GLOSSAR_CATEGORIES.map((c) => ({
  ...c,
  terms: terms.filter((t) => t.data.category === c.id),
})).filter((g) => g.terms.length > 0);

const latestUpdate = terms
  .map((t) => t.data.updatedDate ?? t.data.pubDate)
  .sort((a, b) => b.getTime() - a.getTime())[0];

const termSetSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${hubUrl}#glossar`,
  name: 'GEO-Glossar: Begriffe der KI-Suche',
  description:
    'Begriffe rund um Generative Engine Optimization (GEO) und die Sichtbarkeit in KI-Antworten — von Grounding über Re-Ranking bis Share of AI Search, erklärt für Entscheider im Mittelstand.',
  url: hubUrl,
  inLanguage: 'de',
  ...(latestUpdate && { dateModified: latestUpdate.toISOString() }),
  author: { '@type': 'Person', '@id': GLOSSAR_AUTHOR.id, name: GLOSSAR_AUTHOR.name },
  publisher: { '@id': `${SITE_URL}/#organization` },
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': `${hubUrl}${t.id}/#begriff`,
    name: t.data.title,
    description: t.data.shortDefinition,
    url: `${hubUrl}${t.id}/`,
  })),
});

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'GEO-Glossar', item: hubUrl },
  ],
});
---

<Layout
  lang={lang}
  title="GEO-Glossar: Begriffe der KI-Suche erklärt | CodaAI"
  description={`${total} Begriffe der KI-Suche erklärt: Grounding, Query Fan-out, Re-Ranking, Citation Rate, Share of AI Search — je Begriff eine Seite mit Definition und Praxisbezug.`}
  jsonLd={[termSetSchema, breadcrumbSchema]}
>
  <Navbar lang={lang} />
  <main id="main-content" class="pt-24 lg:pt-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-4 pb-2">
      <Breadcrumb
        items={[{ label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` }, { label: 'GEO-Glossar' }]}
        class="mb-8"
      />
      <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-3">GEO-Glossar · {total} Begriffe</p>
      {/* Kippsatz: Zeile 1 stellt fest, Zeile 2 dreht und spricht den Leser an. */}
      <HeroHeadline
        line1="Die KI-Suche hat ihre eigene Sprache."
        line2="Hier verstehen Sie jedes Wort."
      />
      <div class="mt-5 max-w-3xl space-y-4 text-lg text-muted-foreground leading-relaxed">
        <p data-speakable>
          Generative Engine Optimization (GEO) ist die Arbeit daran, dass ein KI-System wie ChatGPT,
          Gemini oder die Google KI-Übersicht ein Unternehmen nennt oder als Quelle zitiert. Dieses
          Glossar erklärt die Begriffe, die dabei fallen — vom Modellwissen über Grounding und
          Re-Ranking bis zur Messung mit Citation Rate und Share of AI Search.
        </p>
        <p>
          Die Gruppen folgen dem Weg, den ein Inhalt in eine KI-Antwort nimmt. Jeder Begriff hat
          eine eigene Seite mit Definition, Funktionsweise und dem, was er für Ihre Website bedeutet.
        </p>
      </div>

      <nav aria-label="Gruppen" class="mt-8 flex flex-wrap gap-2">
        {groups.map((g) => (
          <a
            href={`#${g.id}`}
            class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-cta/50 hover:text-cta-accessible"
          >
            {g.title} <span class="text-muted-foreground">({g.terms.length})</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-10 space-y-16">
      {groups.map((g, gi) => (
        <section id={g.id} aria-labelledby={`h-${g.id}`} class="scroll-mt-28">
          <div class="max-w-3xl">
            <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-2">Gruppe {gi + 1} von {groups.length}</p>
            <h2 id={`h-${g.id}`} class="cai-h2">{g.title}</h2>
            <p class="mt-3 text-muted-foreground leading-relaxed">{g.intro}</p>
          </div>
          {/* dl statt Karten-Grid: Begriff und Definition gehören semantisch
              zusammen, und eine Definitionsliste ist genau das Format, das
              KI-Systeme als Begriff/Erklärung-Paar extrahieren. */}
          <dl class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
            {g.terms.map((t) => (
              <div class="group rounded-2xl border border-border bg-card p-5 transition-colors hover:border-cta/40">
                <dt class="text-base font-semibold text-foreground">
                  <a href={`${base}${GLOSSAR_PATH}${t.id}/`} class="hover:text-cta-accessible transition-colors">
                    {t.data.title}
                    <span class="sr-only"> — Begriff im GEO-Glossar</span>
                  </a>
                  {t.data.synonyms.length > 0 && (
                    <span class="block text-xs font-normal text-muted-foreground mt-0.5">auch: {t.data.synonyms.join(', ')}</span>
                  )}
                </dt>
                <dd class="mt-2 text-sm text-muted-foreground leading-relaxed">{t.data.shortDefinition}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <section class="mx-auto max-w-7xl px-6 lg:px-8 pb-16">
      <div class="rounded-2xl border border-border bg-muted/20 p-6 lg:p-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-cta-accessible mb-2">Vom Begriff zur Zahl</p>
        <h2 class="cai-h2">Die Begriffe sind erklärt. Die Frage ist, wie Ihr Unternehmen darin abschneidet.</h2>
        <p class="mt-4 max-w-3xl text-muted-foreground leading-relaxed">
          Das Digital Visibility Audit misst Mention Rate, Citation Rate und Share of AI Search für Ihr
          Unternehmen zu echten Einkäuferfragen — dieselben Kennzahlen, die dieses Glossar erklärt.
        </p>
        <div class="mt-6">
          <AuditCTA lang={lang} variant="band" />
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
