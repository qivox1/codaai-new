---
/* /visibility-snapshot/ — Weiterleitung (seit 01.10.2026, Beschluss Oli).
   Der Snapshot liegt jetzt im Kopfbereich der Startseite (/#snapshot). Diese
   Datei bleibt, damit alte Links, Nurture-Mails, LinkedIn-Beiträge und
   Lesezeichen weiter funktionieren. Die Parameter ?d=…&q=… (Vorbefüllung +
   Autostart) werden per Skript mitgenommen; der Meta-Refresh ohne Skript
   landet ohne Parameter auf der Startseite.
   GitHub Pages kann kein 301 — deshalb Meta-Refresh + location.replace, dazu
   noindex und ein Canonical auf das Ziel. Aus der Sitemap ausgeschlossen
   (Filter in astro.config.mjs). Früherer Seiteninhalt: Git-Historie bis 2f8c965. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/#snapshot`;
const canonical = 'https://www.codaai.ai/';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <script is:inline set:html={`location.replace(${JSON.stringify(base + '/')} + location.search + '#snapshot');`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Weitergeleitet zum Visibility Snapshot | CodaAI</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center;">
    <p>
      Den Visibility Snapshot finden Sie jetzt direkt auf der
      <a href={target} style="color: hsl(var(--cta-accessible)); font-weight: 600;">Startseite</a>.
    </p>
  </body>
</html>
