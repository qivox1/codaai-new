  .vc-yend { margin-top: 1.5rem; display: grid; gap: 1.5rem; align-items: center; background: hsl(var(--surface-ink)); color: #fff; border-radius: 22px; padding: 2rem; }
  @media (min-width: 1024px) { .vc-yend { grid-template-columns: minmax(0, 1fr) auto; gap: 3rem; padding: 2.25rem 2.5rem; } }
  .vc-yend .vc-kicker { color: hsl(var(--cta-on-dark)); }
