  .vc-q-mess { margin-top: .6rem; display: flex; align-items: center; gap: .6rem; font-size: .875rem; font-weight: 600; color: hsl(var(--heading)); background: hsl(var(--cta) / .07); border-radius: 12px; padding: .55rem .7rem; }
