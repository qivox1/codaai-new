  .vc-about { align-items: start; }


  /* Experten-Slider */
  .vc-slider-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; }
  .vc-slider-nav { display: flex; gap: .6rem; }
  .vc-sbtn { width: 3rem; height: 3rem; border-radius: 99px; border: 1px solid hsl(var(--border-strong)); background: #fff; color: hsl(var(--heading)); font-size: 1.1rem; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .vc-sbtn:hover { background: hsl(var(--cta-strong)); border-color: transparent; color: #fff; }
  .vc-slider { margin-top: 2.5rem; display: flex; gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: max(1.5rem, calc((100vw - 80rem) / 2 + 2rem)); padding: .5rem max(1.5rem, calc((100vw - 80rem) / 2 + 2rem)) 1.5rem; scrollbar-width: none; }
