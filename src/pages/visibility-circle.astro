  .vc-price::before { content: 'Gründungsrunde · Start Oktober 2026'; position: absolute; top: -.85rem; left: 1.75rem; background: hsl(var(--price)); color: #fff; font-size: .75rem; font-weight: 700; letter-spacing: .04em; padding: .3rem .75rem; border-radius: 99px; }
  .vc-price-num { font-size: clamp(2.6rem, 5vw, 3.4rem); font-weight: 800; letter-spacing: -.02em; color: hsl(var(--heading)); line-height: 1.1; }
  .vc-price-num span { display: block; font-size: 1rem; font-weight: 500; letter-spacing: 0; color: hsl(var(--muted-foreground)); margin-top: .35rem; }
