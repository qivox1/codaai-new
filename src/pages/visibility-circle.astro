---
/* ── /visibility-circle — geschützte Landingpage (19.09.2026, Auftrag Oli) ──────
   Nur für eingeladene Unternehmen: keine Verlinkung in Navigation, Footer,
   Sitemap oder llms.txt; noindex.
   GitHub Pages kann keinen Server-Passwortschutz. Deshalb liegt der Inhalt
   hier NUR VERSCHLÜSSELT (AES-256-GCM, Schlüssel per PBKDF2 aus dem Passwort)
   in src/data/visibility-circle.enc.json und wird erst im Browser nach
   richtiger Passworteingabe entschlüsselt. Klartext (inhalt.html), Passwort
   (passwort.txt) und das Skript verschluesseln.mjs liegen außerhalb des
   öffentlichen Repos im Ordner CodaAI-Website/visibility-circle/.
   Inhalt ändern: inhalt.html bearbeiten → node verschluesseln.mjs → bauen.
   Link mit Passwort zum Verschicken: /visibility-circle/#zugang=<Passwort>
   (der Teil hinter # wird nie an einen Server übertragen).                   */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import enc from '../data/visibility-circle.enc.json';

const lang = 'de' as const;
---

<Layout
  lang={lang}
  title="Visibility Circle | CodaAI"
  description="Der Visibility Circle: eine kleine Runde von Marketing-Teams aus dem Mittelstand, die jeden Monat an ihrer Sichtbarkeit in KI-Antworten arbeiten. Zugang nur mit Einladung."
  article={{ noindex: true }}
>
  <Navbar lang={lang} />
  <main class="vc-main">
    <section class="vc-gate" id="vc-gate">
      <div class="vc-gate-box">
        <p class="vc-eyebrow">Visibility Circle</p>
        <h1 class="cai-h1 vc-gate-h">Diese Seite ist nur für eingeladene Unternehmen.</h1>
        <p class="vc-gate-lead">Sie haben das Passwort mit Ihrer Einladung bekommen. Falls nicht, schreiben Sie uns an <a href="mailto:hi@codaai.ai">hi@codaai.ai</a>.</p>
        <form id="vc-form" class="vc-form" autocomplete="off">
          <label for="vc-pw" class="vc-label">Passwort</label>
          <div class="vc-row">
            <input id="vc-pw" name="pw" type="password" required class="vc-input" autocomplete="current-password" />
            <button type="submit" class="vc-btn" id="vc-submit">Öffnen</button>
          </div>
          <p id="vc-err" class="vc-err" role="alert" hidden>Das Passwort passt nicht. Bitte prüfen Sie die Schreibweise.</p>
        </form>
      </div>
    </section>
    <div id="vc-content" hidden></div>
  </main>
  <Footer lang={lang} />
  <script type="application/json" id="vc-data" set:html={JSON.stringify(enc)} />
</Layout>

<script>
  const KEY = 'codaai-vc-pw';
  const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

  async function decrypt(pw: string): Promise<string | null> {
    const raw = document.getElementById('vc-data')?.textContent;
    if (!raw) return null;
    const d = JSON.parse(raw);
    try {
      const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(pw), 'PBKDF2', false, ['deriveKey']);
      const key = await crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: b64(d.salt), iterations: d.iter, hash: 'SHA-256' },
        base,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt'],
      );
      const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(d.iv) }, key, b64(d.data));
      return new TextDecoder().decode(plain);
    } catch {
      return null;
    }
  }

  function show(html: string) {
    const gate = document.getElementById('vc-gate');
    const box = document.getElementById('vc-content');
    if (!gate || !box) return;
    box.innerHTML = html;
    gate.hidden = true;
    box.hidden = false;
    const target = location.hash && !location.hash.startsWith('#zugang=') ? document.querySelector(location.hash) : null;
    if (target) target.scrollIntoView();
    (window as any).dataLayer?.push({ event: 'circle_unlock' });
    initFx(box);
  }


  /* ── Effekte im entschlüsselten Inhalt ───────────────────────────────────
     Reveal beim Scrollen (.vc-r), Piktogramme zeichnen sich (pathLength=1),
     Zahlen zählen hoch (data-count), Zeitleiste füllt sich. Bei
     prefers-reduced-motion steht alles sofort.                             */
  function initFx(root: HTMLElement) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.querySelectorAll('.vc-ico svg > *').forEach((el) => el.setAttribute('pathLength', '1'));
    const fmt = (v: number, dec: number) =>
      v.toLocaleString('de-DE', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    const count = (el: HTMLElement) => {
      const to = parseFloat(el.dataset.count || '0');
      const dec = parseInt(el.dataset.dec || '0', 10);
      const suf = el.dataset.suffix || '';
      if (reduce) { el.textContent = fmt(to, dec) + suf; return; }
      const t0 = performance.now(); const dur = 1400;
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(to * e, dec) + suf;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const targets = root.querySelectorAll<HTMLElement>('.vc-r, [data-count], .vc-timeline, .vc-ico');
    if (reduce || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-in'));
      root.querySelectorAll<HTMLElement>('[data-count]').forEach(count);
    } else {
    root.classList.add('vc-fx');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const el = en.target as HTMLElement;
        el.classList.add('is-in');
        if (el.dataset.count) count(el);
        io.unobserve(el);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    targets.forEach((el) => io.observe(el));
    }


    // Experten-Slider: Pfeile scrollen um eine Karte, Maus-Ziehen auf Desktop
    const slider = root.querySelector<HTMLElement>('.vc-slider');
    if (slider) {
      root.querySelectorAll<HTMLButtonElement>('.vc-sbtn').forEach((b) => b.addEventListener('click', () => {
        const card = slider.querySelector<HTMLElement>('.vc-expert');
        const step = card ? card.offsetWidth + 20 : 320;
        slider.scrollBy({ left: step * Number(b.dataset.dir), behavior: reduce ? 'auto' : 'smooth' });
      }));
      slider.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') slider.scrollBy({ left: 300, behavior: 'smooth' });
        if (e.key === 'ArrowLeft') slider.scrollBy({ left: -300, behavior: 'smooth' });
      });
    }

    // Anfrageformular → fertige E-Mail
    const form = root.querySelector<HTMLFormElement>('#vc-apply');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) || '').trim();
      const body = [
        'Guten Tag,', '', 'ich möchte ein Aufnahmegespräch für den Visibility Circle anfragen.', '',
        'Name: ' + v('name'), 'Funktion: ' + v('funktion'), 'Unternehmen: ' + v('firma'), 'E-Mail: ' + v('email'), '',
        'Was mich zum Circle führt:', v('nachricht') || '–',
      ].join('\n');
      const subject = 'Visibility Circle – Aufnahmegespräch ' + v('firma');
      (window as any).dataLayer?.push({ event: 'circle_request' });
      location.href = 'mailto:hi@codaai.ai?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      form.querySelector('.vc-apply-done')?.removeAttribute('hidden');
    });
  }

  async function tryOpen(pw: string, remember: boolean): Promise<boolean> {
    const html = await decrypt(pw);
    if (!html) return false;
    if (remember) {
      try { localStorage.setItem(KEY, pw); } catch {}
    }
    show(html);
    return true;
  }

  async function init() {
    // 1) Link mit Passwort: /visibility-circle/#zugang=…  (Hash sofort aus der Adresszeile nehmen)
    if (location.hash.startsWith('#zugang=')) {
      const pw = decodeURIComponent(location.hash.slice(8));
      history.replaceState(null, '', location.pathname + location.search);
      if (await tryOpen(pw, true)) return;
    }
    // 2) Schon einmal geöffnet
    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (saved && (await tryOpen(saved, false))) return;
    if (saved) { try { localStorage.removeItem(KEY); } catch {} }

    // 3) Eingabe
    const form = document.getElementById('vc-form') as HTMLFormElement | null;
    const input = document.getElementById('vc-pw') as HTMLInputElement | null;
    const err = document.getElementById('vc-err');
    const btn = document.getElementById('vc-submit') as HTMLButtonElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!input) return;
      if (btn) btn.disabled = true;
      const ok = await tryOpen(input.value.trim(), true);
      if (btn) btn.disabled = false;
      if (!ok && err) { err.hidden = false; input.select(); }
    });
    input?.focus();
  }

  // Link mit Passwort, während die Seite schon offen ist
  window.addEventListener('hashchange', () => {
    if (location.hash.startsWith('#zugang=')) init();
  });

  init();
</script>

<style is:global>
  .vc-main { padding-top: 5rem; overflow-x: clip; }
  .vc-gate[hidden], #vc-content[hidden] { display: none !important; }
  /* Gate */
  .vc-gate { min-height: 62vh; display: flex; align-items: center; padding: 3rem 1.5rem 5rem; }
  .vc-gate-box { max-width: 40rem; margin: 0 auto; width: 100%; }
  .vc-gate-h { margin-top: .75rem; }
  .vc-gate-lead { margin-top: 1.25rem; font-size: 1.125rem; line-height: 1.6; color: hsl(var(--muted-foreground)); }
  .vc-gate-lead a { color: hsl(var(--cta-accessible)); font-weight: 600; }
  .vc-form { margin-top: 2rem; }
  .vc-label { display: block; font-size: .875rem; font-weight: 600; margin-bottom: .5rem; color: hsl(var(--foreground)); }
  .vc-row { display: flex; gap: .75rem; flex-wrap: wrap; }
  .vc-input { flex: 1 1 14rem; min-width: 0; border: 1px solid hsl(var(--border-strong)); border-radius: 14px; padding: .8rem 1rem; font-size: 1rem; background: #fff; color: hsl(var(--foreground)); }
  .vc-input:focus { outline: 2px solid hsl(var(--ring)); outline-offset: 2px; }
  .vc-err { margin-top: .75rem; color: hsl(var(--error-text)); font-size: .9375rem; }

  /* Grundgerüst */
  .vc-wrap { max-width: 80rem; margin: 0 auto; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .vc-wrap { padding: 0 2rem; } }
  .vc-narrow { max-width: 52rem; }
  .vc-center { text-align: center; }
  .vc-sec { padding: 5rem 0; position: relative; }
  @media (min-width: 1024px) { .vc-sec { padding: 6.5rem 0; } }
  .vc-mist { background: hsl(var(--surface-mist)); }
  .vc-ink { background: hsl(var(--surface-ink)); color: #fff; }
  .vc-ink .cai-h2 { color: #fff; max-width: 52rem; }
  .vc-ink .vc-intro, .vc-ink .vc-small, .vc-ink p { color: hsl(var(--muted-foreground-on-dark)); }
  .vc-ink a { color: hsl(var(--cta-on-dark)); }
  .vc-eyebrow { font-size: .8125rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: hsl(var(--cta-accessible)); }
  .vc-eyebrow-dark { color: hsl(var(--cta-on-dark)); margin-bottom: 1rem; }
  .vc-kicker { display: block; font-size: .78rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: hsl(var(--cta-accessible)); margin: 0 0 .45rem; }
  .vc-intro { margin-top: 1.25rem; max-width: 46rem; font-size: 1.125rem; line-height: 1.65; color: hsl(var(--muted-foreground)); }
  .vc-small { margin-top: 1.5rem; font-size: .875rem; color: hsl(var(--muted-foreground)); }
  .vc-small a { color: hsl(var(--cta-accessible)); font-weight: 600; }
  .vc-mt { margin-top: 2.75rem; }
  .vc-h3 { margin-top: 3.25rem; margin-bottom: 1.25rem; font-size: 1.25rem; font-weight: 700; color: hsl(var(--heading)); }

  /* Buttons */
  .vc-actions { margin-top: 2.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .vc-btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; border-radius: 14px; background: hsl(var(--cta-strong)); color: #fff !important; padding: .85rem 1.35rem; font-size: .9375rem; font-weight: 600; border: 0; cursor: pointer; text-decoration: none; transition: background .15s, transform .15s, box-shadow .15s; box-shadow: 0 6px 20px hsl(var(--cta) / .25); }
  .vc-btn:hover { background: hsl(var(--cta-strong-hover)); transform: translateY(-1px); box-shadow: 0 10px 28px hsl(var(--cta) / .32); }
  .vc-btn:disabled { opacity: .6; cursor: wait; }
  .vc-link { font-weight: 600; font-size: .9375rem; color: hsl(var(--cta-accessible)); text-decoration: none; }
  .vc-link:hover { text-decoration: underline; }

  /* Hero */
  .vc-hero { padding: 3rem 0 4.5rem; background: radial-gradient(60rem 30rem at 85% 10%, hsl(var(--cta) / .07), transparent 60%); }
  @media (min-width: 1024px) { .vc-hero { padding: 4rem 0 5.5rem; } }
  .vc-hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 1024px) { .vc-hero-grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); } }
  .vc-h1 { margin-top: 1rem; }
  .vc-h1 .k1, .vc-h1 .k2 { display: block; }
  .vc-lead { margin-top: 1.5rem; max-width: 42rem; font-size: 1.1875rem; line-height: 1.65; color: hsl(var(--muted-foreground)); }
  .vc-founder { margin-top: 1.75rem; display: flex; align-items: center; gap: .6rem; font-size: .9375rem; font-weight: 500; color: hsl(var(--foreground)); }
  .vc-dot { width: .6rem; height: .6rem; border-radius: 99px; background: hsl(var(--confirm)); flex: none; box-shadow: 0 0 0 0 hsl(var(--confirm) / .5); animation: vcPulse 2.2s infinite; }
  @keyframes vcPulse { 0% { box-shadow: 0 0 0 0 hsl(var(--confirm) / .45); } 70% { box-shadow: 0 0 0 .6rem hsl(var(--confirm) / 0); } 100% { box-shadow: 0 0 0 0 hsl(var(--confirm) / 0); } }

  .vc-orbit { max-width: 22rem; width: 100%; margin: 0 auto; }
  .vc-orbit svg { width: 100%; height: auto; overflow: visible; }
  .vc-orbit-ring { fill: none; stroke: hsl(var(--border-strong)); stroke-width: 1.5; stroke-dasharray: 4 7; }
  .vc-orbit-inner { fill: hsl(var(--cta) / .06); stroke: hsl(var(--cta) / .25); stroke-width: 1.5; }
  .vc-orbit-spin { transform-origin: 160px 160px; animation: vcSpin 60s linear infinite; }
  .vc-node { fill: #fff; stroke: hsl(var(--navy-400)); stroke-width: 2; opacity: 0; animation: vcNode .5s ease forwards; animation-delay: calc(300ms + var(--k) * 90ms); }
  .vc-node-on { fill: hsl(var(--cta)); stroke: hsl(var(--cta)); filter: drop-shadow(0 0 10px hsl(var(--cta) / .55)); }
  .vc-orbit-num { font-size: 64px; font-weight: 800; fill: hsl(var(--heading)); letter-spacing: -.03em; }
  .vc-orbit-lbl { font-size: 14px; font-weight: 600; fill: hsl(var(--muted-foreground)); letter-spacing: .02em; }
  @keyframes vcSpin { to { transform: rotate(360deg); } }
  @keyframes vcNode { from { opacity: 0; } to { opacity: 1; } }

  .vc-facts { margin-top: 3rem; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .vc-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .vc-fact { border: 1px solid hsl(var(--border)); border-radius: 18px; padding: 1.2rem 1.3rem; display: flex; flex-direction: column; gap: .35rem; font-size: .9375rem; color: hsl(var(--muted-foreground)); background: hsl(var(--card)); }
  .vc-fact-num { font-size: 2rem; font-weight: 800; letter-spacing: -.02em; color: hsl(var(--heading)); font-variant-numeric: tabular-nums; }

  /* Studienzahlen */
  .vc-stats { margin-top: 3rem; display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .vc-stats { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .vc-stat { border-top: 2px solid hsl(var(--cta-on-dark) / .55); padding-top: 1.5rem; }
  .vc-stat-num { display: block; font-size: clamp(3.2rem, 7vw, 5rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; color: #fff; font-variant-numeric: tabular-nums; background: linear-gradient(135deg, #fff 30%, hsl(var(--cta-on-dark))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .vc-stat p { margin-top: 1rem; font-size: 1.125rem; line-height: 1.55; max-width: 28rem; }
  .vc-source { margin-top: 2.75rem; font-size: .875rem; letter-spacing: .01em; }
  .vc-source span { font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }

  /* Karten */
  .vc-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .vc-g2, .vc-g3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .vc-g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .vc-card, .vc-step { position: relative; background: hsl(var(--card)); border: 1px solid hsl(var(--border)); border-radius: 18px; padding: 1.6rem 1.7rem; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  .vc-card:hover, .vc-step:hover { transform: translateY(-3px); box-shadow: 0 14px 34px hsl(var(--navy-700) / .09); border-color: hsl(var(--cta) / .35); }
  .vc-card h3, .vc-principle h3, .vc-step h3, .vc-evid h3, .vc-tl-step h3 { font-size: 1.125rem; font-weight: 700; line-height: 1.35; color: hsl(var(--heading)); }
  .vc-card p, .vc-principle p, .vc-step p, .vc-evid p, .vc-tl-step p { margin-top: .6rem; font-size: 1rem; line-height: 1.6; color: hsl(var(--muted-foreground)); }
  .vc-card p.vc-kicker, .vc-evid p.vc-kicker, .vc-tl-step p.vc-kicker { margin-top: 0; color: hsl(var(--cta-accessible)); }
  .vc-card-num .vc-kicker { color: hsl(var(--muted-foreground)); }
  .vc-card-cta { background: hsl(var(--surface-ink)); border-color: transparent; }
  .vc-card-cta h3 { color: #fff; }
  .vc-card-cta p { color: hsl(var(--muted-foreground-on-dark)); }
  .vc-card-cta .vc-link { display: inline-block; margin-top: 1rem; color: hsl(var(--cta-on-dark)); }
  .vc-row { display: flex; gap: 1.1rem; align-items: flex-start; }
  .vc-row .vc-ico { margin: 0; }
  .vc-stack { display: grid; gap: 1rem; }
  .vc-role { display: flex; flex-direction: column; }
  .vc-time { margin-top: auto; padding-top: 1.25rem; font-size: .875rem; font-weight: 700; color: hsl(var(--heading)); display: flex; align-items: center; gap: .5rem; }
  .vc-time::before { content: ''; width: 1.25rem; height: 2px; background: hsl(var(--cta)); }
  .vc-principle { border-top: 3px solid hsl(var(--cta)); padding-top: 1.5rem; }
  .vc-principle .vc-ico { margin-bottom: 1rem; }

  /* Piktogramme im CodaAI-Stil: 24er-Raster, Strich 1.75, Kachel Magenta 10 % */
  .vc-ico { display: inline-flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; border-radius: 12px; background: hsl(var(--cta) / .1); color: hsl(var(--cta-accessible)); margin-bottom: 1.1rem; flex: none; transition: background .22s ease, transform .22s ease; }
  .vc-ico svg { width: 1.4rem; height: 1.4rem; }
  .vc-ico-lg { width: 3.5rem; height: 3.5rem; border-radius: 16px; margin-bottom: 1.5rem; }
  .vc-ico-lg svg { width: 1.8rem; height: 1.8rem; }
  .vc-card:hover .vc-ico, .vc-principle:hover .vc-ico { background: hsl(var(--cta) / .18); transform: scale(1.05); }
  .vc-fx .vc-ico svg > * { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .vc-fx .vc-ico.is-in svg > * { stroke-dashoffset: 0; transition: stroke-dashoffset .9s ease .15s; }
  .vc-card:hover .vc-ico.is-in svg > * { animation: vcDraw .75s ease; }
  @keyframes vcDraw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  /* Reveal */
  .vc-fx .vc-r { opacity: 0; transform: translateY(22px); }
  .vc-fx .vc-r.is-in { opacity: 1; transform: none; transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1); transition-delay: calc(var(--i, 0) * 110ms); }
  .vc-fx .vc-r.is-in:hover { transition-delay: 0s; transition-duration: .25s; }

  /* Zeitleiste */
  .vc-timeline { position: relative; display: grid; gap: 1.5rem; }
  @media (min-width: 1024px) { .vc-timeline { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; } }
  .vc-tl-line { display: none; }
  @media (min-width: 1024px) {
    .vc-tl-line { display: block; position: absolute; left: .55rem; right: 2rem; top: .55rem; height: 2px; background: hsl(var(--border-strong)); }
    .vc-tl-line span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, hsl(var(--navy-500)), hsl(var(--cta))); transition: width 2.2s cubic-bezier(.22,1,.36,1) .2s; }
    .vc-timeline.is-in .vc-tl-line span, .vc-timeline:not(.vc-fx *) .vc-tl-line span { width: 100%; }
  }
  .vc-tl-step { position: relative; padding-top: 2.25rem; }
  .vc-tl-dot { position: absolute; top: 0; left: 0; width: 1.1rem; height: 1.1rem; border-radius: 99px; background: #fff; border: 3px solid hsl(var(--navy-500)); }
  .vc-tl-end .vc-tl-dot { border-color: hsl(var(--cta)); background: hsl(var(--cta)); box-shadow: 0 0 0 6px hsl(var(--cta) / .15); }

  /* Quartale */
  .vc-quarters { display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .vc-quarters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
