  /* Jahresplan (22.09.2026): Quartale als Zeilen, drei Monate nebeneinander, Eigenständigkeit als Leiste */
  .vc-year { display: grid; gap: 1.25rem; }
  .vc-yq { border: 1px solid hsl(var(--border)); border-radius: 18px; padding: 1.4rem; background: hsl(var(--card)); display: grid; gap: 1rem; }
  @media (min-width: 1024px) { .vc-yq { grid-template-columns: 12.5rem minmax(0, 1fr); column-gap: 2rem; padding: 1.6rem 1.75rem; } .vc-yq .vc-q-mess { grid-column: 2; } }
  .vc-yq-head { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .6rem; align-content: start; }
  @media (min-width: 1024px) { .vc-yq-head { flex-direction: column; align-items: flex-start; } }
  .vc-yq-stufe { font-size: .78rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: hsl(var(--cta-accessible)); }
  .vc-meter { display: inline-flex; gap: 4px; }
  .vc-meter i { width: 1.35rem; height: 6px; border-radius: 99px; background: hsl(var(--border-strong)); }
  .vc-meter i.on { background: linear-gradient(90deg, hsl(var(--navy-500)), hsl(var(--cta))); }
  .vc-yq ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  @media (min-width: 720px) { .vc-yq ol { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; } }
