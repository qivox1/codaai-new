  .vc-q-tag { font-weight: 800; font-size: .8rem; color: #fff; background: hsl(var(--surface-ink)); border-radius: 8px; padding: .2rem .5rem; }
  .vc-q-name { font-weight: 700; color: hsl(var(--heading)); }
  .vc-q ol { list-style: none; margin: 0; padding: 0; flex: 1; }
  .vc-q li { display: flex; gap: .85rem; padding: .9rem 0; border-bottom: 1px dashed hsl(var(--border)); }
  .vc-q li:last-child { border-bottom: 0; }
