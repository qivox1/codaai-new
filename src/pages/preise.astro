---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Booking from '../components/Booking.astro';
import PricingCalculatorV2 from '../components/react/PricingCalculatorV2';
import Breadcrumb from '../components/Breadcrumb.astro';
import Reveal from '../components/fx/Reveal.astro';
import HeroHeadline from '../components/HeroHeadline.astro';

const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/* ── Die drei Stufen (Beschluss 27.07.2026) ───────────────────────────────────
   Sichtbarkeit ist das Produkt, Content die Dosierung. "Ohne Stufe" entfällt.
   Stückpreis hängt an der Stufe, jede Stufe hat ein disjunktes Artikelfenster.

   Reduktion 27.07.2026 (Entscheidung Oli, nach dem Launch der Leistungsseite):
   Die Karten teasern nur noch — Beschreibung, Umfang, Preis, Link. Die
   Bausteinlisten stehen vollständig auf /digital-visibility und werden hier nicht
   mehr zweitverwertet. Ebenso entfällt der Block „Was wir nicht versprechen"
   (steht dort in voller Länge) und die FAQ schrumpft auf die fünf Preis- und
   Vertragsfragen.
   Konzept: umbau-digital-visibility/2026-07-27_Preise-Neukonzept_Beschluss.md   */
const stufen = [
  {
    level: 'Stufe 1',
    name: 'Gefunden',
    anchor: 'lesbar',
    ergebnis: 'Die KI kann Sie lesen — und Sie sehen monatlich, wo Sie stehen',
    bausteine: '6 Bausteine',
    from: 'ab 1.470 €',
    recommended: false,
  },
  {
    level: 'Stufe 2',
    name: 'Empfohlen',
    anchor: 'quellen',
    ergebnis: 'Ihr Name fällt auch dort, wo die KI ihre Belege holt',
    bausteine: '10 Bausteine',
    from: 'ab 2.670 €',
    recommended: true,
  },
  {
    level: 'Stufe 3',
    name: 'Zitiert',
    anchor: 'quelle-werden',
    ergebnis: 'Ihr Markt beruft sich auf Ihre Zahlen',
    bausteine: '14 Bausteine',
    from: 'ab 4.910 €',
    recommended: false,
  },
];

/* ── FAQ — reduziert auf die fünf Preis- und Vertragsfragen (27.07.2026).
      Die Inhaltsfragen („Was steckt in einem Fachbeitrag", „Was messen Sie
      monatlich", „Nur Artikel ohne Stufe") beantwortet jetzt /digital-visibility. ── */
const faqs = [
  {
    q: 'Wie setzt sich mein Monatspreis zusammen?',
    a: 'Aus drei Posten: der Anzahl Fachbeiträge multipliziert mit dem Stückpreis Ihrer Stufe, den optionalen Erweiterungen (Übersetzungen, Videos) und dem festen Grundpreis Ihrer Stufe. Beispiel: 4 Artikel × 420 € = 1.680 €, plus Grundpreis der Stufe Empfohlen 990 € = 2.670 € pro Monat. Alles netto, alles auf einer Rechnung.',
  },
  {
    q: 'Warum kostet ein Artikel in Stufe 1 mehr als in Stufe 3?',
    a: 'Weil der Mengenrabatt an der Stufe hängt, nicht an der Artikelzahl: 490 € in Stufe 1, 420 € in Stufe 2, 390 € in Stufe 3. Wer mehr Inhalt braucht, ist in einer höheren Stufe günstiger unterwegs — und bekommt die stärkeren Hebel dazu. Ein Preis je Stufe statt einer Rabatttabelle.',
  },
  {
    q: 'Welche Mindestlaufzeit gilt?',
    a: 'Sechs Monate, bei monatlicher Abrechnung. Sichtbarkeit in Suche und KI-Antworten entsteht über Monate — die ersten Erwähnungen erscheinen im deutschen Markt typischerweise nach 8 bis 12 Wochen. Wer sich auf zwölf Monate festlegt, zahlt 10 % weniger. Es gibt kein automatisches Rollover: Sie entscheiden aktiv über die Verlängerung.',
  },
  {
    q: 'Kann ich die Stufe später wechseln?',
    a: 'Ein Upgrade ist jederzeit zum nächsten Monat möglich, die laufende Mindestlaufzeit läuft dabei weiter. Ein Downgrade zum Ende der Mindestlaufzeit. Die Artikelzahl innerhalb Ihrer Stufe passen Sie zu jedem Verlängerungszeitpunkt an.',
  },
  {
    q: 'Wie bekomme ich ein verbindliches Angebot?',
    a: 'Stellen Sie Ihre Konfiguration im Rechner zusammen und buchen Sie das 30-Minuten-Gespräch. Sie bekommen das Angebot danach schriftlich — zum Weiterleiten an Geschäftsführung oder Einkauf. Abgerechnet wird auf Rechnung, keine Kreditkarte nötig.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  lang={lang}
  title="Preise – damit die nächste Anfrage bei Ihnen landet | CodaAI"
  description="Transparent kalkuliert statt „auf Anfrage&quot;: drei Sichtbarkeits-Stufen ab 1.470 € pro Monat, mit einem Preisrechner, dessen Summe Sie nachrechnen können."
>
  <Navbar lang={lang} />
  <main class="pt-0">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-24 lg:pt-28 pb-0">
      <Breadcrumb items={[{ label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` }, { label: 'Preise' }]} class="mb-0" />
    </div>

    <!-- ── 1 · Hero ─────────────────────────────────────────────────────
         Nutzenargument statt Kostenargument (Entscheidung Oli, 28.07.2026):
         Der Entscheider kauft keine Beiträge, er will die nächste Anfrage.
         Bewusst als Zweck formuliert („damit …"), nicht als Erfolgsversprechen
         — Platzierungs- und Erfolgsgarantien lehnen wir ausdrücklich ab.      -->
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-8 lg:pt-10 pb-16 lg:pb-20">
      <HeroHeadline
        line1="Damit die nächste Anfrage bei Ihnen landet."
        line2="Nicht beim Wettbewerber."
        class="max-w-5xl"
      />
      <p class="pr-line mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground" style="--d:2">
        Bevor jemand anfragt, fragt er die KI. Wir sorgen dafür, dass Ihr Name dort auftaucht,
        wo diese Antwort entsteht — und zeigen Ihnen jeden Monat, ob er es tut.
      </p>
      <div class="pr-line mt-8" style="--d:3">
        <a
          href="#rechner"
          class="inline-flex items-center gap-2 rounded-xl bg-cta px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          Preis konfigurieren →
        </a>
      </div>
    </div>

    <!-- ── 2 · Die drei Stufen — Teaser, Details auf /digital-visibility ─────────── -->
    <section id="stufen" aria-label="Die drei Sichtbarkeits-Stufen" class="py-20 lg:py-28 scroll-mt-24 lg:scroll-mt-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <Reveal as="div">
          <h2 class="cai-h2 max-w-5xl text-foreground">
            Drei Stufen. Je höher, desto mehr Stellen, an denen die KI Sie findet.
          </h2>
        </Reveal>

        <!-- Schiene: füllt sich magenta beim Scrollen und markiert die drei
             Stufen — dieselbe Mechanik wie die Stufen-Linie auf /digital-visibility,
             hier waagerecht. Rein dekorativ. -->
        <div class="pr-rail mt-12 hidden lg:block" aria-hidden="true" data-rail>
          <span class="pr-rail-fill"></span>
          <span class="pr-dot" style="--x:16.6%"></span>
          <span class="pr-dot" style="--x:50%"></span>
          <span class="pr-dot" style="--x:83.3%"></span>
        </div>

        <div class="mt-8 grid gap-6 lg:mt-6 lg:grid-cols-3">
          {stufen.map((s, i) => (
            <Reveal
              as="div"
              delay={i * 110}
              class={`pr-card relative flex flex-col rounded-2xl border bg-card p-6 lg:p-7 ${['lg:mt-10', 'lg:mt-5', 'lg:mt-0'][i]} ${s.recommended ? 'border-cta shadow-[0_10px_40px_hsl(var(--cta)/0.12)]' : 'border-border'}`}
            >
              {s.recommended && (
                <span class="absolute -top-3 left-6 rounded-md bg-cta px-2.5 py-1 text-[10.5px] font-bold uppercase tracking-widest text-white">
                  Empfohlen
                </span>
              )}
              <p class="text-[11.5px] font-bold uppercase tracking-widest text-cta-accessible">{s.level}</p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight text-foreground">{s.name}</h3>
              <p class="mt-3 flex-1 text-[15px] font-semibold leading-snug text-foreground">{s.ergebnis}</p>

              <p class="mt-6">
                <span class="text-3xl font-bold tracking-tight text-foreground">{s.from}</span>
                <span class="text-sm text-muted-foreground">/ Monat</span>
              </p>

              <a
                href={`${base}/digital-visibility/#${s.anchor}`}
                class="mt-4 inline-flex items-center gap-1 text-[13px] font-semibold text-cta-accessible transition-colors hover:text-cta"
              >
                {s.bausteine} →
              </a>
            </Reveal>
          ))}
        </div>

        <Reveal as="p" delay={360} class="mt-10 max-w-2xl text-sm leading-relaxed text-muted-foreground">
          Wir schreiben genauso auf, was wir bewusst <strong class="font-semibold text-foreground">nicht</strong> anbieten — sechs Punkte, jeder mit Begründung:
          <a href={`${base}/digital-visibility/#nicht-im-angebot`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">nachlesen →</a>
        </Reveal>

        <!-- Übergang in den Konfigurator: ein Knopf, darunter die Linie, die
             sich beim Scrollen füllt. Ersetzt das frühere Band mit zwei
             zusätzlichen Sätzen — die Seite soll hier zügig zum Rechner. -->
        <Reveal as="div" delay={420} class="mt-12 flex flex-col items-center">
          <a
            href="#rechner"
            class="inline-flex items-center gap-2 rounded-xl bg-cta px-6 py-4 text-sm font-semibold text-white transition-opacity hover:opacity-90"
          >
            Preis konfigurieren →
          </a>
          <span class="pr-drop mt-6" aria-hidden="true" data-drop><span class="pr-drop-fill"></span></span>
        </Reveal>
      </div>
    </section>

    <!-- ── 3 · Preisrechner (enthält beide Ausgänge) ────────────────────── -->
    <PricingCalculatorV2 lang={lang} base={base} bookingHref={`${base}/preise/#termin`} client:load />

    <!-- ── 4 · Termin ───────────────────────────────────────────────────── -->
    <Booking lang={lang} />

    <!-- ── 5 · FAQ ──────────────────────────────────────────────────────── -->
    <section id="faq" aria-label="Häufige Fragen zum Preis" class="mx-auto max-w-3xl px-6 py-16 lg:px-8 scroll-mt-24 lg:scroll-mt-28">
      <Reveal as="div">
        <h2 class="cai-h2 mb-8 text-center text-foreground">Häufige Fragen zum Preis</h2>
      </Reveal>
      <!-- Akkordeon: man sieht die fünf Fragen, geöffnet ist immer nur eine.
           Ohne JavaScript stehen alle Antworten da. -->
      <div class="pr-faq space-y-3" data-faq>
        {faqs.map((f, i) => (
          <Reveal as="div" delay={(i % 2) * 40}>
            {/* data-Attribute gehören an ein echtes Element — die Reveal-
                Komponente reicht unbekannte Props nicht durch. */}
            <div class="pr-fitem overflow-hidden rounded-xl border border-border bg-card" data-fitem>
            <h3>
              <button
                type="button"
                class="pr-fhead flex w-full items-center gap-4 p-5 text-left"
                aria-expanded="false"
                aria-controls={`faq-${i}`}
                data-fhead
              >
                <span class="flex-1 font-semibold text-foreground">{f.q}</span>
                <svg class="pr-fchev h-5 w-5 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
            </h3>
            <div id={`faq-${i}`} class="pr-fpanel" data-fpanel>
              <p class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
            </div>
            </div>
          </Reveal>
        ))}
      </div>

      <p class="mt-10 text-center text-sm text-muted-foreground">
        Noch keine Zahlen für Ihr Unternehmen?
        <a href={`${base}/#angebot`} class="font-semibold text-cta-accessible transition-colors hover:text-cta">Audit kostenlos anfordern →</a>
      </p>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />


  <style>
    /* ── Hero: Zeilen laufen beim Laden ein (wie /digital-visibility) ───── */
    .pr-line {
      opacity: 0;
      transform: translateY(18px);
      animation: prLineIn 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--d, 0) * 110ms);
    }
    h1.pr-line { --d: 0; }
    @keyframes prLineIn { to { opacity: 1; transform: none; } }

    /* ── Stufen-Schiene ─────────────────────────────────────────────────── */
    .pr-rail {
      position: relative;
      height: 2px;
      border-radius: 2px;
      background: hsl(var(--border));
    }
    .pr-rail-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: 0;
      border-radius: 2px;
      background: hsl(var(--cta));
      transition: width 0.12s linear;
    }
    .pr-dot {
      position: absolute;
      top: 50%;
      left: var(--x);
      height: 10px;
      width: 10px;
      margin: -5px 0 0 -5px;
      border-radius: 999px;
      border: 2px solid hsl(var(--border));
      background: hsl(var(--background));
      transition: border-color 0.3s ease, background-color 0.3s ease, transform 0.3s ease;
    }
    .pr-dot.is-lit {
      border-color: hsl(var(--cta));
      background: hsl(var(--cta));
      transform: scale(1.25);
    }

    /* ── Karten ─────────────────────────────────────────────────────────── */
    .pr-card { transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
    .pr-card:hover {
      transform: translateY(-4px);
      border-color: hsl(var(--cta) / 0.6);
      box-shadow: 0 16px 40px -20px hsl(var(--cta) / 0.55);
    }

    /* ── FAQ-Akkordeon ──────────────────────────────────────────────────
       Ohne JS (keine .pr-js) stehen alle Antworten offen. Beim Überfahren
       zeigt der Kopf magenta, dass sich hier etwas öffnet.                  */
    .pr-fhead { cursor: default; }
    .pr-js .pr-fhead { cursor: pointer; }
    .pr-fitem { transition: border-color 0.2s ease; }
    .pr-js .pr-fitem:hover,
    .pr-js .pr-fitem:focus-within { border-color: hsl(var(--cta) / 0.5); }
    .pr-js .pr-fhead:hover span,
    .pr-js .pr-fhead:focus-visible span { color: hsl(var(--cta-accessible)); }
    .pr-js .pr-fhead:hover .pr-fchev { color: hsl(var(--cta)); }
    .pr-fchev { transition: transform 0.3s ease, color 0.2s ease; }
    .pr-js .pr-fitem.is-open .pr-fchev { transform: rotate(180deg); color: hsl(var(--cta)); }
    .pr-js .pr-fpanel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .pr-js .pr-fitem.is-open .pr-fpanel { max-height: 420px; }

    /* ── Übergang: Linie zeichnet sich in den Rechner ───────────────────── */
    .pr-drop {
      display: block;
      position: relative;
      width: 2px;
      height: 72px;
      border-radius: 2px;
      background: hsl(var(--border));
      overflow: hidden;
    }
    .pr-drop-fill {
      position: absolute;
      inset: 0 0 auto 0;
      height: 0;
      border-radius: 2px;
      background: hsl(var(--cta));
      transition: height 0.12s linear;
    }

    @media (prefers-reduced-motion: reduce) {
      .pr-line { opacity: 1; transform: none; animation: none; }
      .pr-rail-fill, .pr-drop-fill, .pr-dot, .pr-card { transition: none; }
      .pr-js .pr-fpanel, .pr-fchev, .pr-fitem { transition: none; }
      .pr-card:hover { transform: none; }
    }
  </style>

  <script is:inline>
    (function () {
      /* Schiene und Übergangslinie füllen sich abhängig vom Scrollstand.
         Beides rein dekorativ — ohne JS bleiben sie einfach grau. */
      var rail = document.querySelector('[data-rail]');
      var railFill = rail && rail.querySelector('.pr-rail-fill');
      var dots = rail ? Array.prototype.slice.call(rail.querySelectorAll('.pr-dot')) : [];
      var drop = document.querySelector('[data-drop]');
      var dropFill = drop && drop.querySelector('.pr-drop-fill');

      function pct(el, startAt, endAt) {
        var r = el.getBoundingClientRect();
        var h = window.innerHeight;
        var p = (h * startAt - r.top) / (h * (startAt - endAt) || 1);
        return p < 0 ? 0 : p > 1 ? 1 : p;
      }

      function paint() {
        if (railFill) {
          var p = pct(rail, 0.9, 0.45);
          railFill.style.width = (p * 100).toFixed(1) + '%';
          dots.forEach(function (d, i) {
            var at = [0.166, 0.5, 0.833][i];
            d.classList.toggle('is-lit', p >= at);
          });
        }
        if (dropFill) {
          dropFill.style.height = (pct(drop, 0.95, 0.6) * 100).toFixed(1) + '%';
        }
      }

      /* FAQ: immer nur eine Frage offen. */
      var faq = document.querySelector('[data-faq]');
      if (faq) {
        faq.classList.add('pr-js');
        var items = Array.prototype.slice.call(faq.querySelectorAll('[data-fitem]'));
        items.forEach(function (el) {
          var head = el.querySelector('[data-fhead]');
          if (!head) return;
          head.addEventListener('click', function () {
            var open = !el.classList.contains('is-open');
            items.forEach(function (o) {
              o.classList.remove('is-open');
              var h = o.querySelector('[data-fhead]');
              if (h) h.setAttribute('aria-expanded', 'false');
            });
            el.classList.toggle('is-open', open);
            head.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
        });
      }

      var ticking = false;
      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () { paint(); ticking = false; });
      }, { passive: true });
      window.addEventListener('resize', paint);
      paint();
    })();
  </script>

  <Footer lang={lang} />
</Layout>
