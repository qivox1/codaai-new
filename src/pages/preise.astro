---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PricingCalculator from '../components/react/PricingCalculator';
import Breadcrumb from '../components/Breadcrumb.astro';

const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  lang={lang}
  title="Preise – CodaAI Content-Pakete"
  description="Flexible Content-Pakete ab 449 €/Monat. SEO-Texte, Grafiken und Videos. Vergleichen Sie CodaAI mit Agenturkosten und sparen Sie über 90 %."
>
  <Navbar lang={lang} />
  <main class="pt-0">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-24 lg:pt-28 pb-0">
      <Breadcrumb items={[{ label: 'Start', href: `${base}/` }, { label: 'Preise' }]} class="mb-0" />
    </div>
    <PricingCalculator lang={lang} base={base} client:load />
  </main>
  <Footer lang={lang} />
</Layout>
