---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const lang = 'de' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  lang={lang}
  title="Seite nicht gefunden – CodaAI"
  description="Die gesuchte Seite existiert nicht. Zurück zur CodaAI Startseite."
>
  <Navbar lang={lang} />
  <main class="min-h-screen flex items-center justify-center px-6 py-24">
    <div class="text-center max-w-lg mx-auto">

      <p class="text-8xl font-semibold text-cta mb-6" aria-hidden="true">404</p>

      <h1 class="cai-h1 text-foreground mb-4">
        Seite nicht gefunden
      </h1>

      <p class="text-muted-foreground text-lg mb-10">
        Die gesuchte Seite existiert leider nicht oder wurde verschoben.
        Kein Problem – hier geht's zurück.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`${base}/`}
          class="inline-flex items-center justify-center h-12 px-6 rounded-[14px] bg-cta text-white font-semibold text-sm hover:bg-cta/90 transition-colors"
        >
          Zur Startseite
        </a>
        <a
          href="mailto:hi@codaai.ai"
          class="inline-flex items-center justify-center h-12 px-6 rounded-[14px] border border-border text-foreground font-medium text-sm hover:bg-muted/50 transition-colors"
        >
          Hilfe: hi@codaai.ai
        </a>
      </div>

    </div>
  </main>
  <Footer lang={lang} />
</Layout>
