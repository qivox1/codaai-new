---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  lang="de"
  title="Impressum – CodaAI GmbH | Rechtliche Angaben"
  description="Impressum der CodaAI GmbH: Anbieterinformationen, Kontaktdaten, Handelsregistereintrag und verantwortliche Person gemäß § 5 TMG."
>
  <Navbar lang="de" />
  <main class="pt-24 lg:pt-28">
    <div class="mx-auto max-w-3xl px-6 py-16 lg:py-24">
      <Breadcrumb items={[{ label: 'Start', ariaLabel: 'Zur Startseite', href: `${base}/` }, { label: 'Impressum' }]} class="mb-8" />
      {/* Page Title */}
      <h1 class="text-4xl font-bold text-foreground mb-2">Impressum</h1>
      <p class="text-muted-foreground mb-6">
        Angaben gemäß § 5 DDG
      </p>
      <p class="text-sm text-muted-foreground leading-relaxed mb-12">
        Die CodaAI GmbH ist ein KI-Content-Unternehmen mit Sitz in Gütersloh, Deutschland. Wir entwickeln und betreiben eine KI-gestützte Content-Plattform, die mittelständischen Unternehmen hilft, hochwertigen, SEO-optimierten Content zu erstellen und zu veröffentlichen. Unser Angebot richtet sich an B2B-Unternehmen im deutschsprachigen Raum und darüber hinaus. Für Fragen zu unserem Dienst, zu Impressum-Angaben oder zu vertraglichen Themen stehen wir Ihnen gerne per E-Mail oder Telefon zur Verfügung.
      </p>

      {/* Content Sections */}
      <div class="space-y-10">
        {/* Provider */}
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Anbieter
          </h2>
          <div class="text-muted-foreground space-y-1">
            <p class="font-medium text-foreground">
              CodaAI - eine Marke der AMP Beratung
            </p>
            <p>Inhaberin: Anja Miebach</p>
            <p>Langer Weg 7b</p>
            <p>33332 Gütersloh</p>
            <p>Deutschland</p>
          </div>
        </section>

        {/* Contact */}
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Kontakt
          </h2>
          <div class="text-muted-foreground space-y-1">
            <p>Telefon: +49 (0) 151 53 40 69 69</p>
            <p>
              E-Mail:{' '}
              <a
                href="mailto:hi@codaai.ai"
                class="text-cta hover:underline"
              >
                hi@codaai.ai
              </a>
            </p>
          </div>
        </section>

        {/* VAT ID */}
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Umsatzsteuer-ID
          </h2>
          <p class="text-muted-foreground">
            Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz: DE275655431
          </p>
        </section>

        {/* Responsible for content */}
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Redaktionell verantwortlich
          </h2>
          <div class="text-muted-foreground space-y-1">
            <p>Anja Miebach</p>
            <p>Langer Weg 7b</p>
            <p>33332 Gütersloh</p>
          </div>
        </section>

        {/* EU Dispute Resolution */}
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            EU-Streitschlichtung
          </h2>
          <p class="text-muted-foreground">
            Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:{' '}
            <a
              href="https://ec.europa.eu/consumers/odr/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-cta hover:underline"
            >
              https://ec.europa.eu/consumers/odr/
            </a>
            . Unsere E-Mail-Adresse finden Sie oben im Impressum.
          </p>
        </section>

        {/* Consumer Dispute Resolution */}
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Verbraucherstreitbeilegung / Universalschlichtungsstelle
          </h2>
          <p class="text-muted-foreground">
            Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </section>

        {/* Professional Liability Insurance */}
        <section>
          <h2 class="text-lg font-semibold text-foreground mb-4 pb-2 border-b border-border">
            Angaben zur Berufshaftpflichtversicherung
          </h2>
          <div class="text-muted-foreground space-y-4">
            <div>
              <p class="font-medium text-foreground mb-1">
                Name und Sitz des Versicherers:
              </p>
              <p>Allianz Versicherungs-AG</p>
              <p>Königinstraße 28</p>
              <p>80802 München</p>
            </div>
            <div>
              <p class="font-medium text-foreground mb-1">
                Geltungsraum der Versicherung:
              </p>
              <p>Deutschland</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
  <Footer lang="de" />
</Layout>
