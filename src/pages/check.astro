---
/* /check/ — Landingpage „KI-Sichtbarkeits-Check" (DE, seit 18.09.2026).
   Aufbau in src/components/check/CheckPage.astro, das Modul selbst ist die
   sitewide AuditCTA („Ergebnis zuerst"). EN-Gegenstück: /en/check/. */
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CheckPage from '../components/check/CheckPage.astro';

const SITE_URL = 'https://www.codaai.ai';
const pageUrl = `${SITE_URL}/check/`;
const title = 'KI-Sichtbarkeits-Check: Nennt die KI Ihr Unternehmen? | CodaAI';
const description = 'Website eingeben, in Sekunden sehen, ob KI-Antworten Ihre Marke nennen — kostenlos, ohne Anmeldung. Danach auf Wunsch das vollständige Audit mit Wettbewerbern und Maßnahmenplan.';

const webPageSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  url: pageUrl,
  name: 'KI-Sichtbarkeits-Check',
  description,
  inLanguage: 'de',
  isPartOf: { '@type': 'WebSite', url: `${SITE_URL}/`, name: 'CodaAI' },
  potentialAction: {
    '@type': 'Action',
    name: 'Website prüfen',
    target: `${pageUrl}?d={domain}`,
  },
});
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'KI-Sichtbarkeits-Check', item: pageUrl },
  ],
});
---

<Layout lang="de" title={title} description={description} jsonLd={[webPageSchema, breadcrumbSchema]}>
  <Navbar lang="de" />
  <CheckPage lang="de" />
  <Footer lang="de" />
</Layout>
